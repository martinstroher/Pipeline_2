@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Albian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "albian"@en ;
    rdfs:comment "Albian is a geochronologic age of the Early Cretaceous Epoch that followed the Aptian Age, spanning from approximately 113 to 100.5 million years ago. In the context of the South Atlantic marginal basins, the Albian marks the onset of the post-rift drift phase, characterized by the deposition of platform to deep basin carbonates under open marine conditions. This age is stratigraphically represented by the deposition of the Ariri Formation evaporites and the overlying Guarujá Formation carbonates, which seal the underlying Aptian pre-salt reservoirs."@en .

presalt:AlkalineLacustrineEnvironment a owl:Class ;
    rdfs:label "alkaline lacustrine environment"@en ;
    rdfs:comment "An alkaline lacustrine environment is a lacustrine depositional environment that is characterized by lake waters with high alkalinity, typically with a pH greater than 9. Often associated with high salinity and evaporative conditions, this setting is conducive to the precipitation of distinctive minerals like stevensite and extensive non-skeletal carbonates, while being inhospitable to fauna such as mollusks."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:Alkalinity a owl:Class ;
    rdfs:label "alkalinity"@en ;
    rdfs:comment "Alkalinity is a chemical property of a natural water body that measures its capacity to neutralize acid, primarily determined by the concentration of dissolved bicarbonate and carbonate ions. In the context of Brazilian Pre-Salt lacustrine systems, periods of hyper-alkalinity (pH > 10) are critical for the widespread precipitation of chemogenic carbonates and Mg-silicate clays like stevensite. This elevated alkalinity is primarily attributed to high inputs of CO2 from magmatic/hydrothermal activity and accelerated weathering of associated volcanic rocks."@en ;
    rdfs:subClassOf presalt:Property .

presalt:Anhydrite a owl:Class ;
    rdfs:label "anhydrite"@en ;
    rdfs:comment "Anhydrite is an evaporite mineral that is a major component of the Aptian salt section in the Santos Basin, characterized by its brittle mechanical behavior and high density. Within the Pre-Salt sequence, it commonly forms a dense, high-velocity basal layer to the main halite body, creating a strong seismic reflector that defines the base of the salt. Its presence in stratified salt cycles moderates halokinesis, leading to less intense salt deformation and thinner salt structures compared to regions dominated by ductile halite."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:AntecedentTopography a owl:Class ;
    rdfs:label "antecedent topography"@en ;
    rdfs:comment "Antecedent topography is a pre-existing landscape or paleotopographic surface that controls the depositional architecture and facies distribution of overlying sedimentary units. Within the Brazilian Pre-Salt, this topography is primarily inherited from syn-rift fault blocks and the Pre-Alagoas unconformity, providing a substrate that dictates the location and geometry of subsequent lacustrine carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:Aptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "aptian"@en ;
    rdfs:comment "Aptian is a geological age of the Early Cretaceous epoch that, in the context of the South Atlantic basins, encompasses the critical period of deposition for the pre-salt petroleum system. This interval is marked by the accumulation of vast lacustrine carbonate systems, which form the prolific reservoirs of the Barra Velha Formation, and the subsequent deposition of the overlying Ariri Formation evaporites that act as the regional seal. In Brazilian stratigraphy, this age corresponds to the Alagoas local stage and is globally dated from approximately 125 to 113 million years ago."@en .

presalt:Aquifer a owl:Class ;
    rdfs:label "aquifer"@en ;
    rdfs:comment "An aquifer is a subsurface body of permeable rock that is saturated with and can transmit significant quantities of groundwater. In the context of the Brazilian Pre-Salt, aquifers are often hosted in fractured crystalline basement and can provide regional pressure support to hydrocarbon reservoirs or act as conduits for groundwater and hydrothermal fluids feeding the lacustrine depositional systems."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:Aragonite a owl:Class ;
    rdfs:label "aragonite"@en ;
    rdfs:comment "Aragonite is a calcium carbonate mineral (CaCO3) that is a common polymorph of calcite. In the context of the Pre-Salt, it is significant as the original biogenic mineral forming mollusk shells, which is typically unstable and undergoes neomorphism to calcite during diagenesis."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:AririFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "ariri formation"@en ;
    rdfs:comment "The Ariri Formation is an Aptian-age lithostratigraphic unit that consists of a thick succession of stratified, marine-derived evaporites which forms the regional seal for the Brazilian Pre-Salt petroleum system. It overlies the lacustrine carbonates of the Barra Velha Formation across a major erosional unconformity and is characterized by significant halokinesis, forming complex salt walls and diapiric structures."@en .

presalt:BarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "barra velha formation"@en ;
    rdfs:comment "The Barra Velha Formation is an Aptian-age geological formation of the Brazilian Pre-Salt that constitutes the primary lacustrine carbonate reservoir system in the Santos and Campos basins. Deposited in an alkaline lacustrine environment, it is predominantly composed of unique carbonate facies including microbialites (shrubs and stromatolites), spherulites, and laminated limestones, often with significant diagenetic alteration. Stratigraphically, it lies unconformably above the Itapema Formation and is overlain by the evaporites of the Ariri Formation."@en .

presalt:Barremian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "barremian"@en ;
    rdfs:comment "Barremian is a geological stage of the Early Cretaceous epoch that chronologically follows the Hauterivian and precedes the Aptian, spanning from approximately 131 to 126 million years ago. Within the South Atlantic pre-salt successions, this stage represents a critical period of continental rifting characterized by the deposition of lacustrine and fluvial-deltaic sediments, corresponding to the local Aratu, Buracica, and Jiquiá stages."@en .

presalt:BaseSalt a owl:Class ;
    rdfs:label "base salt"@en ;
    rdfs:comment "Base salt is a regional seismic-stratigraphic surface that defines the bottom of the Aptian evaporite sequence and the top of the underlying pre-salt carbonate section, such as the Barra Velha Formation. It is seismically expressed as a high-amplitude, continuous positive reflector generated by a basal layer of dense anhydrite, which creates a significant acoustic impedance contrast with the underlying carbonates."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:BasementHigh a owl:Class ;
    rdfs:label "basement high"@en ;
    rdfs:comment "A basement high is a positive structural feature that represents a topographically elevated area of the crystalline basement surface. In rift settings such as the Brazilian Pre-Salt, these features are commonly formed as horst blocks or through transpressive uplift, controlling the architecture of overlying sedimentary sequences and often serving as the foundation for significant hydrocarbon accumulations."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Basin a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:comment "A basin is a large-scale depression in the Earth's crust that forms through tectonic subsidence and serves as a depocenter for the accumulation of sediments. In the context of the Brazilian Pre-Salt, these basins originated as continental rift systems during the breakup of the Gondwana supercontinent and subsequently evolved into passive continental margins. These features are typically bounded by structural highs and contain the thick sedimentary successions that host petroleum systems."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral with the chemical formula CaCO₃ that, in the Pre-Salt lacustrine setting, constitutes the primary mineralogy of microbial carbonates like shrubs and spherulites and also occurs as a diagenetic product through cementation or neomorphism. Primary lacustrine calcite often preserves original fibrous or fascicular-optical crystal fabrics, whereas diagenetic calcite typically forms as equant cements filling porosity or as neomorphic crystals replacing precursor minerals like aragonite. This non-magnesian calcite is a fundamental component of Pre-Salt reservoir rocks, both forming the primary rock framework and influencing porosity through subsequent diagenetic processes."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:CamboriFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "camboriú formation"@en ;
    rdfs:comment "The Camboriú Formation is a Lower Cretaceous stratigraphic unit that constitutes the economic basement of the Santos Basin, composed primarily of syn-rift volcanic rocks. This formation consists mainly of tholeiitic basalts and associated dyke swarms emplaced during the initial Hauterevian rifting phase, although it may also include older sedimentary rift units at its base. It lies unconformably over the Precambrian crystalline basement and is directly overlain by the lacustrine deposits of the Piçarras Formation."@en .

presalt:CamposBasin a owl:NamedIndividual,
        presalt:RiftBasin ;
    rdfs:label "campos basin"@en ;
    rdfs:comment "The Campos Basin is an Early Cretaceous rift basin that is located in the Central Segment of the South Atlantic margin off the coast of East Brazil, contiguous with the Espírito Santo and Santos basins. Originating from the rifting of West Gondwana, its tectonic evolution resulted in the deposition of a significant pre-salt lacustrine carbonate section, a thick Aptian evaporite layer, and a post-rift marine succession. The basin is a major hydrocarbon province containing prolific petroleum systems in pre-salt, syn-rift, and post-rift reservoirs."@en .

presalt:Carbonate a owl:Class ;
    rdfs:label "carbonate"@en ;
    rdfs:comment "Carbonate is a sedimentary rock that is primarily composed of minerals containing the carbonate anion (CO3)2−, such as calcite and dolomite. In the Brazilian Pre-Salt, these rocks are characteristically lacustrine, forming through complex chemical and biological precipitation in alkaline lake systems to create extensive reservoir build-ups."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:CarbonateFactory a owl:Class ;
    rdfs:label "carbonate factory"@en ;
    rdfs:comment "A carbonate factory is a depositional system that produces and accumulates carbonate sediments, which in the Pre-Salt context refers to a vast, chemogenic lacustrine environment. This abiotic system was driven by hyper-alkaline water chemistry influenced by mantle-derived CO2, precipitating unique carbonate components like spherulites and crystal shrubs that form the main reservoir rocks."@en ;
    rdfs:subClassOf presalt:LacustrineDepositionalSystem .

presalt:CarbonateMound a owl:Class ;
    rdfs:label "carbonate mound"@en ;
    rdfs:comment "A carbonate mound is a large-scale carbonate buildup that exhibits a positive, mounded external geometry and is formed in a lacustrine setting through processes linked to hydrothermal fluid expulsion along major fault systems. In the Brazilian Pre-Salt, these features are identified on seismic data by their mounded shape and chaotic or convex internal reflections, representing significant reservoir intervals whose growth was synchronous with fault activity along horst blocks."@en ;
    rdfs:subClassOf presalt:CarbonateBuildup .

presalt:CarbonatePlatform a owl:Class ;
    rdfs:label "carbonate platform"@en ;
    rdfs:comment "A carbonate platform is a large-scale, seismically mappable depositional body that develops on broad structural highs within a lacustrine sag basin. In the context of the Brazilian Pre-Salt, these platforms are primarily composed of non-marine carbonate grains, such as shrubby microbial boundstones, spherulites, and intraclasts, which form significant reservoir facies. The geometry of these lacustrine platforms is often strongly influenced by antecedent topography and fault-controlled subsidence, distinguishing them from classic marine platform models."@en ;
    rdfs:subClassOf presalt:Platform .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "A carbonate reservoir is a subsurface rock body that is composed of carbonate minerals and possesses sufficient porosity and permeability to store and transmit hydrocarbons. In the Brazilian Pre-Salt, these reservoirs are typically complex successions of facies, such as spherulites, shrubs, and stromatolites, deposited in alkaline lacustrine environments. Their significant faciological and diagenetic heterogeneity often results in reservoir compartmentalization, impacting connectivity and hydrocarbon distribution."@en ;
    rdfs:subClassOf presalt:Reservoir .

presalt:Clay a owl:Class ;
    rdfs:label "clay"@en ;
    rdfs:comment "Clay is a group of authigenic magnesian phyllosilicate minerals that precipitates directly from alkaline, silica- and magnesium-rich lacustrine waters. In the Brazilian Pre-Salt, these minerals are primarily stevensite and saponite, occurring as laminated muds or as interstitial components within carbonate facies. The subsequent dissolution of these chemically unstable clays is a critical diagenetic process responsible for creating significant secondary porosity and enhancing reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000031 .

presalt:ClimateChange a owl:Class ;
    rdfs:label "climate change"@en ;
    rdfs:comment "Climate change is a long-term shift in regional paleoclimatic conditions that primarily involves variations between humid and arid states, significantly influencing lacustrine depositional systems. In the context of the South Atlantic Pre-Salt, such shifts are recorded as changes in sediment input, lake water chemistry, and faunal assemblages, which in turn control the development of carbonate facies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Clinoform a owl:Class ;
    rdfs:label "clinoform"@en ;
    rdfs:comment "A clinoform is a dipping, depositional stratigraphic surface that represents the advancing, down-sloping face of a prograding sedimentary or volcanic body. In the Pre-Salt context, they are identified on seismic data as prograding reflectors associated with carbonate platform margins, lava deltas, or fan deltas, although some apparent clinoforms can be seismic artifacts caused by steeply dipping salt bodies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:Coquina a owl:Class ;
    rdfs:label "coquina"@en ;
    rdfs:comment "Coquina is a bioclastic carbonate rock that is predominantly composed of reworked and accumulated mollusk shells, primarily bivalves and gastropods. Typically occurring as grainstones, packstones, and rudstones deposited in lacustrine rift settings, these rocks form important Pre-Salt reservoirs with significant moldic, vuggy, and intergranular porosity."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Cretaceous a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "cretaceous"@en ;
    rdfs:comment "Cretaceous is a geologic period of the Mesozoic Era that spans from approximately 145 to 66 million years ago, following the Jurassic and preceding the Paleogene. The Early Cretaceous epoch is particularly significant in South Atlantic geology as it encompasses the rifting of Gondwana and the subsequent deposition of the economically important pre-salt lacustrine carbonate sequences in basins such as Santos and Campos."@en .

presalt:CrystalShrub a owl:Class ;
    rdfs:label "crystal shrub"@en ;
    rdfs:comment "A crystal shrub is a distinctive carbonate rock facies that is characterized by an in-situ, dendritic to plumose arrangement of vertically oriented, fibrous calcite crystals. Commonly forming a type of boundstone, this facies is a primary depositional feature of the shallow, alkaline lacustrine systems of the Brazilian Pre-Salt. Crystal shrubs constitute a significant reservoir rock, exhibiting complex porosity networks that include vuggy, intracrystalline, and intergranular pores."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:Cyclothem a owl:Class ;
    rdfs:label "cyclothem"@en ;
    rdfs:comment "A cyclothem is a repetitive, shallowing-upward stratigraphic succession that records fluctuations in lake level and water chemistry within a lacustrine carbonate system. In the Barra Velha Formation, a typical cyclothem consists of basal laminated calcimudstones deposited during a flooding phase, overlain by calcite shrub and spherulite facies formed during an evaporative, high-alkalinity phase. The succession, typically 0.75 to 5 meters thick, is often capped by reworked grainstones and represents a key depositional motif."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:DeepLake a owl:Class ;
    rdfs:label "deep lake"@en ;
    rdfs:comment "A deep lake is a depositional model for the Brazilian Pre-Salt carbonates that postulates a lacustrine system with significant water depths, often exceeding hundreds of meters. In this model, carbonate deposition occurs as microbial platforms and isolated buildups, with evidence derived from seismic interpretations of features like dipping reflectors interpreted as slope clinoforms."@en ;
    rdfs:subClassOf presalt:Lake .

presalt:DeepWater a owl:Class ;
    rdfs:label "deep water"@en ;
    rdfs:comment "Deep water is a depositional environment within a lacustrine or marine basin that is characterized by sufficient depth and stratification to establish anoxic bottom conditions, typically occurring below the storm wave base. In the context of Brazilian Pre-Salt rift basins, this environment is associated with the deposition of organic-rich mudstones, which serve as the primary source rocks for the petroleum system. Structurally, these environments often correspond to the more distal, highly extended domains of the rifted margin."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:Depocenter a owl:Class ;
    rdfs:label "depocenter"@en ;
    rdfs:comment "Depocenter is an area within a sedimentary basin that is characterized by the maximum thickness of accumulated sediment. In rift basins such as the Brazilian Pre-Salt, depocenters are typically structurally controlled by active fault systems, and their locations can migrate through geologic time in response to evolving tectonic subsidence."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:DepositionalFacies a owl:Class ;
    rdfs:label "depositional facies"@en ;
    rdfs:comment "Depositional facies is a body of rock that is characterized by a distinctive set of lithological, biological, and physical attributes reflecting its origin within a specific depositional environment. In the context of the Pre-Salt, these facies are typically associated with lacustrine systems and are often defined by the combined product of primary depositional conditions and subsequent syngenetic or eodiagenetic mineral precipitation. Their spatial distribution and stacking patterns, often interpreted from seismic data, are fundamental for reconstructing the evolution of depositional systems and predicting reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:DepositionalModel a owl:Class ;
    rdfs:label "depositional model"@en ;
    rdfs:comment "A depositional model is a conceptual framework that integrates geological, geophysical, and geochemical data to explain and predict the processes, environments, and resulting three-dimensional geometry of sedimentary deposits. In the context of the Brazilian Pre-Salt, competing models, such as the microbialite platform versus the shallow evaporitic lake model, are used to interpret the origin and distribution of lacustrine carbonate reservoirs. This framework is crucial for predicting reservoir presence, quality, and continuity, thereby guiding petroleum exploration and development strategies."@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

presalt:DepositionalSetting a owl:Class ;
    rdfs:label "depositional setting"@en ;
    rdfs:comment "A depositional setting is a specific geological environment that is characterized by the physical, chemical, and biological conditions under which a particular type of sediment or rock accumulates. This environment dictates the depositional processes and resulting sedimentary facies, with examples in the Pre-Salt context including lacustrine, hydrothermal, and rift settings. The interpretation of the depositional setting, such as a deep versus shallow lacustrine system, is critical for predicting reservoir distribution and quality."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:Desiccation a owl:Class ;
    rdfs:label "desiccation"@en ;
    rdfs:comment "Desiccation is a geological process that involves the drying out of exposed or shallowly submerged sediments due to evaporation. In Pre-Salt lacustrine settings, this process leads to the formation of features such as syndepositional desiccation cracks and drives the precipitation of evaporite minerals from concentrated brines. Cyclic episodes of desiccation alternating with flooding events are fundamental to the depositional models for both the carbonate reservoir facies and the overlying stratified evaporite seals."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Dissolution a owl:Class ;
    rdfs:label "dissolution"@en ;
    rdfs:comment "Dissolution is a diagenetic process that chemically breaks down and removes mineral material, such as carbonates or Mg-rich clays, through interaction with a solvent fluid. In the Brazilian Pre-Salt, this process is a critical factor in creating and enhancing reservoir quality, particularly through the congruent dissolution of Mg-rich clays like stevensite and the later-stage dissolution of carbonate minerals. This dissolution can be driven by fluids acidified by the release of hydrogen ions during the decay of Mg-silicates."@en ;
    rdfs:subClassOf presalt:Diagenesis .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral, composed of calcium magnesium carbonate (CaMg(CO₃)₂), that is a common rock-forming constituent of sedimentary and diagenetic rocks. In Brazilian Pre-Salt lacustrine successions, it is a principal diagenetic product that occurs as primary precipitates, replacements of precursor carbonates, or pore-filling cements, significantly altering reservoir properties."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of precursor calcium carbonate minerals with the mineral dolomite through interaction with magnesium-rich fluids. In Pre-Salt lacustrine settings, this process often occurs during early diagenesis, but dolomite can also form as a primary precipitate or a pore-filling cement, significantly altering reservoir properties."@en ;
    rdfs:subClassOf presalt:Diagenesis .

presalt:EarlyCretaceous a owl:NamedIndividual,
        presalt:GeochronologicalEpoch ;
    rdfs:label "early cretaceous"@en ;
    rdfs:comment "Early Cretaceous is a geochronological epoch that, in the context of the South Atlantic, is characterized by the continental rifting of Gondwana and the subsequent deposition of thick lacustrine sequences. This interval, encompassing the Hauterivian through Albian stages, is marked by the formation of extensive rift basins where the economically significant pre-salt carbonate reservoirs were deposited. The epoch culminates with the deposition of widespread Aptian evaporites, signifying the transition towards the opening of the South Atlantic Ocean."@en .

presalt:EconomicBasement a owl:Class ;
    rdfs:label "economic basement"@en ;
    rdfs:comment "Economic basement is a subsurface stratigraphic unit that represents the deepest interval considered for hydrocarbon exploration, below which drilling is deemed economically or technically unviable. In the Brazilian Pre-Salt of the Santos Basin, this unit is specifically composed of the Hauterivian-age volcanic rocks of the Camboriú Formation. These basalts lie unconformably over the older Precambrian crystalline basement and represent the initial syn-rift phase."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:Erosion a owl:Class ;
    rdfs:label "erosion"@en ;
    rdfs:comment "Erosion is a geological process that wears away and removes rock and sediment from the land surface by natural agents. In the Brazilian Pre-Salt, significant erosion occurred at the top of the carbonate sequence due to tectonic uplift or major lake-level fall, resulting in the widespread removal of strata prior to the deposition of the overlying Ariri Formation evaporites. This event created a major unconformity, which is identified on seismic data by the truncation of underlying reflectors against the base of the salt."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:ErosionalTruncation a owl:Class ;
    rdfs:label "erosional truncation"@en ;
    rdfs:comment "Erosional truncation is a type of stratal termination that is characterized by the cutting off of inclined seismic reflectors by an overlying surface representing an episode of erosion. This geometric relationship, observed on seismic profiles, is a primary indicator of an unconformity, which marks a significant depositional hiatus and often defines the boundary of a stratigraphic sequence."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

presalt:EspRitoSantoBasin a owl:NamedIndividual,
        presalt:SedimentaryBasin ;
    rdfs:label "espírito santo basin"@en ;
    rdfs:comment "The Espírito Santo Basin is a South Atlantic marginal sedimentary basin that is located on the southeastern coast of Brazil, contiguous with the Campos and Santos basins, and formed during the Early Cretaceous rifting of West Gondwana. As a conjugate to the Kwanza Basin in West Africa, it evolved through rift, sag, and post-rift stages, which include the deposition of extensive pre-salt lacustrine carbonates and a thick overlying salt layer, forming a major petroleum province."@en .

presalt:Evaporation a owl:Class ;
    rdfs:label "evaporation"@en ;
    rdfs:comment "Evaporation is a key depositional process that removes water from a basin as vapor, thereby concentrating dissolved ions. In the restricted lacustrine systems of the Brazilian Pre-Salt, this process increased water alkalinity and salinity to the point of supersaturation. This chemical change was the primary driver for the abiotic precipitation of reservoir-forming carbonates, Mg-silicate gels, and overlying thick evaporite sequences."@en ;
    rdfs:subClassOf presalt:Deposition .

presalt:EvaporiticLake a owl:Class ;
    rdfs:label "evaporitic lake"@en ;
    rdfs:comment "An evaporitic lake is a lacustrine depositional system that is characterized by evaporation rates exceeding water inflow, resulting in an under-filled basin with significant chemical sedimentation. In the context of the Brazilian Pre-Salt, these environments are typically shallow, alkaline, and saline, promoting the precipitation of distinctive chemogenic carbonates like calcite shrubs and spherulites within Mg-silicate matrices."@en ;
    rdfs:subClassOf presalt:Lake .

presalt:FaciesVariation a owl:Class ;
    rdfs:label "facies variation"@en ;
    rdfs:comment "Facies variation is the spatial or temporal change in the lithological and petrophysical characteristics of a sedimentary rock unit that reflects differing depositional conditions. In Pre-Salt lacustrine carbonates, this often manifests as abrupt lateral transitions between reservoir and non-reservoir facies, driven by factors like sedimentary input, lake chemistry, and climate, which are critical for creating stratigraphic entrapments."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000030 .

presalt:FanDelta a owl:Class ;
    rdfs:label "fan delta"@en ;
    rdfs:comment "A fan delta is a delta that is formed by the progradation of an alluvial fan directly into a standing body of water. In the context of the Brazilian Pre-Salt, these features are associated with syn-depositional faulting along the margins of underfilled, alkaline lacustrine basins and are considered potential reservoir facies within the Barra Velha Formation."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000006 .

presalt:FaultZone a owl:Class ;
    rdfs:label "fault zone"@en ;
    rdfs:comment "A fault zone is a tabular zone of brittle deformation that consists of numerous, geometrically and kinematically related fault strands and branches. It accommodates significant displacement and is characterized by internal complexity, including high-strain fault branches and low-strain intra-fault domains that often control the location of syn-rift depocenters. Such zones can be highly segmented, exhibit varying fault polarity, and evolve through processes of fault growth and linkage."@en ;
    rdfs:subClassOf presalt:Fracture .

presalt:FloodBasalt a owl:Class ;
    rdfs:label "flood basalt"@en ;
    rdfs:comment "Flood basalt is an extensive succession of basaltic lava flows that results from the voluminous extrusion of mafic magma onto a continental surface, often associated with rifting. In the context of the South Atlantic margin, these tholeiitic basalts, such as those of the Cabiúnas and Camboriú Formations, were extruded during the early rift phase and constitute the economic basement for the overlying Pre-Salt carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:Basalt .

presalt:FlorianPolisHigh a owl:NamedIndividual,
        presalt:StructuralHigh ;
    rdfs:label "florianópolis high"@en ;
    rdfs:comment "Florianópolis High is a regional structural high that defines the southern boundary of the Santos Basin, separating it from the Pelotas Basin on the southeastern Brazilian continental margin. This basement feature acted as a critical paleogeographic barrier during the Aptian, restricting marine circulation from the south and enabling the deposition of the extensive pre-salt evaporite sequence."@en .

presalt:Gas a owl:Class ;
    rdfs:label "gas"@en ;
    rdfs:comment "Gas is a phase of petroleum that consists of a mixture of light hydrocarbon compounds and various non-hydrocarbon impurities, generated through the thermal maturation of organic matter. In the context of Pre-Salt petroleum systems, it is typically an oil-associated thermogenic fluid whose specific composition, including contaminants like CO2, is used to infer thermal maturity, fluid origin, and reservoir compartmentalization."@en ;
    rdfs:subClassOf presalt:Hydrocarbon .

presalt:GeologicalRecord a owl:Class ;
    rdfs:label "geological record"@en ;
    rdfs:comment "The geological record is the chronicle of Earth's history that is preserved within the sequence of rock strata, their internal structures, and the fossils they contain. This record provides the primary evidence for understanding past geological processes and environments, serving as a basis for comparison with unique depositional systems like the Brazilian Pre-Salt. It can refer to the entire history of the Earth as documented in rocks globally, or to a specific stratigraphic interval within a well or basin."@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

presalt:Gneiss a owl:Class ;
    rdfs:label "gneiss"@en ;
    rdfs:comment "Gneiss is a high-grade foliated metamorphic rock that is characterized by distinct compositional banding where light-colored minerals are segregated from dark-colored minerals. In the context of the South Atlantic pre-salt basins, gneiss constitutes a major component of the crystalline basement which, upon erosion during rifting, provided clasts for the syn-rift conglomerates."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:Gondwana a bfo:BFO_0000027,
        owl:NamedIndividual ;
    rdfs:label "gondwana"@en ;
    rdfs:comment "Gondwana is a former supercontinent that comprised the landmasses of the Southern Hemisphere, including the conjoined plates of South America and Africa. Its fragmentation during the Early Cretaceous initiated the rifting that formed the precursor basins of the South Atlantic Ocean, where the Brazilian Pre-Salt sequences were deposited."@en .

presalt:Graben a owl:Class ;
    rdfs:label "graben"@en ;
    rdfs:comment "A graben is a depressed structural block that is down-dropped between two or more sub-parallel normal faults as a result of crustal extension. In rift settings such as the Brazilian Pre-Salt, grabens evolve from small, isolated features into larger, linked systems that serve as primary depocenters for syn-rift sediments. These tectonic features can also act as significant permeability barriers, leading to the compartmentalization of hydrocarbon reservoirs."@en ;
    rdfs:subClassOf presalt:StructuralBlock .

presalt:Grainstone a owl:Class ;
    rdfs:label "grainstone"@en ;
    rdfs:comment "Grainstone is a grain-supported sedimentary carbonate rock that is characterized by the absence of a mud matrix, indicating deposition in a high-energy environment where currents prevent the accumulation of fine sediment. In the Pre-Salt lacustrine setting, this facies is commonly composed of mollusk fragments, spherulites, or intraclasts and represents a critical reservoir target due to its high primary intergranular porosity."@en ;
    rdfs:subClassOf presalt:GrainSupportedSedimentaryCarbonateRock .

presalt:HalfGraben a owl:Class ;
    rdfs:label "half-graben"@en ;
    rdfs:comment "A half-graben is an asymmetric structural basin that is bounded by a major normal fault on one side and a tilted, gently dipping ramp on the other. Formed in extensional or transtensional tectonic settings such as continental rifts, they are filled with syn-tectonic sediments that typically exhibit a wedge-shaped, divergent geometry thickening towards the main bounding fault."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Halite a owl:Class ;
    rdfs:label "halite"@en ;
    rdfs:comment "Halite is an evaporite mineral composed of sodium chloride (NaCl) that constitutes the primary mobile component of the Aptian salt layer in the South Atlantic marginal basins. Due to its highly ductile and plastic behavior compared to associated anhydrite, it flows under geological stress to form massive salt bodies and diapirs, which create critical structural traps for Pre-Salt hydrocarbon accumulations."@en ;
    rdfs:subClassOf presalt:Evaporite .

presalt:HangingWall a owl:Class ;
    rdfs:label "hanging wall"@en ;
    rdfs:comment "Hanging wall is the crustal block that is positioned above a non-vertical fault plane, in contrast to the footwall block which lies below it. In rift settings such as the Brazilian Pre-Salt, the hanging wall is a primary locus for deformation, accommodating strain through processes like fault-propagation folding, particularly during periods of tectonic inversion. The structural and stratigraphic complexity within the hanging wall is critical for petroleum systems, as it can form structural traps or create permeability barriers that lead to reservoir compartmentalization."@en ;
    rdfs:subClassOf presalt:StructuralBlock .

presalt:Hauterivian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "hauterivian"@en ;
    rdfs:comment "Hauterivian is a geologic age of the Early Cretaceous Epoch that spans the time from approximately 132.6 to 129.4 million years ago, following the Valanginian and preceding the Barremian. In the context of Brazilian marginal basins like the Santos and Campos, the Hauterivian corresponds to the onset of the rift phase, characterized by the development of half-grabens and extensive syn-rift volcanism. This initial rifting stage is associated with the deposition of the volcanic and volcaniclastic rocks of the Camboriú Formation, which form the economic basement for the overlying pre-salt reservoirs."@en .

presalt:Horst a owl:Class ;
    rdfs:label "horst"@en ;
    rdfs:comment "A horst is an uplifted structural block that is bounded by normal faults, creating a structural high relative to adjacent, down-dropped blocks known as grabens. In extensional rift settings such as the Brazilian Pre-Salt, horsts represent basement-involved highs that influence syn-rift depositional patterns and can be reactivated, forming critical structural traps for hydrocarbon accumulations."@en ;
    rdfs:subClassOf presalt:StructuralBlock .

presalt:HydrothermalFluid a owl:Class ;
    rdfs:label "hydrothermal fluid"@en ;
    rdfs:comment "A hydrothermal fluid is a hot subsurface fluid that circulates within the Earth's crust, driven by geothermal gradients to redistribute energy and mass. This fluid's circulation causes significant physico-chemical changes in pre-existing rocks, a process known as hydrothermal alteration or diagenesis. In the Brazilian Pre-Salt, these fluids often migrate upwards along faults, interacting with magmatic and basement rocks, and can substantially alter the porosity and permeability of carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:HydrothermalVent a owl:Class ;
    rdfs:label "hydrothermal vent"@en ;
    rdfs:comment "A hydrothermal vent is a geological structure, often forming a pipe-like complex, that is created by the fracturing, transport, and eruption of geothermally heated fluids and associated sediments. In the Brazilian Pre-Salt, these features are identified on seismic data as mounds or vertical discontinuities and are interpreted as conduits for deep-seated fluids, including mantle-derived CO2, which influence diagenesis and can form associated travertine deposits."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:HydrothermalVentComplex a owl:Class ;
    rdfs:label "hydrothermal vent complex"@en ;
    rdfs:comment "A hydrothermal vent complex is a pipe-like geological complex that is formed by the fracturing, transport, and eruption of hydrothermal fluids and sediments through the crust. These seismic-scale features, often appearing as isolated mound-like buildups, are associated with intrusive events in continental rift settings and can play a significant role in carbonate reservoir formation and heterogeneity."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:HyperAlkalineLake a owl:Class ;
    rdfs:label "hyper-alkaline lake"@en ;
    rdfs:comment "A hyper-alkaline lake is a lacustrine depositional system that is characterized by water with exceptionally high alkalinity, typically with a pH of 10 or greater, driven by factors such as high CO2 input, hydrothermal activity, and evaporation. Within the context of the Brazilian Pre-Salt, these Aptian-age lakes were sites of extensive abiotic carbonate precipitation, forming Mg-silicate gels and chemogenic calcite textures that constitute major reservoir intervals."@en ;
    rdfs:subClassOf presalt:Lake .

presalt:IntraAlagoasUnconformity a owl:NamedIndividual,
        presalt:Unconformity ;
    rdfs:label "intra-alagoas unconformity"@en ;
    rdfs:comment "The Intra-Alagoas Unconformity is an intra-formational stratigraphic surface that separates the lower and upper sections of the Barra Velha Formation within the Aptian Pre-Salt succession of the Santos Basin. Dated to approximately 117 Ma, it is seismically characterized as a regional, high-amplitude, continuous positive reflector that represents a significant period of erosion influencing the architecture of overlying carbonate reservoirs."@en .

presalt:Intraclast a owl:Class ;
    rdfs:label "intraclast"@en ;
    rdfs:comment "An intraclast is a sedimentary carbonate grain that is composed of reworked fragments of penecontemporaneous Pre-Salt lithologies, such as microbial shrubs, spherulites, or laminated clays, eroded from within the lacustrine depositional basin. These clasts are transported and redeposited by currents, forming intraclastic calcarenites and calcirudites. In the Pre-Salt, these resedimented deposits often constitute significant reservoirs due to well-developed interparticle porosity."@en ;
    rdfs:subClassOf presalt:SedimentaryGrain .

presalt:ItapemaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "itapema formation"@en ;
    rdfs:comment "The Itapema Formation is a Barremian to Aptian lacustrine stratigraphic unit of the Santos Basin Pre-Salt that is composed of interbedded mollusk-rich coquinas and organic-rich shales. Deposited during the upper rift phase, its coquinas constitute important hydrocarbon reservoirs while the shales, particularly the 'Jiquiá' member, represent a primary source rock interval."@en .

presalt:KwanzaBasin a owl:NamedIndividual,
        presalt:RiftBasin ;
    rdfs:label "kwanza basin"@en ;
    rdfs:comment "The Kwanza Basin is a major sedimentary rift basin on the continental margin of Angola that contains a significant pre-salt succession deposited during the Early Cretaceous opening of the South Atlantic. Its pre-salt stratigraphy is characterized by Barremian synrift deposits, including mollusk grainstones and organic-rich mudstones, which are overlain by Aptian sag-phase carbonates. The basin hosts important petroleum systems and is a key geological analogue to the pre-salt basins on the conjugate Brazilian margin."@en .

presalt:LacustrineCarbonate a owl:Class ;
    rdfs:label "lacustrine carbonate"@en ;
    rdfs:comment "Lacustrine carbonate is a sedimentary rock that is composed primarily of carbonate minerals precipitated or accumulated within a lacustrine (lake) environment. In the context of the South Atlantic Pre-Salt, these are typically alkaline carbonates formed during the Aptian rift phase, where deposition was driven by a combination of microbial activity and widespread abiotic chemical precipitation influenced by mantle-derived CO2 and volcanism. These deposits can form extensive platform-like geometries and constitute the primary reservoir rock in the region."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "A lacustrine environment is a nonmarine depositional system, centered on a lake, that in the South Atlantic Pre-Salt is characterized by its physical separation from the open ocean and highly saline, alkaline water chemistry. These settings are identified by the absence of marine fossils, the presence of specific nonmarine fauna like ostracods, and authigenic minerals such as stevensite that indicate high pH. They host the deposition of significant carbonate reservoir rocks, including coquinas and microbialites, often interbedded with shales."@en ;
    rdfs:subClassOf presalt:LacustrineDepositionalSystem .

presalt:LacustrineSetting a owl:Class ;
    rdfs:label "lacustrine setting"@en ;
    rdfs:comment "A lacustrine setting is a continental depositional environment that is associated with a large-scale palaeolake system, typically formed within a rift valley. In the context of the Brazilian Pre-Salt, this setting is specifically a vast, closed endorheic basin that was disconnected from the ocean and controlled by continental water inputs. Such systems can develop significant bathymetry and are characterized by the deposition of unique carbonate successions that form major petroleum reservoirs."@en ;
    rdfs:subClassOf presalt:LacustrineDepositionalSystem .

presalt:LagoaFeiaGroup a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "lagoa feia group"@en ;
    rdfs:comment "The Lagoa Feia Group is a Barremian to Late Aptian stratigraphic group in the Campos Basin, offshore Brazil, that comprises lacustrine siliciclastic and carbonate deposits of the pre-salt section, deposited during the rift and sag phases of the South Atlantic opening. It is stratigraphically positioned above the Cabiúnas Formation and extends to the top of the Retiro Formation evaporites, encompassing key reservoir intervals such as the Macabu Formation. The group is the stratigraphic equivalent of the Guaratiba Group in the Santos Basin and represents a critical component of the petroleum system in the Brazilian Pre-Salt."@en .

presalt:LakeTanganyika a owl:NamedIndividual,
        presalt:Lake ;
    rdfs:label "lake tanganyika"@en ;
    rdfs:comment "Lake Tanganyika is a modern rift lake in eastern Africa that serves as a key geological analogue for the Aptian pre-salt lacustrine systems of the South Atlantic. As one of the world's largest and deepest rift lakes, its dimensions, latitudinal position, and hydrochemistry are used for comparative studies and quantitative modeling of the ancient carbonate-producing lakes of the Santos and Campos basins."@en .

presalt:LakeWater a owl:Class ;
    rdfs:label "lake water"@en ;
    rdfs:comment "Lake water is the water contained within a lacustrine basin that originates from surface runoff, direct precipitation, and groundwater, and whose chemical composition is influenced by these inputs and subsequent in-basin modification. Within the context of the South Atlantic Pre-Salt, the lake waters were characteristically highly saline and alkaline, often with a pH greater than 9. This specific hydrochemistry, driven by evaporative concentration and variable inputs including hydrothermal fluids, was a primary control on the deposition of chemogenic carbonates and the viability of aquatic fauna."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:Laminite a owl:Class ;
    rdfs:label "laminite"@en ;
    rdfs:comment "Laminite is a finely laminated sedimentary carbonate rock that is typically of microbial origin and deposited in a shallow-water lacustrine setting. In the Brazilian Pre-Salt, this facies is considered an indicator of shallow, hyper-alkaline lake environments and often forms the basal component of shallowing-upwards cycles, representing a flooding stage. These microbial laminites are frequently associated with stromatolites and can be sharply overlain by grainstones or shrub facies within depositional sequences."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:LateAptian a owl:NamedIndividual,
        presalt:GeochronologicalEpoch ;
    rdfs:label "late aptian"@en ;
    rdfs:comment "Late Aptian is a geochronologic epoch that, in traditional South Atlantic tectono-stratigraphic models, represents the period of major evaporite deposition that concluded the pre-salt sequence. While historically dated to approximately 115 million years ago and associated with the end of rifting, this timing is now highly debated, with significant evidence suggesting the main salt was deposited earlier, in the Early Aptian."@en .

presalt:LateCretaceous a owl:NamedIndividual,
        presalt:GeochronologicalEpoch ;
    rdfs:label "late cretaceous"@en ;
    rdfs:comment "The Late Cretaceous is a geologic epoch that constitutes the final division of the Cretaceous Period, extending from approximately 100.5 to 66 million years ago. Within the Brazilian Pre-Salt domain, this time interval is significant for post-rift tectonic and magmatic events, including Santonian-Campanian volcanism, that drove deep-burial hydrothermal alteration of the underlying Early Cretaceous carbonate reservoirs. This late-stage diagenesis had a profound impact on the final characteristics of the pre-salt petroleum system."@en .

presalt:Limestone a owl:Class ;
    rdfs:label "limestone"@en ;
    rdfs:comment "Limestone is a sedimentary rock that is composed principally of calcium carbonate (CaCO3), typically in the form of the mineral calcite. In the context of the Pre-Salt, it is a dominant lithology forming a wide range of lacustrine carbonate facies, including bioclastic grainstones, packstones, wackestones, and laminated mudstones. Its components include various allochems, such as mollusk shells, and a matrix of lime mud (micrite), and it can be subject to diagenetic alteration like dolomitization."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:LowerCretaceous a owl:NamedIndividual,
        presalt:GeochronologicalEpoch ;
    rdfs:label "lower cretaceous"@en ;
    rdfs:comment "Lower Cretaceous is the earlier of two epochs of the Cretaceous Period that, in the context of the South Atlantic, encompasses the critical syn-rift and sag phases of continental breakup and the deposition of the entire pre-salt lacustrine petroleum system. This epoch includes the Hauterivian, Barremian, Aptian, and Albian stages, during which the key lacustrine source rocks and microbial carbonate reservoirs of the Brazilian Pre-Salt were deposited prior to the widespread Aptian salt."@en .

presalt:LulaField a owl:NamedIndividual,
        georeservoir:GEORES_0000020 ;
    rdfs:label "lula field"@en ;
    rdfs:comment "Lula Field is a giant pre-salt oil field in the Santos Basin offshore Brazil that was one of the first multi-billion barrel discoveries in the province. Originally named Tupi, the field is a major producer with hydrocarbons reservoired primarily in the Aptian lacustrine carbonates of the Barra Velha Formation. The field also lends its name to the 'Lula's Fingers,' a distinctive gamma-ray log signature representing shallowing-upward cyclothems in the upper Barra Velha Formation."@en .

presalt:MacabuFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "macabu formation"@en ;
    rdfs:comment "Macabu Formation is an Aptian-age stratigraphic unit of the Lagoa Feia Group that consists of lacustrine carbonates deposited in a shallow, highly alkaline, and evaporative sag basin setting within the Campos Basin. This unit is composed of shallowing-up cyclothems including mud-grade laminated carbonates, spherulitic carbonates, and calcite shrub-like crusts. It is the direct stratigraphic equivalent of the prolific Barra Velha Formation reservoirs in the Santos Basin and is overlain by the evaporites of the Retiro Formation."@en .

presalt:MagmaticEvent a owl:Class ;
    rdfs:label "magmatic event"@en ;
    rdfs:comment "A magmatic event is a discrete geological episode that involves the emplacement of magma, resulting in the formation of intrusive and/or extrusive igneous rocks within a specific time interval. In the context of the Brazilian Pre-Salt, these events are recorded as volcanic and sub-volcanic rocks of varying ages and compositions, such as Aptian basalts and Santonian-Campanian alkaline intrusions. These episodes are critical as they can be associated with hydrothermal alteration of carbonate reservoirs and the release of mantle-derived fluids that influence the petroleum system."@en ;
    rdfs:subClassOf presalt:Magmatism .

presalt:MarineCarbonate a owl:Class ;
    rdfs:label "marine carbonate"@en ;
    rdfs:comment "Marine carbonate is a carbonate rock that is precipitated from seawater through biological or chemical processes within a marine depositional environment. The depositional architecture and facies distribution of marine carbonate systems are primarily controlled by the interplay between sea-level fluctuations and the rate of carbonate factory production. These systems are distinct from lacustrine carbonates, such as those found in the Brazilian Pre-Salt, which are governed by different hydrochemical and climatic controls."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:MarineEnvironment a owl:Class ;
    rdfs:label "marine environment"@en ;
    rdfs:comment "A marine environment is a depositional environment that is influenced by oceanic waters, characterized by saline conditions and typically containing marine fauna such as foraminifera and echinoderms. In the context of the South Atlantic margin, the establishment of a marine environment marks the end of the lacustrine pre-salt depositional phase. This transition is often represented by a restricted, evaporitic shallow marine setting that deposited the Aptian salt layer, which was later succeeded by open marine conditions during the post-salt drift phase."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:MarineSystem a owl:Class ;
    rdfs:label "marine system"@en ;
    rdfs:comment "A marine system is a depositional system that is directly connected to and influenced by the global ocean. Its depositional architecture and facies are primarily controlled by eustatic sea-level fluctuations, oceanic chemistry, and global tectonic processes, in contrast to lacustrine systems which are governed by local climate, tectonics, and catchment-area inputs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

presalt:Marl a owl:Class ;
    rdfs:label "marl"@en ;
    rdfs:comment "Marl is a fine-grained sedimentary rock that is composed of a variable mixture of carbonate minerals and clay. Within Pre-Salt lacustrine settings, these rocks are characteristically rich in magnesium-bearing minerals such as stevensite and dolomite, reflecting deposition in highly alkaline lake waters. They are typically deposited in shallower, more oxidized water conditions compared to associated organic-rich muds."@en ;
    rdfs:subClassOf presalt:FineGrainedSedimentaryRock .

presalt:MicrobialMacrostructure a owl:Class ;
    rdfs:label "microbial macrostructure"@en ;
    rdfs:comment "A microbial macrostructure is an organosedimentary structure that is formed by the trapping, binding, and precipitation of minerals by microbial communities, resulting in features visible at a macroscopic or larger scale. In Pre-Salt successions, these include features such as stromatolites, oncoids, and planar laminites, as well as larger, seismically mappable buildups like mounds and reef-like forms. Although often rare in specific formations like the Barra Velha, these structures can be composed of carbonate or silica and represent significant localized buildups."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000025 .

presalt:MicrobialMicrostructure a owl:Class ;
    rdfs:label "microbial microstructure"@en ;
    rdfs:comment "Microbial microstructure is a microscopic-scale fabric or texture that is formed by or preserves evidence of microbial activity, such as biofilms or mats. In Pre-Salt carbonates, these features commonly manifest as clotted (grumous) peloidal fabrics, filament moulds, or laminated textures observed in thin section. Although often rare within the overall Barra Velha Formation, these microstructures are a key component in the interpretation of microbialites and can contribute to the formation of boundstone reservoir facies."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is an organosedimentary rock that is formed through the trapping and binding of sediment or the precipitation of minerals as a result of the growth and metabolic activity of microorganisms. These structures include various forms such as stromatolites, dendrolites, oncoids, and microbial laminites. In the Brazilian Pre-Salt, microbialites are considered to form buildups within lacustrine carbonate successions like the Barra Velha Formation, although their actual volumetric contribution is often debated and may be less significant than the informal nomenclature suggests."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:MoldicPorosity a owl:Class ;
    rdfs:label "moldic porosity"@en ;
    rdfs:comment "Moldic porosity is a type of secondary porosity that is formed by the selective dissolution of a pre-existing constituent of a rock, such as a shell or crystal, where the resulting pore space preserves the shape of the original component. In Brazilian Pre-Salt carbonate reservoirs, it is a significant porosity type commonly created by the dissolution of mollusk shells within coquinas and packstones, often by meteoric or hydrothermal fluids."@en ;
    rdfs:subClassOf presalt:Porosity .

presalt:Mound a owl:Class ;
    rdfs:label "mound"@en ;
    rdfs:comment "A mound is a carbonate buildup that forms a positive topographic feature whose genesis is strongly controlled by fluid expulsion along deep-seated fault systems. In the Brazilian Pre-Salt, these features are identified on seismic data as isolated or ridge-like bodies with a mounded external geometry, chaotic or convex internal reflections, and can reach heights of several hundred meters. Their formation is commonly attributed to precipitation from sub-lacustrine hydrothermal vents or springs, creating significant lacustrine carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:CarbonateBuildup .

presalt:Mudstone a owl:Class ;
    rdfs:label "mudstone"@en ;
    rdfs:comment "Mudstone is a fine-grained sedimentary rock that, in the Brazilian Pre-Salt context, is primarily composed of laminated magnesian clays with variable subordinate amounts of terrigenous silt, calcite, dolomite, and silica. These rocks encompass a wide compositional range, including organic-rich varieties that are critical petroleum source rocks deposited in low-energy lacustrine environments."@en ;
    rdfs:subClassOf presalt:FineGrainedSedimentaryRock .

presalt:NormalFault a owl:Class ;
    rdfs:label "normal fault"@en ;
    rdfs:comment "A normal fault is a dip-slip fault that accommodates crustal extension, characterized by the hanging wall block moving downward relative to the footwall block. In the Brazilian Pre-Salt basins, these faults are the primary structures formed during the Aptian rifting phase, typically exhibiting NNE to NE-SW strikes and bounding major rift blocks. They are fundamental in creating the horst and graben geometries that control the deposition and trapping of hydrocarbons within the pre-salt section."@en ;
    rdfs:subClassOf presalt:Fault .

presalt:OceanicCrust a owl:Class ;
    rdfs:label "oceanic crust"@en ;
    rdfs:comment "Oceanic crust is the portion of the Earth's lithosphere that is generated at mid-ocean ridges during seafloor spreading, marking the final stage of continental rifting and the onset of a mature ocean basin. In the South Atlantic passive margin, its formation commenced around the Aptian and is associated with ridge-push forces that can cause subsequent tectonic inversion within the adjacent continental basins."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Oil a owl:Class ;
    rdfs:label "oil"@en ;
    rdfs:comment "Oil is a naturally occurring liquid hydrocarbon mixture that is generated from the thermal maturation of organic matter, migrates into porous rock, and accumulates in a subsurface trap. Within a reservoir, it exists as a distinct fluid phase with a characteristic pressure gradient, forming a hydrocarbon column that is typically situated above a water zone due to its lower density. Its specific composition, gas content, and physical properties are determined by the source rock type, maturation history, and any subsequent alteration processes."@en ;
    rdfs:subClassOf presalt:Hydrocarbon .

presalt:Onlap a owl:Class ;
    rdfs:label "onlap"@en ;
    rdfs:comment "Onlap is a basal stratal termination that occurs where younger, initially horizontal strata terminate progressively updip against an older, more steeply inclined surface. Visible on seismic profiles, this geometric pattern indicates deposition during a relative rise in base level and is fundamental for identifying sequence boundaries and interpreting basin-fill history, particularly in rift settings like the Pre-Salt."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000025 .

presalt:Ooid a owl:Class ;
    rdfs:label "ooid"@en ;
    rdfs:comment "An ooid is a coated sedimentary grain, typically spherical and less than 2 mm in diameter, that is formed by the concentric precipitation of mineral layers around a central nucleus. In the context of Pre-Salt lacustrine systems, ooids accumulate in agitated, high-energy environments to form reservoir facies such as ooid grainstones. These grains are distinctively composed of minerals like the Mg-silicate stevensite and can be subject to later diagenetic alteration, including silicification."@en ;
    rdfs:subClassOf presalt:SedimentaryParticle .

presalt:OrganicMatter a owl:Class ;
    rdfs:label "organic matter"@en ;
    rdfs:comment "Organic matter is a naturally occurring, carbon-based substance that is derived from the remains of organisms and preserved within sedimentary rocks. In the context of the Brazilian Pre-Salt, fine-grained sediments rich in organic matter, such as the dark shales of the Piçarras Formation, constitute the primary source rocks for the petroleum system. This material can be observed as distinct streaks or laminae within the sedimentary succession."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Ostracod a owl:Class ;
    rdfs:label "ostracod"@en ;
    rdfs:comment "An ostracod is a microscopic aquatic crustacean that is enclosed in a bivalved carapace and serves as a primary tool for biostratigraphic zonation in the non-marine Lower Cretaceous successions of the Brazilian Pre-Salt. Due to their tolerance for stressed environments, such as deep or saline lacustrine settings, their presence and abundance are key indicators of paleoenvironmental conditions. The accumulation of their small shells can form significant bioclastic deposits, including ostracod grainstones, packstones, and wackestones."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000018 .

presalt:Packstone a owl:Class ;
    rdfs:label "packstone"@en ;
    rdfs:comment "Packstone is a grain-supported sedimentary carbonate rock that contains a matrix of carbonate mud (micrite) in the interstitial spaces between grains. In Pre-Salt successions, the grains are typically mollusk shells and fragments, but can also include spherulites, ostracods, and ooids. These rocks often form important reservoirs, especially where diagenetic processes like shell leaching have created significant moldic porosity."@en ;
    rdfs:subClassOf presalt:GrainSupportedSedimentaryCarbonateRock .

presalt:Peloid a owl:Class ;
    rdfs:label "peloid"@en ;
    rdfs:comment "A peloid is a sedimentary grain that is composed of microcrystalline to cryptocrystalline material, typically carbonate or Mg-silicate, and lacks a discernible internal structure. These sand-sized allochems are commonly rounded and can form through various mechanisms, including fecal pelleting, the micritization of other grains, or the aggregation of mud. In the context of the Brazilian Pre-Salt, both carbonate and Mg-silicate peloids are significant grain constituents in reservoir facies."@en ;
    rdfs:subClassOf presalt:SedimentaryGrain .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a petrophysical property of a porous medium that quantifies its ability to transmit fluids. In petroleum geology, it is a critical measure of reservoir quality, controlled by the size, shape, and interconnectedness of the pore network, including features like fractures and vugs. Significant variations in permeability, often caused by faults, shales, or lateral facies changes, can create barriers that lead to reservoir compartmentalization."@en ;
    rdfs:subClassOf presalt:Property .

presalt:PetroleumSystem a owl:Class ;
    rdfs:label "petroleum system"@en ;
    rdfs:comment "A petroleum system is a unified natural system that encompasses all the essential geological elements and processes required for the generation, migration, and accumulation of hydrocarbons. These elements include a mature source rock, a migration pathway, a reservoir rock, and a trap with an effective seal, such as the thick salt layer in the Santos Basin Pre-Salt which also influences source rock maturation."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Phanerozoic a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "phanerozoic"@en ;
    rdfs:comment "Phanerozoic is the current and youngest geologic eon that is characterized by the proliferation of complex, multicellular life, including animals and plants, as evidenced by an abundant fossil record. It spans from approximately 539 million years ago to the present day and is subdivided into the Paleozoic, Mesozoic, and Cenozoic eras. The Aptian-age Pre-Salt carbonate successions of the South Atlantic are a significant geological feature within the Mesozoic portion of this eon."@en .

presalt:PiArrasFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "piçarras formation"@en ;
    rdfs:comment "The Piçarras Formation is a Barremian-age geological formation that constitutes the lower syn-rift sequence of the Santos Basin, deposited in a non-marine, fluvial-lacustrine system. It is characterized by siliciclastic deposits ranging from proximal alluvial fan conglomerates and sandstones to distal lacustrine siltstones and organic-rich shales with talc-stevensite laminae. These organic-rich shales serve as the main source rocks for the Pre-Salt petroleum system."@en .

presalt:PostDepositionalFaulting a owl:Class ;
    rdfs:label "post-depositional faulting"@en ;
    rdfs:comment "Post-depositional faulting is a structural deformation process that displaces a sedimentary sequence after its deposition has ceased. Unlike syn-depositional faulting, this process does not influence the thickness of the affected stratigraphic units, which typically maintain a constant thickness across the fault. Within the Brazilian Pre-Salt, it often involves the reactivation of pre-existing rift faults, creating structural relief and inversion features that are critical for trap formation and reservoir architecture."@en ;
    rdfs:subClassOf presalt:Deformation .

presalt:PostRiftPhase a owl:Class ;
    rdfs:label "post-rift phase"@en ;
    rdfs:comment "The post-rift phase is a tectono-stratigraphic stage in basin evolution that follows the active rifting phase and is primarily driven by broad thermal subsidence, creating accommodation space for widespread deposition. In the context of the Brazilian Pre-Salt, this phase, also known as the sag or transitional phase, encompasses the deposition of the Aptian lacustrine carbonates of the Barra Velha Formation. This depositional sequence culminates with the precipitation of thick evaporite layers of the Ariri Formation, which precedes the final establishment of a passive margin."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

presalt:PostRiftSequence a owl:Class ;
    rdfs:label "post-rift sequence"@en ;
    rdfs:comment "A post-rift sequence is a tectono-stratigraphic unit that is deposited after the cessation of active faulting and crustal extension, primarily under a regime of regional thermal subsidence. This phase, also known as the sag phase, is characterized by an aggradational filling pattern with parallel seismic facies that onlap and heal the underlying rift-related topography. In the Brazilian Pre-Salt of the Santos Basin, this succession encompasses the lacustrine carbonates of the Barra Velha Formation and the overlying evaporites of the Ariri Formation."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:PreAlagoasUnconformity a owl:NamedIndividual,
        presalt:Unconformity ;
    rdfs:label "pre-alagoas unconformity"@en ;
    rdfs:comment "Pre-Alagoas unconformity is a regional unconformity of Aptian age that separates the underlying syn-rift sequence from the overlying post-rift sag sequence within the Brazilian Pre-Salt basins. This surface marks the top of the Itapema Formation and represents a significant depositional hiatus, often characterized seismically as a low to medium amplitude, discontinuous reflector."@en .

presalt:PreSalt a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "pre-salt"@en ;
    rdfs:comment "Pre-salt is a tectono-stratigraphic sequence that was deposited prior to the widespread Aptian evaporite (salt) layer associated with the opening of the South Atlantic Ocean. This Lower Cretaceous succession comprises syn-rift to post-rift deposits, including the highly productive lacustrine carbonate reservoirs and source rocks that form the supergiant petroleum systems of the Brazilian and West African conjugate margins."@en .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl .

presalt:PreSaltSection a owl:Class ;
    rdfs:label "pre-salt section"@en ;
    rdfs:comment "Pre-salt section is a tectono-stratigraphic interval that was deposited during the syn-rift and sag phases of continental rifting and is stratigraphically positioned beneath an extensive evaporite layer. In the context of the Brazilian passive margin, this section is predominantly of Aptian age and is characterized by highly productive lacustrine carbonate reservoirs, such as those of the Barra Velha Formation."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:Precambrian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "precambrian"@en ;
    rdfs:comment "Precambrian is a supereon of geologic time that spans from the formation of Earth to the beginning of the Cambrian Period, approximately 539 million years ago. In the context of the Brazilian Pre-Salt, the term refers to the crystalline igneous and metamorphic rocks that constitute the continental basement upon which the Mesozoic rift basins were deposited. The structural fabric inherited from this Precambrian basement played a critical role in controlling the geometry and evolution of the fault systems that developed during the rifting phase."@en .

presalt:PrecambrianBasement a owl:Class ;
    rdfs:label "precambrian basement"@en ;
    rdfs:comment "Precambrian basement is a complex of crystalline igneous and metamorphic rocks that formed during the Precambrian eon and constitutes the fundamental crustal framework beneath the volcanic and sedimentary sequences of a rift basin. In the context of the Brazilian Pre-Salt, it is typically composed of granitoids, orthogneisses of tonalitic to syenogranitic composition, and associated high-grade metamorphic rocks. This crystalline basement is unconformably overlain by Mesozoic flood basalts, which in turn form the economic basement directly beneath the Pre-Salt sag and rift sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:Progradation a owl:Class ;
    rdfs:label "progradation"@en ;
    rdfs:comment "Progradation is a depositional process that results in the lateral, basinward outbuilding of strata. This pattern occurs when the rate of sediment supply is greater than the rate of accommodation creation, causing depositional environments, such as shorelines or carbonate platform margins, to migrate into the basin. In seismic reflection data, progradation is characteristically expressed as clinoforms or prograding wedges, which are key geometries for interpreting the evolution of depositional systems like the lacustrine carbonate buildups of the Pre-Salt."@en ;
    rdfs:subClassOf presalt:Deposition .

presalt:PyramidLake a owl:NamedIndividual,
        presalt:Lake ;
    rdfs:label "pyramid lake"@en ;
    rdfs:comment "Pyramid Lake is a modern lacustrine system in an extensional basin in Nevada, USA, that serves as a key geological analog for the formation of Pre-Salt carbonate reservoirs. The lake is characterized by alkaline waters and contains large, sub-lacustrine tufa mounds formed by carbonate precipitation where calcium-rich spring waters vent into the lake. These exhumed mounds provide a valuable model for understanding the morphology, scale, and complex internal geometries of similar hydrothermal carbonate buildups in the South Atlantic rift basins."@en .

presalt:Recrystallization a owl:Class ;
    rdfs:label "recrystallization"@en ;
    rdfs:comment "Recrystallization is a diagenetic process that modifies the crystal fabric of primary carbonate minerals through changes in crystal size and shape. In the context of Pre-Salt carbonates, this process can transform original fibrous calcite into prismatic crystals while often preserving the primary depositional fabric, unlike neomorphism which typically obliterates original textures. This alteration may occur in an open system via dissolution and re-precipitation, potentially modifying the original geochemical and isotopic signatures of the rock."@en ;
    rdfs:subClassOf presalt:Diagenesis .

presalt:ReflectorTermination a owl:Class ;
    rdfs:label "reflector termination"@en ;
    rdfs:comment "Reflector termination is a geometric relationship observed in seismic reflection data that describes the lateral ending of a seismic reflector against another surface or reflector. The analysis of termination patterns, such as onlap, downlap, toplap, and erosional truncation, is a fundamental component of seismic stratigraphy used to interpret depositional geometries, stratal relationships, and define sequence boundaries."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a distinct rock unit that possesses sufficient porosity and permeability to store and transmit hydrocarbons. In the Brazilian Pre-Salt, these are predominantly lacustrine carbonates whose reservoir potential is defined by specific depositional textures and subsequent diagenetic alteration. Key examples include coquinas, in-situ crystal shrubs, and reworked grainstones composed of spherulites."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a measure of a rock's capacity to store and transmit fluids, which is primarily controlled by its depositional facies and subsequent diagenetic alterations. In the Brazilian Pre-Salt, high reservoir quality is associated with specific carbonate facies like in-situ shrubs and reworked grainstones, where porosity is enhanced by the dissolution of precursor clays, and its lateral variation critically impacts trap effectiveness and compartmentalization."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:Rift a owl:Class ;
    rdfs:label "rift"@en ;
    rdfs:comment "Rift is a tectonic stage of basin evolution that is driven by crustal extension and characterized by active normal faulting, which creates structurally controlled depocenters for the accumulation of syn-rift sedimentary sequences. In the context of the South Atlantic margin, this stage is associated with the deposition of lacustrine source rocks and carbonate reservoirs, where the fault systems controlled sedimentation patterns and later served as conduits for hydrocarbon migration."@en ;
    rdfs:subClassOf presalt:Tectonics .

presalt:RiftPhase a owl:Class ;
    rdfs:label "rift phase"@en ;
    rdfs:comment "A rift phase is a distinct tectono-stratigraphic stage within a syn-rift supersequence that is defined by a unique combination of tectonic strain, fault geometry, depocenter distribution, and associated lithofacies. In the Brazilian Pre-Salt, successive rift phases document the evolution of continental extension and control the deposition of key petroleum system elements, from early volcanic rocks to the later lacustrine source rocks and carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:TectonoStratigraphicInterval .

presalt:RiftSection a owl:Class ;
    rdfs:label "rift section"@en ;
    rdfs:comment "A rift section is a tectono-stratigraphic sequence that comprises the sedimentary and volcanic rocks deposited during the extensional rifting phase of a basin's evolution, with deposition strongly controlled by active normal faulting. In the Brazilian Pre-Salt basins, this section is typically divided into lower and upper rift phases, encompassing lithologies from basal volcanic rocks and fluvial-lacustrine siliciclastics to the primary organic-rich source rocks and early bioclastic carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a large-scale tectonic process that involves the extension and thinning of the lithosphere, leading to the formation of elongated basins bounded by normal faults. In the context of the South Atlantic, this process of continental breakup during the Early Cretaceous created the extensive lacustrine basins where the Pre-Salt successions were deposited. The tectonic style is often characterized by oblique extension, resulting in complex fault geometries, transfer zones, and distinct rift phases that control the initial structural and stratigraphic framework of the basin."@en ;
    rdfs:subClassOf presalt:Tectonics .

presalt:Rudstone a owl:Class ;
    rdfs:label "rudstone"@en ;
    rdfs:comment "Rudstone is a grain-supported sedimentary carbonate rock that is characterized by grains larger than 2 mm in diameter, which in the Pre-Salt context are predominantly composed of whole or fragmented bivalve shells. This facies, often described as a coquina, typically displays massive or cross-bedded depositional features and can develop significant moldic and vuggy porosity, making it an important reservoir lithotype."@en ;
    rdfs:subClassOf presalt:GrainSupportedSedimentaryCarbonateRock .

presalt:SagPhase a owl:Class ;
    rdfs:label "sag phase"@en ;
    rdfs:comment "The sag phase is a tectono-stratigraphic interval in basin evolution that follows the main syn-rift stage and is characterized by a broad, regional depression driven predominantly by thermal subsidence with minimal fault activity. In the context of the South Atlantic Pre-Salt, this Aptian-age phase encompasses the deposition of the lacustrine to transitional marine carbonates of the Barra Velha Formation and the overlying evaporites of the Ariri Formation. This phase creates a wide, saucer-shaped basin geometry that contrasts with the fault-bounded grabens of the preceding syn-rift stage."@en ;
    rdfs:subClassOf presalt:TectonoStratigraphicInterval .

presalt:SaltBasin a owl:Class ;
    rdfs:label "salt basin"@en ;
    rdfs:comment "A salt basin is a sedimentary basin that is characterized by the accumulation of an exceptionally thick succession of evaporites, primarily halite. These basins typically form in tectonically restricted settings, such as during the sag phase of continental rifting, where limited connection to the open ocean and an arid climate promote massive salt precipitation. The resulting salt layer often acts as a regional seal for underlying hydrocarbon systems and controls the structural evolution of the overlying post-rift sequence."@en ;
    rdfs:subClassOf presalt:SedimentaryBasin .

presalt:SaltDeposit a owl:Class ;
    rdfs:label "salt deposit"@en ;
    rdfs:comment "A salt deposit is a regional stratigraphic unit that is composed of evaporite minerals, primarily halite, deposited during the Aptian sag phase of the South Atlantic opening. In the Brazilian Pre-Salt province, this extensive layer separates the underlying lacustrine pre-salt reservoirs from the overlying marine post-salt section, acting as a highly effective regional seal. The mobility of this salt layer under sedimentary loading causes significant deformation (halokinesis) in the overlying strata, creating complex structural traps."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:SaltDeposition a owl:Class ;
    rdfs:label "salt deposition"@en ;
    rdfs:comment "Salt deposition is a sedimentary process that involves the accumulation of evaporite minerals, such as halite and anhydrite, from the precipitation of a restricted and hypersaline body of water. In the context of the South Atlantic margins, this widespread event occurred during the Late Aptian, marking the transition from the rift phase to the passive margin and forming a regional seal over the pre-salt carbonate reservoirs. The rapid accumulation of thick salt sequences induced significant crustal loading and subsidence, creating a mobile salt layer that profoundly influenced subsequent post-salt structural development."@en ;
    rdfs:subClassOf presalt:Deposition .

presalt:Sandstone a owl:Class ;
    rdfs:label "sandstone"@en ;
    rdfs:comment "Sandstone is a clastic sedimentary rock that is composed predominantly of sand-sized siliciclastic grains. In the context of the Pre-Salt, sandstones are typically deposited in fluvial, alluvial fan, and fan delta systems at the margins of lacustrine basins. These deposits often exhibit current laminations and can be interbedded with conglomerates or contain mollusk shells, reflecting episodic sediment input into the lake."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:SantosBasin a owl:NamedIndividual,
        presalt:SedimentaryBasin ;
    rdfs:label "santos basin"@en ;
    rdfs:comment "Santos Basin is an offshore sedimentary basin that is located on the southeastern Brazilian continental margin, bounded by the Cabo Frio High to the north and the Florianópolis High to the south. The basin originated during the Lower Cretaceous rifting of Gondwana, evolving from a continental rift system into a passive divergent margin. It is one of the world's most prolific petroleum provinces, containing the giant Pre-Salt carbonate reservoirs which account for the majority of Brazil's hydrocarbon production."@en .

presalt:Seal a owl:Class ;
    rdfs:label "seal"@en ;
    rdfs:comment "A seal is a low-permeability rock unit that forms a barrier to fluid flow, capable of trapping petroleum columns within a reservoir. Seals are categorized as static, which are completely impermeable over geological time, or dynamic, which are low-permeability baffles that restrict flow over production timescales but may allow pressure equilibration over geological time."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:SeismicFacies a owl:Class ;
    rdfs:label "seismic facies"@en ;
    rdfs:comment "A seismic facies is a mappable three-dimensional seismic unit that is defined by a distinct set of reflection characteristics, such as geometry, continuity, amplitude, and frequency, which differentiate it from adjacent units. These seismic patterns are interpreted in conjunction with well data to represent specific depositional environments or lithofacies, serving as a primary tool for inferring reservoir distribution and boundaries in settings like the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:Shale a owl:Class ;
    rdfs:label "shale"@en ;
    rdfs:comment "Shale is a fine-grained, laminated, clastic sedimentary rock that, in the context of the Brazilian Pre-Salt, is characterized by its high radioactivity and potential to act as both a source rock and a vertical seal. These shales, such as the Jiquia Member, form significant permeability barriers that can vertically segment reservoirs, leading to fluid compartmentalization and the formation of perched water tables."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:ShallowLake a owl:Class ;
    rdfs:label "shallow lake"@en ;
    rdfs:comment "A shallow lake is a lacustrine depositional system that is characterized by a low-gradient, ramp-like profile and highly evaporitic, alkaline water chemistry. In the context of the Brazilian Pre-Salt, this system is responsible for depositing the metre-scale, cyclic carbonate successions of the Barra Velha Formation, including key reservoir facies such as shrubstones and spherulites."@en ;
    rdfs:subClassOf presalt:Lake .

presalt:Shrub a owl:Class ;
    rdfs:label "shrub"@en ;
    rdfs:comment "A shrub is a dendritic carbonate growth structure that is characterized by an upward-bifurcating morphology composed of radiating bundles of fibrous-to-prismatic calcite crystals. These structures grow upward in-situ within lacustrine settings, creating positive relief and significant primary inter-branch porosity, and are a key component of Pre-Salt boundstone reservoir facies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Silica a owl:Class ;
    rdfs:label "silica"@en ;
    rdfs:comment "Silica is a group of naturally occurring minerals and amorphous solids based on silicon dioxide (SiO₂) that, in the Pre-Salt, precipitates from alkaline lacustrine waters to form primary sediments, diagenetic cements, and replacement phases. Commonly occurring as nodules, sheets, or cements of chert, chalcedony, and quartz, its precipitation is often triggered by a decrease in pH and can significantly occlude reservoir porosity."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:SilicaCement a owl:Class ;
    rdfs:label "silica cement"@en ;
    rdfs:comment "Silica cement is an authigenic mineral precipitate that consists of silica minerals, such as chalcedony and quartz, which precipitate from pore fluids to occlude primary or secondary porosity. In Pre-Salt lacustrine carbonates, it can precipitate syndepositionally or during early diagenesis due to changes in lake water chemistry, or later during burial, commonly lining vugs and occluding inter-particle porosity."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:SilicaNodule a owl:Class ;
    rdfs:label "silica nodule"@en ;
    rdfs:comment "A silica nodule is a diagenetic body of silica that forms from the early interstitial precipitation of silica gels within lacustrine carbonate sediments. In the context of the Brazilian Pre-Salt, this precipitation is triggered by a decrease in the pH of lake waters, typically associated with freshening intervals or flooding events. These nodules, which may be composed of opal, are commonly found within laminated calcimudstone facies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:Siliciclastic a owl:Class ;
    rdfs:label "siliciclastic"@en ;
    rdfs:comment "Siliciclastic is an adjective describing a class of sedimentary rocks and sediments that are composed predominantly of silicate minerals and rock fragments derived from the weathering and erosion of pre-existing rocks. This class includes common rock types such as sandstones, siltstones, and conglomerates, which are composed of clasts like quartz and fragments of rocks such as quartzite, gneiss, and schist. In the South Atlantic pre-salt basins, these deposits are found in syn-rift and sag sequences, often sourced from the erosion of basement highs and interbedded with carbonate facies."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:Silicification a owl:Class ;
    rdfs:label "silicification"@en ;
    rdfs:comment "Silicification is a diagenetic process that involves the precipitation of silica or the replacement of pre-existing minerals by silica within a rock. In Pre-Salt lacustrine carbonates, this process is often characterized by the early interstitial precipitation of silica gels to form nodules and sheets, typically triggered by a decrease in pH during lake freshening events. The resulting silicification can significantly impact reservoir quality by creating fractures or by preserving or occluding porosity."@en ;
    rdfs:subClassOf presalt:Diagenesis .

presalt:Siltstone a owl:Class ;
    rdfs:label "siltstone"@en ;
    rdfs:comment "Siltstone is a siliciclastic sedimentary rock that is composed predominantly of silt-sized particles. Within the Pre-Salt lacustrine successions, it often occurs as a low-energy, hybrid lithology in depocenters, characterized by a mixture of siliciclastic silt and carbonate material such as mollusk shells. These deposits are found within both syn-rift and sag sequences and can exhibit sedimentary structures like horizontal lamination or bioturbation."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:SourceRock a owl:Class ;
    rdfs:label "source rock"@en ;
    rdfs:comment "Source rock is a sedimentary rock that contains sufficient organic matter to generate and expel hydrocarbons when subjected to heat and pressure. In the Brazilian Pre-Salt, the primary source rocks are organic-rich calcareous shales deposited in distal lacustrine environments, such as those of the Itapema Formation. These rocks form a critical component of a petroleum system, providing the hydrocarbon charge for adjacent or overlying reservoir rocks."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:SouthAtlantic a owl:NamedIndividual,
        presalt:OceanBasin ;
    rdfs:label "south atlantic"@en ;
    rdfs:comment "The South Atlantic is an ocean basin that separates the continents of South America and Africa, formed by the rifting of the Gondwana supercontinent during the Mesozoic Era. Its formation created conjugate passive margins, such as those of Brazil and West Africa, which host prolific petroleum systems. The early rift and sag phases of its opening are particularly significant for the deposition of the extensive Aptian lacustrine carbonate successions of the Brazilian Pre-Salt."@en .

presalt:SouthAtlanticOcean a owl:NamedIndividual,
        presalt:OceanBasin ;
    rdfs:label "south atlantic ocean"@en ;
    rdfs:comment "The South Atlantic Ocean is an ocean basin that formed during the Early Cretaceous separation of the South American and African continents as part of the breakup of Gondwana. Its formation created the conjugate passive margins of Brazil and West Africa, with the initial restricted marine conditions during the Aptian leading to the widespread deposition of evaporites that form the regional seal for the Pre-Salt petroleum systems."@en .

presalt:Spherulite a owl:Class ;
    rdfs:label "spherulite"@en ;
    rdfs:comment "Spherulite is a chemogenic sedimentary particle that is composed of radiating fibrous calcite crystals forming a distinct spherical shape. These particles are interpreted to precipitate directly from calcite-supersaturated, saline, and alkaline lacustrine waters at the sediment-water interface, and are a common grain type within the Aptian Pre-Salt sag interval, often associated with Mg-silicate clays."@en ;
    rdfs:subClassOf presalt:SedimentaryParticle .

presalt:Stevensite a owl:Class ;
    rdfs:label "stevensite"@en ;
    rdfs:comment "Stevensite is an aluminum-poor, magnesium-rich smectitic clay mineral that precipitates directly from silica-rich, highly alkaline lacustrine waters. Within the Brazilian Pre-Salt, it is a characteristic authigenic mineral of low-energy, deeper-water depositional environments, commonly associated with calcite spherulites or dolomite rhombs. It can occur as discrete beds, oolitic coatings, or as a matrix component within carbonate facies."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Stromatolite a owl:Class ;
    rdfs:label "stromatolite"@en ;
    rdfs:comment "Stromatolite is an organosedimentary deposit that is formed by the trapping, binding, and precipitation of minerals by a benthic microbial community, resulting in a characteristically laminated and often convex-upward growth structure. In the context of the Brazilian Pre-Salt, stromatolites are a facies within the Barra Velha Formation that can exhibit significant fenestral and vug porosity, contributing to reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:StructuralLow a owl:Class ;
    rdfs:label "structural low"@en ;
    rdfs:comment "A structural low is a structural feature that is topographically lower in elevation than adjacent areas, typically formed by tectonic processes such as faulting. In extensional rift settings like the Brazilian Pre-Salt, these features often manifest as grabens or half-grabens flanking structural highs and serve as depocenters for sedimentary sequences, which may exhibit distinct seismic facies like onlapping, high-amplitude parallel reflectors."@en ;
    rdfs:subClassOf presalt:StructuralFeature .

presalt:SynDepositionalFaulting a owl:Class ;
    rdfs:label "syn-depositional faulting"@en ;
    rdfs:comment "Syn-depositional faulting is a structural process that involves fault movement occurring contemporaneously with sedimentary deposition. This concomitance between structural activity and sedimentation creates accommodation space, resulting in thicker stratigraphic packages on the downthrown block of the fault. In sag basins like the Brazilian Pre-Salt, this process is a primary control on facies distribution and lateral variations in reservoir quality."@en ;
    rdfs:subClassOf presalt:Deformation .

presalt:TectonicActivity a owl:Class ;
    rdfs:label "tectonic activity"@en ;
    rdfs:comment "Tectonic activity is a geological process that encompasses the deformation of the Earth's crust, manifesting as faulting, folding, and variations in subsidence. In a sedimentary basin, its intensity directly controls the creation of accommodation space, the development of structural features like horsts and grabens, and the distribution of sedimentary facies and reservoir quality. Periods of high activity are characterized by syn-depositional faulting and growth strata, while low activity is indicated by the deposition of more continuous and laterally extensive stratigraphic units."@en ;
    rdfs:subClassOf presalt:Tectonics .

presalt:TectonoStratigraphicEvolution a owl:Class ;
    rdfs:label "tectono-stratigraphic evolution"@en ;
    rdfs:comment "Tectono-stratigraphic evolution is the geological reconstruction that describes the interplay between tectonic processes and the resulting stratigraphic architecture of a sedimentary basin over time. This analysis involves integrating structural data, such as fault displacement and fold kinematics, with stratigraphic data, like sediment fill geometries and isopach maps, to understand how tectonic activity controlled depositional patterns and basin development. In the context of the Brazilian Pre-Salt, it typically delineates the distinct rift and post-rift phases, characterizing how fault-controlled subsidence and uplift influenced the deposition of lacustrine carbonates and subsequent evaporites."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Texture a owl:Class ;
    rdfs:label "texture"@en ;
    rdfs:comment "Texture is a fundamental physical property of a rock that describes the size, shape, and arrangement of its constituent components, such as crystals, grains, and cement. In Pre-Salt lacustrine carbonates, characteristic textures like spherulitic, shrub-like, and laminated cementstones provide key evidence for interpreting depositional models, which range from microbial to abiotic chemogenic processes."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:ThermalSubsidence a owl:Class ;
    rdfs:label "thermal subsidence"@en ;
    rdfs:comment "Thermal subsidence is a tectonic subsidence process that is driven by the cooling and contraction of the lithosphere following the cessation of active rifting. This process characterizes the post-rift sag phase, creating the broad, regional accommodation space that healed rift topography and enabled the deposition of the extensive Pre-Salt lacustrine systems and overlying Aptian evaporites."@en ;
    rdfs:subClassOf presalt:Subsidence .

presalt:TholeiiticBasalt a owl:Class ;
    rdfs:label "tholeiitic basalt"@en ;
    rdfs:comment "Tholeiitic basalt is an extrusive igneous rock of the tholeiitic magma series that, in the context of the Brazilian Pre-Salt, is associated with the Early Cretaceous rifting of the South Atlantic. These basalts form the economic basement as part of the Camboriú and Cabiúnas formations and also occur as volcanic flows interbedded within the pre-salt rift succession. Geochemically and temporally linked to the Paraná-Etendeka Large Igneous Province, these rocks represent the initial magmatic phase of the continental break-up."@en ;
    rdfs:subClassOf presalt:Basalt .

presalt:Trap a owl:Class ;
    rdfs:label "trap"@en ;
    rdfs:comment "A trap is a geological configuration of reservoir and seal rocks that confines and holds buoyant hydrocarbons, formed by a combination of structural and/or stratigraphic elements. In the Brazilian Pre-Salt, the dominant style is a structural trap characterized by a four-way closure of the carbonate reservoir against the overlying thick salt layer, which acts as the main seal."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Travertine a owl:Class ;
    rdfs:label "travertine"@en ;
    rdfs:comment "Travertine is a chemically precipitated carbonate rock that is deposited in continental settings from hydrothermal springs. In the Pre-Salt context, it is associated with subaerial exposure and forms mound-type and fissure ridge-type deposits, representing a potential origin for some isolated carbonate buildups."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Wackestone a owl:Class ;
    rdfs:label "wackestone"@en ;
    rdfs:comment "Wackestone is a mud-supported carbonate rock that is characterized by containing more than 10% grains floating within a fine-grained carbonate mud matrix. In Pre-Salt lacustrine settings, these rocks indicate low-energy depositional environments and are composed of grains such as mollusk fragments, ostracods, or spherulites within a matrix of lime mud, dolomite, or argillaceous minerals."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:WaterDepth a owl:Class ;
    rdfs:label "water depth"@en ;
    rdfs:comment "Water depth is the vertical distance that measures from the surface of a body of water to the sediment-water interface at the time of deposition. In sedimentary geology, it is a critical parameter for interpreting depositional environments, with specific facies associations, such as microbial laminites or wave-influenced grainstones, indicating the shallow lacustrine settings characteristic of the Brazilian Pre-Salt. This depositional measurement is distinct from the present-day vertical depth of a rock unit within a wellbore, which is used for analyzing reservoir fluid properties and pressures."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000022 .

presalt:WaveBase a owl:Class ;
    rdfs:label "wave base"@en ;
    rdfs:comment "Wave base is a conceptual water depth that marks the lower limit of sediment agitation and transport by surface wave action. In the lacustrine settings of the Pre-Salt, the zone below wave base is a lower-energy environment characterized by the accumulation of fine-grained carbonates and chemical precipitates, while the zone at or above wave base is a higher-energy environment where reworking of deposits and the formation of grainstones occur. The depth of the wave base is dynamic and can change with factors such as lake level and fetch."@en ;
    rdfs:subClassOf bfo:BFO_0000146 .

presalt:Weathering a owl:Class ;
    rdfs:label "weathering"@en ;
    rdfs:comment "Weathering is a set of geological processes that involves the physical disintegration and chemical decomposition of rocks and minerals at or near the Earth's surface. Driven by factors such as atmospheric CO2 levels, this process releases dissolved ions and alkalinity from continental crust, controlling the chemical flux into depositional basins. In lacustrine settings like the Pre-Salt, the style of weathering is a critical control on lake chemistry and carbonate precipitation, with its signature recorded by geochemical proxies such as strontium isotopes."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

georeservoir:GEORES_0000024 a owl:Class ;
    rdfs:label "lithology"@en ;
    rdfs:comment "Lithology is the characterization of a rock or stratigraphic unit that is based on its physical attributes, including composition, mineralogy, texture, and grain size. In the context of Brazilian Pre-Salt carbonates, this involves identifying specific rock types such as shrubstones, spherulitestones, grainstones, and rudstones, which result from complex depositional and diagenetic processes. This characterization is fundamental for defining reservoir facies, interpreting depositional environments, and constructing geological models."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of dissolved minerals from a body of water as it undergoes evaporation. In the Brazilian Pre-Salt, evaporites were deposited during the Aptian in both lacustrine and shallow marine settings and are primarily composed of halite and anhydrite, with Mg-rich clays also forming in some lacustrine environments. These deposits, particularly the thick, ductile halite sections, form the regional seal for the underlying carbonate reservoirs and control post-rift structural deformation through salt tectonics."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "A fault is a planar or curviplanar fracture or zone of fractures in a rock volume across which there has been significant displacement as a result of rock-mass movement. In the Brazilian Pre-Salt, faults are fundamental rift-related structures that were often active during sedimentation, controlling the depositional architecture, accommodation space, and the distribution of carbonate reservoirs. These structures are critical components of the petroleum system, forming structural traps, influencing fluid migration, and potentially compartmentalizing reservoirs."@en ;
    rdfs:subClassOf presalt:Fracture .

presalt:IgneousRock a owl:Class ;
    rdfs:label "Igneous Rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:Magmatism a owl:Class ;
    rdfs:label "magmatism"@en ;
    rdfs:comment "Magmatism is a fundamental geological process that encompasses the generation, movement, and solidification of magma and its associated volcanic and plutonic activity. Within the South Atlantic basins, multi-stage magmatic events associated with continental rifting influenced the depositional system through the release of mantle-derived CO2 and drove late-stage hydrothermal alteration of Pre-Salt carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Platform a owl:Class ;
    rdfs:label "platform"@en ;
    rdfs:comment "A platform is a large-scale, seismically-resolvable carbonate depositional body that is characterized by a relatively flat top, depositional relief, and distinct lateral and vertical facies patterns. Within the Pre-Salt sag sequence, platform tops typically represent shallow, high-energy lacustrine environments where facies such as shrubby boundstones and intraclast-spherulite grainstones accumulate. These platform-top facies often develop widespread stratified porosity and permeability, forming significant hydrocarbon reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000006 .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a fundamental physical property of a rock that quantifies the volume of void spaces, or pores, relative to the total rock volume. In Pre-Salt carbonate reservoirs, it manifests as various pore types including intergranular, inter-shrub, moldic, vuggy, and fracture porosity, which can be either primary or formed by diagenetic processes like dissolution. This property, typically expressed as a percentage, is a critical control on hydrocarbon storage capacity and overall reservoir quality."@en ;
    rdfs:subClassOf presalt:Property .

presalt:Reservoir a owl:Class ;
    rdfs:label "reservoir"@en ;
    rdfs:comment "A reservoir is a subsurface rock formation that possesses sufficient porosity and permeability to store and transmit fluids such as oil and gas. In the Brazilian Pre-Salt, reservoirs are typically complex carbonate bodies whose quality and heterogeneity are controlled by the interplay of depositional facies, such as shrubstones and grainstones, and subsequent diagenetic and tectonic events. These formations contain commercially significant accumulations of hydrocarbons, often within a structural or stratigraphic trap."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:StructuralHigh a owl:Class ;
    rdfs:label "structural high"@en ;
    rdfs:comment "A structural high is a geological feature, such as a horst or uplifted block, that is stratigraphically or topographically elevated relative to its surroundings due to tectonic processes like faulting. In rift basins like the Brazilian Pre-Salt, these features often represent paleotopographic highs that control the deposition of reservoir facies, such as high-energy carbonates. Structural highs are fundamental elements in forming structural and stratigraphic traps for hydrocarbon accumulations."@en ;
    rdfs:subClassOf presalt:StructuralFeature .

presalt:Subsidence a owl:Class ;
    rdfs:label "subsidence"@en ;
    rdfs:comment "Subsidence is a geological process that involves the sinking or downward vertical movement of the Earth's crust, which creates accommodation space for sediment accumulation. In rift basins such as the Brazilian Pre-Salt, this process is driven by mechanisms including tectonic extension, thermal cooling and contraction of the lithosphere, and isostatic loading from sediments and salt, often resulting in diachronous and heterogeneous depositional patterns."@en ;
    rdfs:subClassOf presalt:Tectonics .

georeservoir:GEORES_0000030 a owl:Class ;
    rdfs:label "facies association"@en ;
    rdfs:comment "A facies association is a group of sedimentary facies that are genetically related and characteristically occur together, representing deposition within a specific paleoenvironmental setting or system. The analysis of facies associations is critical for interpreting depositional systems, such as the lacustrine carbonate systems of the Pre-Salt, and for predicting the distribution of reservoir rocks."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Basalt a owl:Class ;
    rdfs:label "basalt"@en ;
    rdfs:comment "Basalt is a mafic extrusive igneous rock that, in the context of the Brazilian Pre-Salt, occurs as tholeiitic flood basalts and lava flows representing major magmatic events within the syn-rift sequence. These volcanic rocks typically form the acoustic basement or are found as part of the Camboriú and Cabiúnas Formations, and can also be intercalated with volcanoclastics within the overlying Piçarras Formation."@en ;
    rdfs:subClassOf presalt:IgneousRock .

presalt:CarbonateBuildup a owl:Class ;
    rdfs:label "Carbonate Buildup"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000015 .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that changes the original shape, size, or orientation of a rock body in response to applied stress. In the context of the Brazilian Pre-Salt, this process manifests through both brittle mechanisms, such as faulting, and ductile mechanisms, including folding and salt flow (halokinesis). Deformation occurs across various scales, from regional tectonic events controlling basin architecture to the plastic compaction of individual grains, and can be contemporaneous with deposition."@en ;
    rdfs:subClassOf presalt:Tectonics .

presalt:FineGrainedSedimentaryRock a owl:Class ;
    rdfs:label "Fine-Grained Sedimentary Rock"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Fracture a owl:Class ;
    rdfs:label "fracture"@en ;
    rdfs:comment "A fracture is a surface or zone of rupture in a rock that forms when applied stress exceeds the rock's strength, causing a loss of cohesion. In reservoir rocks, fractures can be open, partially filled with cement, or fully cemented, creating secondary porosity and permeability pathways or acting as barriers to fluid flow. These features occur at multiple scales, from microscopic breaks within rock fabric to large-scale brittle fracture zones influencing basin architecture."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Hydrocarbon a owl:Class ;
    rdfs:label "hydrocarbon"@en ;
    rdfs:comment "Hydrocarbon is a naturally occurring organic compound that consists primarily of hydrogen and carbon atoms, forming molecules of various sizes and complexities. In a petroleum geology context, these compounds are generated from the thermal maturation of organic matter and exist as liquid (crude oil) and gaseous (natural gas) phases. These fluids migrate and accumulate in subsurface reservoirs, forming economically significant deposits referred to as hydrocarbon columns or accumulations."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:OceanBasin a owl:Class ;
    rdfs:label "Ocean Basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:RiftBasin a owl:Class ;
    rdfs:label "rift basin"@en ;
    rdfs:comment "A rift basin is a sedimentary basin that is formed by the extension and thinning of the continental lithosphere, typically associated with the breakup of supercontinents. Characterized by fault-bounded blocks, their syn-rift fill in the South Atlantic includes volcanic rocks, organic-rich lacustrine source rocks, and carbonate reservoirs of the pre-salt succession."@en ;
    rdfs:subClassOf presalt:SedimentaryBasin .

presalt:SedimentaryGrain a owl:Class ;
    rdfs:label "Sedimentary Grain"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000031 .

presalt:SedimentaryParticle a owl:Class ;
    rdfs:label "Sedimentary Particle"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000031 .

presalt:StructuralFeature a owl:Class ;
    rdfs:label "Structural Feature"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:TectonoStratigraphicInterval a owl:Class ;
    rdfs:label "Tectono-Stratigraphic Interval"@en ;
    rdfs:subClassOf presalt:Tectonics .

presalt:Unconformity a owl:Class ;
    rdfs:label "unconformity"@en ;
    rdfs:comment "An unconformity is a surface of erosion or non-deposition that separates younger strata from older rocks, representing a significant hiatus in the geologic record. In seismic data, it is identified as a key reflector characterized by stratal terminations such as erosional truncation and downlap. Within the Brazilian Pre-Salt, these surfaces, like the regional Pre-Alagoas and Intra-Alagoas unconformities, are fundamental for defining tectono-stratigraphic units."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Deposition a owl:Class ;
    rdfs:label "deposition"@en ;
    rdfs:comment "Deposition is a geological process by which sediments, minerals, and organic matter are laid down or settled out of a transporting medium such as water. This accumulation of material forms layers of sedimentary rock, with the final rock characteristics being controlled by the physical, chemical, and biological conditions of the depositional environment. In the Brazilian Pre-Salt, this process is responsible for the accumulation of key carbonate reservoir rocks in shallow, alkaline lacustrine systems and the overlying thick evaporite sequences."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:GrainSupportedSedimentaryCarbonateRock a owl:Class ;
    rdfs:label "Grain-Supported Sedimentary Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:StructuralBlock a owl:Class ;
    rdfs:label "Structural Block"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

georeservoir:GEOCORE_0000003 a owl:Class ;
    rdfs:label "Geological Age"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "Sedimentary Environment"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

georeservoir:GEORES_0000031 a owl:Class ;
    rdfs:label "Sediment"@en,
        "sediment"@en ;
    rdfs:comment "Sediment is naturally occurring material that is transported and deposited by physical processes or is chemically or biochemically precipitated from solution. This material includes a wide range of compositions, such as siliciclastic particles, carbonate grains (muds, grainstones), and chemical precipitates like silicate gels. The accumulation of these materials, often quantified by sedimentation rates, forms the sedimentary fill that comprises depositional sequences within a basin."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Diagenesis a owl:Class ;
    rdfs:label "diagenesis"@en ;
    rdfs:comment "Diagenesis is the collective term for the physical, chemical, and biological processes that alter sediments after their initial deposition and during and after their lithification, but before the onset of metamorphism. In the context of the Brazilian Pre-Salt, these processes are intense and include multiple phases of cementation, dissolution, dolomitization, and silicification. These alterations, such as the dissolution driven by the decay of magnesium silicates, are critical in creating or modifying the porosity and permeability of carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:GeochronologicalEpoch a owl:Class ;
    rdfs:label "Geochronological Epoch"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

presalt:LacustrineDepositionalSystem a owl:Class ;
    rdfs:label "Lacustrine Depositional System"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

presalt:Mineral a owl:Class ;
    rdfs:label "Mineral"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:SedimentaryBasin a owl:Class ;
    rdfs:label "Sedimentary Basin"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:comment "Facies is a body of rock that is defined by a distinctive set of observable lithological, biological, and physical characteristics. These characteristics reflect the specific depositional or diagenetic environment in which the rock was formed, with examples in the Pre-Salt including coquinas, spherulites, and laminates. In petroleum geology, the term also extends to seismic facies, which are seismically identifiable units defined by their reflection patterns and attributes, used to infer lithology and depositional settings away from well control."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEOCORE_0000012 a owl:Class ;
    rdfs:label "Geological Contact"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

presalt:Lake a owl:Class ;
    rdfs:label "Lake"@en,
        "lake"@en ;
    rdfs:comment "A lake is a lacustrine depositional system that, in the Pre-Salt context, occupied an extensive area within an active continental rift during the sag phase of basin evolution. This system was characterized by a complex paleohydrology with significant subsurface hydrothermal fluid input, which resulted in alkaline and often saline water chemistry. This unique hydrochemistry promoted the widespread precipitation of chemogenic and biogenic carbonates that constitute the main reservoir facies."@en ;
    rdfs:subClassOf bfo:BFO_0000029,
        presalt:LacustrineDepositionalSystem .

presalt:Tectonics a owl:Class ;
    rdfs:label "tectonics"@en ;
    rdfs:comment "Tectonics is the set of large-scale geological processes that involve the deformation of the Earth's crust and lithosphere, resulting in the formation of structural features such as faults, folds, and sedimentary basins. In the context of the Brazilian Pre-Salt, these processes encompass the syn-rift, post-rift, and inversion stages that governed the basin's structural framework and the deposition of tectono-stratigraphic sequences. The tectonic evolution directly controls the creation of accommodation space and the architecture of reservoir and source rock intervals."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "Geological Object"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "Earth Material"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "Rock"@en ;
    rdfs:subClassOf presalt:SedimentaryGeologicalObject,
        georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000004 a owl:Class ;
    rdfs:label "Formation"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

georeservoir:GEOCORE_0000005 a owl:Class ;
    rdfs:label "Geological Time Interval"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000003 .

presalt:CarbonateRock a owl:Class ;
    rdfs:label "carbonate rock"@en ;
    rdfs:comment "A carbonate rock is a class of sedimentary rock that is composed primarily of carbonate minerals, such as calcite, aragonite, or dolomite. These rocks are characterized by their chemical reactivity with dilute acid and can form through various biological, chemical, or detrital processes. In the Brazilian Pre-Salt, lacustrine carbonates, including coquinas and microbialites, constitute the primary reservoir facies."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "Geological Structure"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "Stratigraphic Unit"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001,
        georeservoir:GEORES_0000006,
        georeservoir:GEORES_0000020 .

