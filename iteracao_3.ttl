@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Accommodation a owl:Class ;
    rdfs:label "Accommodation"@en ;
    rdfs:comment "Accommodation is the space available for sediment accumulation that is governed by the combined effects of tectonic movement, such as subsidence, and changes in base level. In the Pre-Salt rift basins, accommodation is primarily controlled by tectonically-driven differential subsidence across fault blocks, which creates localized variations that dictate the stacking patterns, geometry, and distribution of carbonate reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:AccommodationSpace a owl:Class ;
    rdfs:label "Accommodation Space"@en ;
    rdfs:comment "Accommodation space is the volume available for sediment accumulation that is created and controlled by the combined effects of tectonic subsidence and changes in base level. In the context of the Brazilian Pre-Salt's lacustrine rift basins, this space is primarily governed by tectonic stimuli, such as fault movement and thermal subsidence, and fluctuations in lake level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Subsidence ],
        bfo:BFO_0000029 .

presalt:AfricanPlate a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "African Plate"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper-noun individual naming a specific tectonic plate. `Geological Object` is the most specific available target class from the provided list."@en .

presalt:Alagoas a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Alagoas"@en ;
    rdfs:comment "Alagoas is a local chronostratigraphic stage of the Brazilian continental margin that corresponds to the upper part of the Aptian age in the Lower Cretaceous. This stage represents the final phase of the lacustrine rift sequence, deposited immediately before the main salt layer of the Ariri Formation, and is characterized by carbonate successions accumulated under increasingly arid and environmentally stressful conditions."@en .

presalt:AlagoasStage a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Alagoas Stage"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific local stage. The parent 'aptian' is incorrect as the relation is part-whole (see relation 668), not subclass."@en .

presalt:Albian a owl:NamedIndividual,
        presalt:EarlyCretaceous ;
    rdfs:label "Albian"@en ;
    rdfs:comment "Albian is a geological age of the Early Cretaceous Epoch that, in the context of the Brazilian continental margin, marks the initiation of the post-salt drift phase. This interval is characterized by the establishment of open marine environments following the deposition of the Aptian salt, leading to the deposition of marine carbonates, such as the Guarujá Formation, and siliciclastics. Chronostratigraphically, it follows the Aptian Age and precedes the Cenomanian Age, spanning from approximately 113 to 100.5 million years ago."@en .

presalt:Allochem a owl:Class ;
    rdfs:label "Allochem"@en ;
    rdfs:comment "Allochem is an allochthonous carbonate grain that was formed outside the area of final deposition and subsequently transported as a discrete particle. Common types of allochems found in Brazilian Pre-Salt reservoirs include bioclasts (such as bivalve and ostracod shells), ooids, peloids, oncoids, and intraclasts. The type and proportion of allochems are fundamental criteria for classifying depositional carbonate rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        bfo:BFO_0000030 .

presalt:Aptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Aptian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific, unique geological age (Check 6). The IS-A relationship is incorrect for a named individual; it should be an instance."@en .

presalt:Aquifer a owl:Class ;
    rdfs:label "Aquifer"@en ;
    rdfs:comment "An aquifer is a subsurface body of permeable rock that is saturated with groundwater and hydraulically connected to a hydrocarbon reservoir. In petroleum systems, an active aquifer provides crucial pressure support that influences production dynamics, and within the Brazilian Pre-Salt, these can be regional systems hosted in fractured basement or underlying sedimentary formations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:AririFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Ariri Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'ariri formation' is a proper noun naming a specific geological formation."@en .

presalt:AtapuField a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Atapu Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term is a proper noun naming a specific geographical site (an oil field)."@en .

presalt:BZiosField a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "Búzios Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term 'Búzios Field' is a proper noun naming a single, specific oil and gas field (Check 6)."@en .

presalt:Barite a owl:Class ;
    rdfs:label "Barite"@en ;
    rdfs:comment "Barite is a barium sulfate mineral (BaSO₄) that occurs as a secondary diagenetic phase within the pore systems of carbonate reservoirs. In the Brazilian Pre-Salt, it commonly precipitates during mesodiagenesis with a prismatic crystal habit, acting as a pore- and fracture-filling cement in facies such as calcilutites and spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Calcilutite ],
        presalt:SulfateMineral .

presalt:BarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Barra Velha Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'barra velha formation' is a proper noun naming a specific geological formation."@en .

presalt:Barremian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Barremian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific, unique geological age (Check 6). The IS-A relationship is incorrect for a named individual; it should be an instance."@en .

presalt:BaseOfSalt a owl:NamedIndividual,
        georeservoir:GEOCORE_0000011 ;
    rdfs:label "Base of Salt"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term refers to a specific, unique regional surface in the Brazilian Pre-Salt, making it a proper-noun individual, not a class."@en .

presalt:BasementHigh a owl:Class ;
    rdfs:label "Basement High"@en ;
    rdfs:comment "A basement high is a structurally elevated block of crystalline or metamorphic basement rock that forms a positive paleotopographic feature within a sedimentary basin. In the Brazilian Pre-Salt, these features are typically fault-bounded horsts that exert a primary control on the architecture and thickness of overlying syn-rift and sag-phase sediments. They often serve as the foundation for the development of extensive lacustrine carbonate platforms where reservoir facies accumulate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SedimentaryBasin ],
        presalt:StructuralBodyOfRock .

presalt:Bed a owl:Class ;
    rdfs:label "Bed"@en ;
    rdfs:comment "A bed is a distinct stratum of sedimentary rock that is defined by a specific lithology or texture and is bounded above and below by surfaces, known as bedding planes, which represent a change in depositional conditions. In the Pre-Salt context, beds can range from millimeters to decimeters in thickness and are composed of various carbonate facies, such as grainstones, rudstones, or shrubstones, often exhibiting sharp boundaries and measurable dip angles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEORES_0000003 .

presalt:BioclasticGrainstone a owl:Class ;
    rdfs:label "Bioclastic Grainstone"@en ;
    rdfs:comment "Bioclastic grainstone is a grain-supported bioclastic carbonate rock that is characterized by a grain size of less than 2 mm and the absence of a mud matrix. Primarily composed of fragmented lacustrine organisms such as bivalves, gastropods, and ostracods, this rock type is a key reservoir facies in the Brazilian Pre-Salt that frequently undergoes diagenetic alteration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Ostracod ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Gastropod ],
        presalt:Grainstone .

presalt:BioclasticRudstone a owl:Class ;
    rdfs:label "Bioclastic Rudstone"@en ;
    rdfs:comment "Bioclastic rudstone is a grain-supported bioclastic carbonate rock that is characterized by having more than 10% of its grains larger than 2 mm in diameter. In the Brazilian Pre-Salt, these rocks are predominantly composed of fragmented and disarticulated bivalve shells, often chaotically arranged, and may contain common intraclasts. It constitutes a significant reservoir facies, exhibiting a heterogeneous pore system that includes interparticle, moldic, and vugular porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:MoldicPorosity ],
        presalt:Rudstone .

presalt:BrazilianContinentalMargin a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "Brazilian Continental Margin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term is a proper noun naming a single, specific geological feature (Check 6)."@en .

presalt:Breccia a owl:Class ;
    rdfs:label "Breccia"@en ;
    rdfs:comment "Breccia is a clastic rock that is composed of angular to subangular fragments of pre-existing rock cemented together in a finer-grained matrix. In the Brazilian Pre-Salt, breccias are formed by diverse mechanisms including gravitational slope collapse, fault-related brittle failure, and hydrothermal or karst-related diagenesis, often creating highly permeable reservoir intervals."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:CabiNasFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Cabiúnas Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a specific geological formation, which is an instance of the class `Formation`."@en .

presalt:CaboFrioHigh a owl:NamedIndividual,
        georeservoir:GEOCORE_0000004 ;
    rdfs:label "Cabo Frio High"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'Cabo Frio High' is a proper noun naming a specific, unique geological feature (Check 6)."@en .

presalt:Calcarenite a owl:Class ;
    rdfs:label "Calcarenite"@en ;
    rdfs:comment "Calcarenite is a clastic carbonate rock that is predominantly composed of sand-sized grains, which in the Pre-Salt are typically reworked intraclasts, ooids, and bioclasts. These reworked deposits often form laminated beds and can possess significant primary interparticle porosity, which is frequently modified by subsequent dolomite or silica cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Ooid ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Intraclast ],
        presalt:ReworkedCarbonate .

presalt:Calcirudite a owl:Class ;
    rdfs:label "Calcirudite"@en ;
    rdfs:comment "Calcirudite is a clastic carbonate rock that is composed predominantly of carbonate fragments larger than 2 mm in diameter, equivalent to granule and pebble size. Within the Brazilian Pre-Salt, these rocks are typically poorly sorted and contain intraclasts derived from lacustrine facies such as microbialites, tufa, and spherulitic carbonates. They occur as either clast-supported (rudstone) or matrix-supported (floatstone) beds, often deposited by high-energy processes like debris flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        presalt:ReworkedCarbonate .

presalt:CalciteCement a owl:Class ;
    rdfs:label "Calcite Cement"@en ;
    rdfs:comment "Calcite cement is an authigenic calcite mineral that precipitates from pore fluids into the void spaces of a sedimentary rock, binding constituent grains and reducing primary porosity. In Pre-Salt carbonates, it is a principal diagenetic phase, especially in rudstones and grainstones, presenting diverse morphologies including microcrystalline rims, drusy, and blocky crystals that fill interparticle, intraparticle, and fracture porosity. The precipitation and subsequent dissolution of calcite cement are critical controls on reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Cement .

presalt:CalciteShrub a owl:Class ;
    rdfs:label "Calcite Shrub"@en ;
    rdfs:comment "A calcite shrub is an in situ carbonate precipitate that is characterized by a branching, fan-shaped, or dendritic morphology composed of fibrous to bladed calcite crystals. These structures, often composed of fascicular-optic calcite, form extensive crusts and layers in lacustrine environments and are a fundamental, though genetically debated, component of Brazilian Pre-Salt reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticBody .

presalt:CalciteSpherulite a owl:Class ;
    rdfs:label "Calcite Spherulite"@en ;
    rdfs:comment "A calcite spherulite is a spherical to sub-spherical diagenetic aggregate that is composed of radiating fibrous calcite crystals, typically forming through the replacement of a precursor clay-rich matrix in lacustrine settings. These aggregates, ranging from 0.1 to over 5 mm in diameter, often grow around a nucleus of micrite, clay minerals, or ostracod fragments and can coalesce to form extensive beds constituting grainstones and packstones. Although the original fibro-radial texture is often preserved, spherulites are commonly subject to recrystallization, dolomitization, or replacement by silica."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:DiageneticBody .

presalt:CamboriFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Camboriú Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a specific geological formation, which is an instance of the class `Formation`."@en .

presalt:CamburiGroup a owl:NamedIndividual,
        georeservoir:GEORES_0000003 ;
    rdfs:label "Camburi Group"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: 'Camburi Group' is a proper name for a specific, individual lithostratigraphic unit, not a class of units."@en .

presalt:CamposBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Campos Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a single, specific geological basin."@en .

presalt:CarbonateDeposit a owl:Class ;
    rdfs:label "Carbonate Deposit"@en ;
    rdfs:comment "A carbonate deposit is a body of sedimentary rock that is formed by the net accumulation of carbonate minerals and sediments over a geological time interval. In the Brazilian Pre-Salt, these deposits typically formed in transitional lacustrine to shallow marine environments and constitute the primary stratigraphic sequences of carbonate platforms. The final thickness and geometry of the deposit are controlled by the interplay between carbonate production/deposition rates, subsidence, and post-depositional erosion or transformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        georeservoir:GEORES_0000001 .

presalt:CarbonateFactory a owl:Class ;
    rdfs:label "Carbonate Factory"@en ;
    rdfs:comment "A carbonate factory is a sedimentary environment that is characterized by the large-scale in-situ production and accumulation of carbonate sediment. The type of factory is defined by its dominant sediment producers (e.g., biotic, abiotic, or microbial), depositional setting, and the prevailing physicochemical conditions of the water body, such as salinity and alkalinity. In the Brazilian Pre-Salt, distinct lacustrine factories are recognized, including the bioclastic coquina-dominated system of the Itapema Formation and the mixed abiotic, microbial, and reworked factory of the Barra Velha Formation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:CarbonateMound a owl:Class ;
    rdfs:label "Carbonate Mound"@en ;
    rdfs:comment "A carbonate mound is a carbonate geobody that is characterized by a pronounced, almost conical relief and is seismically identified by ambiguous limits, low-amplitude internal reflectors, and a high density of faults. These features typically constitute excellent quality reservoirs due to matrix properties and associated fracturing, and are often linked to hydrothermal alteration indicated by elevated silica and uranium content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fracture ],
        georeservoir:GEORES_0000015 .

presalt:Carnallite a owl:Class ;
    rdfs:label "Carnallite"@en ;
    rdfs:comment "Carnallite is a hydrated potassium magnesium chloride evaporite mineral (KMgCl₃·6(H₂O)) that occurs as a less common component within the Aptian salt section. In the Brazilian Pre-Salt, it is found within the Ariri Formation evaporites, alongside halite, anhydrite, and tachyhydrite. Due to its distinct acoustic velocity, carnallite layers are significant for seismic velocity modeling and understanding the geomechanical behavior of the overlying salt seal."@en ;
    rdfs:subClassOf presalt:EvaporiteMineral .

presalt:Cementstone a owl:Class ;
    rdfs:label "Cementstone"@en ;
    rdfs:comment "Cementstone is a carbonate rock that is texturally defined by being dominated by in-situ precipitated cement rather than depositional grains or a biological framework. In the Brazilian Pre-Salt, it refers to chemogenic lacustrine limestones, such as shrub framestones, formed by the coalescence of fibrous calcite or radiating spherulites."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Cenozoic a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Cenozoic"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific geological era (an individual time interval)."@en .

presalt:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "A channel is an elongate geological feature that acts as a conduit for sediment transport or focused fluid flow. In the Brazilian Pre-Salt, this term describes both large-scale depositional landforms, such as fluvial and slope channels that distribute sediments, and smaller-scale diagenetic conduits formed by dissolution that create interconnected porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        bfo:BFO_0000029 .

presalt:Chert a owl:Class ;
    rdfs:label "Chert"@en ;
    rdfs:comment "Chert is a siliceous sedimentary rock composed of microcrystalline quartz that, in Pre-Salt lacustrine settings, is primarily formed by low-temperature silica precipitation associated with microbial activity. It commonly occurs as microbial boundstone buildups, as thin beds, or as a replacive diagenetic mineral. Due to its frequent development of vuggy and fracture porosity, chert constitutes a major reservoir facies in these systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:FracturePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:VuggyPorosity ],
        presalt:ChemicalSedimentaryRock .

presalt:Clinoform a owl:Class ;
    rdfs:label "Clinoform"@en ;
    rdfs:comment "Clinoform is a stratigraphic geometry that is characterized by inclined depositional surfaces representing the advancing, sloping front of a prograding sedimentary body. In the Brazilian Pre-Salt, clinoforms are key seismic-scale features that define the progradation of carbonate platforms into lacustrine basins, with their height providing a proxy for paleolake bathymetry. These features typically exhibit sigmoidal or exponential profiles and record fluctuations in base-level during deposition."@en ;
    rdfs:subClassOf presalt:StratigraphicGeometry .

presalt:ContinentalCrust a owl:Class ;
    rdfs:label "Continental Crust"@en ;
    rdfs:comment "Continental crust is a layer of the Earth's lithosphere that forms the continents and their adjacent shelves and is characterized by being generally thicker and less dense than oceanic crust. During the formation of passive margins, such as the one hosting the Brazilian Pre-Salt, this crust undergoes significant stretching and thinning, a process that creates the accommodation space for the deposition of rift basin sequences."@en ;
    rdfs:subClassOf presalt:Crust .

presalt:ContinentalMargin a owl:Class ;
    rdfs:label "Continental Margin"@en ;
    rdfs:comment "A continental margin is a major physiographic and tectonic zone that represents the transition between continental crust and an oceanic basin. In the context of the Brazilian Pre-Salt, it is the region hosting major rift-related sedimentary basins, such as the Santos Basin, which formed during the opening of the South Atlantic. The architecture and relative position within this margin control the magnitude of rifting displacement and the subsequent development of reservoir successions."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:CoqueirosFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Coqueiros Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a specific geological formation, which is an instance of the class `Formation`."@en .

presalt:Cretaceous a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Cretaceous"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific, unique geological period (Check 6). The IS-A relationship is incorrect for a named individual; it should be an instance."@en .

presalt:Cyclicity a owl:Class ;
    rdfs:label "Cyclicity"@en ;
    rdfs:comment "Cyclicity is a stratigraphic pattern that is characterized by the repetitive vertical succession of specific facies or sets of reservoir properties. In the Brazilian Pre-Salt, these cycles are typically driven by high-frequency climatic and lake-level oscillations, and their vertical stacking is a primary control on reservoir heterogeneity by creating alternating layers of high and low-quality rock."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Dawsonite a owl:Class ;
    rdfs:label "Dawsonite"@en ;
    rdfs:comment "Dawsonite is a sodium aluminum hydroxycarbonate mineral that occurs as a secondary, diagenetic accessory mineral within the pore systems of Brazilian Pre-Salt carbonate reservoirs. It typically forms during later diagenetic phases and is often found in association with other authigenic minerals such as fluorite, pyrite, barite, and dolomite. While generally sparse, dawsonite can be locally abundant and is identified through petrographic analysis, XRD, and EDS."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:Density a owl:Class ;
    rdfs:label "Density"@en ;
    rdfs:comment "Density is a fundamental physical property of a substance that quantifies its mass per unit of volume, typically expressed in grams per cubic centimeter (g/cm³). In the context of reservoir characterization, it is distinguished as either bulk density (RHOB), which is measured by well logs and includes the rock matrix and pore fluids, or grain density, which is measured from core samples and represents the density of the solid mineral constituents. Variations in density are critical for lithofacies differentiation, seismic impedance modeling, and porosity calculations in Pre-Salt carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PhysicalProperty .

presalt:DepositionalCycle a owl:Class ;
    rdfs:label "Depositional Cycle"@en ;
    rdfs:comment "A depositional cycle is a recurring vertical succession of genetically related carbonate facies that reflects a complete or partial oscillation of depositional environments. In the lacustrine Pre-Salt context, these cycles are primarily driven by lake-level fluctuations and typically exhibit fining-upward or coarsening-upward trends, often with in situ facies like shrubstones or mudstones at their base. The completeness of a cycle's preservation often depends on the depositional position within the basin, with incomplete hemicycles being common in proximal settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrubstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Mudstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateFacies ],
        presalt:SedimentarySuccession .

presalt:DepositionalFacies a owl:Class ;
    rdfs:label "Depositional Facies"@en ;
    rdfs:comment "A depositional facies is a body of rock that is distinguished by a specific set of lithological, textural, and biological characteristics reflecting its formation within a particular depositional environment. In the context of Brazilian Pre-Salt lacustrine carbonates, these facies are broadly classified into in-situ deposits, such as shrubby carbonates and spherulites, and reworked deposits, like intraclastic grainstones, which are controlled by lake level and depositional energy."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:DiageneticHistory a owl:Class ;
    rdfs:label "Diagenetic History"@en ;
    rdfs:comment "Diagenetic history is the chronological sequence of physical, chemical, and biological processes that alter a sedimentary rock after its initial deposition. This sequence of events, such as dissolution, cementation, dolomitization, and silicification, fundamentally controls the evolution of the rock's fabric and petrophysical properties. In the Brazilian Pre-Salt, this complex history of alteration is a critical factor in determining reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dolomitization ],
        georeservoir:GEOCORE_0000002 .

presalt:Dolomudstone a owl:Class ;
    rdfs:label "Dolomudstone"@en ;
    rdfs:comment "Dolomudstone is a carbonate mudstone that is predominantly composed of mud-grade dolomite crystals. In the Brazilian Pre-Salt, it often occurs as thin, irregularly laminated beds containing fine calcite particles and variable mud content. This rock type typically exhibits low matrix porosity, consisting of small intercrystalline and interparticle pores, but can form effective reservoirs where porosity is enhanced by intense fracturing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:IntercrystallinePore ],
        presalt:Mudstone .

presalt:Dolostone a owl:Class ;
    rdfs:label "Dolostone"@en ;
    rdfs:comment "Dolostone is a sedimentary carbonate rock that is predominantly composed of the mineral dolomite, typically formed through the diagenetic replacement of precursor calcium carbonate minerals. In the Brazilian Pre-Salt, these rocks are often characterized by dolomite rhombs and aggregates within a matrix of Mg-clays and organic matter, and frequently exhibit high intercrystalline porosity and permeability, constituting an important reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:CarbonateRock .

presalt:Downlap a owl:Class ;
    rdfs:label "Downlap"@en ;
    rdfs:comment "Downlap is a type of basal stratal termination in which initially inclined seismic reflectors or strata terminate downdip against a lower, typically more horizontal, surface. This geometric relationship is characteristic of prograding depositional systems, where younger strata build outwards and downwards over an older surface, often indicating a condensed section or maximum flooding surface below."@en ;
    rdfs:subClassOf presalt:StratigraphicGeometry .

presalt:Drift a owl:Class ;
    rdfs:label "Drift"@en ;
    rdfs:comment "Drift is a tectono-stratigraphic phase that represents the final stage of passive margin evolution, characterized by thermal subsidence and the deposition of marine sediments after the cessation of major rifting. In the context of the Brazilian South Atlantic margin, this phase began in the Albian, following the deposition of the Aptian salt, and is associated with the development of oceanic crust. The resulting drift sequence comprises a thick succession of open marine deposits, including both carbonate platforms and deep-water siliciclastics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:RiftPhase ],
        presalt:TectonoStratigraphicProcess .

presalt:EarlyAptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Early Aptian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a single, specific geological age (Check 6)."@en .

presalt:EarlyDiagenesis a owl:Class ;
    rdfs:label "Early Diagenesis"@en ;
    rdfs:comment "Early diagenesis is the initial stage of post-depositional alteration that occurs at or near the sediment-water interface, driven by the physicochemical conditions of the depositional environment. In the context of Pre-Salt carbonates, this stage involves processes such as the dissolution of primary fabrics like Mg-smectite to create secondary porosity, which is often followed by or concomitant with the precipitation of dolomite, calcite, and silica cements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:SedimentWaterInterface ],
        georeservoir:GEOCORE_0000002 .

presalt:EconomicBasement a owl:Class ;
    rdfs:label "Economic Basement"@en ;
    rdfs:comment "Economic basement is a geological unit composed of volcanic rocks that forms the effective lower boundary for hydrocarbon exploration within the Brazilian Pre-Salt. In the Santos Basin, this unit corresponds to the Hauterivian-age basalts of the Camboriú Formation, representing the Syn-Rift I depositional phase. It is distinguished from the underlying, older crystalline acoustic basement and is typically identified on seismic data by a high-amplitude reflector at its top."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:EffectivePorosity a owl:Class ;
    rdfs:label "Effective Porosity"@en ;
    rdfs:comment "Effective porosity is a petrophysical property that quantifies the interconnected pore volume of a rock through which fluids can flow, excluding isolated pores and volume occupied by bound fluids. It is a key parameter for evaluating reservoir quality in Pre-Salt carbonates, where it is typically lower than total porosity and is commonly derived from Nuclear Magnetic Resonance (NMR) logs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PetrophysicalProperty .

presalt:Eoaptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Eoaptian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a single, specific geological age (Check 6)."@en .

presalt:EspRitoSantoBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Espírito Santo Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a single, specific geological basin."@en .

presalt:Evaporite a owl:Class ;
    rdfs:label "Evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of mineral salts from a body of water that has become concentrated by evaporation. In the Brazilian Pre-Salt, these Aptian-age deposits are predominantly composed of halite and anhydrite, forming the regional seal above the carbonate reservoirs. The significant thickness and ductile nature of the halite layers also drive halokinesis, creating complex salt structures that influence overburden deformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Evaporation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        presalt:ChemicalSedimentaryRock .

presalt:FaciesDistribution a owl:Class ;
    rdfs:label "Facies Distribution"@en ;
    rdfs:comment "Facies distribution is the spatial and temporal arrangement of sedimentary facies within a geological volume that reflects the interplay of depositional processes, paleoenvironment, and subsequent structural controls. In the context of Brazilian Pre-Salt lacustrine carbonates, this distribution is characteristically controlled by paleotopography, with specific facies associations, such as in-situ versus reworked facies, systematically occurring in structurally high versus low areas. Understanding these patterns is fundamental for reconstructing depositional models and predicting reservoir presence and quality."@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

presalt:FaultSystem a owl:Class ;
    rdfs:label "Fault System"@en ;
    rdfs:comment "A fault system is a set of genetically related extensional faults that are active during a specific tectono-stratigraphic interval, collectively controlling accommodation space and sediment deposition within a rift basin. These systems are identified and differentiated from one another primarily by the relative age of the syn-rift growth strata whose deposition they controlled. In the context of the Brazilian Pre-Salt, fault systems are often classified into distinct phases corresponding to the Early, Intermediate, and Late Rift stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        georeservoir:GEOCORE_0000004 .

presalt:FaultZone a owl:Class ;
    rdfs:label "Fault Zone"@en ;
    rdfs:comment "A fault zone is a tabular volume of deformed rock that is structurally composed of a central, highly strained fault core where primary movement is localized, and a surrounding, less intensely deformed damage zone. In the context of the Brazilian Pre-Salt, these zones function as critical conduits for fluid migration, conditioning the development of dissolution porosity and fracture networks that enhance reservoir quality."@en ;
    rdfs:subClassOf presalt:StructuralBodyOfRock .

presalt:Floatstone a owl:Class ;
    rdfs:label "Floatstone"@en ;
    rdfs:comment "Floatstone is a matrix-supported carbonate rock that is characterized by containing over 10% of components larger than 2 millimeters in diameter which are supported by a finer-grained matrix. In the Brazilian Pre-Salt, these larger components often consist of microbialite fragments, oncoids, shells, and various tufa types, embedded within a matrix of micrite, silt, or sand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Oncoid ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Micrite ],
        presalt:CarbonateRock .

presalt:FlorianopolisHigh a owl:NamedIndividual,
        georeservoir:GEOCORE_0000004 ;
    rdfs:label "Florianopolis High"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun (Check 6). 'Florianopolis High' names a single, specific geological feature."@en .

presalt:FlowCapacity a owl:Class ;
    rdfs:label "Flow Capacity"@en ;
    rdfs:comment "Flow capacity is a petrophysical parameter that quantifies the ability of a reservoir interval to transmit fluids, calculated as the product of the interval's effective permeability and its thickness (kh). Expressed in millidarcy-meters (mD.m), it is a key metric used to identify high-productivity zones ('speed zones') and is determined from well tests, core analysis, or log-derived permeability profiles. In heterogeneous reservoirs like the Pre-Salt, its value is often dominated by thin, highly permeable features such as fractures or karstified layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:FluidFlow a owl:Class ;
    rdfs:label "Fluid Flow"@en ;
    rdfs:comment "Fluid flow is the movement of subsurface fluids, such as oil, gas, and water, through the interconnected pore and fracture network of a rock that is governed by the interplay between rock properties, fluid properties, and pressure gradients. In the context of Pre-Salt carbonate reservoirs, this process is critically influenced by geological heterogeneities, including pore-throat geometry, fracture systems, and the stratigraphic arrangement of facies, which create corridors and barriers to flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Oil ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Gas ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

presalt:Fluorite a owl:Class ;
    rdfs:label "Fluorite"@en ;
    rdfs:comment "Fluorite is a diagenetic halide mineral, composed of calcium fluoride (CaF₂), that precipitates in Pre-Salt carbonates as a typical product of hydrothermal alteration. As a secondary mineral phase, it is commonly associated with saddle dolomite, barite, and celestine, and is often observed lining the margins of pores, particularly those enhanced by dissolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        presalt:Mineral .

presalt:Gondwana a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "Gondwana"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'Gondwana' is a proper noun naming a specific, unique geological object (a former supercontinent) (Check 6)."@en .

presalt:GondwanaSupercontinent a owl:NamedIndividual,
        georeservoir:GEORES_0000001 ;
    rdfs:label "Gondwana Supercontinent"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Gondwana is a proper noun naming a specific, unique geological object (a former supercontinent)."@en .

presalt:Graben a owl:Class ;
    rdfs:label "Graben"@en ;
    rdfs:comment "A graben is a depressed crustal block that is bounded by two or more sub-parallel normal faults, creating a structural low relative to adjacent horsts. Formed during extensional tectonics characteristic of rift phases, these features vary from narrow and discontinuous to wide and continuous, often serving as depocenters for sediments. In the Pre-Salt context, grabens can act as significant permeability barriers that compartmentalize hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:GrainSize a owl:Class ;
    rdfs:label "Grain Size"@en ;
    rdfs:comment "Grain size is a fundamental textural property of a sediment or sedimentary rock that quantifies the diameter of its constituent particles. In Brazilian Pre-Salt carbonates, it is a critical parameter for classifying rocks, such as distinguishing bioclastic grainstones (grains < 2 mm) from rudstones (grains > 2 mm), and reflects the depositional energy of the environment. Characteristic grain sizes in the Barra Velha Formation include spherulites commonly less than 2 mm, shrub-grains averaging 2-5 mm, and carbonate muds less than 125 μm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        bfo:BFO_0000019 .

presalt:GrowthStrata a owl:Class ;
    rdfs:label "Growth Strata"@en ;
    rdfs:comment "Growth strata are sedimentary deposits that accumulate contemporaneously with active faulting, resulting in a characteristic wedge-shaped geometry that thickens toward the controlling fault. These syn-tectonic packages exhibit internal divergent reflections on seismic data and record the history of fault movement and subsidence. In the Brazilian Pre-Salt, growth strata are a key feature of the syn-rift succession, filling half-graben basins created during the Early Cretaceous rifting of the South Atlantic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:HalfGraben ],
        georeservoir:GEORES_0000006 .

presalt:GuaratibaGroup a owl:NamedIndividual,
        georeservoir:GEORES_0000003 ;
    rdfs:label "Guaratiba Group"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: 'Guaratiba Group' is a proper name for a specific, individual lithostratigraphic unit, not a class of units."@en .

presalt:GuarujFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Guarujá Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a specific geological formation, which is an instance of the class `Formation`."@en .

presalt:Gypsum a owl:Class ;
    rdfs:label "Gypsum"@en ;
    rdfs:comment "Gypsum is a hydrated calcium sulfate mineral (CaSO₄·2H₂O) that, within the context of Brazilian Pre-Salt reservoirs, is primarily found as a late-stage diagenetic cement filling dissolution fractures. The general absence of gypsum as an early, primary evaporite mineral in the Barra Velha Formation is a key line of evidence used to support a non-marine, lacustrine depositional model. When present as a fracture-fill, it can occlude porosity and negatively impact reservoir quality."@en ;
    rdfs:subClassOf presalt:SulfateMineral .

presalt:HangingWall a owl:Class ;
    rdfs:label "Hanging Wall"@en ;
    rdfs:comment "Hanging wall is the block of rock that lies structurally above an inclined fault plane. In the extensional rift settings of the Brazilian Pre-Salt, the hanging wall typically subsides relative to the footwall, accommodating syn-rift sedimentary packages that often exhibit deformation structures like drag folds and growth wedges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Hauterivian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Hauterivian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific, unique geological age (Check 6). The IS-A relationship is incorrect for a named individual; it should be an instance."@en .

presalt:Horst a owl:Class ;
    rdfs:label "Horst"@en ;
    rdfs:comment "Horst is an uplifted structural block that is bounded by normal faults and flanked by down-dropped blocks known as grabens or half-grabens. In the Brazilian Pre-Salt, these features are typically large-scale structural highs, controlled by high-angle listric and planar faults, and form critical traps for hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:HydrothermalProcess a owl:Class ;
    rdfs:label "Hydrothermal Process"@en ;
    rdfs:comment "A hydrothermal process is a geological process that involves the circulation of hot, chemically active fluids through rock, resulting in the redistribution of energy and mass and causing physicochemical alteration. In Pre-Salt carbonate reservoirs, these processes are typically driven by local geothermal anomalies and facilitated by deep fault systems, leading to the precipitation of characteristic minerals such as saddle dolomite, fluorite, and barite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        georeservoir:GEOCORE_0000002 .

presalt:HydrothermalVent a owl:Class ;
    rdfs:label "Hydrothermal Vent"@en ;
    rdfs:comment "A hydrothermal vent is a pipe-like geological complex that is formed by the fracturing, transport, and eruption of deep-sourced, geothermally heated fluids and sediments. In the Pre-Salt lacustrine setting, these vents strongly influence water chemistry by supplying ions and alkalinity, which promotes the precipitation of minerals like travertine and can also cause significant diagenetic alteration that enhances reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Illite a owl:Class ;
    rdfs:label "Illite"@en ;
    rdfs:comment "Illite is a phyllosilicate clay mineral that is a common component of the mud-rich facies in the lacustrine carbonate systems of the Brazilian Pre-Salt. It is typically found in small quantities alongside other clays like kerolite and stevensite, and often forms interstratified layers with smectite."@en ;
    rdfs:subClassOf presalt:ClayMineral .

presalt:InterparticlePore a owl:Class ;
    rdfs:label "Interparticle Pore"@en ;
    rdfs:comment "An interparticle pore is a type of pore space that is located in the voids between the constituent grains or particles of a sedimentary rock. In Brazilian Pre-Salt lacustrine carbonates, this porosity is a dominant contributor to reservoir quality, particularly within reworked facies like grainstones and rudstones where it is often associated with high permeability. These pores can be enhanced by dissolution or occluded by diagenetic cements such as silica, dolomite, and anhydrite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Grainstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Rudstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:Pore .

presalt:IntraAlagoasUnconformity a owl:NamedIndividual,
        georeservoir:GEOCORE_0000011 ;
    rdfs:label "Intra-Alagoas Unconformity"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific, unique intra-formational unconformity (Check 6)."@en .

presalt:IntraparticlePorosity a owl:Class ;
    rdfs:label "Intraparticle Porosity"@en ;
    rdfs:comment "Intraparticle porosity is a type of secondary porosity that consists of voids located within individual sedimentary grains or particles, formed by the partial dissolution of their internal components. In Brazilian Pre-Salt carbonates, it commonly develops within spherulites, oncoids, and bioclasts, contributing to high porosity values but often having limited permeability due to poor pore connectivity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:ItamambucaGroup a owl:NamedIndividual,
        georeservoir:GEORES_0000003 ;
    rdfs:label "Itamambuca Group"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: 'Itamambuca Group' is a proper name for a specific, individual lithostratigraphic unit, not a class of units."@en .

presalt:ItapemaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Itapema Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'itapema formation' is a proper noun naming a specific geological formation."@en .

presalt:Jurassic a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Jurassic"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term 'Jurassic' is a proper noun naming a single, specific geological time period (Check 6). It is an individual, not a class."@en .

presalt:KFeldspar a owl:Class ;
    rdfs:label "K-Feldspar"@en ;
    rdfs:comment "K-feldspar is a potassium aluminosilicate mineral that occurs in Pre-Salt successions both as a detrital component in associated siliciclastic rocks and as an authigenic phase within the carbonate reservoirs. As a detrital grain, it is a major constituent of arkosic sandstones, while its authigenic form precipitates from diagenetic fluids. This mineral is often subject to diagenetic alteration, including replacement by carbonates such as ankerite or by Al-phyllosilicates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:Feldspar .

presalt:Karst a owl:Class ;
    rdfs:label "Karst"@en ;
    rdfs:comment "Karst is a set of geological features and associated pore systems that results from the dissolution of soluble carbonate rocks by percolating aqueous fluids, often controlled by fractures and faults. In the Brazilian Pre-Salt, this process can be hypogenic, driven by ascending thermal fluids, or related to subaerial exposure during lake-level falls, creating stratigraphically discordant non-matrix porosity. While karstification can significantly enhance reservoir permeability, intense dissolution may also lead to cavern collapse, the formation of karst breccias, and a subsequent reduction in reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PoreSystem ],
        presalt:DiageneticFeature .

presalt:Karstification a owl:Class ;
    rdfs:label "Karstification"@en ;
    rdfs:comment "Karstification is a geological process that creates distinctive porosity and landforms through the dissolution of soluble rocks, such as carbonates, by aqueous fluids. In Pre-Salt reservoirs, this process can be hypogenic, driven by ascending hydrothermal fluids along fault zones, or penecontemporaneous, related to subaerial exposure. While moderate karstification significantly enhances reservoir quality by creating vugs and channels, intense karstification can lead to rock collapse and the formation of low-permeability karst breccia."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        presalt:DiageneticProcess .

presalt:Kerolite a owl:Class ;
    rdfs:label "Kerolite"@en ;
    rdfs:comment "Kerolite is a magnesian clay mineral, considered a variety of talc, that is a principal clay component within the lacustrine carbonate reservoirs of the Brazilian Pre-Salt. It is a key constituent of the Barra Velha Formation, occurring in various facies such as Mg-claystones and intraclastic grainstones, with its abundance typically increasing in the upper stratigraphic units."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:IntraclasticGrainstone ],
        presalt:ClayMineral .

presalt:LacustrineCoquina a owl:Class ;
    rdfs:label "Lacustrine Coquina"@en ;
    rdfs:comment "Lacustrine coquina is a mollusk-rich carbonate rock that is formed by the accumulation of shells and their fragments within a lacustrine depositional system. In the Brazilian Pre-Salt, these coquinas typically formed in shallow, high-energy waters on structural highs and constitute a primary reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:StructuralHigh ],
        presalt:LacustrineCarbonate .

presalt:LagoaFeiaGroup a owl:NamedIndividual,
        georeservoir:GEORES_0000003 ;
    rdfs:label "Lagoa Feia Group"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific, unique stratigraphic group (Check 6)."@en .

presalt:LaminatedMudstone a owl:Class ;
    rdfs:label "Laminated Mudstone"@en ;
    rdfs:comment "Laminated mudstone is a carbonate mudstone facies that is characterized by a millimetric-scale alternation of light-colored, carbonate-rich layers and dark, organic-rich layers. Often exhibiting crinkly or wavy lamination and associated with microbial activity in shallow lacustrine environments, this facies can contain peloids, ostracods, and primary fenestral porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Ostracod ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Peloid ],
        presalt:InSituCarbonateFacies .

presalt:LateAptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Late Aptian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun (Check 6). 'Late Aptian' is a standard, named geological sub-age, a unique interval in Earth history."@en .

presalt:LateCretaceous a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Late Cretaceous"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a single, specific geological epoch (Check 6)."@en .

presalt:LateJurassic a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Late Jurassic"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun (Check 6). 'Late Jurassic' is a standard, named geological epoch, a unique interval in Earth history."@en .

presalt:Lithofacies a owl:Class ;
    rdfs:label "Lithofacies"@en ;
    rdfs:comment "Lithofacies is a body of rock that is defined by a specific set of observable lithological characteristics, such as composition and texture, identified from core descriptions and petrographic analysis. In Brazilian Pre-Salt lacustrine carbonates, these are commonly grouped into in-situ or autochthonous facies, like shrubstones and spherulstones, and reworked or allochthonous facies, such as calcarenites and calcirudites."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:LowerBarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Lower Barra Velha Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific, unique lithostratigraphic unit (Check 6)."@en .

presalt:LulaField a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Lula Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific geographic site (an individual). Check 6 applies."@en .

presalt:MacabuFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Macabu Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a specific geological formation, which is an instance of the class `Formation`."@en .

presalt:MagnesianClay a owl:Class ;
    rdfs:label "Magnesian Clay"@en ;
    rdfs:comment "Magnesian clay is an authigenic clay mineral aggregate, predominantly stevensite, that precipitates in the saline and alkaline lacustrine environments of the Pre-Salt. These primary deposits occur as massive or laminated aggregates, peloids, ooids, or coatings and are chemically unstable, making them highly susceptible to diagenetic replacement by dolomite, silica, and calcite spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Silica ],
        presalt:AuthigenicSediment .

presalt:Magnesite a owl:Class ;
    rdfs:label "Magnesite"@en ;
    rdfs:comment "Magnesite is a diagenetic carbonate mineral that is composed of magnesium carbonate (MgCO3) and occurs as a secondary phase within Pre-Salt lacustrine successions. It characteristically precipitates as lamellar aggregates that replace the precursor magnesian clay matrix and fill shrinkage pores. This replacement process can be significant enough to preserve original sedimentary textures, such as lamination, within the altered rock."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:MarineIncursion a owl:Class ;
    rdfs:label "Marine Incursion"@en ;
    rdfs:comment "Marine incursion is a geological event that involves the episodic or large-scale entry of seawater into a previously restricted or non-marine depositional system. In the context of the Brazilian Pre-Salt, Aptian marine incursions marked the transition from a vast lacustrine system to a saline basin, culminating in the widespread deposition of the Ariri Formation evaporites which constitute the primary regional seal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MarineWater ],
        georeservoir:GEOCORE_0000002 .

presalt:Marl a owl:Class ;
    rdfs:label "Marl"@en ;
    rdfs:comment "Marl is a sedimentary rock that is composed of a mixture of carbonate minerals, such as calcite, and fine-grained siliciclastic sediment, primarily clay and silt. It is typically an earthy, low-permeability deposit formed in low-energy aquatic environments, including freshwater or brackish lakes. Within the Brazilian Pre-Salt succession, rocks with this composition are generally referred to as argillaceous limestones or calcareous mudstones and often act as non-reservoir intervals or seals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        presalt:CarbonateRock .

presalt:MeroField a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Mero Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term is a proper noun naming a specific geographical site (an oil field)."@en .

presalt:Mesozoic a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Mesozoic"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific geological era (an individual time interval)."@en .

presalt:MicrobialMat a owl:Class ;
    rdfs:label "Microbial Mat"@en ;
    rdfs:comment "A microbial mat is a self-sustaining benthic community that develops as a vertically layered structure at a liquid-solid interface, typically in environments with limited grazing organisms. In the Pre-Salt lacustrine carbonate successions, they are preserved as laminated, spongy, or tufted fabrics composed of microcrystalline filaments and various calcite cements, often forming distinct laminae or intercalations within other facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lamination ],
        bfo:BFO_0000027 .

presalt:Mineralogy a owl:Class ;
    rdfs:label "Mineralogy"@en ;
    rdfs:comment "Mineralogy is the mineral composition of a rock that describes the types, proportions, and distribution of its constituent minerals. In the context of Brazilian Pre-Salt reservoirs, the mineralogy is predominantly composed of calcite and dolomite, with significant occurrences of authigenic quartz and magnesium-rich clays like stevensite. It is typically determined through analytical techniques such as X-ray diffraction (XRD) and automated mineralogy systems like QEMSCAN."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:RockProperty .

presalt:Muscovite a owl:Class ;
    rdfs:label "Muscovite"@en ;
    rdfs:comment "Muscovite is a common phyllosilicate mineral of the mica group that occurs in Pre-Salt carbonates as detrital, silt- to sand-sized siliciclastic grains. Within these lacustrine carbonate systems, it is found in minor quantities as a framework grain or within the matrix of various facies, including Mg-claystones and spherulitic rocks. Notably, these grains can act as nuclei for the precipitation of calcite spherulites, a key textural component of many reservoir facies."@en ;
    rdfs:subClassOf presalt:Mica .

presalt:NamibeBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Namibe Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a single, specific geological basin."@en .

presalt:Neobarremian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Neobarremian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific sub-age. The parent 'barremian' is incorrect as the relation is part-whole (see relation 651), not subclass."@en .

presalt:Neomorphism a owl:Class ;
    rdfs:label "Neomorphism"@en ;
    rdfs:comment "Neomorphism is a diagenetic process that involves the in-situ transformation of an original mineral component, such as an aragonite shell, into a more stable polymorph like calcite. In the lacustrine carbonate reservoirs of the Brazilian Pre-Salt, the neomorphism of aragonitic bioclasts is a key process controlling reservoir quality. Its predominance over dissolution is critical for preserving primary interparticle porosity, which often results in higher permeability rock fabrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Aragonite ],
        presalt:DiageneticProcess .

presalt:Nodule a owl:Class ;
    rdfs:label "Nodule"@en ;
    rdfs:comment "A nodule is a discrete diagenetic body that is compositionally distinct from its surrounding host rock, typically forming as a rounded to irregular mass of silica, calcite, or aggregated grains. In the Brazilian Pre-Salt, nodules are commonly composed of silica (quartz, opal) or calcite and are found within various lacustrine carbonate and mixed siliciclastic-carbonate facies. These features can range from millimeters to centimeters in size and may form through replacement or precipitation, sometimes engulfing original sediment grains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:HostRock ],
        presalt:DiageneticBody .

presalt:OceanicCrust a owl:Class ;
    rdfs:label "Oceanic Crust"@en ;
    rdfs:comment "Oceanic crust is the uppermost layer of the oceanic portion of a tectonic plate that is formed by seafloor spreading at mid-ocean ridges during the drift phase of a passive margin's evolution. Following its formation, the cooling of the newly formed oceanic crust drives long-term thermal subsidence, and continued spreading can transmit intraplate stress that may cause tectonic inversion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:DriftPhase ],
        presalt:Crust .

presalt:OilField a owl:Class ;
    rdfs:label "Oil Field"@en ;
    rdfs:comment "An oil field is a subsurface area that contains one or more petroleum reservoirs from which a hydrocarbon accumulation can be produced. These fields, such as the supergiant Búzios Field, are defined by a contiguous accumulation with a quantifiable volume of original oil in place (OOIP) and are developed for commercial production. In the Brazilian Pre-Salt, major oil fields are characterized by vast lacustrine carbonate reservoirs located in deep offshore waters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:OilReserve a owl:Class ;
    rdfs:label "Oil Reserve"@en ;
    rdfs:comment "Oil reserve is the estimated quantity of crude oil that is commercially and technically recoverable from known accumulations under defined economic and operational conditions. In the Brazilian Pre-Salt, these reserves are primarily hosted within complex lacustrine carbonate reservoirs, such as those of the Barra Velha Formation, and represent the exploitable portion of the total oil-in-place."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:OilAccumulation ],
        georeservoir:GEOCORE_0000009 .

presalt:OilWaterContact a owl:Class ;
    rdfs:label "Oil-Water Contact"@en ;
    rdfs:comment "An oil-water contact is a subsurface boundary that separates the predominantly oil-saturated zone from the underlying water-saturated zone within a petroleum reservoir. This boundary is typically identified on well logs by a sharp contrast in electrical resistivity, as oil is significantly more resistive than saline formation water. In complex settings like the Brazilian Pre-Salt, this contact can be irregular and vary in depth due to reservoir compartmentalization or perched water effects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Reservoir ],
        bfo:BFO_0000140 .

presalt:Onlap a owl:Class ;
    rdfs:label "Onlap"@en ;
    rdfs:comment "Onlap is a type of stratigraphic termination that is characterized by the updip termination of initially inclined strata against a more steeply dipping surface, such as a basement high or the flank of a build-up. In seismic sequence stratigraphy, this geometric relationship indicates a progressive landward shift of coastal or lacustrine deposits, typically associated with a relative rise in base level and the creation of accommodation space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        georeservoir:GEOCORE_0000012 .

presalt:OuterHigh a owl:NamedIndividual,
        georeservoir:GEOCORE_0000004 ;
    rdfs:label "Outer High"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun (Check 6). 'Outer High' names a single, specific basement structure in the Santos Basin."@en .

presalt:Packstone a owl:Class ;
    rdfs:label "Packstone"@en ;
    rdfs:comment "Packstone is a grain-supported sedimentary carbonate rock that contains a matrix of carbonate mud (micrite). In the context of Brazilian Pre-Salt lacustrine successions, these rocks are composed of reworked grains such as shrub fragments, spherulites, peloids, and bioclasts, and typically exhibit massive, laminated, or cross-stratified structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateMud ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrub ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Peloid ],
        presalt:GrainSupportedCarbonateRock .

presalt:PelotasBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Pelotas Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a single, specific geological basin."@en .

presalt:Permeability a owl:Class ;
    rdfs:label "Permeability"@en ;
    rdfs:comment "Permeability is a fundamental petrophysical property that measures the capacity of a porous rock to transmit fluids through its interconnected pore network. In complex carbonate reservoirs such as the Brazilian Pre-Salt, it is a critical parameter for determining flow capacity, with the total permeability being a composite of contributions from the rock matrix and high-conductivity features like fractures, vugs, and caves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PetrophysicalProperty .

presalt:PetroleumSystem a owl:Class ;
    rdfs:label "Petroleum System"@en ;
    rdfs:comment "A petroleum system is a geological system that encompasses the essential elements—source rock, reservoir rock, seal, and overburden—and processes required for the generation, migration, and accumulation of hydrocarbons. In the context of the Brazilian Pre-Salt, this system is defined by lacustrine source shales (e.g., Piçarras Formation), microbial carbonate reservoirs (e.g., Barra Velha Formation), and a regional evaporitic seal (Ariri Formation)."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:PiArrasFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Piçarras Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] 'piçarras formation' is a proper noun naming a specific geological formation."@en .

presalt:Platform a owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:comment "A platform is an extensive, relatively flat-topped area of carbonate deposition that develops on a structural high and is bounded by a distinct break in slope to an adjacent, deeper basin. It is characterized by aggradational geometries and can display complex margin styles, such as rimmed or ramp-like, influenced by paleoenvironmental conditions. Within the Brazilian Pre-Salt, these lacustrine platforms formed during the sag phase and contain significant hydrocarbon reservoirs in their shallow-water facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SagPhase ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:StructuralHigh ],
        presalt:GeomorphicElement .

presalt:PoreSize a owl:Class ;
    rdfs:label "Pore Size"@en ;
    rdfs:comment "Pore size is a petrophysical parameter that quantifies the physical dimensions of the void spaces (pores) within a rock. It is commonly measured as a pore throat radius or diameter (in micrometers) via mercury injection capillary pressure, as a pore area (in square millimeters) from petrographic image analysis, or inferred from NMR relaxation times. The distribution of pore sizes, often categorized into micropore, mesopore, and macropore classes, is a critical control on reservoir storage capacity and fluid flow properties in Pre-Salt carbonates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PetrophysicalProperty .

presalt:PoreType a owl:Class ;
    rdfs:label "Pore Type"@en ;
    rdfs:comment "Pore type is a class of void space within a rock that is distinguished by its genetic origin, geometric attributes, and relationship to the rock fabric. In Brazilian Pre-Salt carbonates, common pore types include interparticle, vuggy, fracture, and growth framework, which are fundamental for classifying the complex porous system influenced by both depositional and diagenetic processes. The distribution and connectivity of these types are critical controls on reservoir permeability, fluid flow characteristics, and overall reservoir quality."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:PostRift a owl:Class ;
    rdfs:label "Post-Rift"@en ;
    rdfs:comment "Post-rift is a tectono-stratigraphic phase in basin evolution that follows the active rifting stage and is characterized by deposition driven primarily by regional thermal subsidence. In the Brazilian Pre-Salt, this phase is also known as the sag or transitional phase, resulting in an aggradational filling pattern that heals rift topography and includes the deposition of the lacustrine carbonates of the Barra Velha Formation and the overlying evaporites of the Ariri Formation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:RiftPhase ],
        presalt:TectonoStratigraphicProcess .

presalt:PreAlagoasUnconformity a owl:NamedIndividual,
        georeservoir:GEOCORE_0000011 ;
    rdfs:label "Pre-Alagoas Unconformity"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific, unique regional unconformity (Check 6)."@en .

presalt:PreSalt a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Pre-Salt"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term refers to a specific, named geological mega-sequence ('The Pre-Salt'), making it a proper-noun individual."@en .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:PreSaltSection a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Pre-Salt Section"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term refers to a specific, named geological mega-sequence, making it a proper-noun individual. It is a synonym for 'pre-salt' (415)."@en .

presalt:PreSaltSequence a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Pre-Salt Sequence"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific geological object aggregate in the South Atlantic (Check 6)."@en .

presalt:PreSaltSuccession a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Pre-Salt Succession"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term refers to a specific, named geological mega-sequence, making it a proper-noun individual. It is a synonym for 'pre-salt' (415)."@en .

presalt:Precambrian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Precambrian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a single, specific geological supereon (Check 6)."@en .

presalt:Recrystallization a owl:Class ;
    rdfs:label "Recrystallization"@en ;
    rdfs:comment "Recrystallization is a diagenetic process that alters the crystal fabric of pre-existing carbonate minerals, such as calcite, by changing their crystal size and shape. In Pre-Salt reservoirs, this process affects components like bioclasts, matrix, and cement, and when intense, can obliterate the original depositional texture to form crystalline limestones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Matrix ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticProcess .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "Regional Seal"@en ;
    rdfs:comment "A regional seal is a laterally extensive, low-permeability stratigraphic unit that overlies a petroleum system and prevents the upward migration of hydrocarbons. In the Brazilian Pre-Salt, the regional seal is the thick evaporite sequence of the Ariri Formation, composed primarily of halite and anhydrite. This massive salt layer effectively traps hydrocarbons within the underlying lacustrine carbonate reservoirs of the Barra Velha Formation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:ReservoirHeterogeneity a owl:Class ;
    rdfs:label "Reservoir Heterogeneity"@en ;
    rdfs:comment "Reservoir heterogeneity is the spatial variation of petrophysical and geological properties within a reservoir rock that originates from the combined effects of depositional environment, diagenetic alteration, and structural history. This variation manifests as vertical and lateral changes in facies, porosity, and permeability, which can create flow barriers, lead to reservoir compartmentalization, and form alternating layers of high and low reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:ReworkFacies a owl:Class ;
    rdfs:label "Rework Facies"@en ;
    rdfs:comment "Reworked facies is a carbonate facies association that is predominantly composed of transported and redeposited intraclasts of other Pre-Salt components, such as crystal shrubs and spherulites. These facies typically form calcarenites and calcirudites that exhibit sedimentary structures like cross-bedding and wave ripples, indicating deposition under energetic lacustrine conditions. The composition can also include peloids, ostracods, and varying amounts of clay or detrital siliciclastics, often forming intervals with significant interparticle porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        georeservoir:GEORES_0000030 .

presalt:RibeiraBelt a owl:NamedIndividual,
        georeservoir:GEORES_0000001 ;
    rdfs:label "Ribeira Belt"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific geological orogen, which is a single instance."@en .

presalt:RiftFault a owl:Class ;
    rdfs:label "Rift Fault"@en ;
    rdfs:comment "A rift fault is a tectonic fault, typically a normal fault, that forms during the extensional phase of a rift basin's development. In the Brazilian Pre-Salt, these faults control the initial basin geometry, the deposition of syn-rift sedimentary sequences, and the compartmentalization of carbonate reservoirs. Subsequent reactivation of these faults, often with an oblique or transtensional component, can generate fracture networks that significantly impact reservoir porosity and permeability."@en ;
    rdfs:subClassOf presalt:Fault .

presalt:RiftSection a owl:Class ;
    rdfs:label "Rift Section"@en ;
    rdfs:comment "Rift section is a stratigraphic succession that comprises the sedimentary and volcanic rocks deposited during the initial extensional tectonic phase of a basin's evolution. In the context of the Brazilian Pre-Salt basins, this succession spans from the Hauterivian to the Aptian and is typically divided into a lower volcanic-dominated phase (syn-rift I) and an upper lacustrine phase (syn-rift II). The syn-rift II phase contains the primary source rocks and significant carbonate reservoirs of the Pre-Salt petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        georeservoir:GEORES_0000002 .

presalt:RiftSystem a owl:Class ;
    rdfs:label "Rift System"@en ;
    rdfs:comment "A rift system is a large-scale structural framework that is formed by crustal extension and characterized by a series of normal faults creating an alternating pattern of structural highs (horsts) and lows (grabens). These fault-bounded grabens function as depocenters, accumulating thick sequences of syn-rift sediments which, in the context of the Brazilian Pre-Salt, include the critical lacustrine carbonate reservoirs. This phase of mechanical subsidence is a precursor to the thermal sag phase that marks the evolution towards a passive continental margin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        georeservoir:GEOCORE_0000004 .

presalt:RiftedMargin a owl:Class ;
    rdfs:label "Rifted Margin"@en ;
    rdfs:comment "A rifted margin is a type of continental margin that is formed by the process of continental rifting which successfully progresses to plate rupture and the onset of seafloor spreading. These margins, such as those of the Santos and Campos Basins, are characterized by distinct syn-rift and post-rift stratigraphic sequences that record the evolution from continental extension to passive thermal subsidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PostRiftSequence ],
        georeservoir:GEOCORE_0000004 .

presalt:RockTexture a owl:Class ;
    rdfs:label "Rock Texture"@en ;
    rdfs:comment "Rock texture is a fundamental physical property of a rock that describes the size, shape, and fabric arrangement of its constituent components, such as grains, crystals, and matrix. In the context of Brazilian Pre-Salt carbonates, it is primarily described using the Dunham classification as modified by Embry and Klovan, which characterizes the relationship between depositional components and matrix. The original depositional texture can be preserved, modified, or completely obliterated by diagenetic processes, significantly impacting reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:RockProperty .

presalt:RockType a owl:Class ;
    rdfs:label "Rock Type"@en ;
    rdfs:comment "A rock type is a category of rock that is defined by a distinctive assemblage of physical attributes, including depositional texture, composition, and diagenetic features. In the context of the Brazilian Pre-Salt, geological rock types are classified based on their primary components (e.g., bioclasts, spherulites, microbial structures) and diagenetic overprints, while petrophysical rock types are defined for engineering purposes based on shared fluid flow or capillary pressure characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        georeservoir:GEORES_0000024 .

presalt:SOPauloPlateau a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "São Paulo Plateau"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific geographic site (Check 6)."@en .

presalt:SagBasin a owl:Class ;
    rdfs:label "Sag Basin"@en ;
    rdfs:comment "A sag basin is a large, laterally continuous sedimentary basin that is generated predominantly by slow, regional thermal subsidence following an active rifting phase. This post-rift stage is characterized by relatively constant and low subsidence rates across the basin with minimal tectonic activity compared to the preceding rift. In the Brazilian Pre-Salt, the sag phase represents a transitional sequence from continental to marine environments, encompassing the deposition of the lacustrine carbonate reservoirs of the Barra Velha Formation."@en ;
    rdfs:subClassOf presalt:SedimentaryBasin .

presalt:Salt a owl:Class ;
    rdfs:label "Salt"@en ;
    rdfs:comment "Salt is an Aptian-age evaporite succession that is primarily composed of halite and anhydrite and stratigraphically separates the pre-salt rift sequence from the post-salt drift sequence in the South Atlantic marginal basins. Due to the ductile nature of its halite-rich layers, this succession undergoes significant deformation and flow (halokinesis), forming complex structures such as diapirs, pillows, and welds that control overburden deformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Halokinesis ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        georeservoir:GEORES_0000003 .

presalt:SaltBase a owl:NamedIndividual,
        georeservoir:GEOCORE_0000011 ;
    rdfs:label "Salt Base"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term refers to a specific, unique regional surface, defined by its relation to 'the Aptian evaporite sequence', making it a proper-noun individual."@en .

presalt:SaltDeposition a owl:Class ;
    rdfs:label "Salt Deposition"@en ;
    rdfs:comment "Salt deposition is a sedimentary process that involves the accumulation of evaporite minerals, such as halite and anhydrite, from the evaporation of saline water bodies in a restricted basin. In the Brazilian Pre-Salt, this event occurred during the Aptian (ca. 110-116 Ma) in a syn-rift setting, forming a thick sequence that caused rapid basin loading and initiated subsequent salt tectonics."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Sandstone a owl:Class ;
    rdfs:label "Sandstone"@en ;
    rdfs:comment "Sandstone is a siliciclastic sedimentary rock that is composed of sand-sized grains, typically ranging from fine to coarse and often exhibiting current laminations. In the context of Pre-Salt basins, sandstones are commonly deposited in fluvial, alluvial fan, and fan delta systems, sometimes containing mollusk shells which indicate episodic siliciclastic input into a lacustrine environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:AlluvialFan ],
        presalt:ContinentalSiliciclastic .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Santos Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Check 6: The term is a proper noun naming a single, specific geological basin."@en .

presalt:SapinhoField a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Sapinhoá Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific oil field, which is a kind of site (Check 6)."@en .

presalt:Saponite a owl:Class ;
    rdfs:label "Saponite"@en ;
    rdfs:comment "Saponite is a magnesian smectite clay mineral that precipitates in highly alkaline lacustrine environments and is a constituent of the authigenic clay assemblage in Pre-Salt carbonate reservoirs. Within the Pre-Salt, it is typically a minor component found in association with other Mg-silicates like stevensite and kerolite, where it can form a substrate for the growth of spherulites and shrubs."@en ;
    rdfs:subClassOf presalt:ClayMineral .

presalt:Seal a owl:Class ;
    rdfs:label "Seal"@en ;
    rdfs:comment "A seal is a low-permeability rock unit or geological feature that prevents or significantly impedes the flow of fluids, enabling the trapping of petroleum accumulations over geological or production timescales. Seals are categorized as static, which are completely impermeable over geological time, or dynamic, which are low-permeability baffles that act as seals over production timescales. In the Brazilian Pre-Salt, the thick evaporite sequence of the Ariri Formation serves as the primary regional seal for the underlying carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:SeismicHorizon a owl:Class ;
    rdfs:label "Seismic Horizon"@en ;
    rdfs:comment "A seismic horizon is an interpreted surface on seismic data that represents a geological boundary, such as a formation top or an unconformity, which is identified by a distinct seismic reflector. These horizons are mapped throughout a seismic volume, based on reflector characteristics like amplitude and terminations, to define the boundaries of tectono-stratigraphic sequences. In the Brazilian Pre-Salt, key horizons like the Base-Salt Unconformity and the top of the Barra Velha Formation are crucial for building the stratigraphic framework and identifying reservoir intervals."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

presalt:SeismicReflector a owl:Class ;
    rdfs:label "Seismic Reflector"@en ;
    rdfs:comment "A seismic reflector is an interface within a seismic dataset that is generated by a contrast in acoustic impedance between adjacent geological layers. The reflector's attributes, including amplitude, frequency, and continuity, along with its geometric configuration and termination patterns, are analyzed to interpret subsurface stratigraphy and structure."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

presalt:Sepiolite a owl:Class ;
    rdfs:label "Sepiolite"@en ;
    rdfs:comment "Sepiolite is a fibrous hydrated magnesium silicate clay mineral that, in the Brazilian Pre-Salt, occurs as a rare authigenic component within lacustrine deposits. It is preferentially found in small quantities associated with specific facies, such as fascicular calcite crusts and Mg-claystones, and can have a genetic relationship with precursor minerals like stevensite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Stevensite ],
        presalt:ClayMineral .

presalt:Sequence a owl:Class ;
    rdfs:label "Sequence"@en ;
    rdfs:comment "A sequence is a succession of strata that is deposited during a full cycle of variation in accommodation or sediment supply and is bounded by stratigraphic surfaces of the same genesis. It is characterized by a complete cycle of facies stacking pattern variation and is considered a fundamental, mappable unit in sequence stratigraphy. In the Brazilian Pre-Salt, sequences are defined at multiple scales, from high-resolution reservoir intervals to first-order successions related to major tectonic stages of rifting."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:SequenceBoundary a owl:Class ;
    rdfs:label "Sequence Boundary"@en ;
    rdfs:comment "A sequence boundary is a stratigraphic surface, typically an unconformity, that separates underlying older strata from overlying younger strata and represents a significant depositional hiatus characterized by erosion or non-deposition. In the context of the Brazilian Pre-Salt, these boundaries are organized into a hierarchy (e.g., 1st, 2nd, and 3rd order) and serve as key regional markers tied to major tectonic events like rifting and continental breakup. They are seismically identified by stratal terminations, such as the truncation of underlying reflectors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        georeservoir:GEOCORE_0000011 .

presalt:Shale a owl:Class ;
    rdfs:label "Shale"@en ;
    rdfs:comment "Shale is a fine-grained siliciclastic sedimentary rock that is composed of clay and silt-sized particles, characterized in the Pre-Salt context by its very low permeability. Within the lacustrine Pre-Salt succession, these rocks are identified by high gamma-ray log responses and act as significant vertical permeability barriers. These shale layers, such as the Jiquiá shales, can cause reservoir compartmentalization by separating hydrocarbon-bearing zones."@en ;
    rdfs:subClassOf presalt:ContinentalSiliciclastic .

presalt:ShallowMarineEnvironment a owl:Class ;
    rdfs:label "Shallow Marine Environment"@en ;
    rdfs:comment "A shallow marine environment is a depositional setting that is located on the continental shelf in seawater of limited depth, typically extending from the shoreline to the outer edge of the shelf. In the context of the Brazilian Pre-Salt, this environment specifically characterizes the restricted and highly evaporative Aptian seaway that developed after the main lacustrine carbonate phase, leading to the deposition of thick evaporite sequences. This setting is distinct from, and succeeds, the predominantly non-marine lacustrine systems where the main Barra Velha Formation carbonate reservoirs were deposited."@en ;
    rdfs:subClassOf presalt:MarineEnvironment .

presalt:SilicaCement a owl:Class ;
    rdfs:label "Silica Cement"@en ;
    rdfs:comment "Silica cement is an authigenic mineral precipitate that is composed of silica polymorphs, such as quartz and chalcedony, which crystallize within the pore spaces of a sedimentary rock. In Brazilian Pre-Salt carbonates, it occurs in various forms including microcrystalline quartz, macrocrystalline mosaic quartz, and fibrous chalcedony, acting as a pore-lining or pore-filling phase. This cementation is often a late diagenetic event that can significantly reduce or occlude reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Chalcedony ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Cement .

presalt:SilicaNodule a owl:Class ;
    rdfs:label "Silica Nodule"@en ;
    rdfs:comment "A silica nodule is a diagenetic body that is composed of microcrystalline and/or macrocrystalline quartz, occurring as a discrete, rounded to almond-shaped mass within a host carbonate rock. In the Brazilian Pre-Salt, these are common early diagenetic features found within fine-grained lacustrine carbonates like mudstones. Their formation is often attributed to the precipitation of interstitial silica gels triggered by changes in pore-water chemistry, such as a lowering of pH."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:MacrocrystallineQuartz ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        presalt:DiageneticBody .

presalt:SiliciclasticGrain a owl:Class ;
    rdfs:label "Siliciclastic Grain"@en ;
    rdfs:comment "A siliciclastic grain is a detrital particle that is composed of silicate minerals derived from the weathering and erosion of pre-existing terrestrial rocks. In the context of Brazilian Pre-Salt carbonates, these grains primarily consist of quartz, feldspar, and micas sourced from adjacent plutonic basement rocks and volcanic terrains. They typically occur in low concentrations, serving as nuclei for carbonate spherules or as a minor component within a carbonate matrix, having been transported into the lacustrine system by waves and currents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:SedimentaryGrain .

presalt:Slope a owl:Class ;
    rdfs:label "Slope"@en ;
    rdfs:comment "Slope is a geomorphic element that constitutes the inclined depositional surface connecting a shallow-water carbonate platform or structural high to the adjacent deeper part of a lacustrine basin. This typically low-angle feature is a zone of sediment transport and deposition, characterized by processes like accretion, bypass, and mass transport, resulting in the accumulation of facies such as rudstones, packstones, and wackestones."@en ;
    rdfs:subClassOf presalt:GeomorphicElement .

presalt:SourceRock a owl:Class ;
    rdfs:label "Source Rock"@en ;
    rdfs:comment "Source rock is an organic-rich sedimentary rock that has generated or is capable of generating and expelling hydrocarbons upon thermal maturation. In the Brazilian Pre-Salt, the primary source rocks are organic-rich shales of the Itapema and Barra Velha formations, deposited in a lacustrine rift setting and containing oil-prone Type I kerogen."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:SouthAmericanPlate a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "South American Plate"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper-noun individual naming a specific tectonic plate. `Geological Object` is the most specific available target class from the provided list."@en .

presalt:SpheruliticMudstone a owl:Class ;
    rdfs:label "Spherulitic Mudstone"@en ;
    rdfs:comment "Spherulitic mudstone is a mud-supported carbonate facies that is characterized by containing less than 70% spherulites embedded within a matrix of mud and Mg-clays. The spherulite grains are typically loosely packed and rarely touch, and this facies often exhibits higher porosity and permeability compared to other Pre-Salt mudstones."@en ;
    rdfs:subClassOf presalt:MudSupportedCarbonateRock .

presalt:SpheruliticShrubstone a owl:Class ;
    rdfs:label "Spherulitic Shrubstone"@en ;
    rdfs:comment "Spherulitic shrubstone is an in-situ carbonate facies that is composed of more than 50% shrubs and spherulites combined, with shrubs being the dominant grain type and mud content being less than 10%. This facies is characterized by very fine to coarse spherulites occurring between medium to coarse shrub branches, often displaying a fining-upward textural pattern. It commonly exhibits significant fabric-selective porosity, including large inter-shrub pore spaces and intra-shrub porosity from dissolution, which can be partially or fully occluded by calcite, dolomite, and silica cements."@en ;
    rdfs:subClassOf presalt:InSituCarbonateFacies .

presalt:StackingPattern a owl:Class ;
    rdfs:label "Stacking Pattern"@en ;
    rdfs:comment "Stacking pattern is a vertical arrangement of sedimentary facies that records a systematic change in depositional environments through a stratigraphic succession. These patterns are fundamental for defining stratigraphic cycles and sequences at various hierarchical scales, reflecting trends such as upward-deepening or the increasing abundance of specific components like shrubs in the Pre-Salt lacustrine carbonates."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Stromatolite a owl:Class ;
    rdfs:label "Stromatolite"@en ;
    rdfs:comment "Stromatolite is an organo-sedimentary structure that is formed by the sediment-trapping, sediment-binding, and carbonate precipitation activities of microorganisms. In the Brazilian Pre-Salt, they typically occur in lacustrine settings and exhibit columnar, domal, or stratiform morphologies with characteristic microbial laminations composed of mud and agglutinated carbonate grains. Despite being relatively rare, these structures can possess moderate porosity and are significant indicators of paleoenvironmental conditions related to lake-level fluctuations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        presalt:OrganoSedimentaryStructure .

presalt:StructuralBlock a owl:Class ;
    rdfs:label "Structural Block"@en ;
    rdfs:comment "A Structural Block is a geological structure that consists of a volume of rock bounded by faults which has moved as a single tectonic unit."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:StructuralDomain a owl:Class ;
    rdfs:label "Structural Domain"@en ;
    rdfs:comment "A structural domain is a spatial subdivision of a geological basin that is defined by a relatively consistent set of structural characteristics, such as fault patterns, structural styles, and reflector geometries. These domains are delineated using seismic data to group areas with similar tectonic features, like horsts and grabens, and distinct structural morphologies. This subdivision simplifies geological analysis by allowing for the comparison of properties like fracture intensity and stratigraphic architecture between different regions."@en ;
    rdfs:subClassOf bfo:BFO_0000024 .

presalt:StructuralSetting a owl:Class ;
    rdfs:label "Structural Setting"@en ;
    rdfs:comment "Structural setting is a geological framework that is defined by the geometric arrangement and interplay of tectonic elements such as faults, folds, and basement-controlled features. In the context of the Brazilian Pre-Salt, it typically describes the horst-and-graben architecture resulting from rifting, which creates distinct structural highs and lows. This framework exerts a primary control on depositional patterns, diagenetic alterations, and the distribution of reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        georeservoir:GEOCORE_0000004 .

presalt:Stylolite a owl:Class ;
    rdfs:label "Stylolite"@en ;
    rdfs:comment "A stylolite is a serrated diagenetic surface that is formed by pressure solution, a process of localized rock dissolution under compressive stress. It is characterized by the accumulation of insoluble residue, such as clay minerals, pyrite, and quartz, which become concentrated along the dissolution surface. In Pre-Salt reservoirs, stylolites are common in various lithofacies, can cross-cut earlier diagenetic features, and may be associated with enhanced fracture porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Pyrite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ClayMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Quartz ],
        presalt:DiageneticFeature .

presalt:Substrate a owl:Class ;
    rdfs:label "Substrate"@en ;
    rdfs:comment "Substrate is a depositional surface or material that serves as the foundation upon or within which other sedimentary or diagenetic constituents nucleate and grow. In the context of Brazilian Pre-Salt lacustrine carbonates, it most commonly refers to the fine-grained groundmass, typically composed of magnesian clays or calcitic mud, that facilitates the nucleation of spherulites and shrubs. On a larger scale, the term can also describe the underlying geological feature, such as a structural high, on which an entire carbonate platform develops."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:SugarLoafHigh a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Sugar Loaf High"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term is a proper noun naming a specific geological feature, which is a kind of site."@en .

presalt:SynRift a owl:Class ;
    rdfs:label "Syn-Rift"@en ;
    rdfs:comment "Syn-rift is a tectono-stratigraphic interval that corresponds to the period of active continental rifting, characterized by fault-controlled mechanical subsidence and the concurrent deposition of sedimentary and volcanic successions. In the Brazilian Pre-Salt basins, this interval encompasses the deposition of lacustrine carbonates and siliciclastics, such as the Itapema and Piçarras formations, within developing half-grabens. The syn-rift phase concludes when active mechanical subsidence ceases, and its upper boundary is typically defined by the major post-rift unconformity, which marks the onset of thermal subsidence and continental breakup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:SagPhase ],
        presalt:TectonoStratigraphicInterval .

presalt:Tachyhydrite a owl:Class ;
    rdfs:label "Tachyhydrite"@en ;
    rdfs:comment "Tachyhydrite is a rare and highly soluble evaporite mineral that is composed of hydrous calcium magnesium chloride. In the Brazilian Pre-Salt, it occurs locally within the Aptian Ariri Formation's evaporitic sequence, associated with more common salts like halite, anhydrite, carnallite, and sylvite."@en ;
    rdfs:subClassOf presalt:EvaporiteMineral .

presalt:Talc a owl:Class ;
    rdfs:label "Talc"@en ;
    rdfs:comment "Talc is a magnesium silicate mineral that, within Brazilian Pre-Salt reservoirs, precipitates as a hydrated form from Mg-rich silica gels in highly alkaline, saline lacustrine settings. This hydrated talc, often found in claystones of the Barra Velha Formation, is characterized by a low degree of crystallinity and serves as a significant source of magnesium and silica for later diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:MgSilicateGel ],
        presalt:Mineral .

presalt:TectonicSetting a owl:Class ;
    rdfs:label "Tectonic Setting"@en ;
    rdfs:comment "Tectonic setting is the regional geological framework that describes the large-scale crustal processes and structural state of a basin at a specific time. In the Brazilian Pre-Salt, the tectonic setting encompasses the evolution from the rift phase, characterized by faulting and subsidence that created accommodation space, to the subsequent post-rift or sag phase of relative tectonic quiescence. This evolution profoundly influences the architecture, composition, and distribution of carbonate reservoir facies."@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

presalt:Topography a owl:Class ;
    rdfs:label "Topography"@en ;
    rdfs:comment "Topography is a geometry that describes the three-dimensional arrangement of physical features on a surface, such as a planetary body or a geological horizon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        georeservoir:GEORES_0000023 .

presalt:TotalPorosity a owl:Class ;
    rdfs:label "Total Porosity"@en ;
    rdfs:comment "Total porosity is a fundamental petrophysical property that quantifies the fraction of a rock's bulk volume occupied by all void spaces, regardless of their origin or connectivity. It represents the sum of all pore types, including primary, secondary (e.g., dissolution-related), and fracture porosity, and accounts for the full range of pore sizes from micropores to vugs. This measure is critical for calculating the total volume of hydrocarbons in place within a reservoir."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:FracturePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PrimaryPorosity ],
        presalt:PetrophysicalProperty .

presalt:TransferZone a owl:Class ;
    rdfs:label "Transfer Zone"@en ;
    rdfs:comment "A transfer zone is a complex structural zone, often oriented obliquely to the main rift trend, that accommodates extensional displacement between offset or terminating segments of major normal faults. Within the Brazilian Pre-Salt rift system, these zones often manifest as structural highs separating major depocenters. They play a critical role in controlling the tectono-sedimentary evolution, influencing the distribution and thickness of sedimentary packages and the associated carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:TransitionalEnvironment a owl:Class ;
    rdfs:label "Transitional Environment"@en ;
    rdfs:comment "A transitional environment is a depositional setting that occupies an intermediate spatial or temporal position between distinct depositional systems, characterized by gradational properties such as water energy, depth, and facies. In the Pre-Salt, these settings include the slope between shallow and profundal zones or the boundary between continental and shallow lacustrine-marine conditions, often containing a mix of facies like grainstones and spherulites that reflect these intermediate conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Trap a owl:Class ;
    rdfs:label "Trap"@en ;
    rdfs:comment "A trap is a geological configuration that confines hydrocarbons within a reservoir rock by combining a porous reservoir geometry with an overlying, impermeable seal. In the Brazilian Pre-Salt, traps are predominantly large structural highs, characterized as four-way closures, where Aptian carbonate reservoirs are effectively sealed by the thick overlying Ariri Formation evaporites, although stratigraphic components can also contribute to hydrocarbon confinement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Travertine a owl:Class ;
    rdfs:label "Travertine"@en ;
    rdfs:comment "Travertine is a continental carbonate deposit that is formed by the abiotic precipitation of carbonate minerals from hydrothermal waters discharging at or near the Earth's surface, often along faults and fractures. Precipitation is typically triggered by the degassing of carbon dioxide from the discharging fluids, and its resulting depositional geometries, such as fissure ridges, mounds, and terraced plateaus, are controlled by fluid flow velocity and local topography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:AbioticPrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        presalt:ContinentalCarbonate .

presalt:TupiField a bfo:BFO_0000029,
        owl:NamedIndividual ;
    rdfs:label "Tupi Field"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] The term is a proper noun naming a specific geographical site (an oil field)."@en .

presalt:TupiHigh a owl:NamedIndividual,
        georeservoir:GEORES_0000001 ;
    rdfs:label "Tupi High"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Tupi High is a proper noun naming a specific, unique structural high in the Santos Basin."@en .

presalt:Unconformity a owl:Class ;
    rdfs:label "Unconformity"@en ;
    rdfs:comment "An unconformity is a surface that separates younger strata from older strata, representing a significant hiatus in the geologic record caused by erosion or non-deposition. In seismic data, it is identified as a reflector that truncates underlying strata or separates packages with different reflection geometries, such as an angular unconformity. Key examples in the Brazilian Pre-Salt include the Pre-Alagoas Unconformity (PAU) and the Intra-Alagoas Unconformity (IAU), which are critical surfaces separating distinct tectono-stratigraphic sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        georeservoir:GEOCORE_0000011 .

presalt:Uplift a owl:Class ;
    rdfs:label "Uplift"@en ;
    rdfs:comment "Uplift is a tectonic process that results in the vertical elevation of a portion of the Earth's crust relative to a surrounding area or a fixed datum. In the context of the Brazilian Pre-Salt, this process is typically associated with the upward movement of footwall blocks along normal faults or transpressive forces during rifting. The resulting structural highs control the depositional architecture by creating localized shallow-water environments suitable for carbonate accumulation and can also lead to erosion, supplying sediments to adjacent areas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:Erosion ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Footwall ],
        presalt:TectonicActivity .

presalt:UpperBarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000004 ;
    rdfs:label "Upper Barra Velha Formation"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun naming a specific, unique lithostratigraphic unit (Check 6)."@en .

presalt:UpperRift a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Upper Rift"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun for a specific stratigraphic interval within the Santos Basin Pre-Salt succession (Check 6)."@en .

presalt:Valanginian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Valanginian"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] Proper noun (Check 6). 'Valanginian' is a standard, named geological age, a unique interval in Earth history."@en .

presalt:Volcanic a owl:Class ;
    rdfs:label "Volcanic"@en ;
    rdfs:comment "Volcanic is a term for a rock, sediment, or terrain that originates from the eruption of magma onto the Earth's surface. In the Brazilian Pre-Salt, volcanic material occurs as distinct rock bodies, such as flows or islands, and as sediments intermixed with lacustrine carbonates. The weathering of these volcanic terrains is also a critical source of ions, like magnesium and silica, that influence the unique mineralogy of the carbonate system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Weathering ],
        georeservoir:GEOCORE_0000006 .

presalt:Volcaniclastic a owl:Class ;
    rdfs:label "Volcaniclastic"@en ;
    rdfs:comment "Volcaniclastic is a sedimentary material that is composed of fragments of rock and minerals produced by or derived from volcanic activity. In the Brazilian Pre-Salt, this component consists of volcanic rock fragments and is often broadly grouped with associated siliciclastic grains of plutonic origin, such as granitic-gneissic fragments, quartz, and feldspar, occurring either as discrete units or mixed within carbonate facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:VolcanicActivity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:VolcanicFragment ],
        presalt:ClasticSediment .

presalt:Vug a owl:Class ;
    rdfs:label "Vug"@en ;
    rdfs:comment "A vug is a non-fabric-selective pore within a carbonate rock that is generated or enhanced by dissolution and is significantly larger than the primary fabric-controlled pores. In the Brazilian Pre-Salt, vugs range from millimeters to tens of centimeters in size and can occur as isolated features or as interconnected networks, often linked by natural fractures. While isolated vugs contribute to total porosity, interconnected vug systems are critical for creating high-permeability pathways that significantly enhance reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:Pore .

presalt:Wackestone a owl:Class ;
    rdfs:label "Wackestone"@en ;
    rdfs:comment "Wackestone is a mud-supported carbonate rock that is characterized by containing over 10% grains, such as ostracod bioclasts, spherulite fragments, and peloids, suspended within a carbonate mud matrix. This facies typically forms in low-energy depositional environments below the storm-wave base and can appear massive or exhibit plane-parallel lamination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Peloid ],
        presalt:MudSupportedCarbonateRock .

presalt:WaterDepth a owl:Class ;
    rdfs:label "Water Depth"@en ;
    rdfs:comment "Water depth is a paleo-environmental measurement that quantifies the vertical distance from the surface of an ancient lake to the depositional interface at a specific point in time. In the context of Pre-Salt carbonate reservoirs, this parameter is a primary control on facies distribution, with specific depth ranges often correlating to different lithofacies associations such as shrubby, reworked, and transitional carbonates. This paleo-water depth is distinct from the modern oceanic water depth, which is an operational parameter for drilling and production infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:WaveBase a owl:Class ;
    rdfs:label "Wave Base"@en ;
    rdfs:comment "Wave base is a conceptual water depth that marks the lower limit at which surface wave orbital motion significantly interacts with and reworks sediment on the seafloor. This depth varies based on energy conditions, distinguishing between a shallower fair-weather wave base (FWWB) for average conditions and a deeper storm wave base (SWB) for high-energy events. In the Pre-Salt lacustrine carbonate systems, oscillations of the wave base are a primary control on the deposition, reworking, and development of key reservoir facies like coquinas and shrubstones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

bfo:BFO_0000008 a owl:Class ;
    rdfs:label "temporal region"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000038 a owl:Class ;
    rdfs:label "one-dimensional temporal region"@en ;
    rdfs:subClassOf bfo:BFO_0000008 .

bfo:BFO_0000132 a owl:ObjectProperty ;
    rdfs:label "occurrent part of"@en .

bfo:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

bfo:BFO_0000146 a owl:Class ;
    rdfs:label "fiat surface"@en ;
    rdfs:subClassOf bfo:BFO_0000140 .

presalt:AcousticImpedance a owl:Class ;
    rdfs:label "Acoustic Impedance"@en ;
    rdfs:comment "Acoustic impedance is a fundamental physical property of a formation that is defined as the product of its acoustic P-wave velocity and bulk density. As a key seismic attribute, its variations are used to interpret changes in lithology, porosity, and fluid content, with porosity being the primary driver in formations with a relatively constant mineralogy. In the context of the Brazilian Pre-Salt, high-porosity carbonate reservoirs are often identified by their characteristic low acoustic impedance signatures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:PhysicalProperty .

presalt:AlluvialFan a owl:Class ;
    rdfs:label "Alluvial Fan"@en ;
    rdfs:comment "An alluvial fan is a fan-shaped depositional landform that is formed by the accumulation of sediment deposited by a stream at the base of a topographic escarpment, typically along the margins of extensional rift basins. In lacustrine rift settings, such as the Brazilian Pre-Salt, these fans can build directly into a lake to form a fan delta. Sediments delivered by the fan, such as from sheet floods or terminal splays, can be reworked by waves at the lake margin to form well-sorted carbonate grainstone and rudstone bodies that constitute significant reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:RiftBasin ],
        georeservoir:GEORES_0000006 .

presalt:AqueousFluid a owl:Class ;
    rdfs:label "Aqueous Fluid"@en ;
    rdfs:comment "An Aqueous Fluid is an earth fluid in which water is the primary solvent."@en ;
    rdfs:subClassOf presalt:Fluid .

presalt:AuthigenicSediment a owl:Class ;
    rdfs:label "Authigenic Sediment"@en ;
    rdfs:comment "Authigenic Sediment is a type of sediment that forms in-situ within a depositional environment through chemical or biological precipitation, rather than being transported from elsewhere."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000031 .

presalt:Basalt a owl:Class ;
    rdfs:label "Basalt"@en ;
    rdfs:comment "Basalt is an extrusive igneous rock that, in the Brazilian Pre-Salt, typically forms tholeiitic flood basalts and flow successions which constitute the acoustic basement or early syn-rift sequences. This micro- to macro-crystalline rock, composed of feldspar, pyroxene, and augite, serves as the foundation for overlying carbonate deposition and is a source of clasts within younger reservoir units."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Feldspar ],
        georeservoir:GEOCORE_0000008 .

presalt:Burial a owl:Class ;
    rdfs:label "Burial"@en ;
    rdfs:comment "Burial is a geological process that subjects sedimentary rocks to progressively increasing temperature and pressure as they are covered by younger deposits, initiating a suite of diagenetic changes. In the Brazilian Pre-Salt, this process occurs at depths often exceeding 3000 meters and temperatures of 60-90°C, where alterations like dolomitization, silicification, and cementation critically control the creation or destruction of reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        georeservoir:GEOCORE_0000002 .

presalt:Calcilutite a owl:Class ;
    rdfs:label "Calcilutite"@en ;
    rdfs:comment "Calcilutite is a fine-grained carbonate rock that is composed of mud-sized particles and often characterized by complex textures including parallel or crenulated laminations, peloids, and microbial structures. In the Brazilian Pre-Salt, it is predominantly composed of calcite, dolomite, and quartz, reflecting significant post-depositional alteration through dolomitization and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:CarbonateRock .

presalt:CarbonateFabric a owl:Class ;
    rdfs:label "Carbonate Fabric"@en ;
    rdfs:comment "Carbonate fabric is the overall structure of a carbonate rock that results from the arrangement, size, and shape of its constituent grains, crystals, and pores. The primary depositional fabric, such as shrub boundstone or grainstone, can be significantly modified or completely obliterated by subsequent diagenetic processes like recrystallization and dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        bfo:BFO_0000019 .

presalt:Chalcedony a owl:Class ;
    rdfs:label "Chalcedony"@en ;
    rdfs:comment "Chalcedony is a cryptocrystalline variety of silica that is characterized by distinctive textures such as fibro-radial, spherulitic, or botryoidal aggregates. In Brazilian Pre-Salt reservoirs, it acts as a common diagenetic cement that lines and partially occludes interparticle, vuggy, and fracture porosity, often occurring as a later silica phase associated with fractured zones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        georeservoir:GEOCORE_0000006 .

presalt:ClasticSediment a owl:Class ;
    rdfs:label "Clastic Sediment"@en ;
    rdfs:comment "Clastic sediment is sedimentary material that is composed of fragments, or clasts, derived from the physical weathering and erosion of pre-existing rocks. In the Brazilian Pre-Salt, this term encompasses both siliciclastic detritus eroded from basement highs and carbonate clasts (intraclasts and lithoclasts) fragmented from earlier lacustrine carbonate successions. These sediments are commonly redeposited downslope by gravity flows, forming mixed clastic-carbonate sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Weathering ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        georeservoir:GEORES_0000031 .

presalt:Conglomerate a owl:Class ;
    rdfs:label "Conglomerate"@en ;
    rdfs:comment "Conglomerate is a clastic sedimentary rock that is composed of rounded to subrounded clasts larger than 2 millimeters in diameter, cemented within a finer-grained matrix. In Pre-Salt sequences, these rocks are often deposited in fluvial to alluvial fan environments associated with tectonic uplift and contain a heterogeneous mix of clasts, including basement gneiss, basalt, limestone, and intraformational silica."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Basalt ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Limestone ],
        presalt:ContinentalSiliciclastic .

presalt:CrystallineBasement a owl:Class ;
    rdfs:label "Crystalline Basement"@en ;
    rdfs:comment "Crystalline basement is the fundamental geologic unit of Precambrian-aged igneous and metamorphic rocks, primarily granites and gneisses, that forms the foundation beneath the sedimentary and volcanic sequences of a basin. In the Brazilian Pre-Salt, it represents the continental crust upon which the rift and subsequent sag phase successions, including the carbonate reservoirs, were deposited. This unit can be fractured and brecciated, serving as a host rock for diagenetic processes and mineralization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:IgneousRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Gneiss ],
        presalt:Basement .

presalt:DepositionalSequence a owl:Class ;
    rdfs:label "Depositional Sequence"@en ;
    rdfs:comment "A depositional sequence is a relatively conformable and genetically related succession of strata that is bounded at its top and base by unconformities or their correlative conformities. It represents a major depositional cycle recording long-term changes in accommodation space and sediment supply, often driven by tectonic activity and climatic shifts. In the Brazilian Pre-Salt, these sequences are identified using seismic and well log data and encompass key reservoir intervals, such as the lacustrine carbonates of the Barra Velha Formation, which are often capped by regional evaporite deposits."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:DiageneticProduct a owl:Class ;
    rdfs:label "Diagenetic Product"@en ;
    rdfs:comment "A diagenetic product is a mineral or mineralogical feature that forms within a rock during diagenesis as a result of post-depositional physical, chemical, or biological processes. These products manifest as cements filling porosity, minerals replacing pre-existing components, or as recrystallized fabrics. In Brazilian Pre-Salt carbonates, common diagenetic products include various forms of dolomite, calcite, quartz, and pyrite, which fundamentally control the evolution of reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000006 .

presalt:EarlyCretaceous a owl:NamedIndividual,
        georeservoir:GEOCORE_0000005 ;
    rdfs:label "Early Cretaceous"@en ;
    rdfs:comment "The Early Cretaceous is the earliest epoch of the Cretaceous Period that is characterized by the continental rifting between South America and Africa, which formed the precursor basins of the South Atlantic. Within the Brazilian Pre-Salt context, this epoch encompasses the syn-rift and sag phases, during which extensive lacustrine systems deposited the organic-rich source rocks and shallow-water carbonate reservoirs of the prolific petroleum system. This interval, spanning from approximately 145 to 100.5 million years ago, includes the deposition of the key Barremian-Aptian Pre-Salt successions."@en .

presalt:FaultBlock a owl:Class ;
    rdfs:label "Fault Block"@en ;
    rdfs:comment "A fault block is a crustal block that is bounded by faults, typically forming an uplifted horst or a tilted structure in an extensional tectonic setting. Within the Brazilian Pre-Salt, these blocks form prominent structural highs that control the deposition of carbonate reservoir facies, with stratigraphic thinning on the crests and the accumulation of reworked grainstones along their flanks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:StructuralBodyOfRock .

presalt:FaultReactivation a owl:Class ;
    rdfs:label "Fault Reactivation"@en ;
    rdfs:comment "Fault reactivation is a tectonic process that involves renewed displacement or subsequent movement along a pre-existing fault plane, often in response to a change in the regional stress field. In the Brazilian Pre-Salt, the reactivation of older rift faults during and after the deposition of the Barra Velha Formation controlled the creation of accommodation space, the distribution of carbonate depocenters, and the development of fracture systems that influence reservoir quality."@en ;
    rdfs:subClassOf presalt:Deformation .

presalt:Footwall a owl:Class ;
    rdfs:label "Footwall"@en ;
    rdfs:comment "Footwall is the block of rock that lies structurally below a non-vertical fault plane. In the extensional rift setting of the Brazilian Pre-Salt, the footwall of a normal fault undergoes relative uplift, forming structural highs that provide favorable paleotopography for the development of shallow-water lacustrine carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:FaultBlock .

presalt:Gastropod a owl:Class ;
    rdfs:label "Gastropod"@en ;
    rdfs:comment "Gastropod is a mollusk that is characterized by a single, typically coiled shell which serves as a bioclast in carbonate sedimentary rocks. In the Brazilian Pre-Salt, gastropod shells are found in lacustrine facies where their relative abundance can indicate environmental variations in salinity and energy, and their diagenetic alteration contributes to reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        presalt:Mollusk .

presalt:Gneiss a owl:Class ;
    rdfs:label "Gneiss"@en ;
    rdfs:comment "Gneiss is a high-grade metamorphic rock that is characterized by a distinct foliation, with alternating bands of different mineral compositions. In the context of South Atlantic pre-salt basins, gneiss commonly constitutes the crystalline basement and also occurs as clasts within syn-rift conglomerates, sourced from the erosion of adjacent basement highs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Conglomerate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CrystallineBasement ],
        georeservoir:GEOCORE_0000008 .

presalt:HalfGraben a owl:Class ;
    rdfs:label "Half-Graben"@en ;
    rdfs:comment "A half-graben is a structural basin that is bounded on one side by a major normal or listric fault, resulting in a characteristic wedge-shaped geometry with rotated internal blocks. Formed during extensional tectonics, these structures in the Brazilian Pre-Salt are filled with syn-rift deposits and can vary from narrow, discontinuous features to wide, continuous basins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        presalt:StructuralLow .

presalt:Halokinesis a owl:Class ;
    rdfs:label "Halokinesis"@en ;
    rdfs:comment "Halokinesis is a geological process that involves the subsurface mobilization and flow of salt layers due to their physical properties and external stresses. In the Santos Basin, this process is primarily triggered by differential loading from overlying sediments, controlling the structural evolution and creating features like diapirs and salt windows that impact hydrocarbon migration pathways."@en ;
    rdfs:subClassOf presalt:Deformation .

presalt:Heterogeneity a owl:Class ;
    rdfs:label "Heterogeneity"@en ;
    rdfs:comment "Heterogeneity is the spatial variation of reservoir properties that is determined by the original depositional environment and subsequent structural and diagenetic events. This variation manifests across multiple scales as alternating high and low-quality layers, resulting in a wide range of petrophysical values such as porosity and permeability. Such variability can create flow baffles or seals, leading to the compartmentalization of the reservoir into distinct fluid or pressure segments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Reservoir ],
        presalt:ReservoirProperty .

presalt:HydrocarbonAccumulation a owl:Class ;
    rdfs:label "Hydrocarbon Accumulation"@en ;
    rdfs:comment "A hydrocarbon accumulation is a subsurface body of oil and/or gas that is trapped within a porous and permeable reservoir rock. In the Brazilian Pre-Salt, these accumulations typically form giant or supergiant fields hosted within complex lacustrine carbonate reservoirs, where internal seals can cause segregation and compartmentalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Oil ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Gas ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        georeservoir:GEOCORE_0000001 .

presalt:IntercrystallinePore a owl:Class ;
    rdfs:label "Intercrystalline Pore"@en ;
    rdfs:comment "An intercrystalline pore is a type of secondary porosity that consists of the void spaces located between the constituent crystals of a diagenetically altered rock. In Brazilian Pre-Salt carbonates, this porosity is most commonly formed by dolomitization, creating a network of small, often irregular pores between dolomite crystals, or within silicified intervals. These pores are a significant component of the total pore system and can be crucial for reservoir connectivity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PoreSystem ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:Pore .

presalt:IntraclasticGrainstone a owl:Class ;
    rdfs:label "Intraclastic Grainstone"@en ;
    rdfs:comment "Intraclastic grainstone is a grain-supported sedimentary carbonate rock that is characterized by a composition dominated by intraclasts with a grain size typically less than 2 mm. Within the Brazilian Pre-Salt, it is a significant reservoir facies composed of reworked fragments of fascicular calcite crusts, spherulites, and laminites, often exhibiting moderate to good sorting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Laminite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Intraclast ],
        presalt:Grainstone .

presalt:Lamination a owl:Class ;
    rdfs:label "Lamination"@en ;
    rdfs:comment "Lamination is a primary sedimentary structure that consists of thin, parallel to sub-parallel layers, or laminae, typically less than one centimeter thick, which are distinguishable by variations in properties like grain size or composition. In the context of the Pre-Salt, lamination commonly appears as planar, low-angle, wavy, or irregular forms that can be laterally continuous or discontinuous. This structure provides key information about depositional processes, such as flow regime, and is often preserved as relicts within microbialite facies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Laminite a owl:Class ;
    rdfs:label "Laminite"@en ;
    rdfs:comment "Laminite is a fine-grained laminated carbonate rock that originates from the diagenetic replacement of primary laminated clay deposits, such as stevensite, by calcite or dolomite. Characteristic of Pre-Salt lacustrine depositional systems, these rocks often preserve the original lamination, which is highlighted by remnants of organic matter and fine siliciclastic grains. They frequently exhibit complex diagenetic overprints, including silicification and the development of secondary dissolution porosity, which significantly influence their reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Stevensite ],
        georeservoir:GEORES_0000032 .

presalt:Limestone a owl:Class ;
    rdfs:label "Limestone"@en ;
    rdfs:comment "Limestone is a carbonate sedimentary rock that is composed predominantly of calcium carbonate minerals, chiefly calcite and aragonite. In the Brazilian Pre-Salt, it encompasses a wide range of lacustrine facies, including bioclastic, spherulitic, and argillaceous varieties, whose reservoir quality is often controlled by subsequent diagenetic processes like dissolution, brecciation, and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Aragonite ],
        presalt:CarbonateRock .

presalt:MacrocrystallineQuartz a owl:Class ;
    rdfs:label "Macrocrystalline Quartz"@en ;
    rdfs:comment "Macrocrystalline quartz is a diagenetic quartz cement that is characterized by relatively large crystals which typically form a mosaic or drusy texture. In Pre-Salt reservoirs, it commonly precipitates as a late-stage phase in the center of pores after earlier silica cements and can also replace carbonate components, particularly bivalve bioclasts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Replacement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        presalt:Quartz .

presalt:MarineEnvironment a owl:Class ;
    rdfs:label "Marine Environment"@en ;
    rdfs:comment "A marine environment is a depositional environment that is characterized by its direct connection to an ocean, containing water with oceanic salinity and chemistry. In the context of the South Atlantic's geological evolution, the establishment of open marine conditions during the Aptian drift phase marks the end of the preceding lacustrine system in which the Pre-Salt carbonates were deposited. This transition, often termed 'marine ingress', led to the deposition of the overlying Ariri Formation evaporites in a restricted marine setting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:MarineWater ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:DriftPhase ],
        georeservoir:GEORES_0000021 .

presalt:Matrix a owl:Class ;
    rdfs:label "Matrix"@en ;
    rdfs:comment "Matrix is the fine-grained material in a carbonate rock that fills the interstitial space between larger grains or framework components, such as shrubs and spherulites. In Brazilian Pre-Salt reservoirs, this component was originally composed of magnesian clays, which have often been diagenetically replaced by minerals like dolomite and silica. From a reservoir perspective, the matrix constitutes the bulk rock volume whose inherent porosity and permeability are distinct from those of large-scale features like fractures or conduits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:MechanicalCompaction a owl:Class ;
    rdfs:label "Mechanical Compaction"@en ;
    rdfs:comment "Mechanical compaction is a physical diagenetic process that reduces the bulk volume and porosity of a sediment through the rearrangement, deformation, or breakage of grains under the influence of increasing overburden stress. In Pre-Salt carbonates, this process is evidenced by features such as tight grain arrangements, coalesced shrubs, concave-convex grain contacts, and deformed grains. It is a distinct process from chemical compaction and typically results in the reduction of primary interparticle porosity during burial."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Burial ],
        georeservoir:GEOCORE_0000002 .

presalt:MgSilicateGel a owl:Class ;
    rdfs:label "Mg-Silicate Gel"@en ;
    rdfs:comment "Mg-silicate gel is a poorly crystalline chemical precipitate that forms in alkaline, Mg- and SiO2-rich lacustrine waters during periods of intense evaporation. Upon burial, this hydrated gel undergoes diagenetic transformation through dehydration, forming more stable crystalline Mg-silicate minerals such as stevensite or hydrated talc. As a key component of the Aptian microbial carbonate system, its precipitation influences water chemistry and often precedes the formation of calcite spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Evaporation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        georeservoir:GEOCORE_0000006 .

presalt:Mica a owl:Class ;
    rdfs:label "Mica"@en ;
    rdfs:comment "Mica is a group of sheet silicate minerals that, in the context of the Brazilian Pre-Salt, occurs as a detrital siliciclastic component. It is commonly found as white mica, such as muscovite or sericite, associated with quartz and feldspar within siliciclastic siltstones and mudstones. Additionally, mica can be present as an accessory clastic grain within resedimented carbonate facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Siltstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Mudstone ],
        presalt:Mineral .

presalt:Microbialite a owl:Class ;
    rdfs:label "Microbialite"@en ;
    rdfs:comment "Microbialite is an organosedimentary deposit that is produced, induced, or influenced by the activity of benthic microbial communities. In the Brazilian Pre-Salt, this facies typically occurs as an autochthonous, porous carbonate rock forming tabular to irregular bodies composed of microbially-precipitated clots and peloids cemented by calcite. These bodies can be massive, show relict lamination, or exhibit subvertical branching structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Peloid ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:MicrobialCarbonate .

presalt:MoldicPorosity a owl:Class ;
    rdfs:label "Moldic Porosity"@en ;
    rdfs:comment "Moldic porosity is a type of secondary porosity that is formed by the dissolution of a sedimentary component, such as a shell or grain, leaving a pore that retains the shape of the dissolved feature. In Pre-Salt bioclastic reservoirs, it is a common pore type that contributes to high total porosity but often has low permeability due to poor connectivity between molds. The enlargement and connection of these molds can form vugular porosity, which significantly improves reservoir permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:Mollusk a owl:Class ;
    rdfs:label "Mollusk"@en ;
    rdfs:comment "A Mollusk is an invertebrate animal of the phylum Mollusca, typically having a soft unsegmented body and a calcareous shell."@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

presalt:Nucleus a owl:Class ;
    rdfs:label "Nucleus"@en ;
    rdfs:comment "A nucleus is a central particle or fragment that serves as the initial substrate for the precipitation or accretion of subsequent carbonate layers, forming a larger composite grain such as a spherulite or ooid. In the context of Brazilian Pre-Salt reservoirs, the nucleus can be composed of various materials, including micrite, peloids, bioclasts, phosphate fragments, or even reworked grains like ooids and intraclasts. The composition and shape of the nucleus can influence the morphology of the resulting grain and may be dissolved or obscured during subsequent diagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:OilAccumulation a owl:Class ;
    rdfs:label "Oil Accumulation"@en ;
    rdfs:comment "An oil accumulation is a discrete subsurface volume of petroleum that is held within a stratigraphic or structural trap. In the context of the Brazilian Pre-Salt, these are typically giant accumulations of oil with associated gas found within lacustrine carbonate reservoirs of formations such as Barra Velha and Itapema. The contained fluids form a distinct oil column characterized by properties such as API gravity and saturation pressure, which may exhibit gradients due to post-accumulation processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Gas ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Oil ],
        presalt:HydrocarbonAccumulation .

presalt:Oncoid a owl:Class ;
    rdfs:label "Oncoid"@en ;
    rdfs:comment "An oncoid is an organo-sedimentary coated grain that is formed by the microbial, typically cyanobacterial, accretion of concentric, irregular laminae around a central nucleus. Their formation requires intermittent rolling in a low to moderate energy, very shallow lacustrine setting, making them unequivocal evidence of microbial activity. In the Brazilian Pre-Salt, oncoids can be subject to significant intraparticle dissolution, which creates valuable mouldic porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Nucleus ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        georeservoir:GEORES_0000031 .

presalt:Ooid a owl:Class ;
    rdfs:label "Ooid"@en ;
    rdfs:comment "An ooid is a coated sedimentary grain that consists of a nucleus enveloped by a cortex of one or more concentric laminae, which in the Brazilian Pre-Salt was originally composed of magnesium clays. Typically of coarse sand size, these grains formed in a dynamic, non-marine alkaline lacustrine system and are now preserved as calcite, often exhibiting complex nuclei like intraclasts or bioclasts that indicate multicycle reworking."@en ;
    rdfs:subClassOf presalt:SedimentaryGrain .

presalt:OrganoSedimentaryStructure a owl:Class ;
    rdfs:label "Organo-Sedimentary Structure"@en ;
    rdfs:comment "An Organo-sedimentary Structure is a geological structure that is formed by the interaction of biological activity and sedimentary processes."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:PostRiftSequence a owl:Class ;
    rdfs:label "Post-Rift Sequence"@en ;
    rdfs:comment "A post-rift sequence is a stratigraphic supersequence that was deposited during the thermal subsidence or sag phase that follows the main continental rifting stage. In the Brazilian Pre-Salt context, this sequence is primarily composed of the lacustrine carbonates of the Barra Velha Formation, which constitute the main reservoirs, and the overlying evaporites of the Ariri Formation, which form the regional seal. The deposition is characterized by an aggradational filling pattern that heals the residual rift topography as the basin transitions toward a passive margin."@en ;
    rdfs:subClassOf presalt:Supersequence .

presalt:Pyrite a owl:Class ;
    rdfs:label "Pyrite"@en ;
    rdfs:comment "Pyrite is a diagenetic iron sulfide mineral that forms in Pre-Salt carbonates through processes such as thermochemical sulfate reduction and is often remobilized during diagenesis. It commonly occurs as a secondary mineral filling fractures and pores or replacing precursor minerals and matrix, exhibiting cubic, microcrystalline, or macrocrystalline habits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        presalt:Sulfide .

presalt:Rift a owl:Class ;
    rdfs:label "Rift"@en ;
    rdfs:comment "Rift is a tectono-stratigraphic stage that is driven by crustal extension and characterized by active normal faulting, leading to differential subsidence and the formation of fault-bounded basins. In the context of the Brazilian Pre-Salt, this stage is associated with the opening of the South Atlantic Ocean and the deposition of syn-rift sequences, which include lacustrine source rocks and the initial carbonate reservoir successions. The resulting stratigraphy often comprises asymmetric wedges of growth strata, and the stage may be subdivided into distinct phases reflecting the complex evolution of continental breakup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Subsidence ],
        presalt:TectonoStratigraphicProcess .

presalt:RiftBasin a owl:Class ;
    rdfs:label "Rift Basin"@en ;
    rdfs:comment "A rift basin is a sedimentary basin that is formed by the tectonic extension and thinning of the lithosphere, resulting in an elongated depression bounded by normal faults. These basins are typically characterized by a syn-rift stage of active faulting and rapid subsidence that deposits wedge-shaped sedimentary packages, followed by a post-rift stage of slower, broader thermal subsidence. In the South Atlantic, these basins developed during the breakup of the Gondwana supercontinent and contain the foundational pre-salt sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        presalt:SedimentaryBasin .

presalt:Salinity a owl:Class ;
    rdfs:label "Salinity"@en ;
    rdfs:comment "Salinity is a measure of the total amount of dissolved salts in a fluid, such as formation water or the aqueous phase of fluid inclusions. In the context of the Brazilian Pre-Salt, it is a critical parameter typically expressed as weight percent sodium chloride equivalent (wt% NaCl eq.), which influences diagenetic processes, fluid flow, and the interpretation of depositional environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Fluid ],
        presalt:ReservoirProperty .

presalt:SecondaryPorosity a owl:Class ;
    rdfs:label "Secondary Porosity"@en ;
    rdfs:comment "Secondary porosity is a pore space that is created within a sedimentary rock after deposition through diagenetic processes such as dissolution, fracturing, or alteration of mineral constituents. In Brazilian Pre-Salt lacustrine carbonates, it is the dominant porosity type, primarily generated by the dissolution of unstable components like Mg-clays and carbonate grains. This process creates a wide variety of pore types, including moldic, vugular, intercrystalline, and fracture porosity, which constitute the main oil storage reservoirs."@en ;
    rdfs:subClassOf presalt:PoreSpace .

presalt:SedimentWaterInterface a owl:Class ;
    rdfs:label "Sediment-Water Interface"@en ;
    rdfs:comment "The sediment-water interface is a physical and biogeochemical boundary that separates the bottom sediments of a lake from the overlying water column. In the context of Pre-Salt lacustrine carbonates, this interface is a critical zone for the primary precipitation of minerals, such as the formation of calcite spherulites within gels and the growth of microbial shrubs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

presalt:SedimentarySuccession a owl:Class ;
    rdfs:label "Sedimentary Succession"@en ;
    rdfs:comment "A Sedimentary Succession is a facies association characterized by a vertical sequence of genetically related facies or strata that records changes in depositional environments over time."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000030 .

presalt:Spherulitestone a owl:Class ;
    rdfs:label "Spherulitestone"@en ;
    rdfs:comment "Spherulitestone is a sedimentary carbonate rock that is composed of more than 90% spherulites, which are spherical to subspherical aggregates of radiating calcite crystals. Typically found in the lacustrine Pre-Salt succession, this rock exhibits a grainstone-like texture with tightly packed, well-sorted, and rounded grains, although individual spherulites may be deformed or coalesced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:CarbonateRock .

presalt:StructuralLow a owl:Class ;
    rdfs:label "Structural Low"@en ;
    rdfs:comment "A structural low is a tectonically formed depression in the subsurface that is characterized by a lower structural elevation relative to adjacent areas, such as horsts or structural highs. In the Brazilian Pre-Salt, these features often correspond to grabens and half-grabens created during the rift phase, which control the depositional architecture and thickness of overlying sedimentary sequences. They are identified on seismic data as areas of lower elevation on structural contour maps of key horizons, particularly the top of the basement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:RiftPhase ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:TectonicActivity ],
        georeservoir:GEOCORE_0000004 .

presalt:SubaerialExposure a owl:Class ;
    rdfs:label "Subaerial Exposure"@en ;
    rdfs:comment "Subaerial exposure is a geological process that exposes previously submerged lacustrine sediments and rocks to the atmosphere, driven by a significant fall in lake level. This process results in physical weathering, chemical alteration, and erosion of the exposed carbonates, creating diagnostic features such as breccias, unconformities, and dolomite-enriched pedogenetic profiles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

presalt:Sulfide a owl:Class ;
    rdfs:label "Sulfide"@en ;
    rdfs:comment "Sulfide is a group of authigenic minerals that contains sulfur in its most reduced state and precipitates from sulfur-rich fluids. In the Brazilian Pre-Salt, these minerals, including pyrite, chalcopyrite, and sphalerite, typically occur as euhedral crystals filling vugular and fracture porosity. Their precipitation is often associated with hydrothermal fluid circulation and thermal sulfate reduction (TSR), serving as an indicator of specific diagenetic events."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Supersequence a owl:Class ;
    rdfs:label "Supersequence"@en ;
    rdfs:comment "A supersequence is a primary tectono-stratigraphic unit that comprises a genetically related succession of depositional sequences bounded by major unconformities and their correlative conformities. In the context of the Brazilian Pre-Salt, supersequences represent the highest-order stratigraphic subdivision and correspond to major basin evolution phases, such as the syn-rift, post-rift, and drift stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:DepositionalSequence ],
        georeservoir:GEORES_0000002 .

presalt:VolcanicActivity a owl:Class ;
    rdfs:label "Volcanic Activity"@en ;
    rdfs:comment "Volcanic activity is a geological process that, during the Early Cretaceous rifting of the South Atlantic, involved extensive magmatism and associated hydrothermalism which fundamentally influenced the chemistry of the Pre-Salt lacustrine systems. This synsedimentary process supplied CO2, heat, and ions into the lakes via hydrothermal vents, creating the highly alkaline and supersaturated conditions necessary for the abiotic precipitation of key carbonate reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:AbioticPrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Magmatism ],
        presalt:Magmatism .

presalt:VolcanicFragment a owl:Class ;
    rdfs:label "Volcanic Fragment"@en ;
    rdfs:comment "A volcanic fragment is a sedimentary clast that is composed of material derived from volcanic rock. In the Brazilian Pre-Salt, these fragments are found as constituent grains within lacustrine carbonate facies, such as packstones and grainstones, indicating sediment input from a volcanic source. The alteration of these fragments can influence reservoir diagenesis, for instance, by contributing to the formation of authigenic clays like stevensite."@en ;
    rdfs:subClassOf presalt:SedimentaryClast .

presalt:VuggyPorosity a owl:Class ;
    rdfs:label "Vuggy Porosity"@en ;
    rdfs:comment "Vuggy porosity is a type of secondary porosity that is characterized by dissolution-generated pores that are larger than the rock's constituent grains or crystals. While it is a dominant and high-volume pore type in many Pre-Salt carbonate facies, the vugs are often isolated or poorly connected, resulting in low permeability despite high porosity values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:VugularPorosity a owl:Class ;
    rdfs:label "Vugular Porosity"@en ;
    rdfs:comment "Vugular porosity is a type of secondary porosity that is characterized by dissolution-related pores which are larger than the constituent grains or crystals of the rock. It is formed by the non-fabric selective dissolution of carbonate minerals and can represent the largest volume of porosity in certain Pre-Salt intervals, occurring predominantly in calcirudite and shrubstone facies. While isolated vugs often result in a poorly connected pore system, their association with interparticle or fracture porosity significantly enhances reservoir permeability."@en ;
    rdfs:subClassOf presalt:SecondaryPorosity .

georeservoir:GEOCORE_0000010 a owl:Class ;
    rdfs:label "unconsolidated earth material"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000012 a owl:Class ;
    rdfs:label "geological contact"@en ;
    rdfs:subClassOf bfo:BFO_0000145 .

georeservoir:GEORES_0000015 a owl:Class ;
    rdfs:label "mound unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000006 .

georeservoir:GEORES_0000020 a owl:Class ;
    rdfs:label "depositional system"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEORES_0000023 a owl:Class ;
    rdfs:label "geometry"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

georeservoir:GEORES_0000024 a owl:Class ;
    rdfs:label "lithology"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000024 a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

presalt:AbioticPrecipitation a owl:Class ;
    rdfs:label "Abiotic Precipitation"@en ;
    rdfs:comment "Abiotic precipitation is a geochemical process that forms minerals directly from a solution due to physicochemical changes, occurring without the mediation of biological organisms. In Pre-Salt lacustrine settings, this process is often triggered by rapid precipitation from highly saturated solutions, elevated pH, or CO2 degassing, resulting in crystalline fabrics that lack evidence of microbial activity such as trapping, binding, or clotted textures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        georeservoir:GEOCORE_0000002 .

presalt:Anhydrite a owl:Class ;
    rdfs:label "Anhydrite"@en ;
    rdfs:comment "Anhydrite is an evaporite mineral that is commonly found in the Brazilian Pre-Salt as layered deposits within the Ariri Formation and as a diagenetic pore-filling cement. Characterized by its brittle behavior and high acoustic impedance relative to halite, it forms a key basal seismic reflector and influences the structural style of salt tectonics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:AcousticImpedance ],
        presalt:EvaporiteMineral .

presalt:Aragonite a owl:Class ;
    rdfs:label "Aragonite"@en ;
    rdfs:comment "Aragonite is a metastable mineral polymorph of calcium carbonate that is a primary constituent of biogenic grains, such as bivalve and gastropod shells, in Pre-Salt lacustrine carbonates. Due to its instability, it is highly susceptible to diagenetic alteration through dissolution, which creates moldic porosity, or neomorphism to calcite, with the balance between these processes strongly controlling reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        presalt:CarbonateMineral .

presalt:Basement a owl:Class ;
    rdfs:label "Basement"@en ;
    rdfs:comment "Basement is a geological unit of igneous or metamorphic rock that forms the foundation beneath a sedimentary sequence."@en,
        "Basement is a rock succession that underlies the sedimentary rift sequence and is typically composed of crystalline igneous and metamorphic rocks. In the Brazilian Pre-Salt, its pre-existing structural fabric and composition significantly controlled the development of rift-related faults, horsts, and grabens. Seismically, it is identified as the acoustic basement, often exhibiting chaotic or low-amplitude reflections, and can act as a source of diagenetic fluids for the overlying reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:IgneousRock ],
        georeservoir:GEORES_0000003 .

presalt:CarbonateFacies a owl:Class ;
    rdfs:label "Carbonate Facies"@en ;
    rdfs:comment "A carbonate facies is a distinct body of carbonate rock that is defined by a specific combination of observable petrographic, textural, and structural characteristics. These characteristics, including grain size, sorting, packing, and morphology, reflect the specific depositional environment and subsequent diagenetic history of the rock. In the Brazilian Pre-Salt, carbonate facies are broadly categorized as either in-situ (autochthonous), such as shrubs and spherulites, or reworked (allochthonous) deposits."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:CarbonateSediment a owl:Class ;
    rdfs:label "Carbonate Sediment"@en ;
    rdfs:comment "Carbonate sediment is a naturally occurring particulate material that is composed primarily of carbonate minerals formed through chemical, biochemical, or biological processes within a depositional environment. In the Brazilian Pre-Salt, this sediment originates in a lacustrine system and includes components such as spherulites, microbial shrubs, and fine-grained muds, the accumulation of which forms the precursor to reservoir rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrub ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateMud ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        georeservoir:GEORES_0000031 .

presalt:Cement a owl:Class ;
    rdfs:label "Cement"@en ;
    rdfs:comment "Cement is an authigenic mineral that precipitates from pore fluids to fill void spaces within a sedimentary rock, thereby binding constituent grains and reducing porosity. In the context of Brazilian Pre-Salt reservoirs, cementation is a critical diagenetic process that significantly impacts reservoir quality by occluding primary and secondary pore networks. Common cement compositions include various forms of calcite and dolomite (e.g., blocky, mosaic, saddle), silica (quartz), and other minerals such as dawsonite and barite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Cementation ],
        presalt:DiageneticProduct .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "Chemical Sedimentary Rock"@en ;
    rdfs:comment "Chemical Sedimentary Rock is a sedimentary rock formed by the precipitation of minerals from an aqueous solution."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Compaction a owl:Class ;
    rdfs:label "Compaction"@en ;
    rdfs:comment "Compaction is a diagenetic process that reduces the bulk volume and porosity of sediments due to the effects of increasing overburden stress during burial. This process includes mechanical compaction, evidenced by grain rearrangement and deformation leading to tight packing and concave-convex contacts, and chemical compaction, which involves pressure solution creating sutured grain contacts. In the Pre-Salt lacustrine carbonates, the effects of compaction are often observed as tight grain arrangements, deformed grains, and crinkled laminae in both grain-supported and laminated facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:MechanicalCompaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        presalt:DiageneticProcess .

presalt:ContinentalCarbonate a owl:Class ;
    rdfs:label "Continental Carbonate"@en ;
    rdfs:comment "Continental carbonate is a sedimentary carbonate rock that forms in a wide range of non-marine depositional environments, including lacustrine, palustrine, and spring systems. These rocks are subject to the direct influence of meteoric fluids, microbial activity, and pedogenetic processes, and their formation is strongly controlled by physicochemical parameters such as CO2 degassing and ion availability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        presalt:CarbonateRock .

presalt:Crust a owl:Class ;
    rdfs:label "Crust"@en ;
    rdfs:comment "Crust is the outermost solid shell of a rocky planet, dwarf planet, or natural satellite, which is chemically distinct from the underlying mantle."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

presalt:DiageneticFeature a owl:Class ;
    rdfs:label "Diagenetic Feature"@en ;
    rdfs:comment "A Diagenetic Feature is a component or characteristic of a rock that formed during diagenesis through post-depositional physical, chemical, or biological processes."@en,
        "A diagenetic feature is an observable physical, chemical, or textural characteristic of a rock that results from post-depositional diagenetic processes. In Brazilian Pre-Salt carbonates, prominent examples include dolomitization, silicification, cementation, compaction effects like stylolites, and modifications to porosity. These features are studied at multiple scales, from microscopic textures to large-scale alteration zones mapped via seismic data."@en ;
    rdfs:subClassOf bfo:BFO_0000020,
        georeservoir:GEOCORE_0000006 .

presalt:DriftPhase a owl:Class ;
    rdfs:label "Drift Phase"@en ;
    rdfs:comment "Drift phase is the final tectonostratigraphic phase in the evolution of a passive margin basin that is initiated by the onset of seafloor spreading and the formation of oceanic crust. In the Brazilian South Atlantic, this phase began in the Albian and is characterized by thermal subsidence and the deposition of open marine carbonates followed by thick siliciclastic sequences. This stage also involved magmatic activity along reactivated faults, which drove diagenetic processes such as dolomitization and dissolution in the underlying pre-salt carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:TectonoStratigraphicInterval .

presalt:Evaporation a owl:Class ;
    rdfs:label "Evaporation"@en ;
    rdfs:comment "Evaporation is a climatic process that involves the net loss of water from a lacustrine system to the atmosphere, occurring when water loss rates exceed precipitation and influx. This process leads to lake retraction and increases the concentration of dissolved ions, raising water alkalinity and salinity. In the Pre-Salt context, the resulting supersaturated waters trigger the precipitation of key minerals, such as magnesium silicate gels and calcite, which form characteristic reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        georeservoir:GEOCORE_0000002 .

presalt:ExogenicProcess a owl:Class ;
    rdfs:label "Exogenic Process"@en ;
    rdfs:comment "An Exogenic Process is a geological process that originates at or near the Earth's surface and is driven by external energy sources."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Feldspar a owl:Class ;
    rdfs:label "Feldspar"@en ;
    rdfs:comment "Feldspar is a group of rock-forming tectosilicate minerals that serves as a common siliciclastic component within the carbonate-dominated lacustrine successions of the Brazilian Pre-Salt. It is typically found as detrital grains of K-feldspar and plagioclase within siltstones or as phenocrysts in volcanic-derived felsic tuffs. These feldspar grains are often subject to diagenetic alteration, including replacement by carbonate minerals such as dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Siltstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        presalt:Mineral .

presalt:Fracture a owl:Class ;
    rdfs:label "Fracture"@en ;
    rdfs:comment "A fracture is a structural discontinuity in a rock that is formed by tectonic or gravitational processes when stress exceeds the rock's mechanical strength. In Pre-Salt carbonates, fractures represent a significant pore type often concentrated in brittle, silicified layers, where they can be open, partially open, or cemented by minerals such as silica, and may be enhanced by dissolution to form critical fluid flow pathways."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Cementation ],
        georeservoir:GEOCORE_0000004 .

presalt:FracturePorosity a owl:Class ;
    rdfs:label "Fracture Porosity"@en ;
    rdfs:comment "Fracture porosity is a type of secondary porosity that is composed of the void space created by natural cracks, fissures, or breaks within a rock. In Brazilian Pre-Salt carbonates, these features are often irregular and continuous fractures that contribute to the overall porous system, with apertures observed to range from 0.1 to 0.5 mm. This porosity can be significantly reduced when the fractures are partially or completely filled by diagenetic minerals, including silica, calcite, and dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000019 .

presalt:GeomorphicElement a owl:Class ;
    rdfs:label "Geomorphic Element"@en ;
    rdfs:comment "A Geomorphic Element is a distinct, recognizable landform or part of a landform that constitutes a component of a larger depositional environment."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Halite a owl:Class ;
    rdfs:label "Halite"@en ;
    rdfs:comment "Halite is an evaporite mineral that is composed of sodium chloride (NaCl) and characterized by its highly ductile behavior. In the Brazilian Pre-Salt, it is a primary constituent of the Ariri Formation evaporite sequence, where its plastic flow forms massive salt bodies and diapirs. These extensive salt layers act as a crucial regional seal for the underlying carbonate reservoirs of the petroleum system."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:HydrothermalFluid a owl:Class ;
    rdfs:label "Hydrothermal Fluid"@en ;
    rdfs:comment "A hydrothermal fluid is a hot aqueous solution that circulates through the Earth's crust, driven by geothermal gradients, and causes significant physico-chemical alteration of the rocks it flows through. In the Brazilian Pre-Salt, these fluids typically migrate along tectonic faults and fractures, causing dissolution, brecciation, and the precipitation of a characteristic mineral suite such as saddle dolomite, quartz, and barite, which significantly modifies reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:IgneousRock a owl:Class ;
    rdfs:label "Igneous Rock"@en ;
    rdfs:comment "Igneous rock is a rock that forms from the cooling and solidification of molten magma or lava. In the Brazilian Pre-Salt, these rocks occur as intrusive sills and extrusive basalts that significantly impact the carbonate reservoir by driving diagenetic processes like silicification and dolomitization and acting as flow barriers or fractured conduits."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:InSituCarbonateFacies a owl:Class ;
    rdfs:label "In-Situ Carbonate Facies"@en ;
    rdfs:comment "An In-situ Carbonate Facies is a carbonate facies formed by organisms or chemical precipitation at the site of deposition without significant transport."@en ;
    rdfs:subClassOf presalt:CarbonateFacies .

presalt:Magmatism a owl:Class ;
    rdfs:label "Magmatism"@en ;
    rdfs:comment "Magmatism is a geological process that encompasses the generation, movement, and emplacement of molten rock (magma) and its associated gases within the Earth's crust and onto its surface. In the South Atlantic basins, magmatism occurred in distinct cycles associated with rifting and continental drift, forming intrusive bodies and extrusive volcanic edifices. These magmatic events are a key source of heat and mantle-derived fluids that drive hydrothermal alteration, significantly influencing the diagenetic pathways and reservoir properties of Pre-Salt carbonates."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:MarineWater a owl:Class ;
    rdfs:label "Marine Water"@en ;
    rdfs:comment "Marine water is water originating from the sea or ocean that is defined by a specific geochemical and isotopic composition distinct from continental lacustrine waters. In the context of the South Atlantic margin, the influx of Aptian marine water, characterized by a low strontium isotope ratio (⁸⁷Sr/⁸⁶Sr ≈ 0.707), terminated the Pre-Salt lacustrine system and led to the deposition of the overlying Ariri Formation evaporites."@en ;
    rdfs:subClassOf presalt:AqueousFluid .

presalt:Micrite a owl:Class ;
    rdfs:label "Micrite"@en ;
    rdfs:comment "Micrite is a microcrystalline carbonate mud that precipitates in high pH lacustrine settings and accumulates as pelagic background sediment in low-energy, deep-water environments. It typically forms finely laminated or massive deposits, indicating deposition in a calm and undisturbed setting, and can also occur as an intergranular filling in grain-supported rocks. The reservoir space within micritic rocks is primarily associated with low-angle fractures."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000031 .

presalt:MicrobialCarbonate a owl:Class ;
    rdfs:label "Microbial Carbonate"@en ;
    rdfs:comment "A microbial carbonate is a sedimentary carbonate rock that is formed through the mediation or influence of microbial activity, such as the trapping and binding of sediment or the induction of mineral precipitation by biofilms. These rocks often exhibit characteristic fabrics, including laminated (stromatolites), clotted (thrombolites), or shrub-like (dendrolites) structures. In the context of the Brazilian Pre-Salt, the term is central to the debate over the origin of lacustrine reservoir facies, with ongoing research distinguishing between true microbialites and abiotic chemical precipitates that mimic microbial textures."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:OrganicMatter a owl:Class ;
    rdfs:label "Organic Matter"@en ;
    rdfs:comment "Organic matter is a carbon-based sedimentary material that is derived from the remains of once-living organisms and preserved within the rock record. In the Brazilian Pre-Salt lacustrine carbonates, it is commonly found as kerogen within dark-colored laminae and mudstones, originating from microbial sources. Its diagenesis, particularly through processes like methanogenesis, significantly influences the stability of other minerals such as Mg-clays."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Mudstone ],
        georeservoir:GEOCORE_0000006 .

presalt:PhysicalProperty a owl:Class ;
    rdfs:label "Physical Property"@en ;
    rdfs:comment "A Physical Property is a reservoir property that describes a measurable physical characteristic of a rock or fluid, such as its response to energy or its mass-volume relationship."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        presalt:ReservoirProperty .

presalt:PrimaryPorosity a owl:Class ;
    rdfs:label "Primary Porosity"@en ;
    rdfs:comment "Primary porosity is the void space within a sedimentary rock that is formed at the time of deposition and is inherent to the original rock fabric. In Pre-Salt carbonates, this commonly includes interparticle porosity between grains and growth-framework porosity within microbial or bioconstructed buildups. The preservation of this initial porosity is critical for reservoir quality and is often reduced by subsequent compaction and cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Compaction ],
        presalt:PoreSpace .

presalt:Replacement a owl:Class ;
    rdfs:label "Replacement"@en ;
    rdfs:comment "Replacement is a diagenetic process that involves the substitution of a pre-existing mineral or sedimentary component, such as a clay or carbonate fabric, by a new authigenic mineral. In the Brazilian Pre-Salt, this commonly involves the replacement of carbonate fabrics (spherulites, shrubs) and clays (stevensite) by silica or dolomite. This process can be pervasive or mimetic and significantly alters reservoir properties by modifying the rock fabric and porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateFabric ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Stevensite ],
        presalt:DiageneticProcess .

presalt:ReworkedCarbonate a owl:Class ;
    rdfs:label "Reworked Carbonate"@en ;
    rdfs:comment "Reworked carbonate is a clastic carbonate rock that is composed of transported and redeposited fragments of pre-existing carbonate facies, primarily calcitic spherulites and shrubs. Typically occurring as grainstone or rudstone textures, these facies are deposited by high-energy flows and are characterized by high primary porosity and permeability, making them significant reservoir intervals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Shrub ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:PrimaryPorosity ],
        presalt:CarbonateRock .

presalt:RockProperty a owl:Class ;
    rdfs:label "Rock Property"@en ;
    rdfs:comment "Rock Property is a quality that inheres in a body of rock, describing its physical, chemical, or textural characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:Rudstone a owl:Class ;
    rdfs:label "Rudstone"@en ;
    rdfs:comment "Rudstone is a grain-supported carbonate rock that is characterized by having more than 10% of its volume composed of grains larger than 2 mm in diameter. Within the Brazilian Pre-Salt, it forms a significant reservoir facies where the coarse grains are typically intraclasts, spherulites, or bioclastic fragments, and its heterogeneous pore system is controlled by grain packing and subsequent diagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PoreSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Bioclast ],
        presalt:GrainSupportedCarbonateRock .

presalt:SagPhase a owl:Class ;
    rdfs:label "Sag Phase"@en ;
    rdfs:comment "The sag phase is a tectono-stratigraphic stage that follows the main rift phase and is primarily characterized by broad, regional subsidence driven by thermal contraction of the lithosphere. In the Brazilian Pre-Salt, this phase created a vast, restricted lacustrine system where paleotopography inherited from the rift phase controlled the deposition of microbial carbonate reservoirs on structural highs and evaporites in basinal areas. Although often considered a period of tectonic quiescence, localized extensional faulting commonly persisted during this time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:RiftPhase ],
        presalt:TectonoStratigraphicInterval .

presalt:SedimentaryClast a owl:Class ;
    rdfs:label "Sedimentary Clast"@en ;
    rdfs:comment "A Sedimentary Clast is a type of sedimentary grain that is a fragment of a pre-existing rock or sediment."@en ;
    rdfs:subClassOf presalt:SedimentaryGrain .

presalt:Shrubstone a owl:Class ;
    rdfs:label "Shrubstone"@en ;
    rdfs:comment "Shrubstone is a carbonate rock that is composed primarily of shrubs, which are fascicular aggregates of fibrous calcite crystals displaying branched, bush-like growth patterns. These shrubs can coalesce to form layered crusts or domal structures and often exhibit significant inter-aggregate and vugular porosity, making it a key reservoir lithotype in lacustrine carbonate systems. It is commonly classified into subtypes, such as shrubby or arborescent, based on the scale of its growth framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:VugularPorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrub ],
        presalt:CarbonateRock .

presalt:Siltstone a owl:Class ;
    rdfs:label "Siltstone"@en ;
    rdfs:comment "Siltstone is a sedimentary rock that is characterized by a dominant grain size of silt particles, which in the Pre-Salt context can be siliciclastic, carbonate (calcisiltite), or a hybrid mixture. The siliciclastic variety is primarily composed of K-feldspar, quartz, and mica, and may appear massive or with plane-parallel lamination. These rocks are often found as thin beds intercalated within larger carbonate units, representing deposition from gravitational flows in a lacustrine setting."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:StratigraphicGeometry a owl:Class ;
    rdfs:label "Stratigraphic Geometry"@en ;
    rdfs:comment "A Stratigraphic Geometry is a geological structure that is a large-scale geometric feature or relationship within a body of rock strata."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:StructuralHigh a owl:Class ;
    rdfs:label "Structural High"@en ;
    rdfs:comment "A structural high is a tectonically-formed positive relief feature, often a horst or uplifted block, that is characterized by being topographically elevated relative to adjacent structural lows like grabens. In the Brazilian Pre-Salt, these elevated basement features controlled the depositional environment, providing favorable conditions for the accumulation of high-energy carbonate facies. Consequently, these features often form the core of major hydrocarbon accumulations and reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:TectonicActivity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Reservoir ],
        georeservoir:GEOCORE_0000004 .

presalt:Subsidence a owl:Class ;
    rdfs:label "Subsidence"@en ;
    rdfs:comment "Subsidence is a geological process that describes the progressive downward movement of a basin floor, which creates accommodation space for sediment accumulation. In sedimentary basin analysis, it is quantified as a rate (e.g., meters per million years) that can be constant or vary spatially and temporally due to tectonic activity and sediment loading. Within the Brazilian Pre-Salt, differential subsidence rates are a primary control on the evolution of carbonate platforms and the distribution of reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:SedimentaryBasin ],
        georeservoir:GEOCORE_0000002 .

presalt:SulfateMineral a owl:Class ;
    rdfs:label "Sulfate Mineral"@en ;
    rdfs:comment "A Sulfate Mineral is a mineral containing the sulfate anion (SO₄²⁻) as a major component in its chemical structure."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Weathering a owl:Class ;
    rdfs:label "Weathering"@en ;
    rdfs:comment "Weathering is a set of exogenic processes that causes the physical and chemical alteration of pre-existing rocks when they are exposed to atmospheric conditions. In the context of the Pre-Salt lacustrine system, this process occurs during periods of subaerial exposure caused by lake-level fall, leading to the formation of weathering profiles and paleosols on carbonate deposits. These resultant profiles are often characterized by fabric-destructive alteration, a clotted or granular texture, and diagenetic overprints such as dolomitization and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:ExogenicProcess .

georeservoir:GEORES_0000018 a owl:Class ;
    rdfs:label "fossil"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "sedimentary environment"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "sedimentary facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

georeservoir:GEORES_0000030 a owl:Class ;
    rdfs:label "facies association"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

presalt:Bivalve a owl:Class ;
    rdfs:label "Bivalve"@en ;
    rdfs:comment "Bivalve is a class of aquatic mollusk that possesses a shell composed of two hinged valves. In the Brazilian Pre-Salt, bivalves are the dominant bioclasts forming lacustrine coquina reservoirs, with endemic genera such as _Desertella_ and _Kobayashites_ being characteristic. Their shells are typically found disarticulated and fragmented, and their common dissolution is a primary mechanism for creating significant moldic and vuggy porosity."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000018 .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "Carbonate Reservoir"@en ;
    rdfs:comment "A carbonate reservoir is a subsurface geological formation composed of carbonate rocks that possesses sufficient porosity and permeability to store and transmit economically viable quantities of hydrocarbons. These reservoirs are characterized by extreme geological complexity and heterogeneity resulting from complex depositional and diagenetic histories, which in the Brazilian Pre-Salt includes unique lacustrine facies like coquinas and microbialites, often leading to significant reservoir compartmentalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        presalt:Reservoir .

presalt:ContinentalSiliciclastic a owl:Class ;
    rdfs:label "Continental Siliciclastic"@en ;
    rdfs:comment "Continental siliciclastic is a class of sedimentary deposit or rock that is composed predominantly of silicate minerals and rock fragments derived from the erosion of land areas and deposited in non-marine environments. In the context of the Brazilian Pre-Salt, these deposits typically consist of quartz, feldspar, mica, and clay minerals sourced from basement rocks and are characteristic of the rift phase, often occurring interbedded or mixed with lacustrine carbonates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:RiftPhase ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        georeservoir:GEORES_0000032 .

presalt:Deformation a owl:Class ;
    rdfs:label "Deformation"@en ;
    rdfs:comment "Deformation is a structural process that changes the shape, size, or orientation of a rock body in response to applied tectonic stress. In the Brazilian Pre-Salt, this process is primarily associated with oblique extensional rifting, where interaction with pre-existing basement fabrics creates a complex structural architecture of faults and grabens that control reservoir geometry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Basement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

presalt:EvaporiteMineral a owl:Class ;
    rdfs:label "Evaporite Mineral"@en ;
    rdfs:comment "An Evaporite Mineral is a water-soluble mineral salt that precipitates from a concentrated aqueous solution due to evaporation."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Gas a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:comment "Gas is a fluid phase that consists of a mixture of low-molecular-weight hydrocarbons and non-hydrocarbon components existing under reservoir conditions. In the Brazilian Pre-Salt, it is typically an oil-associated thermogenic fluid, often containing high concentrations of carbon dioxide (CO2), whose composition is used to assess the thermal maturity of the petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Reservoir ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Hydrocarbon ],
        presalt:Hydrocarbon .

presalt:GrainSupportedCarbonateRock a owl:Class ;
    rdfs:label "Grain-Supported Carbonate Rock"@en ;
    rdfs:comment "Grain-Supported Carbonate Rock is a carbonate rock in which the grains are in contact and form a self-supporting framework."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:HostRock a owl:Class ;
    rdfs:label "Host Rock"@en ;
    rdfs:comment "Host rock is a pre-existing rock body that is subsequently altered, fractured, or intruded by geological materials or fluids. In Pre-Salt carbonates, this is the original rock, such as a coquina or shrubstone, that undergoes diagenetic replacement like silicification or contains later features such as mineral-filled veins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:MudSupportedCarbonateRock a owl:Class ;
    rdfs:label "Mud-Supported Carbonate Rock"@en ;
    rdfs:comment "Mud-Supported Carbonate Rock is a carbonate rock in which the grains are not in contact and are supported by a mud matrix."@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:NormalFault a owl:Class ;
    rdfs:label "Normal Fault"@en ;
    rdfs:comment "A normal fault is a dip-slip fault that accommodates crustal extension, where the hanging wall block moves downward relative to the footwall block. In the Brazilian Pre-Salt basins, these faults are fundamental rift-related structures that often strike NE-SW to N-S, compartmentalize crustal blocks, and bound half-grabens. They occur at scales ranging from centimeters in core samples to kilometers in length and displacement, and their activity can be syndepositional, influencing the stratigraphy and creating structural traps."@en ;
    rdfs:subClassOf presalt:Fault .

presalt:Oil a owl:Class ;
    rdfs:label "Oil"@en ;
    rdfs:comment "Oil is a naturally occurring liquid hydrocarbon fluid that accumulates in subsurface geological traps and is the primary target for commercial extraction in a petroleum system. Within the Brazilian Pre-Salt, it is a reservoir fluid characterized by specific pressure gradients and compositional properties, allowing its volume to be quantified above an oil-water contact. This fluid is produced in significant quantities from the deep-water carbonate reservoirs, representing a major component of Brazil's energy production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Hydrocarbon ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Reservoir ],
        presalt:Hydrocarbon .

presalt:Ostracod a owl:Class ;
    rdfs:label "Ostracod"@en ;
    rdfs:comment "Ostracod is an aquatic crustacean that is characterized by a bivalved carapace and serves as a primary biostratigraphic marker in nonmarine Pre-Salt successions. Due to their tolerance for stressed lacustrine environments with high salinity or greater water depth, their presence is a key paleoenvironmental indicator. As a rock-forming component, their shells accumulate to form ostracod-rich wackestones, packstones, and grainstones, which can be subject to diagenetic alteration like dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        georeservoir:GEORES_0000018 .

presalt:PoreSystem a owl:Class ;
    rdfs:label "Pore System"@en ;
    rdfs:comment "Pore system is the totality of pore space within a rock volume that is characterized by the collective distribution, connectivity, and geometric attributes of all constituent voids. In Pre-Salt carbonates, this system is typically complex and multiscale, resulting from the interplay of depositional fabrics and subsequent diagenetic processes, which ultimately governs the rock's petrophysical properties such as porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Pore ],
        georeservoir:GEOCORE_0000004 .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "Pre-Salt Reservoir"@en ;
    rdfs:comment "A pre-salt reservoir is a petroleum reservoir that is stratigraphically located beneath a thick evaporite layer and composed of carbonate rocks deposited during syn-rift to post-rift tectonic phases. These reservoirs, characteristic of the Brazilian continental margin, are typically formed in lacustrine environments and consist of complex facies such as microbialites, coquinas, and intraclastic deposits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        georeservoir:GEOCORE_0000001 .

presalt:StructuralBodyOfRock a owl:Class ;
    rdfs:label "Structural Body of Rock"@en ;
    rdfs:comment "A Structural Body of Rock is a body of rock defined by its geometry and position resulting from tectonic or deformational processes."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

presalt:TectonicActivity a owl:Class ;
    rdfs:label "Tectonic Activity"@en ;
    rdfs:comment "Tectonic activity is a geological process that involves the deformation of the Earth's crust through faulting and folding. In the context of the Brazilian Pre-Salt, this activity, primarily expressed as fault reactivation and movement, is a critical control on the creation of accommodation space and the development of structural highs. Consequently, it directly influences the thickness, distribution, and facies architecture of key carbonate reservoir intervals such as the Barra Velha Formation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Deformation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:FaultReactivation ],
        georeservoir:GEOCORE_0000002 .

presalt:TectonoStratigraphicProcess a owl:Class ;
    rdfs:label "Tectono-Stratigraphic Process"@en ;
    rdfs:comment "A Tectono-Stratigraphic Process is a geological process that defines a major phase of basin evolution characterized by a distinct tectonic regime and resulting stratigraphic architecture."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000009 a owl:Class ;
    rdfs:label "earth fluid"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000006 a owl:Class ;
    rdfs:label "architectural element"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000062 a owl:ObjectProperty ;
    rdfs:label "preceded by"@en .

presalt:CarbonateMud a owl:Class ;
    rdfs:label "Carbonate Mud"@en ;
    rdfs:comment "Carbonate mud is a fine-grained sedimentary material that serves as a matrix between larger grains or forms discrete beds and is composed of a variable mixture of calcite, clay minerals, dolomite, and silica. In the Brazilian Pre-Salt, it is commonly deposited in lacustrine environments during periods of high lake level, often forming finely laminated deposits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:ClayMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        presalt:CarbonateSediment .

presalt:Grainstone a owl:Class ;
    rdfs:label "Grainstone"@en ;
    rdfs:comment "Grainstone is a grain-supported sedimentary carbonate rock that is characterized by the absence of a mud matrix and, in the context of the Brazilian Pre-Salt, is defined by having over 50% reworked components. Typically formed by the reworking of deposits like spherulitestones and shrubstones in high-energy lacustrine shoreline environments, its constituent grains include spherulites, peloids, bioclasts, and fragments of shrubs or volcanic rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Spherulitestone ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Shrubstone ],
        presalt:GrainSupportedCarbonateRock .

presalt:InterparticlePorosity a owl:Class ;
    rdfs:label "Interparticle Porosity"@en ;
    rdfs:comment "Interparticle porosity is a type of primary porosity that consists of the void spaces between the constituent grains or particles of a sedimentary rock. In Brazilian Pre-Salt carbonates, it is predominantly associated with reworked facies like calcarenites and calcirudites and is a major contributor to high reservoir permeability. This porosity can be enhanced by dissolution but is often reduced by diagenetic processes such as compaction and cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Compaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Cementation ],
        bfo:BFO_0000019 .

presalt:Mudstone a owl:Class ;
    rdfs:label "Mudstone"@en ;
    rdfs:comment "Mudstone is a mud-supported carbonate rock that is composed of less than 10% grains suspended in a carbonate mud matrix. Within Pre-Salt lacustrine systems, these rocks display significant mineralogical variation, including Mg-clay, siliceous, and dolomitic types, and can function as organic-rich source rocks or, when associated with features like spherulites, as intervals with reservoir potential."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMud ],
        presalt:MudSupportedCarbonateRock .

presalt:Peloid a owl:Class ;
    rdfs:label "Peloid"@en ;
    rdfs:comment "A peloid is a small carbonate grain, typically silt to fine sand in size, that is composed of micrite and lacks any discernible internal structure. Within the Brazilian Pre-Salt, these grains are commonly interpreted as micritized intraclasts and are a primary component of reservoir facies such as peloidal grainstones and packstones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Grainstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Micrite ],
        presalt:SedimentaryGrain .

presalt:PetrophysicalProperty a owl:Class ;
    rdfs:label "Petrophysical Property"@en ;
    rdfs:comment "A Petrophysical Property is a reservoir property that quantifies the characteristics of a rock related to its ability to store and transmit fluids."@en,
        "A petrophysical property is a quantifiable physical attribute of a rock that is used for formation evaluation and to characterize its capacity to store and transmit fluids. The main properties for reservoir management are porosity, permeability, and water saturation, which are critical for understanding fluid storage and flow. These properties are often influenced by diagenetic processes and can be estimated through the integration of well logs and rock sample data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000019,
        presalt:ReservoirProperty .

presalt:ReservoirProperty a owl:Class ;
    rdfs:label "Reservoir Property"@en ;
    rdfs:comment "A reservoir property is a measurable physical, petrophysical, or fluid characteristic that is used to describe and quantify the state, quality, and behavior of a subsurface rock formation. Key properties include rock attributes like porosity and permeability, which define the permo-porous system, and fluid attributes such as composition, pressure, and temperature (PVT). These properties are critical for understanding reservoir heterogeneity and are often estimated from well logs, core data, and seismic attributes to model fluid distribution and flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Fluid ],
        bfo:BFO_0000019 .

presalt:ReservoirRock a owl:Class ;
    rdfs:label "Reservoir Rock"@en ;
    rdfs:comment "Reservoir rock is a subsurface rock unit that possesses sufficient porosity and permeability to store and transmit fluids. In the Brazilian Pre-Salt, these are predominantly lacustrine carbonates, such as bioclastic limestones (coquinas), shrubstones, and spherulitestones, whose reservoir properties are highly heterogeneous and strongly controlled by diagenetic processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:SedimentaryBasin a owl:Class ;
    rdfs:label "Sedimentary Basin"@en ;
    rdfs:comment "A sedimentary basin is a large-scale depression in the Earth's crust that is formed by tectonic processes and serves as a site for the long-term accumulation of sediments. These sedimentary sequences are deposited on a crystalline basement, with their evolution often governed by distinct tectonic phases, such as the rift and drift stages that formed the Brazilian offshore basins and host significant hydrocarbon accumulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Rift ],
        georeservoir:GEORES_0000039 .

presalt:SedimentaryGrain a owl:Class ;
    rdfs:label "Sedimentary Grain"@en ;
    rdfs:comment "A Sedimentary Grain is a particle of Earth material that has been transported and deposited by a fluid medium."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Silica a owl:Class ;
    rdfs:label "Silica"@en ;
    rdfs:comment "Silica is an authigenic mineral phase composed of silicon dioxide that occurs in Pre-Salt carbonates as a replacement of the host rock, as pore-lining and pore-filling cements, or as primary chemical precipitates. Occurring in multiple generations (e.g., microcrystalline quartz, chalcedony) from syndepositional to late diagenetic, these silicified intervals are strongly associated with the development of non-matrix porosity and zones of excess permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:HostRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Cementation ],
        presalt:Mineral .

presalt:Silicification a owl:Class ;
    rdfs:label "Silicification"@en ;
    rdfs:comment "Silicification is a diagenetic process that replaces host rock minerals, such as calcium carbonate and magnesium-clays, through their dissolution and the concurrent precipitation of silica. In the Brazilian Pre-Salt lacustrine carbonates, this process manifests as various silica forms, including microcrystalline quartz and chalcedony, which can substitute the rock matrix or cement pore spaces. Occurring from early to late diagenesis, silicification significantly alters reservoir quality, often negatively, by occluding pore space and reducing permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HostRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        presalt:DiageneticProcess .

presalt:TectonoStratigraphicInterval a owl:Class ;
    rdfs:label "Tectono-Stratigraphic Interval"@en ;
    rdfs:comment "A Tectono-stratigraphic Interval is a geological time interval defined by a distinct package of sedimentary and/or volcanic rocks deposited during a specific tectonic regime."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

presalt:Bioclast a owl:Class ;
    rdfs:label "Bioclast"@en ;
    rdfs:comment "A bioclast is a sedimentary particle that is composed of the fragmented or whole skeletal remains of organisms. In the Brazilian Pre-Salt, these particles are predominantly derived from bivalves, ostracods, and gastropods, with minor occurrences of phosphatic fragments. Bioclasts often occur in a fragmented state and can be subject to significant diagenetic alteration, such as dolomitization or silicification, forming the primary framework of bioclastic reservoir rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Ostracod ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticAlteration ],
        georeservoir:GEORES_0000031 .

presalt:DiageneticBody a owl:Class ;
    rdfs:label "Diagenetic Body"@en ;
    rdfs:comment "A Diagenetic Body is a body of rock or mineral that forms within a sediment or sedimentary rock during or after deposition."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

presalt:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "A fault is a planar or curviplanar geological fracture that exhibits measurable displacement of adjacent rock blocks as a result of tectonic stresses. In the Brazilian Pre-Salt, faults are classified into sets based on their orientation, length, and age, serving to compartmentalize reservoirs into distinct structural domains. These structures and their associated influence zones, which contain dense fracture networks, are a primary control on the development of non-matrix porosity and permeability."@en ;
    rdfs:subClassOf presalt:Fracture .

presalt:Fluid a owl:Class ;
    rdfs:label "Fluid"@en ;
    rdfs:comment "Fluid is a substance that occupies the pore space of a reservoir rock and is characterized by its composition, physical properties, and mobility. In the context of petroleum reservoirs, fluids primarily consist of hydrocarbons (oil and gas) and water, which are classified based on their mobility within the pore network as either free fluid or bound fluid. The analysis of fluid properties, such as composition and pressure-volume-temperature (PVT) behavior, is essential for reservoir characterization and production forecasting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Hydrocarbon ],
        georeservoir:GEOCORE_0000009 .

presalt:Hydrocarbon a owl:Class ;
    rdfs:label "Hydrocarbon"@en ;
    rdfs:comment "Hydrocarbon is a naturally occurring organic compound that consists primarily of hydrogen and carbon atoms, forming the principal constituent of petroleum, including crude oil and natural gas. Generated from the thermal maturation of organic matter, these compounds migrate and accumulate in geological traps, such as the lacustrine carbonate reservoirs of the Brazilian Pre-Salt, where they form commercially significant accumulations subject to exploration and production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        georeservoir:GEOCORE_0000009 .

presalt:LacustrineCarbonate a owl:Class ;
    rdfs:label "Lacustrine Carbonate"@en ;
    rdfs:comment "Lacustrine carbonate is a carbonate rock that is formed by chemical, biochemical, or detrital processes within a lake environment, with its genesis controlled by local factors such as tectonics, climate, and water chemistry rather than global marine conditions. In the Brazilian Pre-Salt, these rocks were deposited in extensive rift-related saline or brackish lakes and are characterized by unusual textures, such as shrubs and spherulites, forming world-class hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrub ],
        presalt:ContinentalCarbonate .

presalt:LacustrineSystem a owl:Class ;
    rdfs:label "Lacustrine System"@en ;
    rdfs:comment "A lacustrine system is a depositional system that encompasses the physical, chemical, and biological components and processes associated with a lake or a series of interconnected lakes. In the context of the Brazilian Pre-Salt, this refers to the vast, alkaline, and chemically stratified depositional environment of the Aptian South Atlantic where complex microbial and abiotic carbonate accumulations formed. The immense scale and internal stratification of this system distinguish it from typical lacustrine environments, with depositional changes often driven by internal processes rather than lake-level fluctuations."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

presalt:PoreSpace a owl:Class ;
    rdfs:label "Pore Space"@en ;
    rdfs:comment "Pore Space is an immaterial entity representing the void volume within a rock or sediment that can contain fluids."@en,
        "Pore space is the void volume within a rock or sediment that is not occupied by solid mineral constituents and is capable of storing and transmitting fluids. In Pre-Salt carbonates, this volume comprises a complex network of primary pores (e.g., interparticle, growth-framework) and secondary pores (e.g., vugs, fractures), which are significantly modified by diagenetic processes like dissolution that enhances space and cementation that reduces it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000024 .

presalt:Quartz a owl:Class ;
    rdfs:label "Quartz"@en ;
    rdfs:comment "Quartz is a tectosilicate mineral that, within the Pre-Salt context, occurs as both a detrital component and a significant authigenic phase replacing precursor carbonate minerals. As a diagenetic product, it presents various textures such as microcrystalline, macrocrystalline, prismatic, and botryoidal, often filling porosity, fractures, and replacing grains or dolomite crystals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        presalt:Silica .

presalt:RiftPhase a owl:Class ;
    rdfs:label "Rift Phase"@en ;
    rdfs:comment "Rift phase is the initial tectonostratigraphic stage of sedimentary basin evolution that is characterized by active continental extension, crustal thinning, and fault-controlled subsidence. This stage is associated with significant volcanism and the creation of graben and half-graben structures, which accommodate the deposition of syn-rift lacustrine sediments such as organic-rich source rocks and bioclastic carbonates. In the Brazilian Pre-Salt basins, this phase is commonly subdivided into distinct stages (e.g., syn-rift I and II) based on contrasting tectonic strain and depositional patterns."@en ;
    rdfs:subClassOf presalt:TectonoStratigraphicInterval .

georeservoir:GEOCORE_0000014 a owl:ObjectProperty ;
    rdfs:label "generated in"@en .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000063 a owl:ObjectProperty ;
    rdfs:label "precedes"@en .

presalt:DiageneticAlteration a owl:Class ;
    rdfs:label "Diagenetic Alteration"@en ;
    rdfs:comment "Diagenetic alteration is the set of all physical, chemical, and biological processes that modify the mineralogy, texture, and fabric of a sedimentary rock after deposition and prior to the onset of metamorphism. In the Brazilian Pre-Salt, these alterations are often intense, including dissolution, dolomitization, and silicification driven by hydrothermal fluids and burial, which critically control reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEOCORE_0000002 .

presalt:Erosion a owl:Class ;
    rdfs:label "Erosion"@en ;
    rdfs:comment "Erosion is a geological process that removes and transports pre-existing rock and sediment from a land surface by natural agents such as water or wind. In the context of Brazilian Pre-Salt lacustrine carbonates, this process is frequently driven by subaerial exposure during lake-level lowstands, leading to the breakdown of microbial carbonates and the generation of reworked sediments. On a basin scale, these erosional events create significant unconformities, identifiable on seismic data by the truncation of underlying strata, which mark major stratigraphic boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:SubaerialExposure ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MicrobialCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        presalt:ExogenicProcess .

presalt:Intraclast a owl:Class ;
    rdfs:label "Intraclast"@en ;
    rdfs:comment "An intraclast is a sedimentary clast that is composed of a reworked fragment of penecontemporaneous, semi-lithified carbonate sediment eroded from within the same depositional basin. In the Brazilian Pre-Salt, these clasts are typically derived from characteristic lacustrine facies such as spherulitestones, shrubstones, and laminated carbonates, exhibiting a wide range of sizes from sand to pebble. They display variable shapes from angular to well-rounded and are often diagenetically altered by dolomitization or silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateSediment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        presalt:SedimentaryClast .

presalt:Reservoir a owl:Class ;
    rdfs:label "Reservoir"@en ;
    rdfs:comment "A reservoir is a subsurface rock unit that possesses sufficient porosity and permeability to store and transmit economically significant quantities of hydrocarbons. In the Brazilian Pre-Salt, these are typically lacustrine carbonate rocks, such as coquinas, whose quality and heterogeneity are controlled by depositional cycles and subsequent diagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Shrub a owl:Class ;
    rdfs:label "Shrub"@en ;
    rdfs:comment "A shrub is a calcitic crystal aggregate that is characterized by a fan-like morphology composed of fibrous to coarse bladed, fascicular-optic calcite crystals growing divergently away from a substrate. These aggregates range from millimeters to several centimeters in size and often grow in parallel, coalescing to form extensive horizontal layers or low domal structures that are a key component of Pre-Salt reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticBody .

presalt:Stevensite a owl:Class ;
    rdfs:label "Stevensite"@en ;
    rdfs:comment "Stevensite is an aluminum-poor, magnesium-rich smectitic clay that precipitates chemically in the highly alkaline (pH > 9) and silica-rich lacustrine environments characteristic of the Pre-Salt. In these deposits, it commonly occurs as laminated aggregates, coatings, ooids, or peloids and is diagenetically unstable, serving as a precursor for dolomite and a major source of silica for quartz cement upon dissolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Quartz ],
        presalt:ClayMineral .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en .

presalt:ClayMineral a owl:Class ;
    rdfs:label "Clay Mineral"@en ;
    rdfs:comment "A clay mineral is a hydrous phyllosilicate mineral that is characterized by a particle size of less than 2 micrometers and a sheet-like crystal structure. In the Brazilian Pre-Salt lacustrine carbonates, these are predominantly authigenic, aluminum-free magnesium silicates, such as kerolite, stevensite, and sepiolite, which formed in sub-littoral zones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        presalt:Mineral .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

bfo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en .

georeservoir:GEOCORE_0000003 a owl:Class ;
    rdfs:label "geological age"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

georeservoir:GEORES_0000003 a owl:Class ;
    rdfs:label "lithostratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

presalt:Cementation a owl:Class ;
    rdfs:label "Cementation"@en ;
    rdfs:comment "Cementation is a diagenetic process that involves the precipitation of authigenic minerals from pore fluids into the void spaces of a sediment or rock, binding the grains together. In Brazilian Pre-Salt carbonate reservoirs, this process commonly involves minerals such as calcite, dolomite, and quartz, which typically reduce or occlude porosity. However, certain types of cement, such as early siliceous rims, can also preserve reservoir quality by enhancing the rock's resistance to mechanical compaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:Pore ],
        presalt:DiageneticProcess .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "Lacustrine Environment"@en ;
    rdfs:comment "A lacustrine environment is a continental depositional environment that encompasses the physical, chemical, and biological conditions and processes occurring within a lake and its associated margins. Within the Brazilian Pre-Salt context, these environments were typically alkaline and saline, characterized by the chemical precipitation of carbonates and magnesian clays, and the development of distinct sub-environments such as littoral, sublittoral, and profundal zones. The deposits formed in these settings, including microbialites and bioclastic limestones, constitute the primary reservoir rocks of the Pre-Salt succession."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Salinity ],
        georeservoir:GEORES_0000021 .

georeservoir:GEOCORE_0000011 a owl:Class ;
    rdfs:label "geological boundary"@en ;
    rdfs:subClassOf bfo:BFO_0000146 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

presalt:Dissolution a owl:Class ;
    rdfs:label "Dissolution"@en ;
    rdfs:comment "Dissolution is a diagenetic process that removes mineral material from a rock through fluid-rock interaction, creating or enhancing porosity. In Pre-Salt lacustrine carbonates, it is a primary mechanism for generating secondary pores by affecting components like Mg-clays, spherulites, and shrubs, and can release ions that influence subsequent diagenetic events such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:DiageneticProcess .

presalt:Dolomite a owl:Class ;
    rdfs:label "Dolomite"@en ;
    rdfs:comment "Dolomite is an anhydrous carbonate mineral with the chemical formula CaMg(CO₃)₂ that occurs extensively in Brazilian Pre-Salt reservoirs as a primary precipitate, a diagenetic replacement phase, and a pore-filling cement. In these lacustrine successions, it presents diverse morphologies, including rhombohedral, saddle, and microcrystalline forms, and is a major constituent of facies such as laminites and spherulite-rich claystones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Replacement ],
        presalt:CarbonateMineral .

presalt:Mineral a owl:Class ;
    rdfs:label "Mineral"@en ;
    rdfs:comment "A Mineral is a naturally occurring, solid chemical substance with a well-defined crystal structure and a specific chemical composition."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

presalt:Dolomitization a owl:Class ;
    rdfs:label "Dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that replaces pre-existing minerals, such as calcite or stevensite, with the mineral dolomite. In the Brazilian Pre-Salt, this process is a critical control on reservoir quality, with late-stage dolomitization associated with fracturing often enhancing porosity and permeability by creating an intercrystalline pore network. Conversely, early or total dolomitization can sometimes reduce reservoir quality by decreasing pore throat sizes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticProcess .

presalt:Pore a owl:Class ;
    rdfs:label "Pore"@en ;
    rdfs:comment "A pore is a void space within a rock that contributes to the rock's total porosity and can store and transmit fluids. In carbonate reservoirs like the Brazilian Pre-Salt, pores are formed and modified by complex depositional and diagenetic processes, resulting in a heterogeneous, multi-scale system of voids whose size, geometry, and connectivity control reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        bfo:BFO_0000029 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000005 a owl:Class ;
    rdfs:label "geological time interval"@en ;
    rdfs:subClassOf bfo:BFO_0000038 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

georeservoir:GEORES_0000004 a owl:Class ;
    rdfs:label "formation"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000003 .

bfo:BFO_0000117 a owl:ObjectProperty ;
    rdfs:label "has occurrent part"@en .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:comment "A carbonate mineral is a mineral that is chemically characterized by the presence of the carbonate anion (CO₃²⁻) in its crystal structure. In the Brazilian Pre-Salt reservoirs, the principal carbonate minerals are calcite and dolomite, which form the primary framework of the reservoir rocks. These minerals are observed in various forms, including magnesian calcite, fascicular calcite, and different generations of dolomite such as rhombohedral and saddle dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        presalt:Mineral .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "Diagenetic Process"@en ;
    rdfs:comment "A diagenetic process is any physical, chemical, or biological alteration that modifies sedimentary deposits after initial deposition and before the onset of metamorphism. In Brazilian Pre-Salt carbonates, key processes include dissolution, cementation, replacement (dolomitization and silicification), and recrystallization, which fundamentally control the evolution of reservoir porosity and permeability. These alterations are driven by changes in fluid chemistry, temperature, and pressure, often occurring in distinct stages from syngenesis through eodiagenesis and mesodiagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        georeservoir:GEOCORE_0000002 .

presalt:Calcite a owl:Class ;
    rdfs:label "Calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral (CaCO₃) that is a major rock-forming constituent within the Brazilian Pre-Salt successions. In this lacustrine setting, it occurs both as primary precipitates forming spherulitic and fascicular fabrics, and as a later diagenetic cement with blocky, macrocrystalline, or poikilotopic habits. As a diagenetic product, it fills various pore types including interparticle, vugular, and fracture porosity, but is also frequently subject to dissolution, which can create or enhance reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:CarbonateMineral .

georeservoir:GEORES_0000031 a owl:Class ;
    rdfs:label "sediment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Shrub ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMud ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        georeservoir:GEOCORE_0000010 .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from"@en .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        georeservoir:GEOCORE_0000008 .

presalt:CarbonateRock a owl:Class ;
    rdfs:label "Carbonate Rock"@en ;
    rdfs:comment "Carbonate rock is a class of sedimentary rock that is composed of more than 50% carbonate minerals, principally calcite and dolomite. Characterized by high chemical reactivity, these rocks exhibit significant heterogeneity due to complex depositional and diagenetic processes, forming unique lacustrine types in the Brazilian Pre-Salt such as microbially-influenced shrubstones and chemically precipitated spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Heterogeneity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        georeservoir:GEORES_0000032 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 ;
    owl:disjointWith bfo:BFO_0000017 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf bfo:BFO_0000017 .

bfo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

bfo:BFO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en .

bfo:BFO_0000171 a owl:ObjectProperty ;
    rdfs:label "located in"@en .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

