# --- Azure AI Foundry (Azure OpenAI) Authentication ---
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com

# --- LLM generation settings (GPT-5.x reasoning models) ---
# reasoning_effort: none|minimal|low|medium|high  (gpt-5.4 defaults to none — set explicitly)
LLM_REASONING_EFFORT=high
# max_completion_tokens ceiling (covers reasoning + visible tokens)
LLM_MAX_OUTPUT_TOKENS=32000
# best-effort determinism seed (reasoning models do NOT support temperature)
LLM_SEED=42

# --- RAG Configuration ---
RAG_SEARCH_K=20
RAG_RERANK_K=5
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

# Directories
DOCS_DIR=inputs/

# LLM Term Extraction
LLM_EXTRACTION_MODEL=gpt-5.4      # Azure deployment name
# LLM_EXTRACTION_TEMPERATURE=0.0  # unused: GPT-5.x reasoning models ignore temperature
LLM_INPUT_DIR=inputs/
LLM_OUTPUT_FILE=output/extract_raw.json

# Aggregator
AGGREGATOR_OUTPUT_FILE=output/extract_aggregated.csv

# Filter
FILTERED_TERMS_OUTPUT=output/extract_filtered.csv
# Minimum number of source documents a term must appear in to be retained.
# For the 82-document Pre-Salt corpus, 5 ≈ 6% cross-document consensus.
MINIMUM_FREQUENCY_FILTER=5

# NLD Generation
LLM_GENERATION_MODEL=gpt-5.4      # Azure deployment name
# LLM_GENERATION_TEMPERATURE=0.0  # unused: GPT-5.x reasoning models ignore temperature
CONSOLIDATED_LLM_RESULTS_WITH_NLDS=output/define_nld.csv
OUTPUT_FAILURE_FILE=output/define_failures.csv
NLD_SLEEP_SECONDS=4

# Categorization
CATEGORIZED_LLM_TERMS=output/classify_categories.csv
BATCH_SIZE=5

# Ontology configuration (single source of truth) — see ontology_config.yaml
# ONTOLOGY_CONFIG_PATH=domains/presalt/ontology_config.yaml
# RELATION_PROVENANCE_TIERS=owl_axiom,bfo_shape_axiom,ro_release,critic_minted

# Validate lateral-coherence stage overrides (YAML defaults are true)
# LATERAL_HINTS_ENABLED=true
# LATERAL_CLASS_WORTHINESS_ENABLED=true
# LATERAL_FRAME_COMPLETION_ENABLED=true
# LATERAL_RELATION_SCOPE_ENABLED=true

# Relation Extraction (Step 6b)
RELATION_BATCH_SIZE=10
RELATION_CONFIDENCE_THRESHOLD=0.7

# OOPS! pitfall scanner (Step 7b Layer 3)
# Public endpoint or local Docker: docker run -d -p 8080:8080 mpovedavillalon/oops:v1
OOPS_URL=https://oops.linkeddata.es/rest
