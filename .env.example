# --- Gemini Authentication ---
# Option A: AI Studio (API key)
GEMINI_API_KEY=your-api-key-here

# Option B: Vertex AI (uncomment below, comment out GEMINI_API_KEY above)
# VERTEX_AI=true
# GCP_PROJECT=your-project-id
# GCP_LOCATION=us-central1

# --- RAG Configuration ---
RAG_SEARCH_K=20
RAG_RERANK_K=5
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

# Directories
DOCS_DIR=inputs/

# LLM Term Extraction
LLM_EXTRACTION_MODEL=gemini-2.5-pro
LLM_EXTRACTION_TEMPERATURE=0.0
LLM_INPUT_DIR=inputs/
LLM_OUTPUT_FILE=output/extract_raw.json

# Aggregator
AGGREGATOR_OUTPUT_FILE=output/extract_aggregated.csv

# Filter
FILTERED_TERMS_OUTPUT=output/extract_filtered.csv
# Minimum number of source documents a term must appear in to be retained.
# For an 80-document corpus, 3 = 3.75% cross-document consensus (thesis-defensible).
MINIMUM_FREQUENCY_FILTER=3

# NLD Generation
LLM_GENERATION_MODEL=gemini-2.5-pro
LLM_GENERATION_TEMPERATURE=0.0
CONSOLIDATED_LLM_RESULTS_WITH_NLDS=output/define_nld.csv
OUTPUT_FAILURE_FILE=output/define_failures.csv
NLD_SLEEP_SECONDS=4

# Categorization
CATEGORIZED_LLM_TERMS=output/classify_categories.csv
BATCH_SIZE=5

# Ontology configuration (single source of truth) — see ontology_config.yaml
# ONTOLOGY_CONFIG_PATH=ontology_config.yaml
# RELATION_PROVENANCE_TIERS=owl_axiom,bfo_shape_axiom,ro_release,critic_minted

# Relation Extraction (Step 6b)
RELATION_BATCH_SIZE=10
RELATION_CONFIDENCE_THRESHOLD=0.7

# OOPS! pitfall scanner (Step 7b Layer 3)
# Public endpoint or local Docker: docker run -d -p 8080:8080 mpovedavillalon/oops:v1
OOPS_URL=https://oops.linkeddata.es/rest
