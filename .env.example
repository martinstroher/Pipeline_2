# --- Gemini Authentication ---
# Option A: AI Studio (API key)
GEMINI_API_KEY=your-api-key-here

# Option B: Vertex AI (uncomment below, comment out GEMINI_API_KEY above)
# VERTEX_AI=true
# GCP_PROJECT=your-project-id
# GCP_LOCATION=us-central1

# --- RAG Configuration ---
RAG_SEARCH_K=20
RAG_RERANK_K=5
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

# Directories
DOCS_DIR=inputs/

# LLM Term Extraction
LLM_EXTRACTION_MODEL=gemini-2.5-pro
LLM_EXTRACTION_TEMPERATURE=0.0
LLM_INPUT_DIR=inputs/
LLM_OUTPUT_FILE=output/1_raw_llm_extraction.json

# Aggregator
AGGREGATOR_OUTPUT_FILE=output/2_aggregated_counts.csv

# Filter
FILTERED_TERMS_OUTPUT=output/3_filtered_top_terms.csv
# Minimum number of source documents a term must appear in to be retained.
# For an 80-document corpus, 3 = 3.75% cross-document consensus (thesis-defensible).
MINIMUM_FREQUENCY_FILTER=3

# NLD Generation
LLM_GENERATION_MODEL=gemini-2.5-pro
LLM_GENERATION_TEMPERATURE=0.0
CONSOLIDATED_LLM_RESULTS_WITH_NLDS=output/4_nld_generated_definitions.csv
OUTPUT_FAILURE_FILE=output/4_nld_generation_failures.csv
NLD_SLEEP_SECONDS=4

# Categorization
CATEGORIZED_LLM_TERMS=output/5_categorized_ontology.csv
GEORESERVOIR_DEFS_PATH=resources/georeservoir-definitions.txt
GEOCORE_DEFS_PATH=resources/geocore-definitions.txt
BFO_DEFS_PATH=resources/bfo-definitions.txt
BATCH_SIZE=5
