@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Barrier a owl:Class ;
    rdfs:label "barrier"@en ;
    rdfs:comment "Barrier is a geological impediment that restricts or prevents the movement of fluids, such as hydrocarbons or water, within a subsurface petroleum system. In Pre-Salt reservoirs, faults can function as barriers, compartmentalizing hydrocarbon accumulations by juxtaposing permeable reservoir rocks against impermeable strata or by creating sealing zones through fault gouge or diagenetic cementation."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that is a primary constituent of carbonate reservoir rocks and can be replaced by dolomite during diagenesis. Its replacement by dolomite during dolomitization is a significant diagenetic process that often enhances reservoir porosity and permeability."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a type of petroleum reservoir rock that is composed of carbonate minerals such as calcite and dolomite. In the Brazilian Pre-Salt, microbialites formed by microbial communities are a primary reservoir facies within these rocks."@en ;
    rdfs:subClassOf presalt:PetroleumReservoirRock .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that alters the shape, size, or orientation of rock bodies. In Pre-Salt petroleum geology, it is fundamental to the formation of structural traps and is a key component of tectonic processes such as rifting, which shapes basin architecture."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Displacement a owl:Class ;
    rdfs:label "displacement"@en ;
    rdfs:comment "Displacement is a geological offset that occurs along a planar fracture in rock, known as a fault. This offset results from tectonic forces and can significantly impact the integrity of petroleum traps and fluid migration pathways within Pre-Salt reservoirs."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:DissolvedMineral a owl:Class ;
    rdfs:label "dissolved mineral"@en ;
    rdfs:comment "Dissolved mineral is a chemical substance that is present in solution within a fluid, typically water, and precipitates from evaporating water bodies to form chemical sedimentary rocks. In the Pre-Salt play, the precipitation of these minerals from evaporating lacustrine waters forms evaporites, which serve as regional seals."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that is formed by the diagenetic replacement of calcite. It is a key component of carbonate reservoir rocks, and its formation often enhances reservoir porosity and permeability, making it significant for Pre-Salt petroleum systems."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of calcite by dolomite. This process often enhances reservoir porosity and permeability, which is crucial for fluid storage and transmission in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf presalt:DiageneticProcess .

presalt:EvaporatingWaterBody a owl:Class ;
    rdfs:label "evaporating water body"@en ;
    rdfs:comment "An evaporating water body is a body of water that undergoes evaporation, leading to the precipitation of dissolved minerals. In the Pre-Salt play, these bodies are fundamental for the formation of evaporite deposits that act as regional seals."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies. In the Pre-Salt play, it acts as the regional seal."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:ExtensionalDeformation a owl:Class ;
    rdfs:label "extensional deformation"@en ;
    rdfs:comment "Extensional deformation is a geological process that involves the stretching and thinning of the lithosphere. It is a fundamental mechanism in tectonic rifting, which initiates the formation of sedimentary basins like those hosting the Brazilian Pre-Salt petroleum system."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock along which displacement has occurred. In Pre-Salt reservoirs, faults can serve as both migration pathways for hydrocarbons and as barriers, influencing fluid flow and trap integrity."@en ;
    rdfs:subClassOf presalt:PlanarFracture .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a substance that can flow and deform continuously under an applied shear stress, and in Pre-Salt petroleum geology, it primarily refers to the hydrocarbons (oil and natural gas) and formation water that are stored within and transmitted through reservoir rocks. The capacity of a rock to store and transmit these fluids is a key determinant of reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "Lacustrine environment is a continental depositional setting that is associated with lake systems. These environments are crucial in Pre-Salt petroleum geology as they host the deposition of microbialite carbonate reservoirs and associated source rocks."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:LakeSystem a owl:Class ;
    rdfs:label "lake system"@en ;
    rdfs:comment "A lake system is a continental depositional setting that is associated with lacustrine environments. These systems are characterized by standing bodies of water (lakes) and their surrounding areas, where sediments such as microbialites and evaporites accumulate, forming key components of Pre-Salt petroleum systems."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "Lithosphere is a rigid outermost layer of a planetary body that undergoes extensional deformation during tectonic processes such as rifting. It comprises the Earth's crust and the uppermost part of the mantle, playing a crucial role in plate tectonics and the formation of sedimentary basins."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:MicrobialCommunity a owl:Class ;
    rdfs:label "microbial community"@en ;
    rdfs:comment "A microbial community is an assemblage of microorganisms that forms sedimentary rocks called microbialites through its metabolic activity. In the context of Pre-Salt petroleum geology, these communities are responsible for the formation of microbialites, which constitute the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. It serves as the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "migration pathway"@en ;
    rdfs:comment "A migration pathway is a geological conduit that facilitates the movement of hydrocarbons through the subsurface. In Pre-Salt reservoirs, structural features such as faults commonly act as migration pathways, enabling petroleum to move from source rocks to traps."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that describes its capacity to transmit fluids. It is a primary control on reservoir quality, alongside porosity, and can be enhanced by diagenetic processes such as dolomitization in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. It is a primary control on reservoir quality, influencing a rock's capacity to store fluids, and can be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl .

presalt:PreSaltPlay a owl:NamedIndividual,
        georeservoir:GEOCORE_0000001 ;
    rdfs:label "pre-salt play"@en ;
    rdfs:comment "Pre-Salt play is a petroleum play that encompasses a specific combination of geological elements and processes leading to hydrocarbon accumulation, situated beneath a thick, regional evaporite seal in the Brazilian offshore basins. This play is characterized by lacustrine carbonate reservoirs (e.g., microbialites, coquinas) and associated siliciclastics, charged by lacustrine source rocks, and developed during the rift and sag phases of the South Atlantic opening."@en .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "pre-salt reservoir"@en ;
    rdfs:comment "Pre-salt reservoir is a petroleum reservoir rock that is stratigraphically located beneath a thick, regional layer of Aptian evaporites in the South Atlantic rift basins. These reservoirs are predominantly composed of lacustrine carbonates, such as microbialites, and are characterized by complex diagenetic overprints that often enhance porosity and permeability."@en ;
    rdfs:subClassOf presalt:PetroleumReservoirRock .

presalt:Precipitation a owl:Class ;
    rdfs:label "precipitation"@en ;
    rdfs:comment "Precipitation is a geological process that involves the formation of solid minerals from dissolved ions in a solution, often occurring in evaporating water bodies. In the Pre-Salt play, this process is crucial for the formation of evaporite rocks, which serve as the regional seal."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "A regional seal is a geological seal that functions as an impermeable barrier, preventing the vertical migration of hydrocarbons across a broad geographic area. In the Brazilian Pre-Salt play, this critical role is primarily performed by thick evaporite sequences, which are chemical sedimentary rocks formed by the precipitation of dissolved minerals from evaporating water bodies."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a geological facies that possesses the capacity to store and transmit hydrocarbons. In the Santos Basin Pre-Salt sequences, microbialite is a primary example of a reservoir facies, formed by the metabolic activity of microbial communities."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a composite property that describes a rock's capacity to store and transmit fluids. It is primarily controlled by porosity and permeability."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a tectonic process that involves extensional deformation of the lithosphere. This process is fundamental to the formation of sedimentary basins, such as those hosting the Brazilian Pre-Salt petroleum systems, by creating accommodation space for subsequent deposition."@en ;
    rdfs:subClassOf presalt:TectonicProcess .

presalt:RockLayer a owl:Class ;
    rdfs:label "rock layer"@en ;
    rdfs:comment "A rock layer is a geological unit that is a distinct, typically tabular body of rock within a stratigraphic sequence. These layers are subject to deformation by tectonic processes, which can create structural traps essential for hydrocarbon accumulation in Pre-Salt reservoirs. Specific rock layers, such as microbialites, function as primary reservoir facies, while evaporite layers serve as regional seals within the Pre-Salt play."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:RockVolume a owl:Class ;
    rdfs:label "rock volume"@en ;
    rdfs:comment "Rock volume is a physical property that represents the total three-dimensional space occupied by a rock mass. It encompasses both the solid mineral framework and any associated pore spaces. This parameter is crucial for calculating porosity, a fundamental indicator of reservoir storage capacity."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:SantosBasinPreSaltSequence a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "santos basin pre-salt sequence"@en ;
    rdfs:comment "The Santos Basin Pre-Salt sequence is a stratigraphic sequence that is located within the Santos Basin, positioned beneath the regional salt layer. It is characterized by lacustrine carbonate deposits, primarily microbialites, which serve as the main reservoir facies."@en .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "structural trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by the deformation of rock layers through tectonic processes. These traps often involve features like faults, which can act as both migration pathways and barriers for hydrocarbons in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

presalt:VoidSpace a owl:Class ;
    rdfs:label "void space"@en ;
    rdfs:comment "Void space is a volume within a rock that is not occupied by solid material. It represents the portion of the rock that can store fluids such as hydrocarbons and water, directly contributing to the rock's porosity and reservoir potential."@en ;
    rdfs:subClassOf bfo:BFO_0000006 .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "chemical sedimentary rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that forms from the precipitation of minerals from aqueous solutions. These rocks, exemplified by evaporites in the Pre-Salt play, are typically formed as dissolved minerals precipitate from evaporating water bodies, often serving as important seals in petroleum systems."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "A diagenetic process is a geological process that involves physical, chemical, and biological changes to a sedimentary rock after its deposition but before metamorphism. These processes, such as dolomitization, can significantly alter the rock's original characteristics, often enhancing or degrading reservoir properties like porosity and permeability."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "petroleum trap"@en ;
    rdfs:comment "Petroleum trap is a geological configuration that prevents the upward or lateral migration of hydrocarbons, leading to their accumulation in a reservoir rock. These traps can be structural, formed by tectonic deformation, or stratigraphic, and are typically sealed by impermeable layers such as the evaporites found in the Pre-Salt play."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:PlanarFracture a owl:Class ;
    rdfs:label "planar fracture"@en ;
    rdfs:comment "A planar fracture is a fracture in rock that exhibits a generally flat or planar geometry. Faults are a specific type of planar fracture characterized by measurable displacement along the fracture plane. In Pre-Salt reservoirs, these fractures, particularly faults, are significant structural features that can influence fluid flow by acting as either migration pathways or barriers."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en ;
    rdfs:comment "Tectonic process is a geological process that involves the deformation of the Earth's lithosphere. Such processes, like rifting, are fundamental in basin formation and can lead to the development of structural traps critical for petroleum accumulation."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "rock"@en ;
    rdfs:comment "Rock is a naturally occurring solid material that is typically composed of one or more minerals or mineraloids, forming the Earth's crust. In petroleum systems, rocks serve as the fundamental medium for hydrocarbon reservoirs, seals, and traps, with properties such as porosity and permeability dictating their capacity to store and transmit fluids."@en .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "Sedimentary Environment"@en ;
    rdfs:subClassOf bfo:BFO_0000006 .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "Sedimentary Facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

bfo:BFO_0000006 a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "carbonate mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that contains the carbonate ion (CO3^2-) as its fundamental anionic group. Common examples relevant to Pre-Salt petroleum geology include calcite (CaCO3) and dolomite (CaMg(CO3)2), which are the primary constituents of carbonate reservoir rocks."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:ContinentalDepositionalSetting a owl:Class ;
    rdfs:label "Continental Depositional Setting"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "petroleum reservoir rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a geological formation that possesses sufficient porosity and permeability to store and transmit hydrocarbons. In the Brazilian Pre-Salt, these rocks are predominantly carbonates, such as microbialites, where diagenetic processes like dolomitization often enhance their storage and flow capacity."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "Stratigraphic Unit"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:comment "Sedimentary rock is a type of rock that is formed from the accumulation and compaction of sediments, or by the precipitation of minerals from solution. In the Pre-Salt, significant examples include microbialites, formed by microbial activity, which serve as primary reservoir facies, and evaporites, formed by mineral precipitation from evaporating waters, which act as regional seals."@en .

presalt:PhysicalProperty a owl:Class ;
    rdfs:label "Physical Property"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "Geological Structure"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "Earth Material"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

