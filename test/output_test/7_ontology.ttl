@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that is a primary component of carbonate reservoir rocks in the Pre-Salt, and can be replaced by dolomite during the diagenetic process of dolomitization."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a type of petroleum reservoir rock that is composed of carbonate minerals such as calcite and dolomite."@en ;
    rdfs:subClassOf presalt:PetroleumReservoirRock .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that involves the alteration of rock layers or the lithosphere. It is caused by tectonic forces and can lead to the formation of structural traps, which are significant in Pre-Salt petroleum systems."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Displacement a owl:Class ;
    rdfs:label "displacement"@en ;
    rdfs:comment "Displacement is a movement or offset that occurs along a planar fracture in rock, such as a fault, resulting from tectonic processes."@en ;
    rdfs:subClassOf presalt:Movement .

presalt:DissolvedMineral a owl:Class ;
    rdfs:label "dissolved mineral"@en ;
    rdfs:comment "Dissolved mineral is a chemical component that is present in water bodies and precipitates from them during evaporation to form chemical sedimentary rocks, such as evaporites, which act as regional seals in the Pre-Salt play."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that is a component of carbonate reservoir rock. It is formed through dolomitization, a diagenetic process involving the replacement of calcite, which often enhances reservoir porosity and permeability."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of calcite by dolomite, often enhancing reservoir porosity and permeability."@en ;
    rdfs:subClassOf presalt:DiageneticProcess .

presalt:EvaporatingWaterBody a owl:Class ;
    rdfs:label "evaporating water body"@en ;
    rdfs:comment "Evaporating water body is a body of water that is undergoing a process of evaporation, leading to the concentration and precipitation of dissolved minerals that form evaporites, which act as regional seals in the Pre-Salt play."@en ;
    rdfs:subClassOf presalt:WaterBody .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies, acting as the regional seal in the Brazilian Pre-Salt play."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:ExtensionalDeformation a owl:Class ;
    rdfs:label "extensional deformation"@en ;
    rdfs:comment "Extensional deformation is a tectonic process that involves the lithosphere, leading to its stretching and thinning, and is characteristic of rifting."@en ;
    rdfs:subClassOf presalt:TectonicProcess .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock along which displacement has occurred. In the context of Pre-Salt reservoirs, it serves as both a migration pathway and a barrier for hydrocarbons."@en ;
    rdfs:subClassOf presalt:Barrier .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a substance that can be stored and transmitted within the pore spaces of reservoir rocks, with its capacity for storage and transmission being a key component of reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "Lacustrine environment is a continental depositional setting that is associated with lake systems."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:LakeSystem a owl:Class ;
    rdfs:label "lake system"@en ;
    rdfs:comment "Lake system is a continental depositional system that encompasses one or more lakes and their associated lacustrine environments."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSystem .

presalt:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "Lithosphere is the rigid outermost shell of a terrestrial planet, comprising the Earth's crust and uppermost mantle. It is a geological layer that undergoes extensional deformation during tectonic processes like rifting, which is fundamental to basin formation."@en ;
    rdfs:subClassOf presalt:GeologicalLayer .

presalt:MicrobialCommunity a owl:Class ;
    rdfs:label "microbial community"@en ;
    rdfs:comment "Microbial community is a group of microorganisms that, through its metabolic activity, forms sedimentary rocks such as microbialites, which serve as primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf presalt:MicroorganismGroup .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities, serving as the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf presalt:SedimentaryRock .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "migration pathway"@en ;
    rdfs:comment "Migration pathway is a geological conduit that facilitates the movement of fluids, particularly hydrocarbons, through subsurface rock formations. In Pre-Salt reservoirs, faults are identified as features that can serve as such pathways."@en ;
    rdfs:subClassOf presalt:SpatialRegion .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that describes its capacity to transmit fluids. It is a primary control on reservoir quality in Pre-Salt petroleum systems, often enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:PlanarFracture a owl:Class ;
    rdfs:label "planar fracture"@en ;
    rdfs:comment "Planar fracture is a fracture in rock that exhibits a relatively flat or planar geometry. A fault is a specific type of planar fracture along which displacement has occurred. In Pre-Salt reservoirs, such faults can serve as both migration pathways and barriers for hydrocarbons."@en ;
    rdfs:subClassOf presalt:Fracture .

presalt:Play a owl:Class ;
    rdfs:label "play"@en ;
    rdfs:comment "A play is a geological concept that defines a group of oil and gas accumulations or prospects within a specific region. It is characterized by a common set of critical geological elements, including source rock, reservoir rock, seal, and trap type, which collectively define a common exploration strategy. In the context of the Brazilian Pre-Salt, this refers to the overall petroleum system where specific elements, such as evaporites, act as regional seals."@en ;
    rdfs:subClassOf presalt:GeologicalConcept .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. It primarily controls a rock's capacity to store and transmit fluids, and can be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl .

presalt:PreSaltSequence a owl:Class ;
    rdfs:label "pre-salt sequence"@en ;
    rdfs:comment "Pre-salt sequence is a stratigraphic succession of sedimentary rocks that lies beneath a thick layer of Aptian evaporites in the Brazilian continental margin. These rocks were deposited during the rift and sag phases of the South Atlantic opening. They are characterized by lacustrine carbonates and siliciclastics, which host significant hydrocarbon reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "A regional seal is a geological formation that acts as a widespread, impermeable barrier to fluid migration. In the Brazilian Pre-Salt play, this function is primarily fulfilled by evaporites, which are chemical sedimentary rocks formed by the precipitation of dissolved minerals from evaporating water bodies."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000004 .

presalt:Reservoir a owl:Class ;
    rdfs:label "reservoir"@en ;
    rdfs:comment "Reservoir is a rock that possesses the capacity to store and transmit fluids, such as petroleum and natural gas. This capacity is primarily governed by its porosity and permeability, making it a fundamental component for hydrocarbon accumulation in geological settings like the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf presalt:FluidStorageRock .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a geological facies that serves as a petroleum reservoir, exemplified by microbialites in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a composite property that describes a rock's capacity to store and transmit fluids, primarily controlled by its porosity and permeability."@en ;
    rdfs:subClassOf presalt:CompositeProperty .

presalt:ReservoirRock a owl:Class ;
    rdfs:label "reservoir rock"@en ;
    rdfs:comment "Reservoir rock is a rock that has the capacity to store and transmit fluids, such as petroleum, with this capacity primarily controlled by its porosity and permeability."@en ;
    rdfs:subClassOf presalt:FluidStorageRock .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a tectonic process that involves extensional deformation of the lithosphere."@en ;
    rdfs:subClassOf presalt:TectonicProcess .

presalt:RockLayer a owl:Class ;
    rdfs:label "rock layer"@en ;
    rdfs:comment "Rock layer is a distinct body of rock that is characterized by relatively uniform lithological properties, often separated by bedding planes, and can be deformed by tectonic processes to form structural traps in Pre-Salt petroleum systems."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "structural trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by the deformation of rock layers through tectonic processes."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

presalt:VoidSpace a owl:Class ;
    rdfs:label "void space"@en ;
    rdfs:comment "Void space is a component of a rock's total volume that is not occupied by solid material, contributing to the rock's porosity."@en ;
    rdfs:subClassOf presalt:SpatialRegion .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

presalt:Barrier a owl:Class ;
    rdfs:label "barrier"@en ;
    rdfs:comment "Barrier is a geological feature, such as a fault, that impedes the migration of hydrocarbons within Pre-Salt reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "chemical sedimentary rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies, exemplified by evaporites which act as regional seals in the Pre-Salt play."@en ;
    rdfs:subClassOf presalt:SedimentaryRock .

presalt:CompositeProperty a owl:Class ;
    rdfs:label "composite property"@en ;
    rdfs:comment "A composite property is a property that describes a rock's capacity to store and transmit fluids, primarily controlled by porosity and permeability."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:ContinentalDepositionalSetting a owl:Class ;
    rdfs:label "continental depositional setting"@en ;
    rdfs:comment "Continental depositional setting is a depositional environment that is characterized by processes occurring on land or in inland water bodies, exemplified by the lacustrine systems prominent in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:ContinentalDepositionalSystem a owl:Class ;
    rdfs:label "Continental Depositional System"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "Diagenetic process is a geological process that involves post-depositional changes to sediments or rocks, exemplified by the replacement of calcite by dolomite, often enhancing reservoir porosity and permeability."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Fracture a owl:Class ;
    rdfs:label "Fracture"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:GeologicalConcept a owl:Class ;
    rdfs:label "Geological Concept"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

presalt:GeologicalLayer a owl:Class ;
    rdfs:label "Geological Layer"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:MicroorganismGroup a owl:Class ;
    rdfs:label "Microorganism Group"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

presalt:Movement a owl:Class ;
    rdfs:label "Movement"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "Petroleum Reservoir Rock"@en ;
    rdfs:subClassOf presalt:SedimentaryRock .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "petroleum trap"@en ;
    rdfs:comment "Petroleum trap is a geological configuration that allows for the accumulation and retention of hydrocarbons in the subsurface. It typically involves a porous reservoir rock, an impermeable seal rock, and a structural or stratigraphic arrangement that prevents further migration."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Rock a owl:Class ;
    rdfs:label "rock"@en ;
    rdfs:comment "Rock is a naturally occurring solid material that forms the Earth's crust, composed of one or more minerals. In Pre-Salt petroleum geology, it is often a sedimentary material, such as microbialite or evaporite, characterized by physical properties like porosity and permeability that dictate its capacity to store and transmit fluids. These materials can form layers that are deformed into structural traps, or function as petroleum reservoirs or seals."@en .

presalt:WaterBody a owl:Class ;
    rdfs:label "Water Body"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "Earth Material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "Rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000004 a owl:Class ;
    rdfs:label "Formation"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000020 a owl:Class ;
    rdfs:label "Depositional System"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "Sedimentary Environment"@en ;
    rdfs:subClassOf bfo:BFO_0000006 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "Sedimentary Rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "carbonate mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that composes carbonate reservoir rocks, exemplified by calcite and dolomite."@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:FluidStorageRock a owl:Class ;
    rdfs:label "Fluid Storage Rock"@en ;
    rdfs:subClassOf presalt:Rock .

presalt:Mineral a owl:Class ;
    rdfs:label "Mineral"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

presalt:PhysicalProperty a owl:Class ;
    rdfs:label "physical property"@en ;
    rdfs:comment "Physical property is a characteristic of rock that can be measured or observed, such as porosity or permeability, which are fundamental in determining reservoir quality and the capacity of rocks to store and transmit fluids in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:SpatialRegion a owl:Class ;
    rdfs:label "Spatial Region"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en ;
    rdfs:comment "Tectonic process is a geological process that involves the deformation of the Earth's lithosphere, such as extensional deformation during rifting, and is responsible for forming structural traps in petroleum systems."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "Stratigraphic Unit"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:SedimentaryRock a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:comment "Sedimentary rock is a type of rock that is formed by processes such as the metabolic activity of microbial communities or the precipitation of dissolved minerals from evaporating water bodies. Examples relevant to the Pre-Salt include microbialites, which serve as primary reservoir facies, and evaporites, which act as regional seals."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "Geological Process"@en .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "Geological Structure"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000011 .

