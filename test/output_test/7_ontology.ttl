@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bfo:BFO_0000002 owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000004 owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000040 owl:disjointWith bfo:BFO_0000141 .

presalt:Barrier a owl:Class ;
    rdfs:label "barrier"@en ;
    rdfs:comment "Barrier is a geological feature that impedes or prevents the migration of fluids within a reservoir system. In Pre-Salt reservoirs, faults can act as such barriers, compartmentalizing hydrocarbon accumulations."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Displacement a owl:Class ;
    rdfs:label "displacement"@en ;
    rdfs:comment "Displacement is a geological phenomenon that involves the relative movement of rock masses along a planar fracture in rock. In the context of Pre-Salt petroleum geology, this movement occurs along faults, which can act as both migration pathways and barriers for hydrocarbons within reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:PlanarFracture ],
        presalt:Deformation .

presalt:LakeSystem a owl:Class ;
    rdfs:label "lake system"@en ;
    rdfs:comment "A lake system is a continental depositional setting that is associated with lacustrine environments. These systems are characterized by bodies of standing water where unique carbonate facies, such as microbialites, and evaporites can accumulate, forming significant reservoir and seal rocks in the Pre-Salt play."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:MicrobialCommunity a owl:Class ;
    rdfs:label "microbial community"@en ;
    rdfs:comment "Microbial community is a group of microorganisms that, through their metabolic activity, form sedimentary structures known as microbialites. These communities are crucial in the Brazilian Pre-Salt, as their biogenic structures constitute the primary reservoir facies in the Santos Basin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SantosBasinPreSaltSequence ],
        bfo:BFO_0000027 .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "migration pathway"@en ;
    rdfs:comment "Migration pathway is a geological conduit that facilitates the movement of fluids, particularly hydrocarbons, through subsurface rock formations. In Pre-Salt reservoirs, structural elements such as faults can serve as significant migration pathways, enabling petroleum to move from source rocks to reservoir traps."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "pre-salt reservoir"@en ;
    rdfs:comment "A pre-salt reservoir is a petroleum reservoir rock that is stratigraphically located beneath a thick, regional evaporite seal. In the Brazilian Pre-Salt play, these reservoirs are predominantly carbonate rocks, with microbialites serving as the primary reservoir facies, often deposited in lacustrine environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:RegionalSeal ],
        presalt:PetroleumReservoirRock .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a geological facies that represents a rock unit possessing the necessary petrophysical properties, such as porosity and permeability, to store and transmit hydrocarbons. In the Brazilian Pre-Salt, microbialites are the primary example of such facies, forming significant petroleum reservoirs."@en ;
    rdfs:subClassOf presalt:GeologicalFacies .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a composite property that describes a rock's capacity to store and transmit fluids, primarily controlled by its porosity and permeability. In the Brazilian Pre-Salt, this quality is often enhanced by diagenetic processes such as dolomitization and is a key characteristic of the microbialite facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000019 .

presalt:RockVolume a owl:Class ;
    rdfs:label "rock volume"@en ;
    rdfs:comment "Rock volume is a physical quantity that represents the total space occupied by a rock. This quantity encompasses both the solid matrix and the void spaces (pores) within the rock. It is a fundamental parameter in reservoir characterization, particularly in the calculation of porosity and hydrocarbon pore volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VoidSpace ],
        bfo:BFO_0000019 .

bfo:BFO_0000020 owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

bfo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en .

presalt:ContinentalDepositionalSetting a owl:Class ;
    rdfs:label "continental depositional setting"@en ;
    rdfs:comment "Continental depositional setting is a depositional environment that is situated on land, characterized by processes and sediments formed away from direct marine influence. These settings prominently include lacustrine environments, which are key to the Brazilian Pre-Salt sequences where significant reservoir rocks like microbialites are formed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:LacustrineEnvironment ],
        georeservoir:GEORES_0000021 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "A diagenetic process is a geological process that involves physical, chemical, and biological changes occurring in sediments and sedimentary rocks after their initial deposition and before metamorphism. In the context of Pre-Salt reservoirs, these processes, exemplified by dolomitization, are critical for modifying rock properties, often enhancing reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEOCORE_0000002 .

presalt:ExtensionalDeformation a owl:Class ;
    rdfs:label "extensional deformation"@en ;
    rdfs:comment "Extensional deformation is a tectonic process that involves the stretching and thinning of the Earth's lithosphere. This process commonly leads to the formation of rift basins, which are fundamental for the development of petroleum systems, such as those found in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        presalt:TectonicProcess .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock along which displacement has occurred. In Pre-Salt reservoirs, faults serve as both migration pathways for hydrocarbons and barriers to fluid flow, influencing trap formation and reservoir compartmentalization."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a substance that can flow and is stored and transmitted within reservoir rocks. In the context of Pre-Salt petroleum geology, this primarily refers to hydrocarbons (oil and gas) and formation water, whose movement is governed by rock properties like porosity and permeability."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:GeologicalFacies a owl:Class ;
    rdfs:label "Geological Facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "Lacustrine environment is a continental depositional setting that is associated with lake systems. In the context of the Brazilian Pre-Salt, these environments were often characterized by hypersaline conditions, leading to the deposition of both carbonate reservoir rocks and overlying evaporitic seals."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "petroleum trap"@en ;
    rdfs:comment "Petroleum trap is a geological configuration that accumulates and retains hydrocarbons in the subsurface. It typically comprises a porous reservoir rock, a non-porous seal rock, and a trapping mechanism, such as structural deformation or stratigraphic variations, that prevents further hydrocarbon migration. In the Brazilian Pre-Salt, structural traps formed by tectonic processes are prevalent, with evaporites commonly acting as regional seals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PetroleumReservoirRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:StructuralTrap ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:RegionalSeal ],
        georeservoir:GEOCORE_0000001 .

presalt:PlanarFracture a owl:Class ;
    rdfs:label "planar fracture"@en ;
    rdfs:comment "Planar fracture is a fracture in rock that exhibits a relatively flat or two-dimensional geometry. In Pre-Salt petroleum geology, such fractures are fundamental structural elements that can develop into faults, which serve as critical migration pathways and barriers for hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000011 .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a tectonic process that involves extensional deformation of the lithosphere. This fundamental process initiates the formation of sedimentary basins, creating the structural framework of grabens and half-grabens where the thick Pre-Salt lacustrine and early marine sequences were deposited."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        presalt:TectonicProcess .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "structural trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by the deformation of rock layers through tectonic processes. These traps typically involve features such as folds or faults, with faults often acting as critical sealing elements or migration pathways in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Deformation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:TectonicProcess ],
        presalt:PetroleumTrap .

presalt:VoidSpace a owl:Class ;
    rdfs:label "void space"@en ;
    rdfs:comment "Void space is a portion of a rock that is not occupied by solid material. It is a critical component in determining a rock's porosity, representing the volume available for fluid storage within petroleum reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PetroleumReservoirRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000019 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "Stratigraphic Unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

bfo:BFO_0000117 a owl:ObjectProperty ;
    rdfs:label "has occurrent part"@en .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "chemical sedimentary rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a type of sedimentary rock that forms from the precipitation of dissolved minerals from an aqueous solution. In the context of the Pre-Salt play, these rocks, such as evaporites, are significant as they often act as regional seals, preventing hydrocarbon migration due due to their low permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Precipitation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:DissolvedMineral ],
        georeservoir:GEORES_0000032 .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that involves the alteration of rock layers or the lithosphere's shape, volume, or orientation. It is driven by tectonic processes and is fundamental to the formation of structural traps, such as those containing hydrocarbons in Pre-Salt reservoirs. This process includes extensional deformation, which is critical for basin evolution during rifting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:RockLayer ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:ExtensionalDeformation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        georeservoir:GEOCORE_0000002 .

presalt:DissolvedMineral a owl:Class ;
    rdfs:label "dissolved mineral"@en ;
    rdfs:comment "Dissolved mineral is a mineral substance that is held in solution within a fluid, typically water. In the context of Pre-Salt geology, these substances precipitate from evaporating lacustrine water bodies to form evaporite rocks, which serve as regional seals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Evaporite ],
        presalt:Mineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of calcite by dolomite. This alteration often enhances reservoir porosity and permeability, which is critical for hydrocarbon accumulation in carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:DiageneticProcess .

presalt:EvaporatingWaterBody a owl:Class ;
    rdfs:label "evaporating water body"@en ;
    rdfs:comment "An evaporating water body is a body of water that is undergoing a net loss of water volume through evaporation, leading to the concentration and eventual precipitation of dissolved minerals. In Pre-Salt petroleum geology, such bodies are crucial as the source environments for the formation of evaporite sequences, which commonly act as regional seals for hydrocarbon accumulations."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that forms by the precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt play, these rocks are critical as they act as the regional seal, effectively trapping hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:EvaporatingWaterBody ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Precipitation ],
        presalt:ChemicalSedimentaryRock .

presalt:GeologicalUnit a owl:Class ;
    rdfs:label "Geological Unit"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Mineral a owl:Class ;
    rdfs:label "Mineral"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that describes its capacity to transmit fluids. It is a primary control on reservoir quality, alongside porosity, and can be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PhysicalProperty .

presalt:PhysicalProperty a owl:Class ;
    rdfs:label "physical property"@en ;
    rdfs:comment "A physical property is a characteristic of a substance that can be observed or measured without changing its chemical composition. In Pre-Salt petroleum geology, key physical properties of reservoir rocks, such as porosity and permeability, are fundamental for assessing hydrocarbon storage and flow capacity, and are significantly influenced by diagenesis and depositional facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000019 .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. It is a primary control on reservoir quality, determining a rock's capacity to store and transmit fluids. In Pre-Salt carbonate reservoirs, porosity can be significantly enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PhysicalProperty .

presalt:Precipitation a owl:Class ;
    rdfs:label "precipitation"@en ;
    rdfs:comment "Precipitation is a geological process that involves the formation of solid chemical sedimentary rocks from dissolved minerals in a solution. In the context of Pre-Salt geology, this process is fundamental to the formation of evaporites from evaporating water bodies, which act as regional seals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:DissolvedMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:ChemicalSedimentaryRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:EvaporatingWaterBody ],
        georeservoir:GEOCORE_0000002 .

presalt:RockLayer a owl:Class ;
    rdfs:label "rock layer"@en ;
    rdfs:comment "Rock layer is a geological unit that is characterized by distinct lithological properties, often deposited horizontally, and can be deformed by tectonic processes. These layers represent discrete episodes of deposition or formation and are fundamental to understanding stratigraphy, structural geology, and the formation of petroleum traps, such as those found in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf presalt:GeologicalUnit .

presalt:SantosBasinPreSaltSequence a owl:Class,
        owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "santos basin pre-salt sequence"@en ;
    rdfs:comment "Santos Basin Pre-Salt sequence is a stratigraphic sequence that was deposited during the rift phase of the Santos Basin, characterized by lacustrine microbialite carbonate reservoirs sealed by regional evaporites. These sequences are primarily composed of microbialite carbonates, which form the main reservoir facies, interbedded with other lacustrine deposits, and are overlain by thick evaporite layers that act as a regional seal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:RegionalSeal ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateReservoir ] .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "Sedimentary Environment"@en ;
    rdfs:subClassOf bfo:BFO_0000006,
        georeservoir:GEORES_0000020 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

bfo:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from"@en .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that is a primary constituent of carbonate reservoir rocks. It is commonly found in Pre-Salt microbialite reservoirs and can be subject to diagenetic alteration, such as dolomitization, which replaces calcite with dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:CarbonateMineral .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "carbonate mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that is a primary constituent of carbonate reservoir rocks, commonly exemplified by calcite and dolomite. These minerals are characterized by the presence of the carbonate ion (CO3^2-) and are fundamental to the composition of Pre-Salt microbialite reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:Mineral .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that replaces calcite during diagenesis and is a key component of carbonate reservoir rocks. Its formation through dolomitization often enhances reservoir porosity and permeability, making it significant for petroleum accumulation in Pre-Salt sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:CarbonateMineral .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "A regional seal is a geological layer or rock unit that acts as an impermeable barrier to hydrocarbon migration over a large geographic area. In the Brazilian Pre-Salt play, this function is primarily fulfilled by thick evaporite sequences. These evaporites are critical for trapping hydrocarbons within underlying reservoir rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Evaporite ],
        presalt:GeologicalUnit .

presalt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en ;
    rdfs:comment "A tectonic process is a geological process that involves the deformation of the Earth's lithosphere or rock layers. These processes, such as rifting, can lead to significant extensional deformation and are fundamental in the formation of structural traps for petroleum accumulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Rifting ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:RockLayer ],
        georeservoir:GEOCORE_0000002 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:comment "Sedimentary rock is a type of rock that is formed from the accumulation and lithification of sediments or by the precipitation of minerals from solution. In the Brazilian Pre-Salt, key examples include microbialites, which are primary reservoir facies, and evaporites, which act as regional seals."@en .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a type of petroleum reservoir rock that is composed of carbonate minerals such as calcite and dolomite. In the Brazilian Pre-Salt, microbialites formed by microbial communities are a primary reservoir facies within these sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:PetroleumReservoirRock .

presalt:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "Lithosphere is the rigid, outermost shell of a terrestrial planet that comprises the Earth's crust and the uppermost part of the mantle. It is broken into tectonic plates whose movement drives geological processes such as rifting, which involves its extensional deformation and is fundamental to the formation of sedimentary basins like those hosting the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. It serves as the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SantosBasinPreSaltSequence ],
        georeservoir:GEORES_0000032 .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "petroleum reservoir rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a rock that possesses the capacity to store and transmit hydrocarbons. This capacity, known as reservoir quality, is primarily controlled by its porosity and permeability. In the Pre-Salt, common examples include carbonate reservoirs composed of minerals such as calcite and dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
