@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock that has undergone displacement along the fracture surface. In the Brazilian Pre-Salt, faults are key structural elements in structural traps and can either facilitate hydrocarbon migration or act as barriers to fluid flow within carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "Migration Pathway"@en ;
    rdfs:comment "Migration pathway is a geological conduit that enables the movement of hydrocarbons from source rocks into carrier beds, reservoirs, or traps. In the Brazilian Pre-Salt, faults commonly act as migration pathways, although they may also behave as barriers depending on their geometry and sealing properties. The effectiveness of a migration pathway is controlled by the structural framework and by rock properties such as porosity and permeability that govern fluid transmission."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:PreSaltSequence a owl:Class ;
    rdfs:label "Pre-Salt Sequence"@en ;
    rdfs:comment "Pre-salt sequence is a stratigraphic succession that was deposited before the evaporite seal during the rift to early post-rift evolution of Brazilian marginal basins and typically contains lacustrine carbonate reservoirs such as microbialites. In the Brazilian Pre-Salt, this sequence is the main hydrocarbon-bearing interval, commonly characterized by carbonate reservoir rocks with reservoir quality governed by porosity, permeability, and diagenetic processes such as dolomitization. It is overlain by evaporites that provide the regional seal for the Pre-Salt petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        georeservoir:GEORES_0000002 .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "Regional Seal"@en ;
    rdfs:comment "Regional seal is a laterally extensive, low-permeability stratigraphic unit that prevents the vertical escape of hydrocarbons and seals petroleum accumulations over a broad area. In the Brazilian Pre-Salt play, this seal is formed predominantly by evaporites precipitated in evaporative lacustrine to restricted settings. Its continuity is critical for trapping hydrocarbons above carbonate reservoir intervals such as microbialites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Evaporite ],
        georeservoir:GEORES_0000002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( georeservoir:GEORES_0000002 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000087 ;
                        owl:someValuesFrom presalt:Regionalsealrole ] ) ] .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "Reservoir Facies"@en ;
    rdfs:comment "Reservoir facies is a rock facies that has the petrophysical characteristics required to store and transmit hydrocarbons, chiefly adequate porosity and permeability. In the Brazilian Pre-Salt, it commonly refers to carbonate intervals with reservoir quality, especially microbialites, which are the primary reservoir facies in the Santos Basin sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "Reservoir Quality"@en ;
    rdfs:comment "Reservoir quality is a composite rock property that describes the capacity of a reservoir to store and transmit fluids, primarily as a function of porosity and permeability. In the Brazilian Pre-Salt, it is especially used to evaluate the performance of carbonate reservoirs such as microbialites, where depositional texture and diagenetic processes like dolomitization can strongly modify pore systems and flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Microbialite ],
        bfo:BFO_0000019 .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Santos Basin"@en ;
    rdfs:comment "Santos Basin is a sedimentary basin that contains the Brazilian Pre-Salt petroleum system, where microbialite carbonates form the primary reservoir facies and evaporites act as the regional seal. It is one of the main settings for lacustrine carbonate reservoirs in Brazil, with reservoir quality strongly controlled by porosity, permeability, structural traps, faults, and diagenetic processes such as dolomitization."@en .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "Structural Trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that forms when tectonic deformation of rock layers creates a closed geometry capable of accumulating hydrocarbons beneath a seal. In the Brazilian Pre-Salt, such traps commonly develop through extensional structures related to rifting, where faults and folds can both localize hydrocarbon migration and provide trapping configurations. Faults may act either as migration pathways or as sealing barriers, while overlying evaporites commonly provide the regional seal."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

bfo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en .

bfo:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from"@en .

presalt:Carbonatereservoirrole a owl:Class ;
    rdfs:label "CarbonateReservoirRole"@en ;
    rdfs:comment "A role that is borne by a sedimentary rock composed predominantly of carbonate minerals and capable of storing and transmitting hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Diagenesis a owl:Class ;
    rdfs:label "Diagenesis"@en ;
    rdfs:comment "Diagenesis is a post-depositional geologic process that alters sediments and sedimentary rocks through physical, chemical, and biological changes during burial and lithification. In Brazilian Pre-Salt carbonate reservoirs, diagenesis strongly controls reservoir quality by modifying porosity and permeability, for example through dolomitization, which replaces calcite with dolomite and can enhance storage and flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        georeservoir:GEOCORE_0000002 .

presalt:Dolomitization a owl:Class ;
    rdfs:label "Dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that replaces calcite with dolomite in carbonate rocks. In Brazilian Pre-Salt carbonate reservoirs, this mineralogical alteration often enhances porosity and permeability, thereby improving reservoir quality and fluid flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:Diagenesis .

presalt:Evaporite a owl:Class ;
    rdfs:label "Evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that forms by precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt petroleum system, evaporites constitute the regional seal that overlies lacustrine carbonate reservoirs and helps trap hydrocarbons."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "Petroleum Trap"@en ;
    rdfs:comment "Petroleum trap is a subsurface geological configuration that allows migrating hydrocarbons to accumulate and be retained by combining a reservoir rock with an effective seal and closure. In the Brazilian Pre-Salt, traps commonly involve structural deformation of rock layers and fault-related closures, while regional evaporites act as the principal seal above carbonate reservoirs such as microbialites. A petroleum trap functions only where migration, storage capacity, and sealing conditions occur together to prevent further hydrocarbon escape."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Regionalsealrole a owl:Class ;
    rdfs:label "RegionalSealRole"@en ;
    rdfs:comment "A role that is borne by a laterally extensive, low-permeability stratigraphic unit that prevents the vertical escape of hydrocarbons and seals petroleum accumulations over a broad area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "sedimentary facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf bfo:BFO_0000017 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

bfo:BFO_0000171 a owl:ObjectProperty ;
    rdfs:label "located in"@en .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

bfo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:comment "Carbonate Mineral is an Earth Material that consists predominantly of naturally occurring carbonate compounds and commonly occurs as a constituent of rocks and sediments."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Dolomite a owl:Class ;
    rdfs:label "Dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that consists of calcium magnesium carbonate and commonly occurs as a major constituent of carbonate reservoir rocks in the Brazilian Pre-Salt. In this context, it is important both as a primary rock-forming mineral and as the product of dolomitization, a diagenetic replacement of calcite that often enhances reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:CarbonateMineral .

presalt:Permeability a owl:Class ;
    rdfs:label "Permeability"@en ;
    rdfs:comment "Permeability is a petrophysical property of rock that quantifies its ability to transmit fluids through interconnected pore spaces and fractures. In Brazilian Pre-Salt carbonate reservoirs, it is a primary control on reservoir quality together with porosity, and it may be enhanced by diagenetic processes such as dolomitization. Permeability also influences whether faults act as migration pathways or as barriers to fluid flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:Porosity a owl:Class ;
    rdfs:label "Porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that quantifies the ratio of void space to total rock volume. In Brazilian Pre-Salt carbonate reservoirs, it is a primary control on reservoir quality because it determines the rock's capacity to store fluids, and it may be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 ;
    owl:disjointWith bfo:BFO_0000017 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

presalt:Calcite a owl:Class ;
    rdfs:label "Calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that consists of calcium carbonate (CaCO3) and commonly forms a major constituent of carbonate reservoir rocks in the Brazilian Pre-Salt. In these reservoirs, calcite is present in facies such as microbialites and may be altered during diagenesis, including replacement by dolomite through dolomitization. Its abundance strongly influences reservoir properties because changes affecting calcite can modify porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:CarbonateMineral .

presalt:Microbialite a owl:Class ;
    rdfs:label "Microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. In the Brazilian Pre-Salt, it is a carbonate reservoir facies and constitutes the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "Carbonate Reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a petroleum reservoir rock that is composed predominantly of carbonate minerals such as calcite and dolomite and is capable of storing and transmitting hydrocarbons through its porosity and permeability. In the Brazilian Pre-Salt, carbonate reservoirs are commonly represented by microbialite facies, which form the primary reservoir interval in the Santos Basin. Their reservoir quality is strongly influenced by diagenetic processes such as dolomitization, which can enhance porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        georeservoir:GEORES_0000032 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( georeservoir:GEORES_0000032 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000087 ;
                        owl:someValuesFrom presalt:Carbonatereservoirrole ] ) ] .

