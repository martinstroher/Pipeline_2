@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that is a primary constituent of carbonate reservoir rocks, particularly in the Pre-Salt sequences. It is commonly subject to diagenetic alteration, such as dolomitization, which involves its replacement by dolomite and can significantly impact reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:CarbonateMineral .

presalt:DissolvedMineral a owl:Class ;
    rdfs:label "dissolved mineral"@en ;
    rdfs:comment "A dissolved mineral is a mineral that exists in an ionic or molecular state within a solvent, typically water. In geological settings, these minerals precipitate from evaporating water bodies to form chemical sedimentary rocks, such as evaporites, which act as regional seals in the Pre-Salt play."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:ChemicalSedimentaryRock ],
        presalt:Mineral .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a substance that can be stored and transmitted by reservoir rocks. In the context of Pre-Salt petroleum geology, this term primarily refers to hydrocarbons (oil and natural gas) and formation water. The capacity of a rock to store and transmit these fluids is a key determinant of reservoir quality, controlled by its porosity and permeability."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "A lacustrine environment is a continental depositional setting that is associated with lake systems. In the Brazilian Pre-Salt, these environments were critical for the deposition of microbialite carbonate reservoirs and the subsequent formation of evaporite seals. These ancient lake systems varied in salinity and depth, influencing the types of sediments and organisms preserved within the rift and sag basins."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:MicrobialCommunity a owl:Class ;
    rdfs:label "microbial community"@en ;
    rdfs:comment "A microbial community is a group of microorganisms that collectively engage in metabolic activities to form sedimentary structures. In the context of the Brazilian Pre-Salt, their metabolic activity is responsible for the formation of microbialites, which constitute the primary reservoir facies in the Santos Basin."@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. It serves as the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:SantosBasin ;
            owl:onProperty bfo:BFO_0000171 ],
        georeservoir:GEORES_0000032 .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "migration pathway"@en ;
    rdfs:comment "A migration pathway is a geological conduit that facilitates the movement of hydrocarbons through the subsurface. In Pre-Salt petroleum systems, structural features such as faults commonly serve as these pathways, enabling petroleum to migrate from source rocks to reservoir rocks or traps. Depending on their sealing capacity, these same features can also act as barriers."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "pre-salt reservoir"@en ;
    rdfs:comment "Pre-salt reservoir is a petroleum reservoir rock that is located stratigraphically beneath a regional evaporite layer. These reservoirs, often composed of carbonate minerals like microbialites, are characteristic of the Brazilian Pre-Salt play, where their quality is influenced by diagenetic processes such as dolomitization, which can enhance porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        presalt:PetroleumReservoirRock .

presalt:PreSaltSequence a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "pre-salt sequence"@en ;
    rdfs:comment "Pre-salt sequence is a stratigraphic interval that lies beneath a thick layer of Aptian evaporites in the South Atlantic basins, representing the syn-rift and early post-rift successions formed during the continental breakup. These sequences are characterized by lacustrine and marine carbonate reservoirs, primarily microbialites, which are sealed by the overlying salt layer and host significant hydrocarbon accumulations."@en .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "Regional seal is a geological formation that acts as an impermeable barrier, preventing the upward migration of hydrocarbons over a large geographic area. In the Brazilian Pre-Salt play, this function is primarily fulfilled by thick evaporite sequences, which are chemical sedimentary rocks formed by the precipitation of dissolved minerals from evaporating water bodies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Evaporite ],
        georeservoir:GEORES_0000004 .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a geological facies that possesses characteristics enabling it to store and transmit hydrocarbons. In the Santos Basin Pre-Salt sequences, microbialite is a primary example, formed by the metabolic activity of microbial communities. These facies are characterized by sufficient porosity and permeability to allow for fluid accumulation and flow."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a composite property that describes a rock's capacity to store and transmit fluids, primarily controlled by its porosity and permeability. This property is significantly influenced by diagenetic processes such as dolomitization, which can enhance the rock's ability to hold and flow hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        bfo:BFO_0000019 .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a tectonic process that involves extensional deformation of the lithosphere. This process is fundamental to the formation of rift basins, which host the initial depositional sequences of the Brazilian Pre-Salt play. It establishes the structural framework of faults and horst-graben systems that control sediment distribution and subsequent petroleum accumulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        presalt:ExtensionalDeformation .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "structural trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by the deformation of rock layers through tectonic processes. These traps typically involve folds or faults that create configurations preventing hydrocarbon migration, with faults often acting as critical sealing elements or migration pathways in Pre-Salt reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        presalt:PetroleumTrap .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

bfo:BFO_0000171 a owl:ObjectProperty ;
    rdfs:label "located in"@en .

bfo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en .

bfo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a type of petroleum reservoir rock that is composed of carbonate minerals such as calcite and dolomite. In the Brazilian Pre-Salt, microbialites are a primary reservoir facies, characterized by their capacity to store and transmit fluids, which is primarily controlled by porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:PetroleumReservoirRock .

presalt:ContinentalDepositionalSetting a owl:Class ;
    rdfs:label "continental depositional setting"@en ;
    rdfs:comment "A continental depositional setting is a depositional environment that is characterized by the accumulation of sediments and formation of sedimentary rocks in terrestrial, non-marine areas. In the context of the Brazilian Pre-Salt, these settings are primarily represented by extensive lacustrine systems where microbial carbonates and evaporites were deposited."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt play, it acts as the regional seal, effectively trapping hydrocarbons."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:ExtensionalDeformation a owl:Class ;
    rdfs:label "extensional deformation"@en ;
    rdfs:comment "Extensional deformation is a tectonic process that involves the stretching and thinning of the Earth's lithosphere. It is characteristic of rifting, leading to the formation of sedimentary basins through crustal attenuation and subsidence, which is fundamental to the development of Pre-Salt basins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        presalt:Deformation .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock along which displacement has occurred. In Pre-Salt reservoirs, faults serve as both migration pathways for hydrocarbons and as barriers to fluid flow, influencing trap formation and reservoir compartmentalization."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "petroleum trap"@en ;
    rdfs:comment "Petroleum trap is a geological configuration that allows hydrocarbons to accumulate and be retained in the subsurface. It typically comprises a porous reservoir rock, an impermeable seal rock, and a migration pathway, forming a closed system. In the Pre-Salt, these traps are often structural, formed by tectonic deformation, and commonly sealed by regional evaporite layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PetroleumReservoirRock ],
        georeservoir:GEOCORE_0000004 .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "santos basin"@en ;
    rdfs:comment "Santos Basin is a large, offshore sedimentary basin located along the southeastern coast of Brazil that is a prolific petroleum province, particularly known for its deepwater Pre-Salt oil and gas discoveries. It is characterized by significant Pre-Salt carbonate reservoirs, predominantly microbialites, which are sealed by thick evaporite sequences."@en .

presalt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en ;
    rdfs:comment "Tectonic process is a geological process that involves the deformation of the Earth's lithosphere or rock layers. Such processes, like rifting, are fundamental in shaping basin architecture and forming structural traps crucial for petroleum accumulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000009 a owl:Class ;
    rdfs:label "earth fluid"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

georeservoir:GEORES_0000003 a owl:Class ;
    rdfs:label "lithostratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

georeservoir:GEORES_0000004 a owl:Class ;
    rdfs:label "formation"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000003 .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "sedimentary environment"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "sedimentary facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "chemical sedimentary rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that is formed by precipitation of dissolved minerals from evaporating water bodies. In the Pre-Salt play, these rocks, particularly evaporites, act as a regional seal."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that alters the shape, volume, or orientation of rock bodies through tectonic forces. In Pre-Salt petroleum geology, it is fundamental to the formation of structural traps and is exemplified by extensional deformation during rifting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:TectonicProcess .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "A diagenetic process is a geological process that involves physical, chemical, or biological changes occurring in sediments or rocks after deposition and during or after lithification, but prior to metamorphism. In Pre-Salt petroleum systems, these processes, such as dolomitization, are critical as they can significantly modify rock properties, often enhancing reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that replaces calcite during dolomitization and is a component of carbonate reservoir rocks. It is commonly formed through the diagenetic process of dolomitization, which often enhances reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of calcite by dolomite. This process often enhances reservoir porosity and permeability, which is critical for hydrocarbon accumulation in carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:DiageneticProcess .

presalt:Mineral a owl:Class ;
    rdfs:label "Mineral"@en ;
    rdfs:comment "Mineral is a naturally occurring solid substance with a defined chemical composition and crystal structure."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:PhysicalPropertyOfRock a owl:Class ;
    rdfs:label "Physical Property Of Rock"@en ;
    rdfs:comment "Physical Property Of Rock is a quality that describes an intrinsic characteristic of a rock material."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

presalt:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "Lithosphere is a rigid outermost shell of a terrestrial planet that comprises the Earth's crust and the uppermost, brittle part of the mantle. This layer is broken into tectonic plates that move and undergo significant deformation, such as the extensional deformation observed during rifting processes relevant to basin formation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Deformation ],
        georeservoir:GEOCORE_0000006 .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that describes its capacity to transmit fluids. It is a primary control on reservoir quality, alongside porosity, determining the efficiency of fluid flow within a reservoir. In Pre-Salt carbonate reservoirs, diagenetic processes such as dolomitization can significantly enhance permeability, improving hydrocarbon recovery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PhysicalPropertyOfRock .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "petroleum reservoir rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a rock unit that possesses sufficient porosity to store and permeability to transmit hydrocarbons. Its quality is a composite property primarily controlled by these two factors, which allow for the accumulation and production of oil and gas. In the Brazilian Pre-Salt, these rocks are predominantly carbonate minerals, with microbialites serving as a primary reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        georeservoir:GEORES_0000032 .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. It is a primary control on reservoir quality, indicating a rock's capacity to store fluids. In Pre-Salt carbonate reservoirs, porosity can be significantly enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PhysicalPropertyOfRock .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "carbonate mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that contains the carbonate ion (CO3^2-) as its fundamental anionic group. In the context of Pre-Salt petroleum geology, common examples include calcite (CaCO3) and dolomite (CaMg(CO3)2), which are the primary constituents of carbonate reservoir rocks."@en ;
    rdfs:subClassOf presalt:Mineral .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        georeservoir:GEOCORE_0000006 .

