@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock along which displacement has occurred. In Pre-Salt reservoirs, faults can serve as both migration pathways for hydrocarbons and barriers to fluid flow."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a substance that can be stored and transmitted within reservoir rocks. In the context of Pre-Salt petroleum systems, these primarily include hydrocarbons (oil and natural gas) and formation water, which are crucial for reservoir quality assessment."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000009 .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "Lacustrine environment is a continental depositional setting that is associated with lake systems. These environments are crucial in the Brazilian Pre-Salt for the deposition of microbialites and the formation of evaporites, which act as reservoir rocks and regional seals, respectively."@en ;
    rdfs:subClassOf presalt:ContinentalDepositionalSetting .

presalt:MigrationPathway a owl:Class ;
    rdfs:label "migration pathway"@en ;
    rdfs:comment "Migration pathway is a geological conduit that facilitates the movement of fluids, such as petroleum, through rock layers. In Pre-Salt reservoirs, structural features like faults commonly serve as such pathways, sometimes also acting as barriers."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:PreSalt a owl:Class ;
    rdfs:label "pre-salt"@en ;
    rdfs:comment "Pre-salt is a geological play that is characterized by hydrocarbon reservoirs situated beneath a thick, regional evaporite (salt) layer. These reservoirs, predominantly lacustrine carbonates like microbialites, formed during the rift phase of the South Atlantic opening and are sealed by the overlying Aptian salt, making them a significant petroleum frontier, particularly offshore Brazil."@en ;
    rdfs:subClassOf presalt:GeologicalPlay .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:PreSaltPlay a owl:Class ;
    rdfs:label "pre-salt play"@en ;
    rdfs:comment "Pre-salt play is a petroleum play that is characterized by hydrocarbon accumulations situated beneath a thick evaporite seal, typically associated with rift-related carbonate reservoirs. This play is defined by its unique geological setting, including lacustrine carbonate reservoirs, primarily microbialites, developed during rift-related basin evolution, sealed by regional evaporites, and often exhibiting enhanced reservoir quality due to diagenetic processes like dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:RegionalSeal ],
        presalt:PetroleumPlay .

presalt:PreSaltSequence a owl:Class ;
    rdfs:label "pre-salt sequence"@en ;
    rdfs:comment "Pre-salt sequence is a stratigraphic interval that lies beneath a thick evaporite layer and was deposited during the rift and sag phases of the South Atlantic opening. It is characterized by lacustrine and marine carbonate and siliciclastic rocks, including microbialites, which form prolific hydrocarbon reservoirs, and represents a major petroleum play in the Brazilian offshore."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "reservoir facies"@en ;
    rdfs:comment "Reservoir facies is a geological facies that possesses the necessary petrophysical characteristics to store and transmit hydrocarbons. In the Brazilian Pre-Salt, microbialites are a primary example of such facies, formed by the metabolic activity of microbial communities."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "reservoir quality"@en ;
    rdfs:comment "Reservoir quality is a composite property that describes a rock's capacity to store and transmit fluids, primarily controlled by porosity and permeability. In Pre-Salt carbonate reservoirs, diagenetic processes such as dolomitization often play a significant role in enhancing these controlling factors, thereby improving the overall reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Permeability ],
        bfo:BFO_0000019 .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a tectonic process that involves extensional deformation of the lithosphere. This process is fundamental to the initial formation and evolution of sedimentary basins, including those that host the Brazilian Pre-Salt reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        presalt:TectonicProcess .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "santos basin"@en ;
    rdfs:comment "Santos Basin is a sedimentary basin that is located off the southeastern coast of Brazil and is renowned for its significant Pre-Salt petroleum discoveries. Within its Pre-Salt sequences, microbialite serves as the primary reservoir facies."@en .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "structural trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by deformation of rock layers through tectonic processes. These traps commonly arise from folding or faulting, where faults can act as seals or barriers, leading to the accumulation of hydrocarbons."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

bfo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en .

presalt:Barrier a owl:Class ;
    rdfs:label "barrier"@en ;
    rdfs:comment "Barrier is a geological feature that impedes the migration or flow of fluids within a reservoir system. In Pre-Salt reservoirs, a fault can serve as a barrier, compartmentalizing hydrocarbon accumulations."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that is a primary component of carbonate reservoir rocks. It can be replaced by dolomite during the diagenetic process of dolomitization, which often enhances reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:CarbonateMineral .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "chemical sedimentary rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies. In the Pre-Salt play, evaporites are a significant type of chemical sedimentary rock, often acting as regional seals."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:ContinentalDepositionalSetting a owl:Class ;
    rdfs:label "continental depositional setting"@en ;
    rdfs:comment "A continental depositional setting is a depositional environment that occurs on land, away from direct marine influence. It encompasses various terrestrial environments, including lacustrine systems, which are particularly relevant in the Brazilian Pre-Salt for their association with hydrocarbon reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000021 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "A diagenetic process is a geological process that involves physical and chemical changes to a rock after its initial deposition, often impacting its reservoir quality through alterations like mineral replacement. In the context of Pre-Salt reservoirs, these processes, such as dolomitization, are crucial as they can significantly enhance or degrade porosity and permeability, which are key factors for hydrocarbon accumulation and production."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Evaporite a owl:Class ;
    rdfs:label "evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that is formed by the precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt, it characteristically functions as the regional seal, trapping hydrocarbons."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:PetroleumPlay a owl:Class ;
    rdfs:label "Petroleum Play"@en ;
    rdfs:comment "A Petroleum Play is a geological play that defines a prospective area for hydrocarbon exploration based on shared geological characteristics, including source rock, reservoir, seal, and trap."@en ;
    rdfs:subClassOf presalt:GeologicalPlay .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "petroleum reservoir rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a rock that possesses the capacity to store and transmit petroleum fluids. This capacity is primarily controlled by its porosity, defined as the ratio of void space to total rock volume, and its permeability, which allows fluid flow, with carbonate reservoirs like microbialites being significant examples in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        georeservoir:GEOCORE_0000008 .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "petroleum trap"@en ;
    rdfs:comment "Petroleum trap is a geological configuration that impedes the upward or lateral migration of hydrocarbons, leading to their accumulation in a reservoir rock. These traps are essential for the formation of hydrocarbon reservoirs and are typically classified as structural, stratigraphic, or a combination of both. In the Brazilian Pre-Salt, structural traps, which are formed by the deformation of rock layers through tectonic processes, are a significant type of petroleum trap, with faults often acting as both migration pathways and barriers."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "Regional seal is a geological barrier that effectively impedes the migration of hydrocarbons across a broad geographic extent. In the Brazilian Pre-Salt play, this role is predominantly fulfilled by thick evaporite sequences, which form a crucial top seal for the underlying carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Evaporite ],
        presalt:Barrier .

presalt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en ;
    rdfs:comment "Tectonic process is a geological process that involves the deformation of the Earth's lithosphere. These processes, such as rifting, can lead to extensional deformation and the formation of structural traps in petroleum systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Lithosphere ],
        georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000009 a owl:Class ;
    rdfs:label "earth fluid"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

georeservoir:GEORES_0000021 a owl:Class ;
    rdfs:label "sedimentary environment"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "carbonate mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that contains the carbonate ion (CO3^2-) as its fundamental anionic group. These minerals, such as calcite and dolomite, are the primary constituents of carbonate reservoir rocks in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        georeservoir:GEOCORE_0000006 .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the replacement of calcite by dolomite. This process often enhances reservoir porosity and permeability, which is crucial for hydrocarbon accumulation in Pre-Salt carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:DiageneticProcess .

presalt:GeologicalPlay a owl:Class ;
    rdfs:label "Geological Play"@en ;
    rdfs:comment "A Geological Play is a geological concept that describes a set of geological conditions and processes that lead to the accumulation of hydrocarbons in a specific region or basin."@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

presalt:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "Lithosphere is a geological layer that constitutes the rigid outermost shell of a terrestrial planet. It comprises the Earth's crust and the uppermost part of the mantle, behaving as a brittle solid that is subject to tectonic processes like rifting."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. It serves as the primary reservoir facies in the Santos Basin Pre-Salt sequences."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that describes its capacity to transmit fluids. It is a critical factor in determining reservoir quality, often enhanced by diagenetic processes like dolomitization in Pre-Salt carbonate reservoirs."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

presalt:PhysicalProperty a owl:Class ;
    rdfs:label "Physical Property"@en ;
    rdfs:comment "Physical Property is a quality of a material entity that can be measured or observed without changing the material's identity."@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a type of petroleum reservoir rock that is composed of carbonate minerals such as calcite and dolomite. In the Brazilian Pre-Salt, these reservoirs are predominantly formed by microbialites, with their quality, including porosity and permeability, often enhanced by diagenetic processes like dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Microbialite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:PetroleumReservoirRock .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that is a common component of carbonate reservoir rocks and is formed through the diagenetic replacement of calcite during dolomitization. This diagenetic process frequently enhances reservoir porosity and permeability, making it a significant mineral in Pre-Salt petroleum systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:CarbonateMineral .

presalt:Porosity a owl:Class ;
    rdfs:label "porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. It is a critical factor for reservoir quality, controlling a rock's capacity to store fluids, and can be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf presalt:PhysicalProperty .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

