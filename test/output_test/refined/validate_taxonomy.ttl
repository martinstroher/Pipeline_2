@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bfo:BFO_0000051 a owl:ObjectProperty ;
    rdfs:label "has part"@en .

presalt:Evaporite a owl:Class ;
    rdfs:label "Evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that forms by precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt petroleum system, evaporites constitute the regional seal that overlies lacustrine carbonate reservoirs and helps trap hydrocarbons."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "Fault is a planar fracture in rock that is characterized by displacement along the fracture surface. In the Brazilian Pre-Salt, faults are tectonic structures associated mainly with rifting and can form structural traps while also acting either as migration pathways or as barriers to fluid flow in carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "Petroleum Reservoir Rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a subsurface rock unit that stores and transmits petroleum through interconnected pore spaces and sufficient permeability. Its reservoir quality is primarily controlled by porosity and permeability, and in the Brazilian Pre-Salt it commonly includes carbonate reservoir rocks composed of calcite and dolomite, especially microbialite facies in the Santos Basin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000087 ;
            owl:someValuesFrom presalt:Petroleumreservoirrockrole ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        georeservoir:GEOCORE_0000008 .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:PreSaltPlay a owl:Class ;
    rdfs:label "Pre-Salt Play"@en ;
    rdfs:comment "Pre-salt play is a petroleum play that consists of hydrocarbon accumulations in rift-related lacustrine carbonate reservoirs deposited before regional evaporite sealing, typically involving microbialite-dominated facies, structural traps, and fault-controlled migration. In the Brazilian Pre-Salt, the evaporite package acts as the regional seal above these reservoirs, especially in the Santos Basin. Reservoir quality in this play is strongly controlled by porosity and permeability, which may be further modified by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:SantosBasin ;
            owl:onProperty bfo:BFO_0000171 ],
        bfo:BFO_0000027 .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "Pre-Salt Reservoir"@en ;
    rdfs:comment "Pre-salt reservoir is a petroleum reservoir that occurs in subsalt stratigraphic intervals of the Brazilian Pre-Salt play, typically consisting of lacustrine carbonate rocks whose storage and flow capacity are controlled by porosity and permeability. In the Santos Basin, microbialites are the primary reservoir facies, and these reservoirs are commonly sealed by overlying evaporites. Their trapping and performance may also be influenced by structural deformation and faults, which can act as migration pathways or barriers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000087 ;
            owl:someValuesFrom presalt:Presaltreservoirrole ],
        georeservoir:GEORES_0000001 .

presalt:PreSaltSequence a owl:Class ;
    rdfs:label "Pre-Salt Sequence"@en ;
    rdfs:comment "Pre-salt sequence is a stratigraphic succession that was deposited before the regional evaporite seal during the rift to early post-rift evolution of Brazilian marginal basins. In the Brazilian Pre-Salt, it commonly comprises lacustrine sediments and carbonate reservoir rocks, especially microbialites that form the main reservoir facies in the Santos Basin. These deposits are central to the petroleum system because their reservoir quality depends on porosity and permeability and they are overlain by evaporites that provide an effective regional seal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        georeservoir:GEORES_0000002 .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "Regional Seal"@en ;
    rdfs:comment "Regional seal is a laterally extensive, low-permeability stratigraphic unit that prevents the vertical escape of hydrocarbons and seals an entire petroleum play or large part of a basin. In the Brazilian Pre-Salt, this role is performed predominantly by evaporites precipitated in evaporative lacustrine to restricted settings. These evaporitic layers are critical for preserving hydrocarbons trapped in underlying carbonate reservoirs such as microbialites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000087 ;
            owl:someValuesFrom presalt:Regionalsealrole ],
        georeservoir:GEORES_0000002 .

presalt:ReservoirFacies a owl:Class ;
    rdfs:label "Reservoir Facies"@en ;
    rdfs:comment "Reservoir facies is a depositional facies that forms or constitutes a petroleum reservoir by possessing the lithologic and petrophysical characteristics needed to store and transmit hydrocarbons. In the Brazilian Pre-Salt, reservoir facies are typically carbonate rocks, and microbialite serves as the primary reservoir facies in the Santos Basin sequences. Their reservoir quality is mainly expressed through porosity and permeability, which are further modified by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "Structural Trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that forms when tectonic deformation of rock layers creates a closed geometry capable of accumulating hydrocarbons. In the Brazilian Pre-Salt, such traps commonly result from rift-related extensional structures, and faults may both facilitate hydrocarbon migration and act as sealing barriers. These traps are typically effective where reservoir carbonates are overlain by evaporites that provide a regional seal."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en .

bfo:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from"@en .

presalt:Carbonatereservoirrole a owl:Class ;
    rdfs:label "CarbonateReservoirRole"@en ;
    rdfs:comment "A role that is borne by a carbonate sedimentary rock that is capable of storing and transmitting hydrocarbons through its porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "Chemical Sedimentary Rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that forms by the precipitation of dissolved minerals from water rather than by the accumulation of transported clastic particles. In the Brazilian Pre-Salt context, evaporites are a key example of chemical sedimentary rocks, precipitated from evaporating water bodies and commonly acting as the regional seal above carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Permeability a owl:Class ;
    rdfs:label "Permeability"@en ;
    rdfs:comment "Permeability is a petrophysical property of rock that quantifies its ability to transmit fluids through interconnected pore spaces and fractures. In Brazilian Pre-Salt carbonate reservoirs, it is a key component of reservoir quality together with porosity, and it may be enhanced by diagenetic processes such as dolomitization. This property strongly influences fluid flow, production performance, and the effectiveness of migration pathways within microbialite and other carbonate facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:ReservoirQuality ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "Petroleum Trap"@en ;
    rdfs:comment "Petroleum trap is a subsurface geological configuration that prevents migrating hydrocarbons from escaping and allows them to accumulate in a reservoir beneath an effective seal. In the Brazilian Pre-Salt, traps commonly involve structural deformation of rock layers and fault-related closures associated with rifting, with microbialite-rich carbonate reservoirs sealed regionally by evaporites. A petroleum trap requires the proper combination of reservoir rock, seal, and closure geometry to retain oil and gas."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Petroleumreservoirrockrole a owl:Class ;
    rdfs:label "PetroleumReservoirRockRole"@en ;
    rdfs:comment "A role that is borne by a rock that stores and transmits petroleum through interconnected pore spaces and sufficient permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Presaltreservoirrole a owl:Class ;
    rdfs:label "PreSaltReservoirRole"@en ;
    rdfs:comment "A role that is borne by a body of rock in subsalt intervals of the Brazilian Pre-Salt play that stores and transmits hydrocarbons, typically in lacustrine carbonate rocks sealed by evaporites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:Regionalsealrole a owl:Class ;
    rdfs:label "RegionalSealRole"@en ;
    rdfs:comment "A role that is borne by a laterally extensive, low-permeability stratigraphic unit that prevents vertical hydrocarbon escape and seals a petroleum play or large part of a basin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Santos Basin"@en ;
    rdfs:comment "Santos Basin is a sedimentary basin that contains the Brazilian Pre-Salt petroleum system, where microbialite-rich carbonate reservoirs form the primary reservoir facies beneath an evaporite regional seal. It developed in association with rifting and includes lacustrine depositional successions whose reservoir quality is strongly controlled by porosity, permeability, structural traps, faults, and diagenetic processes such as dolomitization."@en .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "sedimentary facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

bfo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en .

presalt:Diagenesis a owl:Class ;
    rdfs:label "Diagenesis"@en ;
    rdfs:comment "Diagenesis is a post-depositional geological process that alters sediment or sedimentary rock through physical, chemical, and biological changes during burial and lithification. In Brazilian Pre-Salt carbonate reservoirs, diagenesis strongly controls reservoir quality by modifying porosity and permeability, with dolomitization being an important example that replaces calcite with dolomite and can enhance storage and flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEOCORE_0000002 .

presalt:Dolomite a owl:Class ;
    rdfs:label "Dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that consists of calcium magnesium carbonate and commonly forms in carbonate reservoir rocks through diagenetic replacement of calcite. In the Brazilian Pre-Salt, dolomite is an important constituent of carbonate reservoirs and is commonly associated with dolomitization processes that can enhance porosity, permeability, and overall reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "Dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that replaces calcite with dolomite in carbonate rocks. In Brazilian Pre-Salt carbonate reservoirs, this mineralogical alteration often enhances porosity and permeability, thereby improving reservoir quality and fluid flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:Diagenesis .

presalt:Porosity a owl:Class ;
    rdfs:label "Porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that quantifies the ratio of void space to total rock volume. In Brazilian Pre-Salt carbonate reservoirs, it is a primary control on reservoir quality because it governs the rock's capacity to store fluids, and it may be enhanced by diagenetic processes such as dolomitization. In microbialite-dominated reservoir facies, porosity commonly interacts with permeability to determine hydrocarbon storage and flow behavior."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:ReservoirQuality ],
        bfo:BFO_0000019 .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "Reservoir Quality"@en ;
    rdfs:comment "Reservoir quality is a composite rock property that describes the capacity of a reservoir to store and transmit fluids, primarily as a function of porosity and permeability. In the Brazilian Pre-Salt, it is a key attribute of carbonate reservoirs such as microbialites, and it can be significantly modified by diagenetic processes like dolomitization that enhance pore space and fluid flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom presalt:Microbialite ],
        bfo:BFO_0000019 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 ;
    owl:disjointWith bfo:BFO_0000017 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

presalt:Calcite a owl:Class ;
    rdfs:label "Calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that commonly composes carbonate reservoir rocks and can be replaced by dolomite during dolomitization. In the Brazilian Pre-Salt, calcite is an important constituent of microbialites and other carbonate facies, and its abundance and diagenetic alteration help control reservoir quality through their effects on porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Microbialite ],
        presalt:CarbonateMineral .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that contains the carbonate ion (CO3^2-) as a fundamental structural component, commonly occurring in reservoir rocks as phases such as calcite and dolomite. In the Brazilian Pre-Salt, carbonate minerals constitute the framework of many carbonate reservoirs and strongly influence diagenetic processes, porosity evolution, and overall reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        georeservoir:GEOCORE_0000001 .

presalt:Microbialite a owl:Class ;
    rdfs:label "Microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. In the Brazilian Pre-Salt, especially in the Santos Basin, it constitutes the primary carbonate reservoir facies. Its reservoir quality is commonly linked to the development and preservation of porosity within these lacustrine carbonate successions."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf bfo:BFO_0000017 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

bfo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000171 a owl:ObjectProperty ;
    rdfs:label "located in"@en .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "Carbonate Reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a petroleum reservoir rock that is composed predominantly of carbonate minerals such as calcite and dolomite and is capable of storing and transmitting hydrocarbons through its porosity and permeability. In the Brazilian Pre-Salt, carbonate reservoirs are commonly represented by microbialite facies, especially in the Santos Basin. Their reservoir quality is strongly controlled by porosity-permeability architecture and can be modified by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000087 ;
            owl:someValuesFrom presalt:Carbonatereservoirrole ],
        georeservoir:GEORES_0000032 .

