@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "Carbonate Reservoir"@en ;
    rdfs:comment "Carbonate reservoir is a petroleum reservoir rock that is composed predominantly of carbonate minerals such as calcite and dolomite and can store and transmit hydrocarbons. In the Brazilian Pre-Salt, microbialites commonly constitute the primary reservoir facies, and reservoir quality is mainly controlled by porosity and permeability. Diagenetic processes such as dolomitization may further modify and often improve its storage and flow properties."@en ;
    rdfs:subClassOf presalt:PetroleumReservoirRock ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( presalt:PetroleumReservoirRock [ a owl:Restriction ;
                        owl:onProperty georeservoir:GEOCORE_0000017 ;
                        owl:someValuesFrom presalt:CarbonateMineral ] ) ] .

presalt:Evaporite a owl:Class ;
    rdfs:label "Evaporite"@en ;
    rdfs:comment "Evaporite is a chemical sedimentary rock that forms by precipitation of dissolved minerals from evaporating water bodies. In the Brazilian Pre-Salt, evaporites constitute the regional seal above the carbonate reservoirs, strongly controlling hydrocarbon trapping and subsurface compartmentalization."@en ;
    rdfs:subClassOf presalt:ChemicalSedimentaryRock .

presalt:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "Fault is a planar rock fracture that is characterized by displacement along the fracture surface due to tectonic deformation. In the Brazilian Pre-Salt, faults are key structural elements that can form structural traps and act either as hydrocarbon migration pathways or as barriers to fluid flow within carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Microbialite a owl:Class ;
    rdfs:label "Microbialite"@en ;
    rdfs:comment "Microbialite is a sedimentary rock that is formed by the metabolic activity of microbial communities. In the Brazilian Pre-Salt, especially in the Santos Basin, it constitutes the primary carbonate reservoir facies. Its reservoir quality is largely controlled by the development and preservation of porosity and permeability during deposition and diagenesis."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "Regional Seal"@en ;
    rdfs:comment "Regional seal is a laterally extensive, low-permeability stratigraphic unit that prevents the vertical escape of hydrocarbons and seals petroleum accumulations over a broad area. In the Brazilian Pre-Salt play, evaporites form the regional seal above the lacustrine carbonate reservoirs. This seal is critical for preserving hydrocarbons trapped within microbialite and other carbonate reservoir facies."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( georeservoir:GEORES_0000002 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000087 ;
                        owl:someValuesFrom presalt:Regionalsealrole ] ) ] .

presalt:ReservoirQuality a owl:Class ;
    rdfs:label "Reservoir Quality"@en ;
    rdfs:comment "Reservoir quality is a composite rock property that describes the capacity of a reservoir to store and transmit fluids, primarily as a function of porosity and permeability. In Brazilian Pre-Salt carbonate reservoirs, reservoir quality is especially critical in microbialite facies, where depositional texture and diagenetic processes such as dolomitization strongly influence pore systems and fluid flow behavior."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        presalt:PhysicalPropertyOfRock .

presalt:SantosBasin a owl:NamedIndividual,
        georeservoir:GEORES_0000039 ;
    rdfs:label "Santos Basin"@en ;
    rdfs:comment "[critic CONVERT_TO_INSTANCE] proper-noun named basin denoting one specific geological entity, so step 1 applies"@en .

presalt:StructuralTrap a owl:Class ;
    rdfs:label "Structural Trap"@en ;
    rdfs:comment "Structural trap is a type of petroleum trap that is formed by tectonic deformation of rock layers, creating a geometric closure that prevents hydrocarbon escape and allows accumulation. In the Brazilian Pre-Salt, structural traps commonly result from rift-related faulting and folding, with faults acting either as migration pathways or as sealing barriers. Their effectiveness depends on the structural configuration and the presence of a competent regional seal, typically evaporites above the carbonate reservoir."@en ;
    rdfs:subClassOf presalt:PetroleumTrap .

bfo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    rdfs:subClassOf bfo:BFO_0000017 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 ;
    owl:disjointWith bfo:BFO_0000017 .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf bfo:BFO_0000017 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en .

bfo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en .

bfo:RO_0000091 a owl:ObjectProperty ;
    rdfs:label "has disposition"@en .

presalt:Calcite a owl:Class ;
    rdfs:label "Calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral that consists of calcium carbonate and commonly forms a major constituent of carbonate reservoir rocks in the Brazilian Pre-Salt. In these reservoirs, calcite occurs in facies such as microbialites and can be altered during diagenesis, including replacement by dolomite through dolomitization. Its abundance strongly influences reservoir properties because subsequent dissolution, cementation, or replacement affects porosity and permeability."@en ;
    rdfs:subClassOf presalt:CarbonateMineral .

presalt:ChemicalSedimentaryRock a owl:Class ;
    rdfs:label "Chemical Sedimentary Rock"@en ;
    rdfs:comment "Chemical sedimentary rock is a sedimentary rock that forms by the precipitation of dissolved minerals directly from water rather than by the accumulation of transported clastic particles. In the Brazilian Pre-Salt context, evaporites are a key example of chemical sedimentary rocks, precipitated from evaporating water bodies and commonly acting as the regional seal above carbonate reservoirs."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "Diagenetic Process"@en ;
    rdfs:comment "Diagenetic process is a geological process that alters the mineralogical and petrophysical properties of sediment or rock after deposition through physical and chemical modification. In Brazilian Pre-Salt carbonate reservoirs, diagenetic processes such as dolomitization can replace calcite with dolomite and thereby modify porosity and permeability. These post-depositional changes are important controls on reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Dolomite a owl:Class ;
    rdfs:label "Dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral that consists of calcium magnesium carbonate and commonly occurs as a major constituent of carbonate reservoir rocks. In the Brazilian Pre-Salt context, it is important because it can form through dolomitization, a diagenetic replacement of calcite that often improves reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:CarbonateMineral .

presalt:Dolomitization a owl:Class ;
    rdfs:label "Dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that replaces calcite with dolomite in carbonate rocks. In Brazilian Pre-Salt reservoirs, this mineral replacement commonly enhances porosity and permeability, thereby improving reservoir quality and fluid flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticProcess .

presalt:Hydrocarbonstorageandtransmissiondisposition a owl:Class ;
    rdfs:label "HydrocarbonStorageAndTransmissionDisposition"@en ;
    rdfs:comment "A disposition that is borne by a body of rock with sufficient porosity and permeability to store and transmit hydrocarbons."@en ;
    rdfs:subClassOf bfo:BFO_0000016 .

presalt:Permeability a owl:Class ;
    rdfs:label "Permeability"@en ;
    rdfs:comment "Permeability is a physical property of rock that quantifies its ability to transmit fluids through interconnected pore spaces and fractures. In Brazilian Pre-Salt carbonate reservoirs, it is a primary control on reservoir quality together with porosity, and it can be enhanced by diagenetic processes such as dolomitization. Faults may also influence permeability by acting either as fluid-migration pathways or as barriers within the reservoir."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        presalt:PhysicalPropertyOfRock .

presalt:PetroleumTrap a owl:Class ;
    rdfs:label "Petroleum Trap"@en ;
    rdfs:comment "Petroleum trap is a subsurface geological configuration that prevents the further migration of hydrocarbons and allows them to accumulate in a reservoir beneath an effective seal. In the Brazilian Pre-Salt, traps commonly involve structural deformation of rock layers, while evaporites typically provide the regional seal and faults may act either as migration pathways or as sealing barriers."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Porosity a owl:Class ;
    rdfs:label "Porosity"@en ;
    rdfs:comment "Porosity is a physical property of rock that is defined as the ratio of void space to total rock volume. In Brazilian Pre-Salt carbonate reservoirs, porosity is a primary control on reservoir quality because it governs the rock's capacity to store fluids, and it may be enhanced by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        presalt:PhysicalPropertyOfRock .

presalt:Regionalsealrole a owl:Class ;
    rdfs:label "RegionalSealRole"@en ;
    rdfs:comment "A role that is borne by a stratigraphic unit that prevents the vertical escape of hydrocarbons and seals petroleum accumulations over a broad area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000054 ;
            owl:someValuesFrom bfo:BFO_0000015 ],
        bfo:BFO_0000023 .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "geological object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "geological process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "amount of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000013 a owl:ObjectProperty ;
    rdfs:label "generated by"@en .

georeservoir:GEOCORE_0000017 a owl:ObjectProperty ;
    rdfs:label "constituted by"@en .

georeservoir:GEORES_0000039 a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

presalt:PetroleumReservoirRock a owl:Class ;
    rdfs:label "Petroleum Reservoir Rock"@en ;
    rdfs:comment "Petroleum reservoir rock is a subsurface rock unit that has sufficient porosity and permeability to store and transmit hydrocarbons. In the Brazilian Pre-Salt, reservoir rocks are commonly carbonate rocks composed of minerals such as calcite and dolomite, with microbialites forming a primary reservoir facies in the Santos Basin. Their reservoir quality depends mainly on the rock's capacity to contain void space and allow fluid flow, which can be modified by diagenetic processes such as dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        georeservoir:GEORES_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( georeservoir:GEORES_0000001 [ a owl:Restriction ;
                        owl:onProperty bfo:RO_0000091 ;
                        owl:someValuesFrom presalt:Hydrocarbonstorageandtransmissiondisposition ] ) ] .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "geological structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "earth material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "stratigraphic unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:comment "Carbonate mineral is a mineral that contains the carbonate ion (CO3^2-) as a fundamental structural component, commonly including phases such as calcite and dolomite. In Brazilian Pre-Salt carbonate reservoirs, these minerals constitute the framework of reservoir rocks and strongly influence diagenetic processes, porosity evolution, and reservoir quality."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:PhysicalPropertyOfRock a owl:Class ;
    rdfs:label "Physical Property of Rock"@en ;
    rdfs:comment "Physical Property Of Rock is a quality that inheres in rock and characterizes a measurable physical aspect of that rock."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom bfo:BFO_0000004 ],
        bfo:BFO_0000019 .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

