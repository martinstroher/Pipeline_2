@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix georeservoir: <https://www.inf.ufrgs.br/bdi/ontologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix presalt: <https://w3id.org/presalt-onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

presalt:AbioticPrecipitation a owl:Class ;
    rdfs:label "abiotic precipitation"@en ;
    rdfs:comment "Abiotic precipitation is a chemical process that forms minerals directly from a supersaturated solution without the mediating influence of biological activity. In Brazilian Pre-Salt lacustrine settings, it is driven by factors like elevated pH and rapid evaporation from highly saturated solutions, resulting in crystalline fabrics, such as spherulitic carbonates, that lack evidence of microbial mediation like trapping or binding textures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineSetting ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Mineral ],
        presalt:Precipitation .

presalt:Albian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "albian"@en ;
    rdfs:comment "Albian is a geological age of the Early Cretaceous Epoch that spans the time from approximately 113 to 100.5 million years ago. In the context of the South Atlantic passive margin, the Albian marks the onset of the post-salt drift sequence, characterized by the establishment of open marine environments following the deposition of the Aptian evaporites. Typical Albian deposits in the Santos Basin include platform to deep-water carbonates and siliciclastics, such as the limestones of the Guarujá Formation."@en .

presalt:AlkalineLake a owl:Class ;
    rdfs:label "alkaline lake"@en ;
    rdfs:comment "An alkaline lake is a lacustrine body of water that is characterized by a persistently high pH, often exceeding 10, making it hyper-alkaline. In Pre-Salt basins, this alkalinity is typically driven by a combination of accelerated weathering, magmatic-hydrothermal inputs, and intense evaporation, which promotes the abiotic precipitation of carbonates and Mg-silicates while inhibiting most metazoan life."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:AlluvialFan a owl:Class ;
    rdfs:label "alluvial fan"@en ;
    rdfs:comment "Alluvial fan is a fan-shaped depositional landform that is built by the accumulation of sediment deposited by streams or debris flows at the base of a topographic high, such as a fault scarp in an extensional basin. In arid rift settings like the Brazilian Pre-Salt, these fans often prograde into lacustrine environments, where their distal sheet flood and terminal splay deposits are reworked by waves. This process can generate texturally mature carbonate grainstones and rudstones that form important reservoir bodies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        georeservoir:GEORES_0000006 .

presalt:Aragonite a owl:Class ;
    rdfs:label "aragonite"@en ;
    rdfs:comment "Aragonite is a mineral polymorph of calcium carbonate (CaCO₃) that is chemically identical to calcite but has a different crystal structure and is less stable under typical surface and burial conditions. In the context of Brazilian Pre-Salt reservoirs, aragonite is a primary mineral composing the shells of organisms like bivalves and gastropods. Its high susceptibility to dissolution and neomorphism during diagenesis makes it a critical control on the development of secondary porosity and overall reservoir quality in lacustrine carbonate systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Neomorphism ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:CarbonateMineral .

presalt:Barite a owl:Class ;
    rdfs:label "barite"@en ;
    rdfs:comment "Barite is a barium sulfate mineral that occurs in Brazilian Pre-Salt carbonates as a secondary, diagenetic phase. In this setting, it commonly exhibits prismatic habits, acts as a pore- and fracture-filling cement, and is often associated with silicification in facies such as calcilutites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PreSaltCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:Mineral .

presalt:Barremian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Barremian"@en ;
    rdfs:comment "Barremian is a geological age of the Early Cretaceous Epoch that follows the Valanginian and precedes the Aptian, corresponding to a critical syn-rift depositional phase in the South Atlantic basins. In the Brazilian Pre-Salt, this period is characterized by the deposition of lacustrine syn-rift sequences, such as the Piçarras Formation (K36 sequence) and the basal sections of the overlying carbonate succession (e.g., K38 sequence), which form the lower pre-salt interval."@en .

presalt:BaseOfSalt a owl:NamedIndividual,
        presalt:RegionalUnconformity ;
    rdfs:label "base of salt"@en ;
    rdfs:comment "The base of salt is a regional stratigraphic surface, often an unconformity, that marks the boundary between the overlying Aptian evaporite sequence and the underlying pre-salt carbonate succession. In the Brazilian Pre-Salt, this surface corresponds to the top of the Barra Velha Formation and is seismically characterized as a high-amplitude, continuous reflection."@en .

presalt:BasementHigh a owl:Class ;
    rdfs:label "basement high"@en ;
    rdfs:comment "A basement high is a structurally elevated block of crystalline basement rock that forms a positive paleotopographic feature, often a fault-bounded horst, which controls the depositional architecture of overlying sedimentary sequences. In the Brazilian Pre-Salt, these highs serve as platforms for the development of extensive lacustrine carbonate reservoirs. The pre-salt sedimentary package is typically thinner over the crest of these highs due to onlap and may be locally absent due to non-deposition or erosion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Basement ],
        presalt:TectonicFeature .

presalt:BasementStructure a owl:Class ;
    rdfs:label "basement structure"@en ;
    rdfs:comment "A basement structure is a large-scale tectonic feature of the crystalline or volcanic basement that is defined by fault-bounded blocks such as horsts, grabens, and half-grabens formed during rifting. These features create the fundamental paleotopography that controls the accommodation space, depositional patterns, and subsequent deformation of overlying sedimentary sequences, including the pre-salt carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Horst ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Basement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Graben ],
        presalt:TectonicFeature .

presalt:BedPlane a owl:Class ;
    rdfs:label "bed plane"@en ;
    rdfs:comment "A bed plane is a surface of discontinuity that marks the boundary between successive sedimentary layers, such as beds or laminae. In subsurface analysis, particularly from borehole image logs, these planes are identified as distinct features whose measured orientation (dip and azimuth) is used to interpret the structural attitude and depositional geometry of the strata."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Bed ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Dip ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Lamina ],
        presalt:Discontinuity .

presalt:BioclasticDeposit a owl:Class ;
    rdfs:label "bioclastic deposit"@en ;
    rdfs:comment "A bioclastic deposit is a sedimentary accumulation that is predominantly composed of whole or fragmented skeletal remains of organisms, such as bivalves, gastropods, and ostracods. Within the Brazilian Pre-Salt lacustrine carbonate systems, these deposits typically show evidence of significant reworking and are redeposited by gravitational flows, storm events, or wave action into settings ranging from shallow-water ridges to deeper basinal lows. Due to their potential for high porosity, these redeposited accumulations form significant hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Gastropod ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Ostracod ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonateSystem ],
        presalt:SedimentaryDeposit .

presalt:Biofilm a owl:Class ;
    rdfs:label "biofilm"@en ;
    rdfs:comment "A biofilm is a microbial community that adheres to a substrate, forming a cohesive layer which significantly influences sedimentary and diagenetic processes in carbonate systems. In the context of Brazilian Pre-Salt carbonates, biofilms act as templates for spherulite growth, serve as nucleation sites for calcite and dolomite, and can form protective mats that prevent the influx of clastic sediments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Substrate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        bfo:BFO_0000027 .

presalt:BivalveRudstone a owl:Class ;
    rdfs:label "bivalve rudstone"@en ;
    rdfs:comment "Bivalve rudstone is a grain-supported bioclastic carbonate rock that is predominantly composed of whole or fragmented bivalve shells, often with minor gastropod and ostracod components. Commonly found in lacustrine Pre-Salt settings, these rocks are typically poorly sorted with a chaotic fabric of disarticulated shells and constitute a major reservoir facies due to the development of significant interparticle, intraparticle, and moldic porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Gastropod ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Ostracod ],
        presalt:BioclasticRudstone .

presalt:Calcilutite a owl:Class ;
    rdfs:label "calcilutite"@en ;
    rdfs:comment "Calcilutite is a fine-grained clastic carbonate rock that is composed of silt- and clay-sized particles of complex orthochemical and allochemical origin. Within the Brazilian Pre-Salt, it is characterized by diverse textures including peloidal and microbial fabrics, and is often heavily altered by diagenetic processes such as dolomitization and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        presalt:ClasticCarbonateRock .

presalt:CalciteCement a owl:Class ;
    rdfs:label "calcite cement"@en ;
    rdfs:comment "Calcite cement is an authigenic crystalline carbonate mineral that precipitates from pore fluids within sedimentary rocks, binding grains and occluding primary or secondary porosity. In Brazilian Pre-Salt carbonates, it is a principal cement in bioclastic grainstones and rudstones, presenting various morphologies including microcrystalline rims, drusy, blocky, and coarse mosaic crystals. This cement fills interparticle, intraparticle, moldic, and fracture pores, generally reducing reservoir quality, but can also be dissolved to create secondary porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Rudstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:BioclasticGrainstone ],
        presalt:Cement .

presalt:CarbonateSystem a owl:Class ;
    rdfs:label "carbonate system"@en ;
    rdfs:comment "A carbonate system is a sedimentary system that encompasses the interconnected environments, physicochemical and biological processes, and resulting rock bodies associated with the production, accumulation, and diagenesis of carbonate sediments. In the Brazilian Pre-Salt, this refers to the unique late- to post-rift lacustrine system where alkaline and hypersaline waters, influenced by hydrothermal and volcanic inputs, controlled the development of complex microbial, abiogenic, and biogenic carbonate accumulations that form major petroleum reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEORES_0000020 .

presalt:Chert a owl:Class ;
    rdfs:label "chert"@en ;
    rdfs:comment "Chert is a cryptocrystalline siliceous rock that, in the Pre-Salt context, primarily forms by direct precipitation from silica-rich, highly evaporated lacustrine waters, often mediated by microbial activity. It commonly occurs as microbial boundstones forming large buildups on topographic highs, but can also be found as a replacive diagenetic mineral. Composed of microcrystalline quartz and chalcedony, these rocks often develop significant vuggy and fracture porosity, making them a major reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VuggyPorosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:MicrocrystallineQuartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Chalcedony ],
        georeservoir:GEORES_0000032 .

presalt:Conglomerate a owl:Class ;
    rdfs:label "conglomerate"@en ;
    rdfs:comment "Conglomerate is a clastic sedimentary rock that is composed of rounded to subrounded, gravel-sized clasts (greater than 2 mm in diameter) set within a finer-grained matrix. In Pre-Salt settings, these rocks are deposited in high-energy environments such as alluvial fans and contain compositionally diverse clasts, ranging from extra-basinal basement and metamorphic rocks to intra-basinal reworked silica and carbonate fragments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Clast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Matrix ],
        presalt:ClasticSedimentaryRock .

presalt:ContinentalSiliciclasticDeposit a owl:Class ;
    rdfs:label "continental siliciclastic deposit"@en ;
    rdfs:comment "Continental siliciclastic is a class of sedimentary deposit or rock that is composed primarily of silicate minerals, such as quartz, feldspar, and mica, and deposited in a non-marine terrestrial environment. In the Brazilian Pre-Salt, these deposits are characteristic of the rift super-sequence, exemplified by the Piçarras Formation, and represent deposition in settings like fluvial or alluvial systems adjacent to the main lacustrine depocenters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Mica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Feldspar ],
        presalt:Deposit .

presalt:CoqueirosFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Coqueiros Formation"@en ;
    rdfs:comment "Coqueiros Formation is a Lower Cretaceous stratigraphic unit that is composed predominantly of bioclastic carbonate rocks, known as coquinas, deposited during the rift phase of the Brazilian Pre-Salt basins. These rocks are primarily rudstones and grainstones made of bivalve, gastropod, and ostracod bioclasts, which were deposited in a variety of lacustrine settings and are often intercalated with organic shales. Considered Barremian to Aptian in age, this formation constitutes a major reservoir interval in basins such as the Campos Basin, where its porous coquinas hold significant hydrocarbon accumulations."@en .

presalt:Cretaceous a owl:NamedIndividual,
        presalt:GeologicalPeriod ;
    rdfs:label "cretaceous"@en ;
    rdfs:comment "Cretaceous is a geologic period of the Mesozoic Era that spans from approximately 145 to 66 million years ago, following the Jurassic and preceding the Paleogene. In the context of the South Atlantic marginal basins, the Lower Cretaceous is the epoch of continental rifting and the deposition of the economically significant lacustrine Pre-Salt carbonate successions, while the Upper Cretaceous corresponds to the overlying marine post-salt drift sequence."@en .

presalt:Current a owl:Class ;
    rdfs:label "current"@en ;
    rdfs:comment "A current is a directional movement of a fluid, such as water, that transports and deposits sedimentary particles. In a sedimentary context, currents are responsible for the winnowing of fine-grained material, like clay, and the concentration of coarser grains, leading to the formation of well-sorted deposits such as grainstones. Within the Pre-Salt lacustrine environments, currents are a critical mechanism for creating high-energy depositional facies that form important hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        presalt:SedimentaryProcess .

presalt:Cyclothem a owl:Class ;
    rdfs:label "cyclothem"@en ;
    rdfs:comment "Cyclothem is a repetitive, shallowing-upward stratigraphic succession that represents a single depositional cycle within the alkaline lacustrine environments of the Brazilian Pre-Salt. A typical cycle begins with laminated mud-grade carbonates deposited during a flooding phase, transitioning upwards into spherulitic and shrub-like carbonates precipitated from evaporating, Mg-rich waters, and is often capped by grainstones of reworked carbonate debris."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Grainstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:AlkalineLacustrineEnvironment ],
        georeservoir:GEORES_0000020 .

presalt:Dawsonite a owl:Class ;
    rdfs:label "dawsonite"@en ;
    rdfs:comment "Dawsonite is a sodium aluminum carbonate hydroxide mineral that occurs as a diagenetic, secondary accessory phase within Brazilian Pre-Salt carbonate reservoirs. It is typically identified through XRD and petrographic analysis and is commonly associated with a paragenesis including fluorite, pyrite, barite, and dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        presalt:CarbonateMineral .

presalt:Depocenter a owl:Class ;
    rdfs:label "depocenter"@en ;
    rdfs:comment "A depocenter is a structural low within a sedimentary basin that experiences the greatest thickness of sediment accumulation for a given stratigraphic interval. In rift settings such as the Brazilian Pre-Salt, these features are commonly formed in the hanging walls of normal faults or within half-grabens, providing the primary accommodation space for the deposition of syn-rift sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SedimentaryBasin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:HangingWall ],
        georeservoir:GEOCORE_0000004 .

presalt:DepositionalFacies a owl:Class ;
    rdfs:label "depositional facies"@en ;
    rdfs:comment "A depositional facies is a distinct body of rock that is characterized by a specific set of lithological, textural, and structural attributes reflecting the conditions of its original depositional environment. In the context of Brazilian Pre-Salt carbonates, these facies are broadly classified into in-situ deposits, such as shrub-like growths, and reworked deposits, including intraclastic or spherulitic grainstones and mudstones. The distribution and characteristics of these facies are controlled by environmental factors like lake level and hydrodynamic energy."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:DetritalGrain a owl:Class ;
    rdfs:label "detrital grain"@en ;
    rdfs:comment "A detrital grain is a siliciclastic mineral particle that has been transported from an external source area and deposited within a carbonate sedimentary succession. In the Brazilian Pre-Salt, these grains are typically silt to fine sand-sized and composed of minerals such as quartz, feldspar, and mica, sourced from the crystalline basement, volcanic rocks, or the basin margin. They generally occur in low abundances, either incorporated within carbonate components, trapped by microbial mats, or occupying pore spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CrystallineBasement ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Mica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Feldspar ],
        georeservoir:GEOCORE_0000001 .

presalt:DolomiteCement a owl:Class ;
    rdfs:label "dolomite cement"@en ;
    rdfs:comment "Dolomite cement is an authigenic carbonate mineral that precipitates from formation fluids to fill primary or secondary porosity within a sedimentary rock. In Brazilian Pre-Salt reservoirs, it is a volumetrically significant diagenetic phase that commonly reduces porosity by occluding interparticle and vugular pores, occurring in various morphologies including rhombohedral, mosaic, and saddle dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Cement .

presalt:DolomiteCementation a owl:Class ;
    rdfs:label "dolomite cementation"@en ;
    rdfs:comment "Dolomite cementation is a diagenetic process that involves the precipitation of dolomite crystals from pore fluids, filling primary or secondary porosity within a sedimentary rock. In Pre-Salt carbonates, this process is a key control on reservoir quality, typically reducing porosity by occluding pore space, and can manifest in various morphologies including rhombohedral, blocky, granular mosaic, and saddle dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Cementation .

presalt:DolomiteRhomb a owl:Class ;
    rdfs:label "dolomite rhomb"@en ;
    rdfs:comment "A dolomite rhomb is a crystal of the mineral dolomite that is characterized by a well-developed, euhedral rhombohedral morphology. In Brazilian Pre-Salt carbonates, these diagenetic crystals typically range from 25 to 100 micrometers in diameter, often display concentric zonation, and can occur as a replacement phase with displacive growth in clay-rich matrices or as a pore-filling cement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Replacement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Morphology ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        georeservoir:GEOCORE_0000006 .

presalt:Dolomudstone a owl:Class ;
    rdfs:label "dolomudstone"@en ;
    rdfs:comment "Dolomudstone is a carbonate mudstone that is primarily composed of mud-grade dolomite crystals. This rock typically exhibits a very fine texture and may contain fine calcite particles and clay minerals, often occurring in the Pre-Salt as laminated facies with low matrix porosity but potential for significant fracture porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ClayMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:Dolostone .

presalt:DriftPhase a owl:Class ;
    rdfs:label "drift phase"@en ;
    rdfs:comment "Drift phase is a tectonostratigraphic stage in basin evolution that follows the rifting and post-rift/sag phases, characterized by the onset of seafloor spreading, the development of oceanic crust, and the establishment of a passive margin. Initiating in the Albian in the Santos Basin, this phase is marked by widespread thermal subsidence and the deposition of open marine sediments, initially carbonates and later dominated by thick siliciclastic successions. This stage also involves ongoing subsidence and fault reactivation, which can drive magmatism and fluid flow that impact diagenesis in underlying reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:FaultReactivation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:PostRift ],
        presalt:TectonoStratigraphicInterval .

presalt:EarlyAptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "early aptian"@en ;
    rdfs:comment "Early Aptian is a geological age of the Early Cretaceous Period that encompasses the time from approximately 125 to 120 million years ago, representing a key transitional phase in the evolution of the South Atlantic margin. In the Brazilian Pre-Salt, this age marks the transition from the late rift to the sag phase, characterized by the deposition of the lacustrine Itapema Formation (source rocks and coquina reservoirs) and culminating in the deposition of the thick regional salt seal."@en .

presalt:EconomicBasement a owl:Class ;
    rdfs:label "economic basement"@en ;
    rdfs:comment "Economic basement is a stratigraphic unit that, in the context of the Brazilian Pre-Salt, is composed of Hauterivian-age continental basalts of the Camboriú Formation, forming the lower boundary for petroleum exploration. This unit represents the Syn-Rift I tectonic phase and is separated from the underlying, older acoustic basement by a major unconformity. Seismically, its top is typically a high-amplitude reflector due to the impedance contrast with overlying sediments, while its internal character is chaotic or reflection-free."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Basalt ],
        georeservoir:GEOCORE_0000001 .

presalt:Eoaptian a owl:NamedIndividual,
        presalt:GeologicalSubAge ;
    rdfs:label "eoaptian"@en ;
    rdfs:comment "Eoaptian is the earliest subdivision of the Aptian Age that, in the context of the Brazilian Pre-Salt, corresponds to the terminal phase of syn-rift deposition. This interval includes the deposition of the upper part of the Itapema Formation, which contains significant coquina reservoirs, and immediately precedes the main phase of evaporite deposition that forms the regional seal."@en .

presalt:Eodiagenesis a owl:Class ;
    rdfs:label "eodiagenesis"@en ;
    rdfs:comment "Eodiagenesis is the initial stage of diagenesis that occurs shortly after deposition at shallow burial depths, characterized by processes influenced by the depositional environment. In Brazilian Pre-Salt carbonates, this stage includes mechanical compaction, dissolution of unstable minerals like Mg-clays and calcite, and early cementation by microcrystalline quartz, calcite, and fine rhombohedral dolomite. These processes, which can be influenced by meteoric water, significantly alter the primary fabric and initiate the development of secondary porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:SedimentWaterInterface ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:MechanicalCompaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:DiageneticStage .

presalt:FascicularCalciteCrust a owl:Class ;
    rdfs:label "fascicular calcite crust"@en ;
    rdfs:comment "A fascicular calcite crust is an abiotic carbonate precipitate that is characterized by a fabric of plumose, increasingly divergent (fascicular-optic) calcite crystal aggregates forming a shrub-like morphology. These crusts form as syngenetic to early diagenetic precipitates at or near the sediment-water interface in alkaline lacustrine environments, constituting a primary reservoir facies in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:FaultActivity a owl:Class ;
    rdfs:label "fault activity"@en ;
    rdfs:comment "Fault activity is a tectonic process that encompasses the movement and displacement along a fault or fault system over a specific geological time interval. In rift basins such as the Brazilian Pre-Salt, this process is a primary control on the creation of accommodation space, the distribution of depocenters, and the architecture of sedimentary sequences. Its timing and intensity are commonly inferred from seismic data through the analysis of stratal thickness variations, syn-kinematic reflector geometries, and stratal terminations against the fault plane."@en ;
    rdfs:subClassOf presalt:TectonicActivity .

presalt:FaultSystem a owl:Class ;
    rdfs:label "fault system"@en ;
    rdfs:comment "A fault system is a set of genetically related faults that are grouped based on shared characteristics such as structural style, orientation, kinematics, and a common period of activity. In rift basins, distinct fault systems are often defined by the specific syn-rift stratigraphic sequences for which they controlled accommodation space and deposition. These systems can be hierarchically organized and may exhibit reactivation during subsequent tectonic phases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:FaultReactivation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        georeservoir:GEOCORE_0000004 .

presalt:FaultZone a owl:Class ;
    rdfs:label "fault zone"@en ;
    rdfs:comment "A fault zone is a tabular volume of deformed rock that accommodates displacement and is structurally composed of a central, highly strained fault core and a surrounding, less intensely deformed damage zone. The fault core contains fault rocks such as breccias and cataclasites, while the damage zone consists of a network of associated fractures that decrease in density away from the core. In carbonate successions like the Brazilian Pre-Salt, these zones act as critical conduits for fluid flow, controlling diagenetic processes like karstification and significantly impacting reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:FluidFlow ],
        georeservoir:GEOCORE_0000004 .

presalt:Floatstone a owl:Class ;
    rdfs:label "floatstone"@en ;
    rdfs:comment "Floatstone is a matrix-supported carbonate rock that contains more than 10% of components larger than 2 mm in diameter which are supported by a finer-grained matrix. In the Brazilian Pre-Salt, these larger components often consist of microbialite fragments, tufas, oncoids, or mollusk shells, while the supporting matrix is typically composed of sand, silt, or micrite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Matrix ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Oncoid ],
        presalt:MatrixSupportedCarbonateRock .

presalt:Fluorite a owl:Class ;
    rdfs:label "fluorite"@en ;
    rdfs:comment "Fluorite is a halide mineral composed of calcium fluoride (CaF₂) that occurs as a secondary, late-stage diagenetic phase within Pre-Salt carbonate reservoirs. In this setting, it is considered a product of hydrothermal alteration, precipitating from migrating fluids and commonly found at the margins of dissolution-enhanced pores in association with minerals like saddle dolomite, barite, and goyazite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:HydrothermalAlteration ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:Mineral .

presalt:Fold a owl:Class ;
    rdfs:label "fold"@en ;
    rdfs:comment "A fold is a geological structure that is formed by the ductile deformation and bending of rock layers, often in association with faulting. In Brazilian Pre-Salt rift settings, they commonly occur as extensional fault-propagation folds, transverse folds associated with relay ramps, and hanging wall folds related to displacement variations along normal faults. These structures can develop during syn-rift extension or later post-rift tectonic inversion, influencing the geometry of reservoir units."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:Footwall a owl:Class ;
    rdfs:label "footwall"@en ;
    rdfs:comment "Footwall is the structural block that lies beneath an inclined fault plane. In extensional rift settings such as the Brazilian Pre-Salt, uplift of the footwall along normal faults creates structural highs or shoulders. These uplifted areas often control deposition, serving as preferential sites for the accumulation of shallow-water carbonate reservoirs and, when exposed to erosion, as sources of clastic sediment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Fault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Erosion ],
        presalt:StructuralBlock .

presalt:Fragmentation a owl:Class ;
    rdfs:label "fragmentation"@en ;
    rdfs:comment "Fragmentation is a physical sedimentary process that involves the mechanical breaking of larger grains, particularly bioclastic shells, into smaller pieces. The degree of fragmentation, often assessed alongside abrasion and sorting, is a key textural attribute used to interpret the energy of the depositional environment and directly influences the resulting rock's reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Grain ],
        presalt:SedimentaryProcess .

presalt:Framestone a owl:Class ;
    rdfs:label "framestone"@en ;
    rdfs:comment "Framestone is an in-situ carbonate boundstone that is characterized by a rigid, self-supporting framework constructed by dendritic, shrub-like crystal growths. In the context of the Brazilian Pre-Salt, this facies is primarily composed of non-magnesian, fibrous-radial calcite crystal shrubs which create significant primary growth-framework porosity critical for reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Cement ],
        presalt:Boundstone .

presalt:Gypsum a owl:Class ;
    rdfs:label "gypsum"@en ;
    rdfs:comment "Gypsum is a hydrous calcium sulfate mineral (CaSO₄·2H₂O) that, within the Pre-Salt context, is observed as a late-stage diagenetic product filling dissolution fractures. The general absence of primary, bedded gypsum deposits in the Barra Velha Formation is a key line of evidence used to argue against a marine or hypersaline evaporitic origin for these lacustrine carbonates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:Mineral .

presalt:Halokinesis a owl:Class ;
    rdfs:label "halokinesis"@en ;
    rdfs:comment "Halokinesis is a geological process that involves the subsurface mobilization and flow of salt deposits due to their physical properties. This process, often triggered by differential loading from overlying sediments, controls the structural styles of petroleum systems by forming features like diapirs and canopies. In the Santos Basin, halokinesis is a critical mechanism that impacts the geometric arrangement of strata and can create windows in the salt seal, providing migration pathways for hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:SantosBasin ],
        georeservoir:GEOCORE_0000002 .

presalt:Hauterivian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "hauterivian"@en ;
    rdfs:comment "Hauterivian is a geological age of the Early Cretaceous Epoch that follows the Valanginian and precedes the Barremian, spanning approximately from 132.6 to 129.4 million years ago. In the context of the Brazilian Pre-Salt basins, the Hauterivian corresponds to an early phase of the rift stage, characterized by the formation of structural lows like half-grabens and the deposition of the Camboriú Formation."@en .

presalt:HydrothermalVent a owl:Class ;
    rdfs:label "hydrothermal vent"@en ;
    rdfs:comment "A hydrothermal vent is a pipe-like geological complex that is formed by the fracturing of rock and subsequent transport and eruption of deep-sourced, geothermally heated fluids and sediments. In Pre-Salt rift settings, these systems influence the lacustrine depositional environment by supplying ions for carbonate precipitation and drive diagenetic alterations, such as dissolution, that can significantly enhance reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:CarbonatePrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        georeservoir:GEOCORE_0000004 .

presalt:Illite a owl:Class ;
    rdfs:label "illite"@en ;
    rdfs:comment "Illite is a non-expanding phyllosilicate clay mineral that is structurally intermediate between muscovite and smectite. In the context of the Brazilian Pre-Salt, it is found as a diagenetic mineral within carbonate facies of formations such as the Barra Velha, often occurring as a minor component or as interstratified mixed-layer illite/smectite clays."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:ClayMineral .

presalt:InSituFacies a owl:Class ;
    rdfs:label "in situ facies"@en ;
    rdfs:comment "In situ facies is a category of lacustrine carbonate rocks, specific to the Brazilian Pre-Salt, that is defined by a primary composition of mud, calcite spherulites, and fascicular calcite shrubs interpreted as having formed in place. The classification of specific rock types within this group is based on the relative proportions of these components, with the name derived from the most abundant constituent. This facies group is a key component of Pre-Salt reservoirs and is distinguished from reworked facies, which are composed of transported grains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Mud ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        presalt:CarbonateFacies .

presalt:IntercrystallinePore a owl:Class ;
    rdfs:label "intercrystalline pore"@en ;
    rdfs:comment "An intercrystalline pore is a type of secondary porosity that is located in the spaces between adjacent crystals within a crystalline fabric. In Brazilian Pre-Salt carbonates, this porosity commonly results from diagenetic processes such as dolomitization, where it develops between dolomite rhombs, and is a significant pore type in facies like shrubstones, spherulstones, and calcarenites. These pores are often irregular, can be enlarged by subsequent dissolution, and contribute significantly to reservoir storage, although connectivity can be variable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Calcarenite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Shrubstone ],
        presalt:Pore .

presalt:IntraAlagoasUnconformity a owl:NamedIndividual,
        presalt:Unconformity ;
    rdfs:label "intra-alagoas unconformity"@en ;
    rdfs:comment "The Intra-Alagoas Unconformity is a major stratigraphic surface that represents an unconformity or correlative conformity internally dividing the Aptian-age Barra Velha Formation in the Brazilian Pre-Salt. Dated to approximately 117 Ma and also known as the base sag, it is seismically characterized as a high-amplitude reflector that is prominent on paleohighs and serves as a key marker for sequence stratigraphic analysis between the Pre-Alagoas and Base of Salt unconformities."@en .

presalt:Jurassic a owl:NamedIndividual,
        presalt:GeologicalPeriod ;
    rdfs:label "jurassic"@en ;
    rdfs:comment "Jurassic is a geologic period and system that constitutes the middle part of the Mesozoic Era, spanning the time from approximately 201.3 to 145 million years ago. It follows the Triassic Period and precedes the Cretaceous Period and is notable for the dominance of dinosaurs and the initial breakup of the supercontinent Pangaea. In the South Atlantic margin, Jurassic successions are associated with the pre-rift and earliest syn-rift phases, preceding the main Aptian carbonate deposition of the Pre-Salt."@en .

presalt:KFeldspar a owl:Class ;
    rdfs:label "k-feldspar"@en ;
    rdfs:comment "K-feldspar is a tectosilicate mineral of the feldspar group that is characterized by the chemical formula KAlSi₃O₈. In the context of Brazilian Pre-Salt carbonate reservoirs, it typically occurs as a secondary, authigenic mineral formed during diagenesis, often identified within various facies through petrographic, XRD, and QEMSCAN analyses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Feldspar ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Composition ],
        presalt:TectosilicateMineral .

presalt:Karst a owl:Class ;
    rdfs:label "karst"@en ;
    rdfs:comment "Karst is a terrain and associated set of subsurface features that is formed by the dissolution of soluble rocks, such as carbonates, by percolating aqueous fluids. In Pre-Salt carbonate reservoirs, this process is strongly controlled by faults and fractures and can create a stratigraphically discordant non-matrix pore system, significantly enhancing reservoir quality. However, excessive karstification can also lead to collapse and the formation of low-quality karst breccia, with both hypogenic (ascending fluids) and epigenic (subaerial exposure) karst systems being recognized."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:PoreSpace ],
        presalt:DiageneticFeature .

presalt:Kerolite a owl:Class ;
    rdfs:label "kerolite"@en ;
    rdfs:comment "Kerolite is a magnesian clay mineral that is a principal clay component within the lacustrine carbonate reservoirs of the Brazilian Pre-Salt. It is commonly identified through XRD analysis and occurs within various facies, including Mg-claystones, intraclastic grainstones, and fascicular calcite crusts. Within the Barra Velha Formation, its abundance typically increases in the upper stratigraphic units, where it is often associated with mixed-layer kerolite/Mg-smectite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:IntraclasticGrainstone ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonateReservoir ],
        presalt:ClayMineral .

presalt:LacustrineCarbonatePlatform a owl:Class ;
    rdfs:label "lacustrine carbonate platform"@en ;
    rdfs:comment "A lacustrine carbonate platform is a carbonate platform that develops within a lacustrine system, typically on a structural high, and is composed of non-marine carbonate grains and organisms. In the Brazilian Pre-Salt, these platforms formed during the sag phase of rift basins and are primarily built by microbial boundstones, spherulites, and intraclasts. These large, seismically-mappable features constitute the main petroleum reservoirs of the Pre-Salt, with facies like grainstones and boundstones hosting significant porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:StructuralHigh ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Boundstone ],
        presalt:CarbonatePlatform .

presalt:LacustrineDeposit a owl:Class ;
    rdfs:label "lacustrine deposit"@en ;
    rdfs:comment "A lacustrine deposit is a sedimentary rock that forms from the accumulation of chemical, biological, or detrital materials within a lake environment. In the Brazilian Pre-Salt, these deposits are predominantly Lower Cretaceous carbonates (such as bioclastic accumulations) and magnesian clays that accumulated in tectonically active rift basins. These deposits constitute the primary hydrocarbon reservoirs beneath the extensive South Atlantic salt layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:MgSilicateClay ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        presalt:Deposit .

presalt:LacustrineEnvironment a owl:Class ;
    rdfs:label "lacustrine environment"@en ;
    rdfs:comment "A lacustrine environment is a continental depositional environment that encompasses the physical, chemical, and biological conditions associated with a lake. In the context of the Brazilian Pre-Salt, this environment was characterized by alkaline, often saline waters with elevated ion concentrations, which controlled the abiotic precipitation of carbonates and the development of unique microbial and faunal communities. It is typically subdivided into distinct zones based on water depth and energy, including littoral, sublittoral, and profundal sub-environments, which dictate the distribution of facies such as microbialites and bioclastic limestones."@en ;
    rdfs:subClassOf presalt:DepositionalEnvironment .

presalt:Laminite a owl:Class ;
    rdfs:label "laminite"@en ;
    rdfs:comment "Laminite is a diagenetic facies that is characterized by fine laminations and originates from the extensive replacement of primary laminated clay deposits by carbonate minerals. In the Brazilian Pre-Salt, these rocks are interpreted as originally stevensitic clays deposited in a lacustrine setting, which subsequently underwent complex diagenetic processes including calcitization, dolomitization, and silicification."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000029 .

presalt:LateAptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "late aptian"@en ;
    rdfs:comment "The Late Aptian is a chronostratigraphic age that, in the context of the Brazilian Pre-Salt, corresponds to the final phase of syn-rift deposition preceding the main evaporite sequence. This interval is characterized by the deposition of the Upper Barra Velha Formation, which exhibits a sag-like geometry and is bounded at its top by the regional Late Aptian Syn-rift Unconformity (LASRU) dated at approximately 113 Ma."@en .

presalt:LateCretaceous a owl:NamedIndividual,
        presalt:GeologicalEpoch ;
    rdfs:label "late cretaceous"@en ;
    rdfs:comment "Late Cretaceous is a geological epoch of the Mesozoic Era, and its corresponding rock series, that spans from approximately 100.5 to 66 million years ago. In the context of the Brazilian Pre-Salt basins, this interval represents the initial phase of the post-salt drift sequence. These successions are characterized as a thick, siliciclastic-dominated sedimentary overburden deposited above the Aptian salt layer."@en .

presalt:LateJurassic a owl:NamedIndividual,
        presalt:GeologicalEpoch ;
    rdfs:label "late jurassic"@en ;
    rdfs:comment "Late Jurassic is a geological epoch of the Mesozoic Era that spans the time from approximately 163.5 to 145 million years ago, preceding the Cretaceous Period. In the context of South Atlantic geology, this epoch represents the pre-rift stage immediately before the onset of continental breakup between South America and Africa. This period is associated with the initial thermal doming and crustal extension that set the stage for the Early Cretaceous rifting and the formation of the basins where the Pre-Salt sequence was later deposited."@en .

presalt:Limestone a owl:Class ;
    rdfs:label "limestone"@en ;
    rdfs:comment "Limestone is a sedimentary rock that is composed primarily of calcium carbonate (CaCO3). In the Brazilian Pre-Salt, these rocks typically form in lacustrine environments and encompass a wide variety of facies, including bioclastic, argillaceous, and microbial carbonates, whose reservoir quality is often controlled by subsequent diagenetic alteration such as dissolution and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:CarbonateRock .

presalt:LowerBarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Lower Barra Velha Formation"@en ;
    rdfs:comment "The Lower Barra Velha Formation is a stratigraphic subdivision of the Aptian Barra Velha Formation that was deposited during the late rift phase of the Santos Basin, characterized by syn-tectonic depositional architecture. It is predominantly composed of reworked lacustrine carbonate facies, such as grainstones and rudstones, and can include intercalations of mafic volcanic rocks. Its deposition was strongly influenced by active faulting, resulting in significant thickness variations, and its top is commonly defined by the Intra-Alagoas Unconformity."@en .

presalt:MacabuFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Macabu Formation"@en ;
    rdfs:comment "The Macabu Formation is a late Aptian stratigraphic unit of the Brazilian Pre-Salt that was deposited in an alkaline, brackish-lacustrine environment under an arid climate. It constitutes a significant hydrocarbon reservoir characterized by a complex mix of lithologies, including bioclastic carbonates, stevensitic arenites, and distinctive features such as calcite shrubs, spherulites, and laminites, which are interpreted as predominantly abiotic chemical precipitates."@en .

presalt:Magnesite a owl:Class ;
    rdfs:label "magnesite"@en ;
    rdfs:comment "Magnesite is a diagenetic carbonate mineral that is composed of magnesium carbonate (MgCO3) and occurs as a secondary authigenic phase in Pre-Salt reservoirs. In the context of Pre-Salt lacustrine carbonates, it typically forms as lamellar aggregates that replace precursor magnesium-rich clays and fill shrinkage pores within the clay matrix."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PreSaltReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:MgSilicateClay ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:CarbonateMineral .

presalt:MarineFossil a owl:Class ;
    rdfs:label "marine fossil"@en ;
    rdfs:comment "A marine fossil is the preserved remains or traces of an organism that lived exclusively in a marine or restricted marine environment. The presence or absence of such fossils is a critical criterion for interpreting depositional environments, distinguishing between marine and non-marine (e.g., lacustrine) settings. In the context of the Brazilian Pre-Salt, specific microfossils like miliolid and planktonic foraminifera are considered definitive marine indicators, while fossils of organisms with wide salinity tolerance, such as certain ostracods, are not."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000018 .

presalt:MarineIncursion a owl:Class ;
    rdfs:label "marine incursion"@en ;
    rdfs:comment "Marine incursion is a geological event that involves the flooding of a continental or restricted basin by seawater, typically driven by eustatic sea-level rise or tectonic subsidence. Within the South Atlantic rift system, sporadic marine incursions during the Aptian terminated the lacustrine pre-salt carbonate deposition and, through increased water salinity and evaporation, initiated the widespread precipitation of the Ariri Formation evaporites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:Basin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MarineWater ],
        georeservoir:GEOCORE_0000002 .

presalt:Marl a owl:Class ;
    rdfs:label "marl"@en ;
    rdfs:comment "Marl is a calcareous mudrock that is composed of a variable mixture of carbonate minerals (typically calcite) and clay or silt. It is an indurated rock generally defined as containing between 35% and 65% carbonate minerals, with the remainder consisting of clay and silt-sized siliciclastic particles. Deposited in low-energy marine or lacustrine environments, marls often represent a transition between purely carbonate and purely siliciclastic depositional systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        georeservoir:GEORES_0000032 .

presalt:MegaSequence a owl:Class ;
    rdfs:label "mega-sequence"@en ;
    rdfs:comment "A mega-sequence is a large-scale tectono-stratigraphic unit that represents a distinct phase of basin evolution, such as rifting or thermal subsidence, and is bounded by major unconformities. In the context of the Brazilian Pre-Salt, the stratigraphic column is divided into three primary mega-sequences: the rift, the post-rift (or sag), and the drift. These correspond respectively to the initial continental rifting, a transitional sag phase with carbonate and evaporite deposition, and the final oceanic drift stage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Rifting ],
        presalt:TectonoStratigraphicUnit .

presalt:Mesodiagenesis a owl:Class ;
    rdfs:label "mesodiagenesis"@en ;
    rdfs:comment "Mesodiagenesis is a diagenetic stage that occurs during moderate to deep burial, characterized by chemical and physical alterations driven by increasing temperature, pressure, and the influence of migrating fluids. In the context of Brazilian Pre-Salt carbonates, these alterations include significant calcite dissolution, recrystallization, late fracturing, and cementation by minerals such as dolomite, quartz, and barite, often influenced by hydrothermal fluids. These processes can significantly modify the reservoir system, creating secondary porosity through dissolution and fracturing while also reducing it through compaction and cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Compaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Recrystallization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:DiageneticStage .

presalt:MicrobialCarbonate a owl:Class ;
    rdfs:label "microbial carbonate"@en ;
    rdfs:comment "Microbial carbonate is a carbonate rock that is formed through the mediation of microbial activity, where microorganisms influence carbonate precipitation or trap and bind sedimentary particles. These rocks, which include structures like stromatolites and thrombolites, are significant components of the lacustrine successions of the Brazilian Pre-Salt. In the context of the South Atlantic pre-salt, the origin of many associated textures is debated, with microbial processes often considered alongside purely abiotic precipitation mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:MicrobialActivity ],
        presalt:CarbonateRock .

presalt:MicrobialLaminite a owl:Class ;
    rdfs:label "microbial laminite"@en ;
    rdfs:comment "Microbial laminite is a finely laminated authigenic carbonate rock that originates from the lithification of microbial mats, which trap and bind sediment or induce mineral precipitation. Within the Brazilian Pre-Salt, they are interpreted as lacustrine supralittoral-to-eulittoral deposits, often exhibiting complex diagenetic histories involving the replacement of precursor minerals like stevensitic clays by calcite and dolomite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:MicrobialMat ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:LaminatedCarbonate .

presalt:Microfracture a owl:Class ;
    rdfs:label "microfracture"@en ;
    rdfs:comment "Microfracture is a fracture of microscopic scale that occurs within or across rock components, such as grains or crystals. In Pre-Salt carbonates, it constitutes a significant type of secondary porosity that is observable in thin sections and micro-CT scans. When open and interconnected, microfractures can substantially enhance reservoir permeability, although they may also be partially or fully cemented, reducing their contribution to fluid flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Cement ],
        presalt:Fracture .

presalt:Micropore a owl:Class ;
    rdfs:label "micropore"@en ;
    rdfs:comment "Micropore is a type of pore space within a rock that is characterized by a very small size, specifically ranging from 0.125 to 0.5 micrometers in diameter. In Brazilian Pre-Salt carbonates, micropores commonly occur as intraparticle porosity resulting from calcite dissolution within microbial shrubs or as intercrystalline porosity in cemented packstones. Despite contributing to total porosity, these small pores often result in low permeability and high irreducible water saturation, significantly impacting reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PoreSpace ],
        presalt:Pore .

presalt:Muscovite a owl:Class ;
    rdfs:label "muscovite"@en ;
    rdfs:comment "Muscovite is a phyllosilicate mineral of the mica group that occurs as a minor detrital siliciclastic component in Pre-Salt carbonate rocks. Within the Pre-Salt lacustrine successions, it is typically found as silt- to sand-sized grains within the matrix or as framework grains, and can occasionally serve as a nucleus for the growth of calcite spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PreSaltCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Matrix ],
        presalt:Mica .

presalt:Neobarremian a owl:NamedIndividual,
        presalt:GeologicalSubAge ;
    rdfs:label "neobarremian"@en ;
    rdfs:comment "Neobarremian is a geological sub-age that corresponds to the upper part of the Barremian Age of the Early Cretaceous Period. In the context of the Brazilian Pre-Salt, this interval is critical as it encompasses the deposition of the main carbonate reservoir rocks, including the Itapema and Barra Velha Formations, during the late rift phase."@en .

presalt:Nodule a owl:Class ;
    rdfs:label "nodule"@en ;
    rdfs:comment "Nodule is a discrete diagenetic body that is compositionally distinct from its surrounding host rock, typically exhibiting a rounded to irregular shape and sharp boundaries. In the context of Brazilian Pre-Salt carbonates, nodules are commonly composed of silica (quartz, opal) or calcite and occur within host rocks such as laminated carbonates, spherulestones, or siltstones. Their formation often precedes significant compaction, as evidenced by the deflection of sedimentary laminae around them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:HostRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        georeservoir:GEOCORE_0000001 .

presalt:OilWaterContact a owl:Class ;
    rdfs:label "oil-water contact"@en ;
    rdfs:comment "The oil-water contact is a subsurface boundary that separates the oil-saturated zone of a reservoir from the underlying water-saturated zone. It is commonly identified in wells by a sharp contrast on resistivity logs, where high-resistivity oil transitions to low-resistivity formation water. In complex reservoirs, this contact may not be a simple horizontal plane and can show significant depth variations due to structural compartmentalization or capillary effects, defining the lower limit of the oil column."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Reservoir ],
        georeservoir:GEOCORE_0000012 .

presalt:Onlap a owl:Class ;
    rdfs:label "onlap"@en ;
    rdfs:comment "Onlap is a stratal termination pattern that describes the geometric relationship where initially inclined or horizontal strata terminate progressively updip against a more steeply dipping surface, such as a basin margin or fault block. This pattern indicates a rise in relative base level, such as during a lacustrine transgression, which results in the landward migration of the depositional limit and the creation of accommodation space."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:OpenFracture a owl:Class ;
    rdfs:label "open fracture"@en ;
    rdfs:comment "An open fracture is a fracture that forms primarily through tensile or extensional stress, resulting in displacement perpendicular to the fracture surfaces with little to no shear displacement. In the Brazilian Pre-Salt, these fractures represent a significant pore type that commonly develops in brittle, silicified carbonate layers during the reactivation of rift-related faults, and may be enhanced by dissolution or partially filled with cements and debris."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Cement ],
        presalt:Fracture .

presalt:OrganicRichShale a owl:Class ;
    rdfs:label "organic-rich shale"@en ;
    rdfs:comment "Organic-rich shale is a hydrocarbon source rock that is composed of fine-grained sediments with a high concentration of organic matter deposited in deep, anoxic lacustrine environments. Within the South Atlantic Pre-Salt petroleum system, these rocks are the primary source for hydrocarbons, characterized by high total organic carbon content and amorphous kerogen typical of deposition in profundal lakes during the syn-rift and sag phases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:BrazilianPreSalt ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSetting ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        presalt:Shale .

presalt:PassiveMargin a owl:Class ;
    rdfs:label "passive margin"@en ;
    rdfs:comment "A passive margin is a continental margin that forms during the post-rift, or drift, phase of continental separation, characterized by the absence of significant tectonic activity as it transitions from continental to oceanic crust. In the context of the Brazilian South Atlantic, this tectono-stratigraphic stage follows the syn-rift and sag phases and is associated with thermal subsidence and the deposition of post-salt marine sequences, including carbonate platforms and subsequent siliciclastic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Subsidence ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:PostRift ],
        georeservoir:GEOCORE_0000001 .

presalt:PassiveMarginBasin a owl:Class ;
    rdfs:label "passive-margin basin"@en ;
    rdfs:comment "A passive-margin basin is a sedimentary basin that develops on the trailing edge of a continent following the cessation of rifting and the onset of seafloor spreading. These basins are formed under an extensional tectonic regime during continental breakup and are subsequently characterized by a prolonged post-rift phase of thermal subsidence, as exemplified by the Santos and Campos basins of Brazil."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:ContinentalMargin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Subsidence ],
        presalt:SedimentaryBasin .

presalt:PiArrasFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Piçarras Formation"@en ;
    rdfs:comment "The Piçarras Formation is a Barremian-Aptian lithostratigraphic unit that represents the initial syn-rift siliciclastic deposition in the Santos Basin, overlying the Camboriú Formation volcanics. It is characterized by proximal alluvial fan deposits of conglomerates and sandstones that transition to distal lacustrine deposits of fine-grained sandstones, siltstones, organic-rich shales, and talc-stevensite clays. This formation, which underlies the Itapema Formation, often forms thick sedimentary wedges in the hanging walls of rift-related normal faults."@en .

presalt:PoreThroat a owl:Class ;
    rdfs:label "pore throat"@en ;
    rdfs:comment "A pore throat is a narrow constriction that connects adjacent pore bodies within a porous medium. The size and geometry of pore throats are primary controls on a rock's permeability and capillary properties, determining its ability to store and transmit fluids. In Pre-Salt carbonate reservoirs, pore throat sizes are commonly measured using mercury injection capillary pressure (MICP) and classified into categories (e.g., micro, meso, macro) to characterize reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PoreSpace ],
        bfo:BFO_0000029 .

presalt:PreAlagoasUnconformity a owl:NamedIndividual,
        presalt:RegionalUnconformity ;
    rdfs:label "pre-alagoas unconformity"@en ;
    rdfs:comment "Pre-Alagoas Unconformity is a regional tectono-stratigraphic surface that marks the base of the Alagoas Stage (ca. 123–117 Ma) and separates the lower syn-rift from the upper transitional pre-salt sequences in the South Atlantic marginal basins. This surface represents a major change in depositional systems, separating the underlying bioclastic carbonates of the Itapema Formation from the overlying chemical and microbial carbonates of the Barra Velha Formation. Seismically, it is expressed as an angular unconformity over structural highs, transitioning to a conformable surface within depositional lows, and is often characterized by a discontinuous, fault-affected reflector."@en .

presalt:PreSaltOntoLearn a owl:Ontology ;
    rdfs:label "PreSaltOntoLearn: Pre-Salt Petroleum Geology Ontology" ;
    rdfs:comment "A RAG-augmented LLM-generated ontology for Brazilian Pre-Salt petroleum geology. Generated by the PreSaltOntoLearn pipeline." ;
    owl:imports bfo:bfo.owl ;
    owl:versionInfo "0.1.0" .

presalt:RegionalSeal a owl:Class ;
    rdfs:label "regional seal"@en ;
    rdfs:comment "A regional seal is a low-permeability rock unit of extensive lateral continuity that prevents the vertical migration of hydrocarbons from underlying reservoirs across a large portion of a sedimentary basin. In the Brazilian Pre-Salt, the regional seal is composed of the thick Aptian evaporite succession of the Ariri Formation, consisting primarily of halite and anhydrite. This massive salt layer overlies the main lacustrine carbonate reservoirs and is a critical element for the immense hydrocarbon accumulations found in the Santos and Campos basins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty georeservoir:GEOCORE_0000017 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        presalt:Seal .

presalt:ReworkedDeposit a owl:Class ;
    rdfs:label "reworked deposit"@en ;
    rdfs:comment "A reworked deposit is a sedimentary deposit that is composed of clasts eroded from pre-existing, coeval or slightly older sediments or rocks which are subsequently transported and redeposited. In the Brazilian Pre-Salt, these are typically intraclastic carbonates derived from the erosion of in situ shrubby and spherulitic facies, often exhibiting features of multicycle redeposition within a dynamic lacustrine setting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Clast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        presalt:Deposit .

presalt:ReworkedFacies a owl:Class ;
    rdfs:label "reworked facies"@en ;
    rdfs:comment "Reworked facies is a category of detrital carbonate facies that is composed of transported and redeposited fragments of pre-existing carbonate components, primarily intraclasts of crystal shrubs and spherulites. Standing in contrast to in-situ facies, this group encompasses various rock types classified by texture, such as calcarenite and calcirudite, and often exhibits sedimentary structures indicative of deposition by currents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEORES_0000025 ],
        presalt:CarbonateFacies .

presalt:Rift a owl:Class ;
    rdfs:label "rift"@en ;
    rdfs:comment "A rift is an elongate structural depression that is formed by the extension and thinning of the Earth's lithosphere, typically bounded by a system of normal faults. Its development is characterized by a syn-rift tectono-stratigraphic stage, where active normal faulting and differential subsidence lead to the deposition of asymmetric wedges of growth strata. Rifting represents the initial phase of continental divergence, which may ultimately lead to the formation of a new ocean basin through continental breakup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Graben ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Horst ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:GrowthStrata ],
        presalt:StructuralLow .

presalt:RiftBasin a owl:Class ;
    rdfs:label "rift basin"@en ;
    rdfs:comment "A rift basin is a sedimentary basin that forms due to the extensional deformation and thinning of the continental lithosphere, typically associated with the breakup of supercontinents. Its development is characterized by active normal faulting, which creates accommodation space for syn-rift deposits that often form asymmetric wedges of growth strata within grabens and half-grabens. These basins represent the initial stage of crustal rupture and are often precursors to the development of a passive divergent margin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Graben ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:HalfGraben ],
        georeservoir:GEOCORE_0000004 .

presalt:RiftFault a owl:Class ;
    rdfs:label "rift fault"@en ;
    rdfs:comment "A rift fault is a fault, typically a normal fault, that forms in response to crustal extension during the rifting phase of basin development. These faults are fundamental in creating the initial basin architecture, controlling the location and thickness of syn-rift sedimentary successions. In the Brazilian Pre-Salt, rift faults often form complex arrays that compartmentalize the basement and are frequently reactivated by later tectonic events, influencing the development of fracture systems and structural inversions within the overlying carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:FaultReactivation ],
        presalt:Fault .

presalt:RiftSection a owl:Class ;
    rdfs:label "rift section"@en ;
    rdfs:comment "Rift section is a tectono-stratigraphic unit that comprises the package of sedimentary and volcanic rocks deposited during the active extensional faulting phase of a rift basin's evolution. In the Brazilian Pre-Salt, this unit was deposited from the Hauterivian to the Aptian in fluvial-lacustrine environments and includes key source rocks and bioclastic carbonate reservoirs. It is seismically characterized by wedge-shaped geometries with divergent internal reflectors and is typically bounded at its top by a regional unconformity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:SourceRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:hasValue presalt:Aptian ;
            owl:onProperty georeservoir:GEOCORE_0000015 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VolcanicRock ],
        presalt:TectonoStratigraphicUnit .

presalt:SagBasin a owl:Class ;
    rdfs:label "sag basin"@en ;
    rdfs:comment "A sag basin is a broad sedimentary basin that develops during a post-rift transitional phase, characterized by widespread regional depression driven predominantly by thermal subsidence rather than active faulting. This stage exhibits relatively uniform, low-rate subsidence, creating accommodation space for extensive depositional systems, such as the lacustrine carbonates of the Barra Velha Formation, which are typically overlain by thick evaporites forming the regional seal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:PostRift ],
        presalt:SedimentaryBasin .

presalt:SagSection a owl:Class ;
    rdfs:label "sag section"@en ;
    rdfs:comment "A sag section is a tectono-stratigraphic unit that is deposited in a broad, regional depression formed predominantly by thermal subsidence after the main phase of active mechanical rifting has ceased. In the Brazilian Pre-Salt, this post-rift transitional unit contains the main carbonate reservoir rocks, such as the Barra Velha Formation, and is characterized by a saucer-shaped geometry that onlaps underlying rift structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:PreSaltSuccession ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000178 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Subsidence ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:PostRift ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Microbialite ],
        presalt:TectonoStratigraphicUnit .

presalt:SaltDeposition a owl:Class ;
    rdfs:label "salt deposition"@en ;
    rdfs:comment "Salt deposition is a sedimentary process that involves the precipitation of evaporite minerals, primarily halite and anhydrite, from hypersaline waters within a restricted basin. In the South Atlantic, this event occurred during the Aptian (~110-116 Ma) in a syn-rift tectonic setting, with fault activity influencing the location of depocenters. The resulting thick evaporite sequence caused rapid basin loading and provided the source material for subsequent salt tectonics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Anhydrite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:Basin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Halite ],
        presalt:SedimentaryProcess .

presalt:Sandstone a owl:Class ;
    rdfs:label "sandstone"@en ;
    rdfs:comment "Sandstone is a siliciclastic sedimentary rock that is composed of coarse to fine-grained detrital material. Within the Pre-Salt sequence, sandstones are typically interpreted as deposits of fluvial, alluvial fan, or fan delta systems and often exhibit current laminations. This facies can be mixed with mollusk shells, indicating episodic input of coarse siliciclastic sediment into a lacustrine setting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lamination ],
        presalt:ClasticSedimentaryRock .

presalt:Saponite a owl:Class ;
    rdfs:label "saponite"@en ;
    rdfs:comment "Saponite is a magnesium-rich smectite clay mineral that precipitates from highly alkaline lake water within the Pre-Salt depositional system. It is a common component of the authigenic Mg-silicate clay suite, often associated with stevensite and kerolite, and can form a substrate for the growth of carbonate facies like spherulites and shrubstones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:LakeWater ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:MgSilicateClay ],
        presalt:ClayMineral .

presalt:SecondaryPorosity a owl:Class ;
    rdfs:label "secondary porosity"@en ;
    rdfs:comment "Secondary porosity is the pore space within a rock that develops after deposition through subsequent diagenetic or tectonic processes, such as dissolution, dolomitization, or fracturing. In Brazilian Pre-Salt carbonates, it is the dominant porosity type, commonly formed by the dissolution of unstable constituents like Mg-clays and carbonate grains, creating a complex network of moldic, vuggy, intercrystalline, and fracture pores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:PoreSpace .

presalt:SedimentarySequence a owl:Class ;
    rdfs:label "sedimentary sequence"@en ;
    rdfs:comment "A sedimentary sequence is a fundamental stratigraphic unit that comprises a succession of genetically related strata deposited during a complete cycle of accommodation or sediment supply variation. It is bounded by stratigraphic surfaces of the same genesis, typically unconformities or their correlative conformities, which mark significant changes in the depositional regime. In the context of the South Atlantic margin, these are often grouped into large-scale tectono-stratigraphic units, such as the rift, transitional, and drift sequences that record the basin's evolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Strata ],
        georeservoir:GEORES_0000020 .

presalt:Sepiolite a owl:Class ;
    rdfs:label "sepiolite"@en ;
    rdfs:comment "Sepiolite is a magnesium silicate clay mineral that occurs in the Brazilian Pre-Salt as a product of chemical precipitation in alkaline lacustrine environments. Within the Barremian-Aptian succession, it is commonly associated with stevensite and forms part of the primary clay matrix from which carbonate spherulites and shrubs grow, and may also persist as a pore-filling component."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:MgRichClay ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BrazilianPreSalt ;
            owl:onProperty bfo:BFO_0000171 ],
        presalt:ClayMineral .

presalt:ShallowLake a owl:Class ;
    rdfs:label "shallow lake"@en ;
    rdfs:comment "A shallow lake is a lacustrine depositional environment that is characterized by limited water depth and is typically evaporitic, alkaline, and situated within a closed or restricted basin. Within the South Atlantic Pre-Salt, these saline to hyper-alkaline lacustrine systems are the primary depositional setting for unique, chemically precipitated carbonate facies, including shrubstones and spherulites, which constitute significant reservoir intervals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Basin ],
        georeservoir:GEOCORE_0000001 .

presalt:SilicaCementation a owl:Class ;
    rdfs:label "silica cementation"@en ;
    rdfs:comment "Silica cementation is a diagenetic process that precipitates silica minerals, such as quartz, chalcedony, or chert, from pore fluids into the void spaces of a sedimentary rock. Within Brazilian Pre-Salt carbonates, this process has a dual effect on reservoir quality, either occluding pores, vugs, and fractures to diminish storage capacity, or forming rigid, rim-like cements that preserve porosity by increasing the rock's resistance to compaction. This silicification can be extensive, occurring in various forms and potentially replacing the original carbonate fabric entirely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateFabric ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Cementation .

presalt:SilicaLayer a owl:Class ;
    rdfs:label "silica layer"@en ;
    rdfs:comment "A silica layer is a stratiform body of silica within the lacustrine carbonate succession of the Barra Velha Formation that formed contemporaneously with deposition through primary chemical precipitation or early diagenetic replacement. These brittle layers, typically centimeters thick, are often intensely fractured and associated with enhanced non-matrix porosity, making them significant features in reservoir characterization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fracture ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        georeservoir:GEORES_0000006 .

presalt:SilicaNodule a owl:Class ;
    rdfs:label "silica nodule"@en ;
    rdfs:comment "A silica nodule is a localized, discrete concentration of silica that occurs within a host sedimentary rock, typically characterized by a rounded to almond-shaped form and a composition of microcrystalline to macrocrystalline quartz. In Brazilian Pre-Salt lacustrine carbonates, these are early diagenetic features commonly found within mudstones, interpreted to have formed from the precipitation of interstitial silica gels triggered by changes in lake-water chemistry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEOCORE_0000001 .

presalt:SilicaPrecipitation a owl:Class ;
    rdfs:label "silica precipitation"@en ;
    rdfs:comment "Silica precipitation is a geochemical process that results in the formation of solid silica minerals, such as quartz and chalcedony, from a solution. In Brazilian Pre-Salt lacustrine carbonates, this process occurs as a primary sediment, a replacement of precursor minerals, or a cement during penecontemporaneous to late diagenetic stages, with early precipitation often linked to periods of reduced lake water alkalinity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Chalcedony ],
        presalt:Precipitation .

presalt:SiliciclasticGrain a owl:Class ;
    rdfs:label "siliciclastic grain"@en ;
    rdfs:comment "A siliciclastic grain is a detrital particle that is composed of silicate minerals, such as quartz, feldspar, and mica, derived from the weathering and erosion of pre-existing rocks. In the context of the Pre-Salt, these grains are typically transported from marginal rift sources into the lacustrine system, where they can form the nuclei of carbonate spherules or occur as a matrix component within carbonate facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Weathering ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:Clast .

presalt:SilicifiedInterval a owl:Class ;
    rdfs:label "silicified interval"@en ;
    rdfs:comment "A silicified interval is a diagenetically altered rock unit that is characterized by the significant replacement of its original minerals, typically carbonates, with silica. In Pre-Salt reservoirs, these brittle intervals create a rheological contrast with the host rock, making them prone to fracturing and thus capable of acting as either high-permeability corridors or as flow barriers where porosity is occluded."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        georeservoir:GEORES_0000020 .

presalt:Slope a owl:Class ;
    rdfs:label "slope"@en ;
    rdfs:comment "Slope is an inclined geomorphic surface that connects areas of higher elevation, such as a carbonate platform or structural high, to adjacent lower-lying areas like a basin floor. In Pre-Salt carbonate systems, slopes are critical depositional settings characterized by features such as accretional clinoforms, bypass surfaces, and mass transport deposits. Their gradients are typically low, often less than 3 degrees, but vary based on tectonic activity and depositional processes, influencing the distribution of reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Clinoform ],
        georeservoir:GEOCORE_0000011 .

presalt:SpheruliticMudstone a owl:Class ;
    rdfs:label "spherulitic mudstone"@en ;
    rdfs:comment "Spherulitic mudstone is a mud-supported carbonate facies of the Brazilian Pre-Salt that is composed of calcite spherulites embedded within a dominant mud matrix, where the spherulites constitute less than 70% of the rock volume. Characterized by spherulite grains that rarely touch, this facies can exhibit significantly higher porosity and permeability compared to other mud-rich lithologies, making it a potential reservoir rock with a free fluid signature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        presalt:Mudstone .

presalt:SpheruliticShrubstone a owl:Class ;
    rdfs:label "spherulitic shrubstone"@en ;
    rdfs:comment "Spherulitic shrubstone is an in-situ carbonate rock facies that is characterized by a framework dominated by shrubs with a significant component of spherulites, where these two components collectively comprise over 50% of the rock and there is less than 10% mud. A key reservoir facies in Brazilian Pre-Salt lacustrine settings, it typically displays spherulites between shrub branches and exhibits high fabric-selective interparticle porosity, which is often enhanced by dissolution and subsequent cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSetting ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        presalt:Shrubstone .

presalt:Spherulitite a owl:Class ;
    rdfs:label "spherulitite"@en ;
    rdfs:comment "Spherulitite is a sedimentary carbonate rock that is composed predominantly of spherulites. The constituent spherulites are spherical to sub-spherical aggregates of radially arranged calcite crystals, which form grain-supported to matrix-supported fabrics such as grainstones and packstones. These rocks are characteristic of the Brazilian Pre-Salt lacustrine carbonates and are frequently altered by diagenetic processes including dolomitization, recrystallization, and silicification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Recrystallization ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Spherulite ],
        presalt:CarbonateRock .

presalt:StratigraphicInterval a owl:Class ;
    rdfs:label "stratigraphic interval"@en ;
    rdfs:comment "A stratigraphic interval is a package of rock strata that is defined and differentiated from adjacent rock units based on a unifying set of properties. These defining properties can include lithology, facies successions, age, seismic character, or bounding surfaces such as unconformities or specific seismic reflectors. Stratigraphic intervals are fundamental units for subdividing the geologic record for analysis, correlation, and interpretation, ranging in scale from individual depositional cycles to entire tectono-stratigraphic sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Strata ],
        georeservoir:GEORES_0000020 .

presalt:Stromatolite a owl:Class ;
    rdfs:label "stromatolite"@en ;
    rdfs:comment "Stromatolite is an organo-sedimentary structure that is formed by the sediment-trapping, sediment-binding, and carbonate precipitation activities of microbial communities. In Brazilian Pre-Salt lacustrine settings, they typically exhibit columnar, domal, or stratiform morphologies with characteristic microbial laminations, and their development is closely linked to lake-level fluctuations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lamination ],
        georeservoir:GEORES_0000025 .

presalt:Stylolite a owl:Class ;
    rdfs:label "stylolite"@en ;
    rdfs:comment "A stylolite is a diagenetic pressure-solution feature that forms as an irregular, serrated surface or seam within a rock mass where mineral constituents have been dissolved under stress. These features are defined by the concentration of insoluble residue, such as clay minerals, pyrite, and detrital quartz, which accumulate along the dissolution surface during burial. In Pre-Salt carbonates, stylolites can truncate earlier diagenetic phases and may be associated with localized fracture porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ClayMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Pyrite ],
        presalt:DiageneticFeature .

presalt:SubaerialExposure a owl:Class ;
    rdfs:label "subaerial exposure"@en ;
    rdfs:comment "Subaerial exposure is a geological condition that occurs when previously subaqueous sediments or rocks are exposed to the atmosphere, typically due to a fall in relative water level such as lake desiccation. In lacustrine carbonate settings like the Pre-Salt, this process is associated with lake-level lowstands and results in weathering, pedogenetic alteration, brecciation, and the formation of unconformities, with evidence including dolomite-enriched profiles and reworked deposits from subaerial disaggregation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:Weathering ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:Brecciation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

presalt:Tachyhydrite a owl:Class ;
    rdfs:label "tachyhydrite"@en ;
    rdfs:comment "Tachyhydrite is a rare and highly soluble evaporite mineral that is composed of hydrated calcium magnesium chloride (CaMg₂Cl₆·12H₂O). In the Brazilian Pre-Salt, it occurs locally within the Aptian Ariri Formation as part of a thick evaporitic sequence, where it is associated with halite, anhydrite, carnallite, and sylvite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        presalt:EvaporiteMineral .

presalt:TalcStevensiteOoid a owl:Class ;
    rdfs:label "talc-stevensite ooid"@en ;
    rdfs:comment "A talc-stevensite ooid is a coated sedimentary grain that is primarily composed of the magnesium silicate clay minerals stevensite and talc (including its variety, kerolite), formed under agitated conditions in highly alkaline, Mg- and Si-rich lacustrine environments. Characteristic of the Brazilian Pre-Salt rift section, these diagenetically unstable ooids are commonly dissolved and replaced by dolomite and quartz, creating complex porosity networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Talc ],
        georeservoir:GEOCORE_0000001 .

presalt:TholeiiticBasalt a owl:Class ;
    rdfs:label "tholeiitic basalt"@en ;
    rdfs:comment "Tholeiitic basalt is a type of basaltic volcanic rock that is geochemically defined by its formation from magmas evolving under low-pressure conditions, characteristic of continental rifting. In the context of the Brazilian Pre-Salt, these rocks form extensive Early Cretaceous flood basalt provinces, such as the Camboriú and Cabiúnas Formations, which constitute the economic basement beneath the syn-rift sequence. These basalts are genetically linked to the Paraná-Etendeka Large Igneous Province and represent the initial magmatic phase of the South Atlantic opening."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CabiNasFormation ],
        [ a owl:Restriction ;
            owl:hasValue presalt:EarlyCretaceous ;
            owl:onProperty georeservoir:GEOCORE_0000014 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CamboriFormation ],
        georeservoir:GEOCORE_0000008 .

presalt:TransferZone a owl:Class ;
    rdfs:label "transfer zone"@en ;
    rdfs:comment "A transfer zone is a zone of deformation that accommodates displacement between major, non-collinear fault segments, and is typically oriented obliquely to the main rift trend. Within the Brazilian Pre-Salt, these zones often form structural highs separating adjacent depocenters, thereby exerting significant control over the geometry of fault systems and the distribution of syn-rift reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Deformation ],
        georeservoir:GEOCORE_0000004 .

presalt:Trap a owl:Class ;
    rdfs:label "trap"@en ;
    rdfs:comment "A trap is a geological configuration of reservoir and seal rocks that confines and holds a subsurface accumulation of hydrocarbons. In the Brazilian Pre-Salt, traps are typically large, complex structural highs with four-way closure, where the carbonate reservoir is sealed by the overlying thick evaporites of the Ariri Formation. These traps may also have a significant stratigraphic component, where lateral changes in reservoir quality contribute to the overall closure and hydrocarbon containment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Seal ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:HydrocarbonAccumulation ],
        georeservoir:GEOCORE_0000004 .

presalt:Travertine a owl:Class ;
    rdfs:label "travertine"@en ;
    rdfs:comment "Travertine is a continental carbonate deposit that precipitates from mineral-rich, hot or cold waters, typically along fractures, as a result of processes like CO2 degassing. In Pre-Salt settings, it can form mound-shaped bodies and fissure ridges associated with fault systems, and is characterized by facies such as crystalline spar shrubs and planar crusts whose morphology is controlled by fluid flow and topography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:FormationWater ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEORES_0000028 ],
        presalt:ContinentalCarbonate .

presalt:UpperBarraVelhaFormation a owl:NamedIndividual,
        georeservoir:GEORES_0000002 ;
    rdfs:label "Upper Barra Velha Formation"@en ;
    rdfs:comment "The Upper Barra Velha Formation is a stratigraphic unit of Aptian age that constitutes the upper section of the Barra Velha Formation in the Santos Basin, deposited in a shallow, alkaline lacustrine system during the late-rift to sag phase. This unit is predominantly composed of a complex association of carbonate facies, including shrubby limestones, intraclastic grainstones, rudstones, and dolostones, along with spherulitic Mg-rich claystones. These facies form one of the most significant and productive petroleum reservoirs in the Brazilian Pre-Salt."@en .

presalt:Valanginian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "valanginian"@en ;
    rdfs:comment "The Valanginian is a geological age of the Early Cretaceous Epoch that, in the South Atlantic marginal basins, corresponds to the onset of the syn-rift tectono-sedimentary sequence. Within the Brazilian Pre-Salt, this period is marked by the initial development of half-graben depocenters and the deposition of the basal lacustrine sediments of the Itapema Formation."@en .

presalt:VolcanicFragment a owl:Class ;
    rdfs:label "volcanic fragment"@en ;
    rdfs:comment "A volcanic fragment is a lithoclast that is composed of igneous volcanic rock and has been incorporated as a detrital grain into a sedimentary rock. In the context of the Brazilian Pre-Salt, these fragments are typically found within lacustrine carbonate facies, such as grainstones and packstones, having been reworked from volcanic sources active during the rifting of the South Atlantic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:VolcanicRock ],
        georeservoir:GEOCORE_0000001 .

presalt:Volcaniclastic a owl:Class ;
    rdfs:label "volcaniclastic"@en ;
    rdfs:comment "Volcaniclastic is a general term for clastic material that is composed of rock fragments derived from volcanic activity, regardless of the transport mechanism. In the Brazilian Pre-Salt, this component is typically represented by volcanic rock fragments, such as tuff, which are often mixed with siliciclastic and carbonate grains within the reservoir succession."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

presalt:Volcanism a owl:Class ;
    rdfs:label "volcanism"@en ;
    rdfs:comment "Volcanism is a geological process that involves the eruption of magma, volcanic ash, and associated gases from a planetary body's crust or mantle onto its surface or into its atmosphere. In the context of the Brazilian Pre-Salt, the extensive Serra Geral–Camboriú volcanism was active during the Early Cretaceous rifting phase. This activity fundamentally influenced the chemical composition of the lacustrine depositional systems and contributed significant volumes of volcanic and volcaniclastic rocks to the syn-rift sequence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Gas ],
        presalt:Magmatism .

presalt:Wackestone a owl:Class ;
    rdfs:label "wackestone"@en ;
    rdfs:comment "Wackestone is a mud-supported carbonate rock that contains more than 10% grains suspended within a micritic matrix. In the context of the Brazilian Pre-Salt, these grains commonly include ostracod bioclasts, spherulite fragments, peloids, and reworked microbial shrub fragments, reflecting deposition in low-energy lacustrine settings. The facies can be massive or exhibit plane-parallel lamination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Grain ],
        presalt:MatrixSupportedCarbonateRock .

presalt:Wackstone rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Allochem ] .

presalt:Wave a owl:Class ;
    rdfs:label "wave"@en ;
    rdfs:comment "A wave is a disturbance that propagates through a fluid medium, transferring energy and influencing sediment deposition and facies development. In lacustrine Pre-Salt settings, wind-driven surface waves are critical for the development of high-energy facies like shrubstones on paleotopographic highs, while internal waves, generated by perturbations of a chemocline in a stratified water column, are a key mechanism for reworking and transporting sediments at depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        presalt:SedimentaryProcess .

georeservoir:GEORES_0000004 a owl:Class ;
    rdfs:label "Formation"@en ;
    rdfs:comment "A formation is the fundamental lithostratigraphic unit that consists of a body of rock strata identified by its distinct lithological characteristics and is mappable at a regional scale. In petroleum geology, the term also refers to the specific subsurface rock interval encountered by a well, whose physical properties such as pressure, temperature, and fluid saturation are measured."@en ;
    rdfs:subClassOf presalt:LithostratigraphicUnit .

bfo:BFO_0000008 a owl:Class ;
    rdfs:label "temporal region"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf bfo:BFO_0000003 .

bfo:BFO_0000024 a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000038 a owl:Class ;
    rdfs:label "one-dimensional temporal region"@en ;
    rdfs:subClassOf bfo:BFO_0000008 .

bfo:BFO_0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

bfo:BFO_0000146 a owl:Class ;
    rdfs:label "fiat surface"@en ;
    rdfs:subClassOf bfo:BFO_0000140 .

presalt:AccommodationSpace a owl:Class ;
    rdfs:label "accommodation space"@en ;
    rdfs:comment "Accommodation space is the volume available for potential sediment accumulation that is primarily controlled by the interplay between tectonic subsidence and changes in base level. In lacustrine rift settings such as the Brazilian Pre-Salt, this space is generated by a combination of tectonic stimuli acting on faults, regional thermal subsidence, and fluctuations in lake level, directly governing the preservation of stratigraphic sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Subsidence ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Subsidence ] .

presalt:Allochem a owl:Class ;
    rdfs:label "allochem"@en ;
    rdfs:comment "An allochem is a recognizable carbonate particle, typically sand-sized or larger, that has been transported from its site of origin before its final deposition. In the Brazilian Pre-Salt lacustrine successions, the primary allochems are bioclasts (chiefly bivalve and ostracod shells), ooids, peloids, and intraclasts, which constitute the main framework grains of depositional carbonate rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        georeservoir:GEOCORE_0000001 .

presalt:Bed a owl:Class ;
    rdfs:label "bed"@en ;
    rdfs:comment "A bed is a layer of sedimentary rock that is distinguished from adjacent strata by changes in lithology, texture, or internal structure, and is bounded by surfaces known as bedding planes. In the context of Pre-Salt carbonates, beds range from millimeters to decimeters in thickness, often consist of specific facies such as grainstone or mudstone with sharp boundaries, and may exhibit internal features like normal grading or lamination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lamination ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Grainstone ],
        presalt:Layer .

presalt:BioclasticGrainstone a owl:Class ;
    rdfs:label "bioclastic grainstone"@en ;
    rdfs:comment "Bioclastic grainstone is a grain-supported bioclastic carbonate rock that is distinguished from bioclastic rudstone by having a constituent grain size of less than 2 mm. Within the Brazilian Pre-Salt lacustrine successions, its bioclasts are mainly composed of fragmented bivalves, gastropods, and ostracods, and it represents a significant reservoir facies often modified by diagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:GrainSize ],
        presalt:BioclasticCarbonateRock .

presalt:BioclasticRudstone a owl:Class ;
    rdfs:label "bioclastic rudstone"@en ;
    rdfs:comment "Bioclastic rudstone is a grain-supported bioclastic carbonate rock that is characterized by constituent grains larger than 2 millimeters in diameter. In the Brazilian Pre-Salt, these rocks are typically composed of fragmented and disarticulated bivalve shells, forming a significant reservoir facies with a complex pore system that includes interparticle, moldic, and vugular porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VugularPorosity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:MoldicPorosity ],
        presalt:BioclasticCarbonateRock .

presalt:Breccia a owl:Class ;
    rdfs:label "breccia"@en ;
    rdfs:comment "Breccia is a clastic rock that is composed of angular to subangular clasts, larger than 2 mm in diameter, set in a finer-grained matrix or cement. In the Brazilian Pre-Salt, breccias are significant reservoir components formed by diverse mechanisms including gravitational collapse of platform margins, brittle failure along fault zones, and hydrothermal or karst-related diagenetic processes. These rocks are typically composed of carbonate intraclasts and can be clast-supported or matrix-supported, often exhibiting enhanced permeability that contributes to prolific production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Karstification ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:HydrothermalProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Matrix ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Clast ],
        presalt:ClasticSedimentaryRock .

presalt:Brecciation a owl:Class ;
    rdfs:label "brecciation"@en ;
    rdfs:comment "Brecciation is a geological process that fractures a rock mass, resulting in the formation of a breccia composed of angular clasts. In the context of the Brazilian Pre-Salt, this process is driven by various mechanisms including tectonic faulting, hydrofracturing from overpressurized fluids, hydrothermal activity, and karstification. The resulting breccias often occur in zones of high fracture density and can be critical for fluid flow and reservoir development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Breccia ],
        georeservoir:GEOCORE_0000002 .

presalt:Burial a owl:Class ;
    rdfs:label "burial"@en ;
    rdfs:comment "Burial is a geological process that subjects sedimentary rocks to increasing pressure and temperature as they are progressively covered by younger overlying sediments. This process drives significant diagenetic alterations, such as compaction, cementation, dissolution, and dolomitization, which critically control the final reservoir quality by either destroying or enhancing porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Compaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dissolution ],
        georeservoir:GEOCORE_0000002 .

presalt:Calcirudite a owl:Class ;
    rdfs:label "calcirudite"@en ;
    rdfs:comment "Calcirudite is a clastic carbonate rock that is defined by a dominant component of carbonate grains larger than 2 mm in diameter (rudite-grade). In the context of the Brazilian Pre-Salt, these rocks are typically poorly sorted resedimented deposits, such as debris flows, composed of intraclasts, microbialite fragments, and reworked tufa, and are texturally classified as either clast-supported rudstones or matrix-supported floatstones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Grain ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:GrainSize ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Microbialite ],
        presalt:ClasticCarbonateRock .

presalt:CalciteShrub a owl:Class ;
    rdfs:label "calcite shrub"@en ;
    rdfs:comment "A calcite shrub is an in situ carbonate fabric that is composed of aggregates of fibrous to bladed, often fascicular-optic, calcite crystals arranged in a distinctive upward-bifurcating or fan-like morphology. Characteristic of Brazilian Pre-Salt lacustrine deposits, these structures form crusts and layers whose origin is debated as either abiotic chemical precipitation or biologically mediated growth."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000025 .

presalt:CarbonateBuildUp a owl:Class ;
    rdfs:label "carbonate build-up"@en ;
    rdfs:comment "Carbonate build-up is a localized depositional body of carbonate rock that forms a positive topographic feature on the lake floor, with formation often controlled by hydrothermal activity along fault-related structural highs. These features typically exhibit aggradational geometries with chaotic internal seismic reflectors and are inferred to be composed of shrubby and spherulitic carbonates. Due to their composition and diagenetic history, carbonate build-ups possess high porosity and permeability, making them excellent hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fracture ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:HydrothermalProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        presalt:CarbonateDeposit .

presalt:CarbonatePlatform a owl:Class ;
    rdfs:label "carbonate platform"@en ;
    rdfs:comment "A carbonate platform is a sedimentary depositional system that is characterized by the accumulation of predominantly carbonate sediments on a topographically elevated area within a basin. In the context of the Brazilian Pre-Salt, these are extensive lacustrine systems that developed over structural basement highs during the syn-rift to sag phases. They exhibit diverse depositional geometries, including aggradational and mounded forms, and are composed of a range of facies from low-energy spherulitestones to high-energy grainstones, forming critical hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateSediment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Basin ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SynRift ],
        georeservoir:GEORES_0000020 .

presalt:Carnallite a owl:Class ;
    rdfs:label "carnallite"@en ;
    rdfs:comment "Carnallite is a hydrated potassium magnesium chloride evaporite mineral that occurs as a less common constituent within the salt succession of the Aptian Ariri Formation. In the Brazilian Pre-Salt, it forms distinct layers within the salt body, alongside halite, anhydrite, and tachyhydrite, creating significant seismic velocity contrasts that are critical for accurate seismic imaging of the underlying reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Salt ],
        [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty bfo:BFO_0000176 ],
        presalt:EvaporiteMineral .

presalt:Cave a owl:Class ;
    rdfs:label "cave"@en ;
    rdfs:comment "A cave is a large-scale karst feature that is characterized by meter-scale or larger dimensions, formed by the dissolution of carbonate rock. In the context of Brazilian Pre-Salt reservoirs, caves are significant contributors to reservoir permeability, often associated with hydrothermal alteration along fault zones. These features are frequently identified during drilling by events such as total fluid loss, indicating their high connectivity and extreme flow capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:FlowCapacity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:HydrothermalAlteration ],
        presalt:Pore .

presalt:Channel a owl:Class ;
    rdfs:label "channel"@en ;
    rdfs:comment "A channel is a conduit-like macroporosity feature that is formed by the focused dissolution of carbonate rock, often enlarging pre-existing fractures, faults, or bedding planes. In the context of Brazilian Pre-Salt reservoirs, these karst-related features are a key component of the vuggy and cavernous porosity system, creating high-permeability pathways essential for fluid flow and production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:Pore .

presalt:ChemicalSedimentaryDeposit a owl:Class ;
    rdfs:label "Chemical Sedimentary Deposit"@en ;
    rdfs:subClassOf presalt:Deposit .

presalt:Clinoform a owl:Class ;
    rdfs:label "clinoform"@en ;
    rdfs:comment "A clinoform is a stratigraphic unit that is characterized by inclined depositional surfaces representing the progradation of sediments or volcanics from a shallower to a deeper depositional environment. Within the Brazilian Pre-Salt lacustrine setting, these geobodies typically have a sigmoidal to concave-up profile, are composed of carbonate or volcanic deposits, and their height is used as a proxy for paleo-lake depth. They commonly flank structural highs, prograde into adjacent depressions, and can be modified by features such as channels and collapse scars."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Channel ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateDeposit ],
        georeservoir:GEORES_0000002 .

presalt:ContinentalCrust a owl:Class ;
    rdfs:label "continental crust"@en ;
    rdfs:comment "Continental crust is the layer of the Earth's lithosphere that forms the continents and their shelves, distinguished by being generally thicker and less dense than oceanic crust. In rift settings, such as the South Atlantic margin, it undergoes significant stretching, thinning, and necking, creating the accommodation space for sedimentary basins like the Santos Basin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Density ],
        presalt:Crust .

presalt:ContinentalMargin a owl:Class ;
    rdfs:label "continental margin"@en ;
    rdfs:comment "A continental margin is a major physiographic and tectonic zone that represents the transition between continental crust and oceanic crust. Its architecture, established during continental rifting, governs the development of sedimentary basins, with the relative position within the margin influencing the structural styles and reservoir successions of features like the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Rifting ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ContinentalCrust ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:OceanicCrust ],
        georeservoir:GEOCORE_0000004 .

presalt:Coquina a owl:Class ;
    rdfs:label "coquina"@en ;
    rdfs:comment "Coquina is a bioclast-enriched carbonate rock that is composed predominantly of accumulated biological hard parts, such as bivalve, gastropod, and ostracod shells, typically exhibiting grain-supported textures like grainstone and rudstone. As a significant petroleum reservoir in the Brazilian Pre-Salt's lacustrine Itapema Formation, its quality is controlled by a complex pore system, including vuggy, moldic, and interparticle porosity, developed in shallow, storm-influenced depositional settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Gastropod ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:hasValue presalt:ItapemaFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        presalt:BioclasticCarbonateRock .

presalt:Deformation a owl:Class ;
    rdfs:label "deformation"@en ;
    rdfs:comment "Deformation is a geological process that changes the original shape, size, orientation, or position of a rock body in response to applied stress. In the context of rift basins like the Brazilian Pre-Salt, this process is primarily driven by tectonic forces, such as oblique extension, and is strongly influenced by pre-existing crustal fabrics. It manifests as a diverse structural architecture, including faults and half-grabens, which collectively define the structural style of an area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:TectonicActivity .

presalt:DepositionalEnvironment a owl:Class ;
    rdfs:label "depositional environment"@en ;
    rdfs:comment "A depositional environment is a natural setting on the Earth's surface that is characterized by a specific combination of physical, chemical, and biological processes under which sediments accumulate. In the Brazilian Pre-Salt, these settings encompass a range from subaerial hydrothermal springs and shallow platforms to deep lacustrine systems, often within a transitional continental to restricted marine context. The interpretation of these environments is crucial for understanding the resulting mosaic of facies and predicting the distribution of reservoir rocks."@en ;
    rdfs:subClassOf bfo:BFO_0000029 .

presalt:DiageneticMineral a owl:Class ;
    rdfs:label "diagenetic mineral"@en ;
    rdfs:comment "A diagenetic mineral is a mineral that forms or is altered within a sedimentary rock after its initial deposition through processes such as precipitation, replacement, or recrystallization. These minerals can precipitate as cements within pore spaces or form by replacing pre-existing sedimentary grains and matrix, thereby modifying the rock's porosity and permeability. In the context of Brazilian Pre-Salt carbonates, common diagenetic minerals include calcite, dolomite, silica, pyrite, and barite, which are critical in controlling reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Replacement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Replacement ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Replacement ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Recrystallization ],
        presalt:Mineral .

presalt:DiageneticProduct a owl:Class ;
    rdfs:label "diagenetic product"@en ;
    rdfs:comment "A diagenetic product is any mineral, mineral assemblage, or rock fabric that is formed or modified by diagenetic processes occurring after sediment deposition and before the onset of metamorphism. In the context of Brazilian Pre-Salt carbonates, common diagenetic products include various forms of dolomite, calcite, and silica cements that precipitate in pore spaces, as well as replacement minerals like pyrite and authigenic clays. The specific types and succession of these products are crucial for understanding the post-depositional history and evolution of reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        georeservoir:GEOCORE_0000006 .

presalt:Dolostone a owl:Class ;
    rdfs:label "dolostone"@en ;
    rdfs:comment "Dolostone is a sedimentary carbonate rock that is composed predominantly of the mineral dolomite. In the Brazilian Pre-Salt, it typically consists of dolomite rhombs and aggregates of blocky or saddle dolomite, often associated with Mg-clays, organic matter, and chert nodules. This rock type is formed by the diagenetic process of dolomitization and frequently constitutes a high-quality reservoir facies due to its significant intercrystalline porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:CarbonateRock .

presalt:EvaporiteDeposit a owl:Class ;
    rdfs:label "evaporite deposit"@en ;
    rdfs:comment "An evaporite deposit is a chemical sedimentary deposit that is formed by the precipitation of salt minerals from a concentrated aqueous solution in a restricted basin subjected to intense evaporation. In the Brazilian Pre-Salt, these deposits are composed of thick, stratified successions of halite, anhydrite, carnallite, and sylvite, which accumulated in shallow lacustrine to marine settings. These successions, such as the Ariri and Retiro Formations, form a critical regional seal for the underlying petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:Aptian ;
            owl:onProperty georeservoir:GEOCORE_0000015 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Carnallite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Sylvite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        presalt:ChemicalSedimentaryDeposit .

presalt:Extension a owl:Class ;
    rdfs:label "extension"@en ;
    rdfs:comment "Extension is a tectonic process that involves the stretching and thinning of the lithosphere, typically accommodated by normal faulting. In the context of the Brazilian Pre-Salt, this process was fundamental to the formation of the rift basins, creating the accommodation space for syn-rift sequences and the subsequent sag phase. The direction and obliquity of extension relative to pre-existing basement structures controlled the resulting structural architecture and the development of hydrocarbon traps."@en ;
    rdfs:subClassOf presalt:TectonicActivity .

presalt:FluidFlow a owl:Class ;
    rdfs:label "fluid flow"@en ;
    rdfs:comment "Fluid flow is the process that describes the movement of fluids, such as oil, gas, and water, through the interconnected pore and fracture network of a rock. In a petroleum reservoir, this process is governed by the interplay between the fluid's properties (e.g., viscosity, density) and the rock's petrophysical characteristics, including porosity, permeability, and pore-throat geometry. Geological heterogeneities, such as stratigraphic architecture and fracture networks, create preferential pathways and impediments that control the direction and rate of flow at the reservoir scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:Pore ],
        georeservoir:GEOCORE_0000002 .

presalt:Gas a owl:Class ;
    rdfs:label "gas"@en ;
    rdfs:comment "Gas is a naturally occurring hydrocarbon-based fluid mixture that exists in a gaseous state at reservoir or surface conditions and is primarily composed of methane along with other light hydrocarbons and non-hydrocarbon compounds. In the context of Pre-Salt petroleum systems, it is typically an oil-associated thermogenic gas, generated from the thermal cracking of kerogen or oil at varying maturity stages. This gas often contains significant concentrations of non-hydrocarbon components, such as carbon dioxide (CO2), which can impact reservoir fluid properties and development strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Oil ],
        presalt:Hydrocarbon .

presalt:Gneiss a owl:Class ;
    rdfs:label "gneiss"@en ;
    rdfs:comment "Gneiss is a high-grade metamorphic rock that is characterized by a distinct banded texture and constitutes a major component of the pre-Cambrian crystalline basement in South Atlantic marginal basins. In the Brazilian Pre-Salt, it typically forms a granitic-gneissic complex that underlies the sedimentary rift sequence. Erosion of this basement rock provides clasts for conglomerates deposited in syn-rift and sag sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CrystallineBasement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Clast ],
        georeservoir:GEOCORE_0000008 .

presalt:GrowthStrata a owl:Class ;
    rdfs:label "growth strata"@en ;
    rdfs:comment "Growth strata are a package of syn-tectonic sedimentary layers that are deposited contemporaneously with active fault movement. They characteristically form wedge-shaped geometries with internal divergent reflections that thicken toward the downthrown side of the controlling fault, filling accommodation space in rift-related half-grabens and recording the history of fault activity."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:HangingWall a owl:Class ;
    rdfs:label "hanging wall"@en ;
    rdfs:comment "Hanging wall is the tectonic block that is located above an inclined fault plane. In extensional rift settings, the hanging wall typically subsides relative to the footwall, accommodating syn-rift sedimentary packages that may form growth wedges and exhibit complex internal deformation such as drag folds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Subsidence ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Fault ],
        presalt:StructuralBlock .

presalt:IgneousRock a owl:Class ;
    rdfs:label "igneous rock"@en ;
    rdfs:comment "Igneous rock is a rock that is formed from the cooling and solidification of magma or lava. In the Brazilian Pre-Salt, these rocks are abundant and occur as both extrusive (Barremian/Aptian basalts) and intrusive (Santonian/Campanian alkaline sills) bodies that significantly impact reservoir character. These intrusions are often associated with hydrothermal fluid circulation, driving diagenetic processes such as silicification and dolomitization in the surrounding carbonate host rocks."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:InterparticlePore a owl:Class ;
    rdfs:label "interparticle pore"@en ;
    rdfs:comment "Interparticle pore is a type of primary pore space that exists in the voids between the constituent grains or clasts of a sedimentary rock. In Brazilian Pre-Salt carbonates, this porosity is predominantly found in reworked, grain-supported facies such as calcirudites and calcarenites, where it is often enhanced by dissolution and significantly contributes to reservoir permeability. The original pore volume can be reduced or occluded by the precipitation of cements like dolomite, quartz, or anhydrite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Calcarenite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Calcirudite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        presalt:Pore .

presalt:IntraclasticGrainstone a owl:Class ;
    rdfs:label "intraclastic grainstone"@en ;
    rdfs:comment "Intraclastic grainstone is a grain-supported sedimentary carbonate rock that is predominantly composed of sand-sized (<2 mm) intraclasts derived from the reworking of pre-existing, semi-lithified lacustrine carbonate deposits. In the context of the Brazilian Pre-Salt, these intraclasts are typically fragments of fascicular calcite crusts, spherulites, laminites, and shrubstones, often mixed with subordinate whole spherulites, ooids, and siliciclastic or volcanoclastic grains. This facies is characterized by moderate to good sorting and rounded grains, representing deposition in high-energy lacustrine environments and forming a significant reservoir rock type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Sorting ],
        presalt:Grainstone .

presalt:ItapemaFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Itapema Formation"@en ;
    rdfs:comment "The Itapema Formation is a syn-rift stratigraphic unit of the Brazilian Pre-Salt that is composed of interbedded lacustrine coquinas and organic-rich shales deposited during the Neobarremian to Eoaptian. It constitutes a critical component of the petroleum system, containing both significant coquina reservoirs and world-class source rocks within its shale intervals, and is stratigraphically positioned below the Barra Velha Formation."@en .

presalt:Karstification a owl:Class ;
    rdfs:label "karstification"@en ;
    rdfs:comment "Karstification is a geological dissolution process that acts on soluble rocks, such as carbonates, to create distinctive subsurface features including vugs, dissolution channels, and caves. In the Brazilian Pre-Salt, this process can be hypogenic, driven by ascending hydrothermal fluids along fault zones, or penecontemporaneous, resulting from subaerial exposure. The intensity of karstification critically controls reservoir quality, either enhancing porosity and permeability or degrading it through rock collapse and the formation of low-permeability karst breccias."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Vug ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Cave ],
        presalt:Dissolution .

presalt:Magmatism a owl:Class ;
    rdfs:label "magmatism"@en ;
    rdfs:comment "Magmatism is a geological process that encompasses the generation, movement, and emplacement of molten rock (magma) within and onto the Earth's crust. In the context of the South Atlantic margin, this process occurred in multiple tectonically-controlled cycles (e.g., rift, drift) and includes both intrusive and extrusive events. These magmatic events are a significant source of heat and mantle-derived CO2, driving hydrothermal fluid flow that can cause diagenetic alteration in reservoir rocks and influence the chemistry of depositional environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:HydrothermalAlteration ],
        georeservoir:GEOCORE_0000002 .

presalt:MatrixDissolution a owl:Class ;
    rdfs:label "matrix dissolution"@en ;
    rdfs:comment "Matrix dissolution is a diagenetic process that selectively removes the fine-grained material (matrix) from between the framework grains of a sedimentary rock, creating or enhancing porosity. In Brazilian Pre-Salt carbonates, this process is critical for reservoir development, as it commonly targets the primary syngenetic Mg-clay (e.g., stevensite) or micritic matrix to create significant intergranular, laminar, and vugular pore systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Micrite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MgClay ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Matrix ],
        presalt:Dissolution .

presalt:MgRichClay rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Burial ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:LakeWater ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Stevensite ] .

presalt:Mud a owl:Class ;
    rdfs:label "mud"@en ;
    rdfs:comment "Mud is a fine-grained sedimentary material that constitutes a primary depositional component in Pre-Salt lacustrine carbonates, composed of a complex mixture of clay minerals, calcite, dolomite, and silica. It is characteristically rich in magnesian clays (e.g., kerolite, stevensite) and organic matter, and occurs either as discrete, finely laminated beds or as the matrix material within grain-supported facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:ClayMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        georeservoir:GEORES_0000031 .

presalt:Neomorphism a owl:Class ;
    rdfs:label "neomorphism"@en ;
    rdfs:comment "Neomorphism is a diagenetic process that transforms a mineral into a polymorph or a different crystal fabric through in-situ recrystallization. In Brazilian Pre-Salt carbonate reservoirs, this process primarily involves the transformation of unstable aragonitic bioclasts into more stable calcite, competing directly with dissolution. The predominance of neomorphism over dissolution is crucial for preserving primary interparticle porosity and thus maintaining higher reservoir permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Mineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        presalt:DiageneticProcess .

presalt:OceanicCrust a owl:Class ;
    rdfs:label "oceanic crust"@en ;
    rdfs:comment "Oceanic crust is the uppermost layer of the oceanic portion of a tectonic plate that is formed by seafloor spreading at mid-ocean ridges following continental breakup. Composed primarily of mafic rocks like basalt and gabbro, it is significantly denser and thinner than continental crust. In the context of the Brazilian margin, the onset of oceanic crust generation marks the transition to the post-rift drift phase, initiating long-wavelength thermal subsidence that influences subsequent basin development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Basalt ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Density ],
        presalt:Crust .

presalt:Oil a owl:Class ;
    rdfs:label "oil"@en ;
    rdfs:comment "Oil is a naturally occurring liquid hydrocarbon mixture that is generated from the thermal maturation of organic matter and accumulates in subsurface geological traps. Within a reservoir, it exists as a distinct fluid phase with specific physical properties, such as a characteristic pressure gradient, that govern its accumulation above a free-water level. It is the primary economic resource targeted and produced from petroleum systems, such as the giant fields of the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Reservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Hydrocarbon ],
        presalt:Hydrocarbon .

presalt:Oncoid a owl:Class ;
    rdfs:label "oncoid"@en ;
    rdfs:comment "An oncoid is a spheroidal, coated organo-sedimentary grain that is formed by the microbial accretion of concentric, irregular laminae around a central nucleus. Their formation requires intermittent rolling in a very shallow, low- to moderate-energy depositional environment, and they are considered unequivocal evidence of microbial (cyanobacterial) activity. In Pre-Salt carbonates, oncoids can develop significant intraparticle porosity through dissolution, locally enhancing reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Nucleus ],
        presalt:Clast .

presalt:Packstone a owl:Class ;
    rdfs:label "packstone"@en ;
    rdfs:comment "Packstone is a grain-supported sedimentary carbonate rock that is characterized by the presence of a mud or micrite matrix. In the context of the Brazilian Pre-Salt, these rocks are composed of reworked grains including fragments of shrubs, spherulites, peloids, and bioclasts, which are set within a matrix that can consist of carbonate minerals or Mg-clays."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Matrix ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Grain ],
        presalt:GrainSupportedCarbonateRock .

presalt:PreSaltSuccession a owl:Class ;
    rdfs:label "pre-salt succession"@en ;
    rdfs:comment "Pre-salt succession is a Lower Cretaceous stratigraphic succession that is bounded by the crystalline basement at its base and the overlying regional Aptian evaporite layer at its top. This succession comprises sedimentary and volcanic rocks deposited in a continental lacustrine system during the rift and sag phases associated with the opening of the South Atlantic Ocean. It contains the highly productive carbonate reservoirs of the Brazilian offshore, such as those found in the Barra Velha and Itapema formations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Coquina ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:LowerCretaceous ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:LowerCretaceous ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SantosBasin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CamposBasin ],
        [ a owl:Restriction ;
            owl:hasValue presalt:EarlyCretaceous ;
            owl:onProperty georeservoir:GEOCORE_0000014 ],
        [ a owl:Restriction ;
            owl:hasValue presalt:EarlyCretaceous ;
            owl:onProperty georeservoir:GEOCORE_0000014 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VolcanicRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEORES_0000020 .

presalt:Pyrite a owl:Class ;
    rdfs:label "pyrite"@en ;
    rdfs:comment "Pyrite is an iron sulfide mineral that occurs as a common diagenetic product in Brazilian Pre-Salt successions, often resulting from thermochemical sulfate reduction. It is frequently found filling fractures and pores or replacing other minerals, exhibiting cubic, microcrystalline, or macrocrystalline habits, with its presence in fractures suggesting remobilization during diagenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        presalt:Sulfide .

presalt:ReworkedSediment a owl:Class ;
    rdfs:label "reworked sediment"@en ;
    rdfs:comment "Reworked sediment is a clastic carbonate sediment that is derived from the erosion, breakdown, and transport of pre-existing in-situ carbonate facies, such as shrubs and spherulites. In the Brazilian Pre-Salt, this process typically occurs during lacustrine lowstands, when wave action and subaerial exposure on paleo-highs break down the primary carbonate buildups. These fragmented materials are subsequently transported away from the highs by gravitational currents and redeposited in adjacent lows and more distal basinal settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Spherulite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        presalt:CarbonateSediment .

presalt:Rudstone a owl:Class ;
    rdfs:label "rudstone"@en ;
    rdfs:comment "Rudstone is a grain-supported sedimentary carbonate rock that is defined by having more than 10% of its components larger than 2 mm in diameter. In the Brazilian Pre-Salt, these large components commonly consist of intraclasts, bioclastic fragments such as mollusk shells, spherulites, or shrub fragments. These rocks are often deposited in high-energy settings and can form significant reservoir intervals with complex pore systems including interparticle, moldic, and vuggy porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:ShrubFragment ],
        presalt:GrainSupportedCarbonateRock .

presalt:SedimentWaterInterface a owl:Class ;
    rdfs:label "sediment-water interface"@en ;
    rdfs:comment "The sediment-water interface is a physical and biogeochemical boundary that separates the bottom of a water body from the underlying unconsolidated sediments. In the context of Pre-Salt lacustrine carbonates, this interface is a critical zone where unique chemical conditions facilitate the precipitation of reservoir-forming components, such as calcite spherulites and shrubs, directly on the lake bed or within gels just below it."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:Shale a owl:Class ;
    rdfs:label "Shale"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:ShrubFragment a owl:Class ;
    rdfs:label "shrub fragment"@en ;
    rdfs:comment "A shrub fragment is a carbonate allochem that is formed by the mechanical breakdown, disarticulation, and reworking of microbial shrub structures from their original growth position. These fragments are transported as sedimentary grains by currents and redeposited, commonly forming the primary framework of high-energy grainstone facies. Petrographically, they are often identified by their distinctive optical properties, such as sweeping extinction, even when highly abraded and altered."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Grainstone ],
        presalt:ReworkedSediment .

presalt:SilicaCement a owl:Class ;
    rdfs:label "silica cement"@en ;
    rdfs:comment "Silica cement is an authigenic mineral phase that is composed of silica polymorphs, such as quartz and chalcedony, which precipitates from pore fluids to fill or line voids in a rock. In Brazilian Pre-Salt carbonates, it occurs as microcrystalline quartz, macrocrystalline mosaic quartz, and chalcedony, precipitating within interparticle pores, vugs, and fractures as a pore-lining or pore-occluding phase that can significantly impact reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Quartz ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Chalcedony ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Vug ],
        presalt:Cement .

presalt:Siltstone a owl:Class ;
    rdfs:label "siltstone"@en ;
    rdfs:comment "Siltstone is a clastic sedimentary rock that is composed predominantly of silt-sized particles, which in the Pre-Salt context can be siliciclastic, carbonate (calcisiltite), or a hybrid mixture. Within the lacustrine Pre-Salt succession, siliciclastic siltstones are typically rich in K-feldspar, quartz, and mica, and are often found interbedded with carbonate and hybrid types deposited by processes such as gravitational flows."@en ;
    rdfs:subClassOf presalt:ClasticSedimentaryRock .

presalt:StructuralHigh a owl:Class ;
    rdfs:label "structural high"@en ;
    rdfs:comment "A structural high is a tectonically uplifted area that forms a positive relief feature on a specific geological surface, such as the basement, relative to adjacent structural lows or grabens. In the context of the Brazilian Pre-Salt, these features are typically fault-bounded horst blocks formed during the rifting phase, which acted as paleotopographic highs. These elevated positions favored the deposition of high-energy carbonate facies, which constitute the main petroleum reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Basement ],
        georeservoir:GEOCORE_0000001 .

presalt:Sulfide a owl:Class ;
    rdfs:label "sulfide"@en ;
    rdfs:comment "Sulfide is a diagenetic mineral that is composed of sulfur chemically bonded to one or more metals. In the Brazilian Pre-Salt, common examples such as pyrite, chalcopyrite, and sphalerite precipitate from sulfur-rich fluids associated with hydrothermal activity and thermal sulfate reduction. These minerals typically occur as euhedral crystals filling vugular and fracture porosity within carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:HydrothermalProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:Mineral .

presalt:Sylvite a owl:Class ;
    rdfs:label "sylvite"@en ;
    rdfs:comment "Sylvite is an evaporite mineral that occurs as a highly soluble salt within the thick, marine-origin evaporitic succession of the Ariri Formation. In the Brazilian Pre-Salt, it is found associated with halite, anhydrite, carnallite, and tachyhydrite, where it forms the cap rock for the underlying Barra Velha Formation reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        presalt:EvaporiteMineral .

presalt:Talc a owl:Class ;
    rdfs:label "talc"@en ;
    rdfs:comment "Talc is a magnesium silicate mineral that, in the Brazilian Pre-Salt, precipitates from Mg-rich silica gels in highly alkaline (pH 9-10) lacustrine settings. This hydrated form, characterized by a defective turbostratic crystal structure, is a key component of the Barra Velha Formation and acts as a precursor for diagenesis, releasing magnesium that promotes widespread dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000176 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSetting ],
        presalt:PhyllosilicateMineral .

georeservoir:GEOCORE_0000009 a owl:Class ;
    rdfs:label "Earth Fluid"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000010 a owl:Class ;
    rdfs:label "unconsolidated earth material"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000006 .

georeservoir:GEORES_0000023 a owl:Class .

bfo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

bfo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000020,
        bfo:BFO_0000031 .

bfo:BFO_0000006 a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf bfo:BFO_0000020 .

bfo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    owl:disjointWith bfo:BFO_0000031 .

bfo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

bfo:BFO_0000029 a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf bfo:BFO_0000141 .

presalt:Basalt a owl:Class ;
    rdfs:label "basalt"@en ;
    rdfs:comment "Basalt is a mafic extrusive igneous rock that is primarily composed of plagioclase feldspar and pyroxene minerals. In the Brazilian Pre-Salt, it commonly occurs as extensive tholeiitic flood basalts, such as those of the Camboriú Formation, which form the acoustic basement and are characterized seismically by high-continuity, sub-parallel reflectors indicative of stacked lava flows. These basalts also act as a source rock for clastic material, with eroded fragments found within overlying conglomeratic and carbonate reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CamboriFormation ],
        georeservoir:GEOCORE_0000008 .

presalt:Boundstone a owl:Class ;
    rdfs:label "boundstone"@en ;
    rdfs:comment "Boundstone is a sedimentary carbonate rock that is characterized by having its original components bound together in situ during deposition. In the Brazilian Pre-Salt, these rocks are commonly microbialites, such as stromatolites, or are composed of distinctive shrub-like fabrics whose origin is debated between microbial and abiotic processes. They can form important reservoir facies when fabric-selective porosity is developed, often through matrix dissolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:MatrixDissolution ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Microbialite ],
        presalt:InSituCarbonateRock .

presalt:Calcarenite a owl:Class ;
    rdfs:label "calcarenite"@en ;
    rdfs:comment "Calcarenite is a clastic carbonate rock that is composed predominantly of sand-sized carbonate grains. In the Brazilian Pre-Salt, these grains are typically reworked intraclasts of other carbonate facies (such as spherulites), ooids, and bioclasts, often forming laminated and graded beds with significant reservoir potential due to interparticle porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Ooid ],
        presalt:ClasticCarbonateRock .

presalt:CarbonateDeposit a owl:Class ;
    rdfs:label "carbonate deposit"@en ;
    rdfs:comment "A carbonate deposit is a sedimentary deposit that is formed by the accumulation of carbonate materials, which can be subsequently eroded and transformed after deposition. These deposits often form distinct layers or platforms whose thickness and distribution are controlled by the interplay between carbonate production, accumulation rates, and subsidence. In the Brazilian Pre-Salt, Aptian-age carbonate deposits formed in transitional lacustrine to shallow marine settings and constitute significant hydrocarbon reservoir sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:hasValue presalt:Aptian ;
            owl:onProperty georeservoir:GEOCORE_0000015 ],
        presalt:SedimentaryDeposit .

presalt:CarbonateFacies a owl:Class ;
    rdfs:label "carbonate facies"@en ;
    rdfs:comment "A carbonate facies is a subdivision of a carbonate stratigraphic unit that is distinguished by a unique combination of textural and compositional attributes, including grain size, sorting, packing, and morphology. In the Brazilian Pre-Salt lacustrine setting, these facies are broadly categorized as either autochthonous (in-situ grown) or allochthonous (reworked), encompassing rock types such as shrubs, spherulitites, laminites, and grainstones. The recognition of these distinct facies is fundamental for interpreting depositional environments and predicting the distribution of reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:RockType ],
        georeservoir:GEORES_0000029 .

presalt:ContinentalCarbonate a owl:Class ;
    rdfs:label "Continental Carbonate"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:CrystallineBasement a owl:Class ;
    rdfs:label "crystalline basement"@en ;
    rdfs:comment "Crystalline basement is a complex of igneous and metamorphic rocks, typically Precambrian granites and gneisses, that constitutes the foundational rock unit beneath a sedimentary basin. In the Brazilian Pre-Salt province, it underlies the rift sequences and is distinguished from the overlying Early Cretaceous volcanic rocks which often form the economic basement. These basement rocks can be fractured, acting as a host for subsequent diagenetic mineralization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:IgneousRock ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Gneiss ],
        georeservoir:GEOCORE_0000001 .

presalt:DiageneticFeature a owl:Class ;
    rdfs:label "diagenetic feature"@en ;
    rdfs:comment "A diagenetic feature is an observable textural, mineralogical, or structural characteristic of a rock that results from post-depositional diagenetic processes. Common examples in Brazilian Pre-Salt carbonates include cementation, compaction effects, dissolution voids, stylolites, and mineralogical alterations such as dolomitization and silicification. These features can be identified at various scales, from microscopic textures in thin sections to large-scale alteration zones mappable with seismic data."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:DiageneticStage a owl:Class ;
    rdfs:label "Diagenetic Stage"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Discontinuity a owl:Class ;
    rdfs:label "discontinuity"@en ;
    rdfs:comment "A discontinuity is a geological feature that marks an interruption in the physical continuity of rock layers or a rock mass. In a Pre-Salt context, this broadly refers to both structural breaks, such as faults and fractures, and stratigraphic surfaces, such as unconformities or bedding planes that separate units with different depositional characteristics. These features are often visualized using seismic attributes like coherence and are critical for understanding fluid flow and reservoir compartmentalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000011 .

presalt:GeologicalSubAge a owl:Class ;
    rdfs:label "Geological Sub-Age"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000003 .

presalt:HalfGraben a owl:Class ;
    rdfs:label "half-graben"@en ;
    rdfs:comment "A half-graben is an asymmetric structural low that is bounded on one side by a major normal fault, resulting in a tilted fault block with a characteristic wedge-shaped geometry. These extensional features, which can be controlled by planar or listric faults, are fundamental in creating accommodation space for syn-rift sedimentary deposits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:FaultBlock ],
        presalt:StructuralLow .

presalt:Horst a owl:Class ;
    rdfs:label "horst"@en ;
    rdfs:comment "A horst is an uplifted structural block that is bounded by normal faults, forming a structural high relative to adjacent down-dropped blocks known as grabens or half-grabens. In the context of the Brazilian Pre-Salt, horsts are large-scale features, often controlled by high-angle planar and listric faults, that can be internally complex with smaller-scale horsts and grabens. These structural highs are critical for forming traps for significant hydrocarbon accumulations in the underlying carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:NormalFault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Graben ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:HydrocarbonAccumulation ],
        presalt:StructuralBlock .

presalt:InSituCarbonateRock a owl:Class ;
    rdfs:label "In-Situ Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:LacustrineCarbonateSystem a owl:Class ;
    rdfs:label "lacustrine carbonate system"@en ;
    rdfs:comment "A lacustrine carbonate system is a sedimentary depositional system that is characterized by the accumulation of carbonate sediments, often microbial or chemogenic in origin, within a lake environment. The Brazilian Pre-Salt contains the largest known example from the Phanerozoic, a vast and complex accumulation of Aptian-age carbonates deposited in a late- to post-rift setting prior to the opening of the South Atlantic Ocean."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CarbonateSediment ],
        [ a owl:Restriction ;
            owl:hasValue presalt:Aptian ;
            owl:onProperty georeservoir:GEOCORE_0000015 ],
        presalt:LacustrineSystem .

presalt:Lamina a owl:Class ;
    rdfs:label "lamina"@en ;
    rdfs:comment "A lamina is a sedimentary layer that is characteristically less than one centimeter thick. It is distinguished from a bed by its thickness and can be defined by variations in grain size, composition, color, or internal fabric. Within Pre-Salt carbonates, laminae exhibit diverse geometries, including planar, wavy, and irregular forms, with their arrangement and continuity providing key insights into depositional energy and paleoenvironmental conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom georeservoir:GEORES_0000023 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Composition ],
        presalt:Layer .

presalt:LaminatedCarbonate a owl:Class ;
    rdfs:label "Laminated Carbonate"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Layer a owl:Class ;
    rdfs:label "layer"@en ;
    rdfs:comment "A layer is a tabular rock body that is distinguished from adjacent units by a coherent set of lithological, diagenetic, or petrophysical characteristics. These units are fundamental for reservoir characterization as they can form high-permeability conduits, such as vuggy or fractured zones, or act as flow barriers, such as silicified or clay-rich intervals."@en ;
    rdfs:subClassOf georeservoir:GEORES_0000020 .

presalt:MechanicalCompaction a owl:Class ;
    rdfs:label "mechanical compaction"@en ;
    rdfs:comment "Mechanical compaction is a physical diagenetic process that reduces the bulk volume and porosity of a sediment through the rearrangement, deformation, or fracturing of grains under increasing overburden stress. In carbonate rocks, this process is evidenced by tighter grain arrangements, concave-convex or long grain contacts, and deformed grains, and is distinct from chemical compaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Grain ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        presalt:Compaction .

presalt:MicrobialActivity a owl:Class ;
    rdfs:label "microbial activity"@en ;
    rdfs:comment "Microbial activity is a suite of metabolic processes carried out by microorganisms that directly or indirectly influences the precipitation, dissolution, and alteration of sedimentary components. In the context of Brazilian Pre-Salt carbonates, this activity is inferred from its geological products, such as the development of microbial mats, crenulated laminations, and peloidal-clotted textures, rather than from direct fossil evidence. It can also locally alter pore-fluid chemistry, influencing mineral stability and initiating the growth of diagenetic phases like calcite spherulites."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Nucleus a owl:Class ;
    rdfs:label "nucleus"@en ;
    rdfs:comment "Nucleus is the central core particle of a coated grain that acts as the initial substrate around which subsequent carbonate laminae precipitate. In Brazilian Pre-Salt carbonates, the nucleus of grains such as spherulites and ooids is commonly composed of diverse materials including micrite, peloids, bioclasts, or reworked intraclasts, and its shape can influence the final morphology of the host grain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Bioclast ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:CarbonatePrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Micrite ],
        bfo:BFO_0000024 .

presalt:Ooid a owl:Class ;
    rdfs:label "ooid"@en ;
    rdfs:comment "An ooid is a coated sedimentary grain, typically of coarse sand size, that is composed of a nucleus surrounded by a cortex of concentric laminae. Within the Brazilian Pre-Salt lacustrine systems, these grains were often originally composed of magnesium clays, such as stevensite, before being replaced by calcite, and they frequently exhibit complex nuclei like intraclasts or bioclasts due to formation in dynamic, reworked environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Nucleus ],
        georeservoir:GEOCORE_0000001 .

presalt:Peloid a owl:Class ;
    rdfs:label "peloid"@en ;
    rdfs:comment "A peloid is a small, irregular carbonate grain, typically silt to fine sand in size, that is composed of microcrystalline carbonate and lacks a discernible internal structure, often interpreted in the Pre-Salt as a micritized intraclast. In the Brazilian Pre-Salt lacustrine successions, peloids are a significant primary constituent of reservoir rocks, forming peloidal grainstones and packstones, and are commonly associated with ooids, spherulites, and bioclasts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Packstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Grainstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        georeservoir:GEOCORE_0000001 .

presalt:RegionalUnconformity a owl:Class ;
    rdfs:label "regional unconformity"@en ;
    rdfs:comment "A regional unconformity is a stratigraphic surface of erosion or non-deposition that separates younger strata from older rocks and extends across a significant portion of a sedimentary basin. Identifiable on seismic data by widespread reflector terminations such as truncation, it represents a significant hiatus in the geological record often caused by tectonic uplift or a major fall in base level. In the Brazilian Pre-Salt, these surfaces are critical markers for subdividing major tectono-stratigraphic sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SedimentaryBasin ],
        presalt:Unconformity .

presalt:Rifting a owl:Class ;
    rdfs:label "rifting"@en ;
    rdfs:comment "Rifting is a large-scale tectonic process that involves the horizontal stretching and thinning of the continental lithosphere in response to extensional forces. This process creates rift basins through normal faulting and subsidence, which, in the case of the South Atlantic, was accompanied by significant volcanism and generated the accommodation space for the Pre-Salt lacustrine successions."@en ;
    rdfs:subClassOf presalt:TectonicActivity .

presalt:Seal a owl:Class ;
    rdfs:label "seal"@en ;
    rdfs:comment "A seal is a low-permeability rock unit that forms a barrier to fluid migration, effectively trapping hydrocarbons within a petroleum system. In the context of the Brazilian Pre-Salt, the primary regional seal consists of thick evaporite deposits, specifically the halite and anhydrite of the Ariri Formation. Other lithologies with low permeability, such as micritic carbonates, can also function as local or intra-formational seals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:EvaporiteDeposit ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Anhydrite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Halite ],
        georeservoir:GEORES_0000002 .

presalt:SedimentaryDeposit a owl:Class ;
    rdfs:label "Sedimentary Deposit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000006 .

presalt:Unconformity a owl:Class ;
    rdfs:label "unconformity"@en ;
    rdfs:comment "An unconformity is a surface of erosion or non-deposition that separates younger strata from older underlying rocks, representing a significant hiatus in the geological record. In the Brazilian Pre-Salt, these surfaces are identified seismically by truncation and onlap, and mark major tectono-stratigraphic boundaries such as the Pre-Alagoas Unconformity which separates syn-rift from transitional sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Erosion ],
        presalt:Discontinuity .

presalt:Weathering a owl:Class ;
    rdfs:label "weathering"@en ;
    rdfs:comment "Weathering is a set of physical and chemical processes that cause the decomposition and disintegration of rocks and minerals at or near the Earth's surface. In the context of Brazilian Pre-Salt carbonates, this process is associated with subaerial exposure during lake-level falls, resulting in the formation of distinct weathering profiles or paleosols. These profiles are characterized by the erasure of original rock fabric, the development of granular or clotted textures, and can be identified geochemically by a high Chemical Index of Alteration (CIA)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Mineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        georeservoir:GEOCORE_0000002 .

georeservoir:GEOCORE_0000005 a owl:Class ;
    rdfs:label "Geological Time Interval"@en ;
    rdfs:subClassOf bfo:BFO_0000038 .

georeservoir:GEOCORE_0000011 a owl:Class ;
    rdfs:label "Geological Boundary"@en ;
    rdfs:subClassOf bfo:BFO_0000146 .

georeservoir:GEORES_0000001 a owl:Class ;
    rdfs:label "body of rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000028 a owl:Class ;
    rdfs:label "Facies"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

bfo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    owl:disjointWith bfo:BFO_0000003 .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf bfo:BFO_0000001 .

presalt:BioclasticCarbonateRock a owl:Class ;
    rdfs:label "Bioclastic Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Chalcedony a owl:Class ;
    rdfs:label "chalcedony"@en ;
    rdfs:comment "Chalcedony is a cryptocrystalline variety of silica (SiO₂) that is characterized by a fibrous microstructure, often appearing as fibro-radial, spherulitic, or botryoidal aggregates. In Brazilian Pre-Salt carbonates, it is a significant diagenetic phase that acts as a pore-lining and pore-filling cement in interparticle, fracture, and vuggy pores. This cementation can post-date other silica phases and partially occlude reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        presalt:Silica .

presalt:ClasticCarbonateRock a owl:Class ;
    rdfs:label "Clastic Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Compaction a owl:Class ;
    rdfs:label "compaction"@en ;
    rdfs:comment "Compaction is a diagenetic process that reduces the bulk volume and porosity of a sediment or rock in response to increasing stress, typically from the weight of overlying sediments. It includes mechanical compaction, evidenced by physical grain rearrangement, deformation, and fracturing, and chemical compaction, which involves pressure solution at grain contacts. In Pre-Salt carbonates, common evidence includes tight grain packing, concave-convex to sutured grain contacts, and deformed grains, all contributing to a decrease in porosity with burial depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:MechanicalCompaction ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        presalt:DiageneticProcess .

presalt:EarlyCretaceous a owl:NamedIndividual,
        presalt:GeologicalEpoch ;
    rdfs:label "early cretaceous"@en ;
    rdfs:comment "The Early Cretaceous is a geological epoch that, in the context of the South Atlantic, is characterized by the continental rifting and breakup that separated South America from Africa. This period, spanning from approximately 145 to 100.5 million years ago, involved the formation of extensive lacustrine rift basins where the syn-rift source rocks and subsequent sag-phase carbonate reservoirs of the Pre-Salt succession were deposited."@en .

presalt:FaultReactivation a owl:Class ;
    rdfs:label "fault reactivation"@en ;
    rdfs:comment "Fault reactivation is a tectonic process that involves renewed slip or displacement along a pre-existing, older fault plane, typically in response to a change in the regional stress field. In the context of the Brazilian Pre-Salt, the reactivation of syn-rift faults during later depositional phases controlled the creation of accommodation space, the distribution of carbonate reservoirs, and the development of fracture systems that influence porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fault ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Displacement ],
        presalt:TectonicActivity .

presalt:Feldspar a owl:Class ;
    rdfs:label "feldspar"@en ;
    rdfs:comment "Feldspar is a group of rock-forming tectosilicate minerals that are characterized by a framework of silica and alumina tetrahedra. In the context of the Brazilian Pre-Salt, feldspar, particularly potassium feldspar (K-feldspar), occurs as detrital siliciclastic grains within carbonate and mixed siliciclastic-carbonate facies. It is also found as primary euhedral phenocrysts in volcanic-derived felsic tuff layers intercalated within the lacustrine succession."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        presalt:TectosilicateMineral .

presalt:FormationWater a owl:Class ;
    rdfs:label "Formation Water"@en ;
    rdfs:comment "Water is a naturally occurring fluid that occupies the pore space of reservoir rocks, coexisting with or underlying hydrocarbons. Referred to as formation water in a subsurface context, its salinity and resistivity are critical petrophysical parameters used to calculate hydrocarbon saturation. The spatial distribution of this water defines key surfaces like the oil-water contact and can influence reservoir compartmentalization through phenomena such as perched water."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        presalt:Fluid .

presalt:GeologicalEpoch a owl:Class ;
    rdfs:label "Geological Epoch"@en ;
    rdfs:subClassOf presalt:GeologicalPeriod .

presalt:GeologicalPeriod a owl:Class ;
    rdfs:label "Geological Period"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

presalt:GrainSupportedCarbonateRock a owl:Class ;
    rdfs:label "Grain-Supported Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Hydrocarbon a owl:Class ;
    rdfs:label "hydrocarbon"@en ;
    rdfs:comment "Hydrocarbon is a class of naturally occurring organic compounds that comprises petroleum (crude oil) and natural gas, generated from the thermal maturation of organic matter within source rocks. These substances migrate and accumulate in porous reservoir rocks, forming commercially exploitable deposits such as the vast light oil and gas accumulations found in the lacustrine carbonate reservoirs of the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonateReservoir ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:OrganicMatter ],
        presalt:Fluid .

presalt:LacustrineCarbonateReservoir a owl:Class ;
    rdfs:label "lacustrine carbonate reservoir"@en ;
    rdfs:comment "A lacustrine carbonate reservoir is a petroleum reservoir that is composed of carbonate rocks deposited within a lacustrine (lake) system and has sufficient porosity and permeability to store and transmit hydrocarbons. These reservoirs, particularly in the Brazilian Pre-Salt, are characterized by significant heterogeneity and are typically formed in rift basins, with reservoir quality controlled by depositional facies like shrubstones and grainstones and a complex diagenetic history that creates secondary pore systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Shrubstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Grainstone ],
        presalt:CarbonateReservoir .

presalt:Lamination a owl:Class ;
    rdfs:label "lamination"@en ;
    rdfs:comment "Lamination is a type of primary sedimentary stratification that consists of thin layers, or laminae, typically less than one centimeter thick. In the Brazilian Pre-Salt, these structures are a dominant feature in carbonate rocks, presenting as planar, wavy, or irregular layers that can be laterally continuous or discontinuous. They are characteristic of facies such as argillaceous limestones and microbialites, reflecting variations in depositional conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lamina ],
        georeservoir:GEORES_0000025 .

presalt:MatrixSupportedCarbonateRock a owl:Class ;
    rdfs:label "Matrix-Supported Carbonate Rock"@en ;
    rdfs:subClassOf presalt:CarbonateRock .

presalt:Mica a owl:Class ;
    rdfs:label "mica"@en ;
    rdfs:comment "Mica is a group of sheet silicate minerals that occurs as a detrital component within siliciclastic and hybrid sedimentary rocks of the Brazilian Pre-Salt. Commonly observed as white mica (muscovite/sericite) in thin section, it is a characteristic siliciclastic grain in siltstones and mudstones, where its abundance is quantified alongside quartz and feldspar using petrographic and geochemical log data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Mudstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Siltstone ],
        presalt:PhyllosilicateMineral .

presalt:Microbialite a owl:Class ;
    rdfs:label "microbialite"@en ;
    rdfs:comment "Microbialite is an organosedimentary deposit that is produced, induced, or influenced by benthic microbial communities. In the context of the Brazilian Pre-Salt, it typically forms autochthonous, porous carbonate bodies composed of microbially induced clots and peloids, often appearing as tabular to irregular lenses with relict lamination or subvertical branching structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:MicrobialActivity ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Peloid ],
        presalt:Deposit .

presalt:Mudstone a owl:Class ;
    rdfs:label "mudstone"@en ;
    rdfs:comment "Mudstone is a matrix-supported carbonate sedimentary rock that, according to the Dunham classification, contains less than 10% grains and is composed predominantly of carbonate mud. In the Brazilian Pre-Salt, these rocks exhibit a highly variable mineralogical composition and can be classified as calci-mudstone, dolo-mudstone, siliceous mudstone, or Mg-clay mudstone. Depending on their composition and organic content, they can function as low-quality reservoir intervals or as critical source rocks for the petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:MineralogicalComposition ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Grain ],
        presalt:MatrixSupportedCarbonateRock .

presalt:NormalFault a owl:Class ;
    rdfs:label "normal fault"@en ;
    rdfs:comment "A normal fault is a dip-slip fault that results from crustal extension, where the hanging wall block moves downward relative to the footwall block. In the Brazilian Pre-Salt, these faults are a primary component of the rift-related structural framework, forming half-grabens and compartmentalizing both basement blocks and overlying sedimentary sequences. Their activity is often syndepositional, influencing the architecture of carbonate reservoirs and offsetting key horizons such as the base of the salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:HalfGraben ],
        presalt:Fault .

presalt:Ostracod a owl:Class ;
    rdfs:label "ostracod"@en ;
    rdfs:comment "An ostracod is an aquatic crustacean that is characterized by a bivalved carapace and serves as the primary biostratigraphic index fossil for non-marine Lower Cretaceous sequences like the Brazilian Pre-Salt. In these lacustrine settings, their shells are significant rock-forming components whose accumulation and preservation indicate specific paleoenvironmental conditions, and whose subsequent diagenesis can contribute to reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineSetting ],
        georeservoir:GEORES_0000018 .

presalt:PhyllosilicateMineral a owl:Class ;
    rdfs:label "Phyllosilicate Mineral"@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:PreSaltReservoir a owl:Class ;
    rdfs:label "pre-salt reservoir"@en ;
    rdfs:comment "A pre-salt reservoir is a carbonate petroleum reservoir that is located stratigraphically beneath a thick evaporite sequence and was deposited during the late syn-rift to early post-rift phases of continental breakup. These reservoirs are primarily composed of complex lacustrine carbonates, including coquinas, microbialites, calcite shrubs, and various intraclastic rocks, often exhibiting complex architecture and distribution. Found in the Santos and Campos basins of Brazil, they constitute giant oil and gas accumulations within formations such as Barra Velha, Itapema, and Macabu."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:PostRift ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:LacustrineCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:SantosBasin ],
        presalt:LacustrineCarbonateReservoir .

presalt:Precipitation a owl:Class ;
    rdfs:label "Precipitation"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Recrystallization a owl:Class ;
    rdfs:label "recrystallization"@en ;
    rdfs:comment "Recrystallization is a diagenetic process that alters the crystal size and fabric of existing minerals, such as calcite, without changing their fundamental chemical composition. In Pre-Salt carbonates, this process commonly involves the transformation of fine-grained components like bioclasts or micritic matrix into a coarser mosaic of calcite crystals. Intense recrystallization can obliterate the original depositional texture, creating crystalline limestones, and may be associated with the modification of the rock's porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Micrite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Bioclast ],
        presalt:DiageneticProcess .

presalt:Reservoir a owl:Class ;
    rdfs:label "reservoir"@en ;
    rdfs:comment "A reservoir is a subsurface rock body that possesses sufficient porosity and permeability to store and transmit economically significant quantities of hydrocarbons. In the Brazilian Pre-Salt, these are typically lacustrine carbonate rocks, such as coquinas, whose quality and heterogeneity are controlled by the interplay of depositional facies, diagenesis, and position within sedimentary cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        georeservoir:GEOCORE_0000001 .

presalt:Shrubstone a owl:Class ;
    rdfs:label "shrubstone"@en ;
    rdfs:comment "Shrubstone is a depositional carbonate rock that is primarily composed of shrubs, which are bush-like, fascicular aggregates of fibrous calcite crystals displaying branched or parallel growth patterns. These rocks often form coalesced layers or domal structures and can exhibit significant inter-aggregate, vugular, and dissolution-related porosity, making them an important reservoir facies in lacustrine carbonate systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:LacustrineCarbonateSystem ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VugularPorosity ],
        presalt:InSituCarbonateRock .

presalt:StructuralBlock a owl:Class ;
    rdfs:label "Structural Block"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:StructuralLow a owl:Class ;
    rdfs:label "structural low"@en ;
    rdfs:comment "A structural low is a tectonic feature that represents a relative depression of a geological surface, such as the basement, in relation to adjacent structural highs. In the context of the Brazilian Pre-Salt, these features typically manifest as fault-bounded grabens or half-grabens that serve as primary depocenters for syn-rift sediments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Basement ],
        presalt:TectonicFeature .

presalt:TectonicFeature a owl:Class ;
    rdfs:label "Tectonic Feature"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000004 .

presalt:TectonoStratigraphicInterval a owl:Class ;
    rdfs:label "Tectono-Stratigraphic Interval"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000005 .

presalt:TectonoStratigraphicUnit a owl:Class ;
    rdfs:label "Tectono-Stratigraphic Unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000002 .

presalt:TectosilicateMineral a owl:Class ;
    rdfs:label "Tectosilicate Mineral"@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:VolcanicRock a owl:Class ;
    rdfs:label "volcanic rock"@en ;
    rdfs:comment "Volcanic rock is an igneous rock that is formed from the cooling and solidification of magma or lava at or near the Earth's surface. In the Brazilian Pre-Salt, volcanic rocks are a significant source of detritus, occurring as granule- to pebble-sized fragments and intraclasts within reworked carbonate deposits such as grainstones and rudstones. The alteration of these volcanic materials in the lacustrine depositional environment can also influence diagenetic processes and the formation of authigenic minerals like stevensite."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

presalt:Vug a owl:Class ;
    rdfs:label "vug"@en ;
    rdfs:comment "A vug is a non-fabric-selective secondary pore that is generated or enhanced by dissolution, resulting in a cavity that is larger than the constituent grains or crystals of the rock. In the Brazilian Pre-Salt, vugs range from millimeters to tens of centimeters in size and occur as isolated features or as interconnected networks, often linked by fractures, which can create zones of exceptionally high permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:Pore .

georeservoir:GEORES_0000006 a owl:Class ;
    rdfs:label "Depositional Unit"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000001 .

georeservoir:GEORES_0000018 a owl:Class ;
    rdfs:label "Fossil"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf bfo:BFO_0000002 .

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 ;
    owl:disjointWith bfo:BFO_0000141 .

bfo:BFO_0000062 a owl:ObjectProperty ;
    rdfs:label "preceded by"@en .

bfo:BFO_0000063 a owl:ObjectProperty ;
    rdfs:label "precedes"@en .

bfo:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf bfo:BFO_0000004 .

bfo:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en .

presalt:Aptian a owl:NamedIndividual,
        georeservoir:GEOCORE_0000003 ;
    rdfs:label "Aptian"@en ;
    rdfs:comment "Aptian is a geological age of the Early Cretaceous Epoch that is characterized by the deposition of the main pre-salt lacustrine carbonate reservoirs and the overlying regional evaporite seal in the South Atlantic marginal basins. Spanning approximately from 125 to 113 million years ago, this age is defined in the Brazilian and West African basins by the development of a unique, vast lacustrine carbonate system, which constitutes the primary reservoir interval, followed by the deposition of a thick, basin-wide salt layer that forms the regional seal."@en .

presalt:Bivalve a owl:Class ;
    rdfs:label "bivalve"@en ;
    rdfs:comment "A bivalve is an aquatic mollusk that is characterized by a shell composed of two hinged parts, known as valves. In the Brazilian Pre-Salt, the shells of endemic lacustrine bivalves are the dominant bioclasts that constitute the framework of coquina reservoirs. These shells are typically found disarticulated and fragmented, and their subsequent dissolution is a primary mechanism for creating the high-porosity moldic frameworks characteristic of these carbonate reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        georeservoir:GEORES_0000018 .

presalt:BrazilianPreSalt a owl:NamedIndividual,
        georeservoir:GEORES_0000020 ;
    rdfs:label "brazilian pre-salt"@en ;
    rdfs:comment "The Brazilian Pre-Salt is a major petroleum province and tectono-stratigraphic succession of Early Cretaceous (Aptian) age that is defined by its position beneath a thick, extensive layer of evaporites in Brazil's offshore Santos and Campos basins. These rocks, primarily lacustrine carbonates, were deposited during the rift-to-sag tectonic phase associated with the breakup of Gondwana and the opening of the South Atlantic Ocean. The overlying evaporite layer acts as a highly effective regional seal, trapping giant accumulations of oil and gas in the underlying carbonate reservoirs."@en .

presalt:CarbonatePrecipitation a owl:Class ;
    rdfs:label "carbonate precipitation"@en ;
    rdfs:comment "Carbonate precipitation is a physicochemical and biochemical process that forms solid carbonate minerals from an aqueous solution when it becomes supersaturated with respect to those minerals. In lacustrine systems such as the Brazilian Pre-Salt, this process is controlled by factors including lake water chemistry (pH and salinity), climate cycles, and microbial activity. Precipitation can be abiotic, driven by evaporation during arid periods, or biologically induced, leading to the formation of key reservoir facies such as microbialites and spherulestones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:LacustrineSystem ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        presalt:Precipitation .

presalt:ClasticSedimentaryRock a owl:Class ;
    rdfs:label "Clastic Sedimentary Rock"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000032 .

presalt:Crust a owl:Class ;
    rdfs:label "Crust"@en,
        "crust"@en ;
    rdfs:comment "Crust is a primary carbonate rock fabric that is formed by the in-situ chemical or microbial precipitation of calcite, typically manifesting as coalescent or non-coalescent shrubs, fibrous aggregates, or laminated layers. The degree of coalescence between the constituent calcite shrubs or crystals is a primary control on the development of growth-framework porosity, directly influencing reservoir quality. Often analogous to lacustrine travertine deposits, these crusts are a fundamental component of the Barra Velha Formation reservoirs in the Brazilian Pre-Salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:CalciteShrub ],
        [ a owl:Restriction ;
            owl:hasValue presalt:BarraVelhaFormation ;
            owl:onProperty bfo:BFO_0000176 ],
        georeservoir:GEORES_0000025 .

presalt:Gastropod a owl:Class ;
    rdfs:label "gastropod"@en ;
    rdfs:comment "A gastropod is a univalve mollusk that serves as a significant skeletal grain (bioclast) within the lacustrine carbonate facies of the Brazilian Pre-Salt. The shells of gastropods contribute to the composition of grainstones, packstones, and rudstones, with their prevalence over other mollusks like bivalves indicating specific environmental conditions such as salinity variations. These bioclasts are often found in storm-deposited coquinas and are susceptible to diagenetic alteration, including neomorphism and dissolution, which can influence reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:Grainstone ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        georeservoir:GEOCORE_0000001 .

presalt:Graben a owl:Class ;
    rdfs:label "graben"@en ;
    rdfs:comment "A graben is an elongate, down-dropped structural block that is bounded by two or more subparallel normal faults, causing it to be displaced downward relative to the adjacent blocks. In extensional rift settings such as the Brazilian Pre-Salt, grabens form key depocenters where thick sequences of syn-rift sediments accumulate. These structures can also act as permeability barriers or form components of structural traps, influencing fluid migration and reservoir compartmentalization."@en ;
    rdfs:subClassOf presalt:StructuralLow .

presalt:HydrothermalAlteration a owl:Class ;
    rdfs:label "hydrothermal alteration"@en ;
    rdfs:comment "Hydrothermal alteration is a geological process that causes complex physicochemical changes in pre-existing rocks through interaction with circulating hot fluids. In Pre-Salt carbonate settings, this process is typically associated with deep-seated faults and magmatic activity, resulting in the precipitation of characteristic minerals like saddle dolomite, barite, and fluorite, or the creation of dissolution features such as vugs and caves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Vug ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:HydrothermalFluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:SaddleDolomite ],
        presalt:HydrothermalProcess .

presalt:HydrothermalFluid a owl:Class ;
    rdfs:label "hydrothermal fluid"@en ;
    rdfs:comment "A hydrothermal fluid is a hot, aqueous subsurface fluid that circulates through the Earth's crust, driven by high geothermal gradients associated with magmatic or tectonic activity. In petroleum systems like the Brazilian Pre-Salt, these fluids migrate along faults and fractures, causing significant diagenetic alteration through dissolution (hypogenic karst) and the precipitation of characteristic minerals, which can create or enhance reservoir porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:FormationWater ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:FormationWater .

presalt:HydrothermalProcess a owl:Class ;
    rdfs:label "hydrothermal process"@en ;
    rdfs:comment "A hydrothermal process is a set of physicochemical processes that involves the circulation of hot fluids through the Earth's crust, causing the redistribution of energy and mass. In carbonate sequences, this process results in hydrothermal alteration, where interactions with hot fluids flowing through conduits like fault systems cause the dissolution of pre-existing minerals and precipitation of new ones, such as saddle dolomite, fluorite, and barite. Such alteration can significantly modify the original rock fabric, geochemical signatures, and reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Mineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000063 ;
            owl:someValuesFrom presalt:HydrothermalAlteration ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Dolomitization ],
        georeservoir:GEOCORE_0000002 .

presalt:LacustrineSystem a owl:Class ;
    rdfs:label "lacustrine system"@en ;
    rdfs:comment "A lacustrine system is a depositional system that is centered on a lake or a series of interconnected lakes, where sedimentation is controlled by the physical, chemical, and biological conditions of the water body. In the context of the Brazilian Pre-Salt, this refers to a vast, alkaline, and chemically stratified system that developed in a late- to post-rift tectonic setting. These systems are characterized by the accumulation of complex carbonate geometries, often of microbial and abiotic origin, which form significant hydrocarbon reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000014 ;
            owl:someValuesFrom presalt:PostRift ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Lake ],
        georeservoir:GEORES_0000020 .

presalt:Micrite a owl:Class ;
    rdfs:label "micrite"@en ;
    rdfs:comment "Micrite is a fine-grained carbonate mud that represents pelagic background sedimentation in calm, deep lacustrine environments. It accumulates in low-energy settings to form distinct laminated or massive rock bodies, or acts as the matrix in other carbonates, and typically relies on secondary fractures for reservoir-quality porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        presalt:CarbonateSediment .

presalt:Replacement a owl:Class ;
    rdfs:label "replacement"@en ;
    rdfs:comment "Replacement is a diagenetic process that substitutes a pre-existing mineral, fabric, or rock component with a new mineral phase, often on a volume-for-volume basis. In Brazilian Pre-Salt reservoirs, common examples include the replacement of stevensitic clays and calcite spherulites by dolomite or silica, which can significantly alter the rock fabric and promote the formation of microporosity and vugular porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Stevensite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:DiageneticProcess .

presalt:SedimentaryProcess a owl:Class ;
    rdfs:label "Sedimentary Process"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000002 .

presalt:Stevensite a owl:Class ;
    rdfs:label "stevensite"@en ;
    rdfs:comment "Stevensite is an aluminum-poor, magnesium-rich smectitic clay mineral that precipitates chemically in highly alkaline (pH > 9), silica-rich lacustrine environments. Within the Brazilian Pre-Salt, it is a common primary deposit in low-energy settings, occurring as laminated aggregates, coatings, ooids, and peloids, and is diagenetically unstable, often dissolving to become a significant source of authigenic silica."@en ;
    rdfs:subClassOf presalt:ClayMineral .

georeservoir:GEOCORE_0000012 a owl:Class ;
    rdfs:label "Geological Contact"@en ;
    rdfs:subClassOf bfo:BFO_0000145 .

georeservoir:GEOCORE_0000015 a owl:ObjectProperty ;
    rdfs:label "has age"@en .

georeservoir:GEORES_0000029 a owl:Class ;
    rdfs:label "Sedimentary Facies"@en ;
    rdfs:subClassOf georeservoir:GEORES_0000028 .

presalt:Anhydrite a owl:Class ;
    rdfs:label "anhydrite"@en ;
    rdfs:comment "Anhydrite is an evaporite mineral of anhydrous calcium sulfate (CaSO4) that, in the Pre-Salt, forms mechanically brittle layers and diagenetic cements. Stratigraphically, it constitutes a key basal layer of the Ariri Formation, creating a high-impedance seismic reflector at the top of the Barra Velha reservoirs and influencing salt tectonic styles. As a cement, it can occlude porosity within the carbonate reservoir facies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:CarbonateReservoir ],
        presalt:EvaporiteMineral .

presalt:CarbonateReservoir a owl:Class ;
    rdfs:label "carbonate reservoir"@en ;
    rdfs:comment "A carbonate reservoir is a subsurface geological formation composed of carbonate rocks that possesses sufficient porosity and permeability to store and transmit hydrocarbons. These reservoirs are characterized by extreme heterogeneity resulting from complex depositional, diagenetic, and tectonic histories, which often creates significant challenges for characterization and production, particularly in unique settings like the Brazilian Pre-Salt lacustrine deposits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Permeability ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Porosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Heterogeneity ],
        presalt:Reservoir .

presalt:CarbonateSediment a owl:Class ;
    rdfs:label "carbonate sediment"@en ;
    rdfs:comment "Carbonate sediment is a type of unconsolidated material that is primarily composed of minerals containing the carbonate anion (CO3)2-, formed either through direct precipitation from water or by the accumulation of grains. In the lacustrine systems of the Brazilian Pre-Salt, this sediment is characteristically composed of in-situ microbial shrubs, abiotic spherulites, fine-grained muds, and reworked intraclasts. The accumulation of this material, governed by factors like lake level and accommodation space, serves as the precursor that lithifies into carbonate reservoir rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Intraclast ],
        georeservoir:GEORES_0000031 .

presalt:Cementation a owl:Class ;
    rdfs:label "cementation"@en ;
    rdfs:comment "Cementation is a diagenetic process that precipitates authigenic minerals from pore fluids into the void spaces of a sediment or rock. While this process generally reduces reservoir quality by occluding porosity, certain cement types can also preserve pores by forming rigid mineral frameworks that increase resistance to compaction, with common cements in Pre-Salt carbonates including calcite, dolomite, and quartz."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEORES_0000031 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        presalt:DiageneticProcess .

presalt:Deposit a owl:Class ;
    rdfs:label "deposit"@en ;
    rdfs:comment "A deposit is a body of sediment or rock that forms through the accumulation of material via chemical, biological, or physical processes within a depositional setting. In the Brazilian Pre-Salt's lacustrine basins, these include chemically precipitated carbonates, microbialites, and fine-grained Mg-clays, whose character and distribution are controlled by factors such as water chemistry, bathymetry, and hydrothermal input."@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000001 .

presalt:Erosion a owl:Class ;
    rdfs:label "erosion"@en ;
    rdfs:comment "Erosion is a geological process that removes and transports rock and sedimentary material from the Earth's surface, resulting in the truncation of underlying strata. In seismic stratigraphy, this process is identified by truncated reflectors along an erosional surface, which often represents a significant unconformity separating stratigraphic units. Within the Pre-Salt lacustrine system, episodes of low lake level can expose carbonate buildups to subaerial erosion, breaking them down to generate reworked sediments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateBuildUp ],
        georeservoir:GEOCORE_0000002 .

presalt:EvaporiteMineral a owl:Class ;
    rdfs:label "Evaporite Mineral"@en ;
    rdfs:subClassOf presalt:Mineral .

presalt:Halite a owl:Class ;
    rdfs:label "halite"@en ;
    rdfs:comment "Halite is an evaporite mineral that is chemically composed of sodium chloride (NaCl) and precipitates from saline water bodies. In the Brazilian Pre-Salt, it is a primary component of the Aptian Ariri Formation, where its highly ductile and plastic behavior allows it to flow and form thick, mobile salt bodies and diapirs that act as a critical regional seal for the underlying petroleum system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:AririFormation ;
            owl:onProperty bfo:BFO_0000176 ],
        presalt:EvaporiteMineral .

presalt:LacustrineCarbonate a owl:Class ;
    rdfs:label "lacustrine carbonate"@en ;
    rdfs:comment "Lacustrine carbonate is a sedimentary carbonate rock that is deposited in a lake environment, where its genesis and facies variability are primarily controlled by local factors such as tectonics, climate, and water chemistry. In the context of the Brazilian Pre-Salt, these rocks form extensive and economically significant hydrocarbon reservoirs characterized by unusual autochthonous components, including microbial shrubs and abiotic spherulites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Spherulite ],
        presalt:ContinentalCarbonate .

presalt:MgSilicateClay a owl:Class ;
    rdfs:label "mg-silicate clay"@en ;
    rdfs:comment "Mg-silicate clay is an authigenic mineral group that is rich in magnesium and silicon and precipitates in the alkaline lacustrine systems characteristic of the Brazilian Pre-Salt. This diagenetically unstable mineral is a key precursor phase, and its subsequent dissolution is a primary mechanism for creating secondary porosity, while its replacement by calcite or silica significantly alters reservoir properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:AlkalineLacustrineEnvironment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001001 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        presalt:ClayMineral .

presalt:OrganicMatter a owl:Class ;
    rdfs:label "organic matter"@en ;
    rdfs:comment "Organic matter is a carbonaceous sedimentary component that is derived from the remains of once-living organisms, such as microbes and algae. In the Pre-Salt lacustrine setting, it is commonly preserved as kerogen within dark, finely laminated mudstones and clay-rich facies deposited in deeper, anoxic parts of the lake. Its diagenesis can significantly influence mineral stability, and it constitutes the primary material for hydrocarbon generation in source rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:Mudstone ],
        georeservoir:GEOCORE_0000006 .

presalt:SedimentaryBasin a owl:Class ;
    rdfs:label "sedimentary basin"@en ;
    rdfs:comment "A sedimentary basin is a region of the Earth's crust that has undergone long-term subsidence, creating accommodation space for the accumulation of a significant thickness of sediments and volcanic rocks. These basins are formed by tectonic processes, such as the rifting associated with continental breakup, which control their geometry and evolutionary phases (e.g., rift, post-rift, drift). The resulting sedimentary fill, which can include siliciclastic, carbonate, and evaporitic deposits overlying a crystalline basement, often hosts significant petroleum systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:AccommodationSpace ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Subsidence ],
        georeservoir:GEOCORE_0000001 .

presalt:Silicification a owl:Class ;
    rdfs:label "silicification"@en ;
    rdfs:comment "Silicification is a diagenetic process that replaces pre-existing minerals, such as carbonates and magnesium-clays, with various forms of silica. In Brazilian Pre-Salt reservoirs, this process is often driven by hydrothermal or CO2-rich fluids and results in the precipitation of microcrystalline silica, chalcedony, and quartz, which can either replace the host rock or cement pore spaces. This alteration significantly modifies the original rock fabric and can severely reduce reservoir porosity and permeability by occluding pores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MgSilicateClay ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Silica ],
        presalt:DiageneticProcess .

presalt:TectonicActivity a owl:Class ;
    rdfs:label "tectonic activity"@en ;
    rdfs:comment "Tectonic activity is a geological process that involves the deformation of the Earth's crust through faulting and folding. In sedimentary basins such as the Brazilian Pre-Salt, it is a primary control on the creation of accommodation space, influencing depositional geometry, reservoir thickness, and diagenetic fluid pathways."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:SedimentaryBasin ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Crust ],
        georeservoir:GEOCORE_0000002 .

georeservoir:GEORES_0000025 a owl:Class ;
    rdfs:label "Sedimentary Structure"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000012 .

presalt:AririFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Ariri Formation"@en ;
    rdfs:comment "The Ariri Formation is an Upper Aptian evaporitic stratigraphic unit that was deposited over the Barra Velha Formation in the Santos Basin and serves as the primary regional seal for the Pre-Salt petroleum system. It is composed of a complexly interstratified sequence, typically with a basal anhydrite layer overlain by thick halite with intercalations of carnallite, tachyhydrite, and sylvite. Reaching thicknesses of over 2000 meters, the unit's varied rheology drives the formation of salt walls and diapirs, controlling post-rift deformation."@en .

presalt:BarraVelhaFormation a owl:NamedIndividual,
        presalt:LithostratigraphicUnit ;
    rdfs:label "Barra Velha Formation"@en ;
    rdfs:comment "The Barra Velha Formation is an Aptian-age geological formation that constitutes the primary lacustrine carbonate reservoir succession of the Brazilian Pre-Salt, deposited during the late rift to sag phases in the Santos Basin. It is composed of a complex suite of lithologies including in-situ microbialites (shrubstones) and spherulites, reworked intraclastic grainstones, and Mg-rich clays, and is stratigraphically positioned between the underlying Itapema Formation and the overlying Ariri Formation evaporites."@en .

presalt:Bioclast a owl:Class ;
    rdfs:label "bioclast"@en ;
    rdfs:comment "A bioclast is a sedimentary particle that consists of whole or fragmented skeletal hard parts of organisms. Within the Brazilian Pre-Salt, bioclasts are primarily derived from lacustrine organisms such as bivalves, ostracods, and gastropods, and may also include phosphatic fragments like fish vertebrae."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Bivalve ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Ostracod ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Gastropod ],
        georeservoir:GEOCORE_0000001 .

presalt:Fluid a owl:Class ;
    rdfs:label "fluid"@en ;
    rdfs:comment "Fluid is a naturally occurring substance that occupies the pore system of rocks and is capable of flow, typically encompassing hydrocarbons (oil and gas) and formation water. In a reservoir context, fluids are characterized by their physical and chemical properties, such as pressure-volume-temperature (PVT) behavior and composition, which govern processes like gravitational segregation and displacement. Petrophysically, pore fluids are differentiated into mobile 'free fluid' that can be produced and immobile 'bound fluid' retained by capillary or molecular forces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Composition ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        georeservoir:GEOCORE_0000009 .

presalt:Fracture a owl:Class ;
    rdfs:label "fracture"@en ;
    rdfs:comment "A fracture is a structural discontinuity that forms from the mechanical failure of rock under tectonic or gravitational stress, commonly occurring as opening-mode joints within brittle, silicified layers of carbonate reservoirs. In the Pre-Salt, these features are typically steep, often partially open or cemented with silica, and may be enlarged by dissolution, creating a significant component of the reservoir's non-matrix porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:SilicaCement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        georeservoir:GEOCORE_0000004 .

presalt:Intraclast a owl:Class ;
    rdfs:label "intraclast"@en ;
    rdfs:comment "An intraclast is a sedimentary clast that is composed of reworked fragments of penecontemporaneous carbonate sediment originating from within the same depositional basin. In the Brazilian Pre-Salt, these clasts are typically fragments of spherulites, shrubs, or laminated carbonates, forming intraclastic grainstones and rudstones that serve as important reservoir facies. They exhibit a wide range of sizes and shapes and are often subject to diagenetic alteration, including silicification and dolomitization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateSediment ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:Spherulite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:LaminatedCarbonate ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:Clast .

presalt:PostRift a owl:Class ;
    rdfs:label "post-rift"@en ;
    rdfs:comment "Post-rift is a tectono-stratigraphic phase in basin evolution, also known as the sag or transitional phase, that follows the cessation of active crustal extension and is primarily driven by thermal subsidence. In the context of the Brazilian Pre-Salt, this phase encompasses the deposition of the lacustrine carbonate reservoirs of the Barra Velha Formation and the overlying evaporites of the Ariri Formation. The resulting aggradational depositional pattern tends to fill in and smooth over the structural relief created during the preceding rift phase."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:SynRift ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000062 ;
            owl:someValuesFrom presalt:SynRift ],
        presalt:TectonoStratigraphicInterval .

presalt:Quartz a owl:Class ;
    rdfs:label "quartz"@en ;
    rdfs:comment "Quartz is a tectosilicate mineral that is composed of silicon dioxide (SiO₂) and is a common rock-forming mineral. In the Brazilian Pre-Salt, it occurs as both detrital grains and as a significant authigenic phase resulting from diagenesis. This diagenetic quartz frequently replaces precursor carbonate minerals and precipitates as cement in various forms, such as microcrystalline, macrocrystalline, and prismatic, which can significantly alter reservoir rock properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        presalt:TectosilicateMineral .

georeservoir:GEORES_0000002 a owl:Class ;
    rdfs:label "Stratigraphic Unit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Strata ],
        georeservoir:GEORES_0000001 .

bfo:BFO_0000132 a owl:ObjectProperty ;
    rdfs:label "occurrent part of"@en .

presalt:Cement a owl:Class ;
    rdfs:label "cement"@en ;
    rdfs:comment "Cement is an authigenic mineral material that precipitates from formation fluids into the void spaces of a rock, binding sedimentary grains and reducing porosity. In Pre-Salt carbonates, it comprises various compositions including dolomite, calcite, and silica, and as a key diagenetic process, it fills primary pores, dissolution vugs, and fractures, significantly impacting reservoir quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Silica ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom presalt:PoreSpace ],
        presalt:DiageneticProduct .

presalt:Clast a owl:Class ;
    rdfs:label "clast"@en ;
    rdfs:comment "A clast is an individual fragment of a pre-existing rock or semi-consolidated sediment that has been incorporated into a new sedimentary rock. In the context of Brazilian Pre-Salt carbonates, clasts are commonly composed of reworked microbial fabrics, spherulites, or peloidal micrites, and can range in size from sand to pebbles, forming clast-supported rocks like rudstones and breccias. These fragments can be intensely silicified, and the spaces between them (interclast) or within them (intraclast) constitute significant types of reservoir porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Micrite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Spherulite ],
        georeservoir:GEOCORE_0000001 .

presalt:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "A fault is a planar or curviplanar fracture that separates two blocks of rock which have moved relative to one another, resulting in measurable shear displacement. In the context of the Brazilian Pre-Salt, faults are classified into sets based on orientation, length, and age (e.g., syn-rift), and are identified using seismic and well data. These structures compartmentalize reservoirs and create zones of associated fractures, known as fault influence widths, which are critical for understanding non-matrix porosity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Fracture ],
        presalt:Fracture .

presalt:Grain a owl:Class ;
    rdfs:label "grain"@en ;
    rdfs:comment "Grain is a discrete constituent particle that serves as a fundamental building block of a sedimentary rock. In the context of Brazilian Pre-Salt carbonates, grains are typically sand- to gravel-sized and include a variety of components such as spherulites, fragments of shrubs, peloids, and intraclasts. The arrangement, size, sorting, and nature of these grains, along with their diagenetic alteration, are critical in controlling the porosity and permeability of reservoir facies like grainstones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom georeservoir:GEORES_0000032 ],
        georeservoir:GEOCORE_0000006 .

presalt:Grainstone a owl:Class ;
    rdfs:label "grainstone"@en ;
    rdfs:comment "Grainstone is a grain-supported sedimentary carbonate rock that is characterized by the absence of a mud matrix and, within the Pre-Salt context, is defined by having more than 50% reworked components. These rocks typically form in high-energy lacustrine shoreline environments through the reworking of pre-existing deposits, resulting in accumulations of grains such as shrub and spherulite fragments, ooids, peloids, and bioclasts. Texturally variable, they can range from poorly to well-sorted and often form lobate or fan-like bodies that constitute significant reservoir intervals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Peloid ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Ooid ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Grain ],
        presalt:GrainSupportedCarbonateRock .

presalt:LithostratigraphicUnit a owl:Class ;
    rdfs:label "lithostratigraphic unit"@en ;
    rdfs:comment "A lithostratigraphic unit is a body of rock strata that is defined and identified based on its distinct lithological characteristics and its stratigraphic position relative to other units. These formally named units, such as the Barra Velha and Itapema Formations in the Brazilian Pre-Salt, are the fundamental building blocks of stratigraphic classification and are mappable at the scale of geological investigation using well log and seismic data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Strata ],
        georeservoir:GEORES_0000002 .

presalt:Dolomitization a owl:Class ;
    rdfs:label "dolomitization"@en ;
    rdfs:comment "Dolomitization is a diagenetic process that involves the partial or complete replacement of pre-existing minerals, such as calcite and magnesium-rich clays, by the mineral dolomite. In Pre-Salt reservoirs, this process is a critical control on reservoir quality, capable of either significantly enhancing porosity and permeability by creating intercrystalline pore networks or reducing it, depending on its timing and fabric. Early dolomitization often does not improve reservoir quality, whereas later dolomitization associated with fracturing can create high-quality reservoirs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom presalt:Diagenesis ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MgSilicateClay ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Dolomite ],
        presalt:DiageneticProcess .

presalt:PoreSpace a owl:Class ;
    rdfs:label "pore space"@en ;
    rdfs:comment "Pore space is the total void volume within a rock that is not occupied by solid mineral constituents and is available to contain fluids such as oil, gas, or water. In Pre-Salt carbonates, this space comprises a complex network of various pore types, including interparticle, vuggy, and fracture porosity, whose final volume and connectivity are heavily modified by diagenetic processes like dissolution and cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Cementation ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:VuggyPorosity ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:Pore ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000178 ;
            owl:someValuesFrom presalt:InterparticlePore ],
        bfo:BFO_0000006 .

presalt:Subsidence a owl:Class ;
    rdfs:label "subsidence"@en ;
    rdfs:comment "Subsidence is a geological process of downward vertical movement of the Earth's crust that creates accommodation space for sediment accumulation. Driven by factors such as tectonic extension, thermal cooling, and sediment loading, its rate is a critical parameter in stratigraphic models that govern depositional patterns and facies distribution. In rift basins like the Brazilian Pre-Salt, subsidence is often spatially and temporally variable, controlling the thickness and geometry of sedimentary packages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Crust ],
        georeservoir:GEOCORE_0000002 .

presalt:SynRift a owl:Class ;
    rdfs:label "syn-rift"@en ;
    rdfs:comment "Syn-rift is a tectono-stratigraphic interval that is genetically associated with the active phase of continental rifting, characterized by fault-controlled mechanical subsidence and deposition within developing grabens and half-grabens. This interval ends when active mechanical subsidence ceases, a transition often marked by a major regional unconformity, and its deposits in the Brazilian Pre-Salt include volcanic, siliciclastic, and lacustrine carbonate rocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Extension ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom presalt:Subsidence ],
        presalt:TectonoStratigraphicInterval .

georeservoir:GEOCORE_0000003 a owl:Class ;
    rdfs:label "Geological Age"@en ;
    rdfs:subClassOf bfo:BFO_0000019 .

presalt:ClayMineral a owl:Class ;
    rdfs:label "Clay Mineral"@en ;
    rdfs:subClassOf presalt:PhyllosilicateMineral .

georeservoir:GEOCORE_0000006 a owl:Class ;
    rdfs:label "Earth Material"@en ;
    rdfs:subClassOf bfo:BFO_0000040 .

presalt:Dolomite a owl:Class ;
    rdfs:label "dolomite"@en ;
    rdfs:comment "Dolomite is a carbonate mineral composed of calcium magnesium carbonate (CaMg(CO3)2) that occurs extensively in Pre-Salt lacustrine successions as a primary precipitate, a diagenetic replacement of precursor carbonates, and a pore-filling cement. It presents in various crystal habits, including rhombohedral, saddle, and microcrystalline forms, which are critical in defining reservoir properties. Its occurrence is often linked to specific depositional facies, such as spherulite-rich intervals and Mg-claystones, where it can significantly alter the original rock fabric and porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:BrazilianPreSalt ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:RO_0001000 ;
            owl:someValuesFrom presalt:CarbonateRock ],
        presalt:CarbonateMineral .

presalt:Spherulite a owl:Class ;
    rdfs:label "spherulite"@en ;
    rdfs:comment "Spherulite is a spherical to sub-spherical calcite aggregate that is characterized by a primary fibro-radial internal structure composed of radiating crystals. Typically ranging in diameter from 0.1 to 4 mm, they can form around nuclei of micrite, clay, or ostracod fragments and are a primary grain type in Pre-Salt carbonate rocks. Although originally calcitic, spherulites are frequently altered through diagenetic processes such as dolomitization, silicification, or recrystallization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Silicification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dolomitization ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        georeservoir:GEOCORE_0000001 .

georeservoir:GEORES_0000020 a owl:Class ;
    rdfs:label "Depositional System"@en ;
    rdfs:subClassOf bfo:BFO_0000027 .

presalt:CarbonateMineral a owl:Class ;
    rdfs:label "Carbonate Mineral"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000176 ;
            owl:someValuesFrom presalt:ReservoirRock ],
        presalt:Mineral .

presalt:Pore a owl:Class ;
    rdfs:label "Pore"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:DiageneticProcess ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000171 ;
            owl:someValuesFrom georeservoir:GEOCORE_0000008 ],
        bfo:BFO_0000006 .

georeservoir:GEORES_0000031 a owl:Class ;
    rdfs:label "Sediment"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000010 .

presalt:Silica a owl:Class ;
    rdfs:label "silica"@en ;
    rdfs:comment "Silica is a diagenetic mineral phase composed of silicon dioxide that occurs in multiple paragenetic stages within Pre-Salt carbonate reservoirs, including as syndepositional layers, replacive bodies, and cements. These occurrences, often classified as early replacive layers (Silica I), pore-lining cements (Silica II), and late pore-filling cements (Silica III), are a primary control on the development of non-matrix porosity and excess permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:DiageneticMineral .

presalt:Calcite a owl:Class ;
    rdfs:label "calcite"@en ;
    rdfs:comment "Calcite is a carbonate mineral (CaCO₃) that, in the Pre-Salt, occurs as both a primary rock-forming precipitate and a later diagenetic cement. Primary forms include spherulitic and fascicular-optic aggregates (shrubs), while diagenetic habits such as blocky, poikilotopic, and macrocrystalline calcite fill various pore types, though it is also subject to dissolution, which creates secondary porosity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue presalt:BrazilianPreSalt ;
            owl:onProperty bfo:BFO_0000171 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000056 ;
            owl:someValuesFrom presalt:Dissolution ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:Diagenesis ],
        presalt:CarbonateMineral .

presalt:DiageneticProcess a owl:Class ;
    rdfs:label "diagenetic process"@en ;
    rdfs:comment "A diagenetic process is any physical, chemical, or biological change that modifies sedimentary deposits after their initial deposition and before the onset of metamorphism. In Pre-Salt carbonates, these processes include dissolution, cementation, recrystallization, compaction, and replacement, which are driven by changes in fluid chemistry, temperature, and pressure during burial. These alterations are fundamental in controlling reservoir quality by creating, modifying, or destroying porosity and permeability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:PreSaltCarbonate ],
        georeservoir:GEOCORE_0000002 .

presalt:Mineral a owl:Class ;
    rdfs:label "mineral"@en ;
    rdfs:comment "A mineral is a naturally occurring, solid, inorganic substance that possesses a definite chemical composition and a specific, ordered internal atomic structure. In the context of the Brazilian Pre-Salt, primary and diagenetic minerals, such as various forms of calcite and dolomite, quartz, and clay minerals, are the fundamental constituents of the carbonate reservoir rocks and provide critical information on depositional and diagenetic history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:RO_0000086 ;
            owl:someValuesFrom presalt:Composition ],
        georeservoir:GEOCORE_0000006 .

georeservoir:GEOCORE_0000004 a owl:Class ;
    rdfs:label "Geological Structure"@en ;
    rdfs:subClassOf bfo:BFO_0000031 .

georeservoir:GEOCORE_0000014 a owl:ObjectProperty ;
    rdfs:label "generated in"@en .

bfo:BFO_0000117 a owl:ObjectProperty ;
    rdfs:label "has occurrent part"@en .

georeservoir:GEOCORE_0000002 a owl:Class ;
    rdfs:label "Geological Process"@en ;
    rdfs:subClassOf bfo:BFO_0000015 .

bfo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en .

georeservoir:GEORES_0000032 a owl:Class ;
    rdfs:label "Sedimentary Rock"@en ;
    rdfs:subClassOf georeservoir:GEOCORE_0000008 .

bfo:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from"@en .

georeservoir:GEOCORE_0000001 a owl:Class ;
    rdfs:label "Sedimentary Geological Object"@en ;
    rdfs:subClassOf bfo:BFO_0000030 .

presalt:Dissolution a owl:Class ;
    rdfs:label "dissolution"@en ;
    rdfs:comment "Dissolution is a diagenetic process that creates or enhances secondary porosity through the chemical removal of mineral material by fluids. In Pre-Salt carbonates, it is a primary mechanism for generating vuggy, intragranular, and inter-framework pores by affecting components like Mg-clays and shrubs during both eodiagenetic and mesodiagenetic stages, and can release ions that promote subsequent cementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MgClay ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Cement ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:MgClay ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:CarbonateFabric ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom presalt:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom presalt:PreSaltCarbonate ],
        presalt:DiageneticProcess .

bfo:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

georeservoir:GEOCORE_0000008 a owl:Class ;
    rdfs:label "Rock"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Mineral ],
        georeservoir:GEOCORE_0000006 .

presalt:CarbonateRock a owl:Class ;
    rdfs:label "Carbonate Rock"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:CarbonatePrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Calcite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:Dolomite ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000013 ;
            owl:someValuesFrom presalt:CarbonatePrecipitation ],
        [ a owl:Restriction ;
            owl:onProperty georeservoir:GEOCORE_0000017 ;
            owl:someValuesFrom presalt:CarbonateMineral ],
        georeservoir:GEORES_0000032 .

